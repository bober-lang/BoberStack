//! Access keys, the identities they act as, and the accounts they belong to.

import { Fault } from "../fault"
import { Store, Table } from "../state/store"
import { Authorization, verify } from "./sigv4"
import { isDigit } from "std/ascii"
import { CryptoError } from "std/crypto/error"
import { bytes } from "std/crypto/random"
import { Request } from "std/http"

/// An access key issued: a user's, or a temporary one, which a session token goes with until it expires.
export class Credential {
	secret = ""
	account = ""
	/// The identity it acts as, and that identity's unique id.
	arn = ""
	userId = ""
	/// Active, Inactive, or Deleted: a deleted key's is kept, so that it is refused, not taken for an unknown one.
	status = "Active"
	/// A temporary one's; "" and 0 for a user's.
	token = ""
	expiry: i64 = 0
}

/// The credentials issued, by access key id, in the global state.
export function credentials(global: Store): Table[Credential] { return new Table[Credential](global, "credentials") }

/// The account whose root an unknown access key is taken for, as LocalStack has it: the key itself if it is 12
/// digits, else 000000000000.
export function accountOf(accessKey: string): string {
	return if (accessKey.length == 12 && accessKey.every(isDigit)) accessKey else "000000000000"
}

/// Why c may not sign req, whose body is body, under auth at the instant now, as AWS answers it; null if it may: it is
/// active, of the session token the request bears, not yet expired, and the signature is its.
export function authenticate(c: Credential, req: Request, body: string, auth: Authorization,
	now: i64): Fault | null throws CryptoError {
	if (c.status != "Active" || c.token != (req.headers.get("x-amz-security-token") ?? "")) {
		return new Fault(403, "InvalidClientTokenId", "The security token included in the request is invalid.")
	}
	if (c.expiry != 0 && now >= c.expiry) {
		return new Fault(403, "ExpiredToken", "The security token included in the request is expired")
	}
	const why = verify(req, body, auth, c.secret, now)
	return if (why == null) null else new Fault(403, "SignatureDoesNotMatch", why)
}

/// A unique id as AWS makes them: prefix and n random characters of A-Z and 2-7, as AIDA… for a user or AKIA… for
/// an access key.
export function id(prefix: string, n: i32): string throws Fault {
	return prefix + random(n, "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567")
}

/// n random characters of base64's: a secret access key's 40, or a session token.
export function secret(n: i32 = 40): string throws Fault {
	return random(n, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
}

/// n characters drawn from alphabet, of 32 or 64, which a byte's value divides evenly.
function random(n: i32, alphabet: string): string throws Fault {
	let b = ""
	try {
		b = bytes(n)
	} catch (e: IoError) {
		throw new Fault(500, "InternalFailure", `No random bytes: ${e}`)
	}
	const out: u8[] = []
	for (let i = 0; i < n; i++) {
		out.push(alphabet[(b[i] as i32) % alphabet.length])
	}
	return fromBytes(out)
}
