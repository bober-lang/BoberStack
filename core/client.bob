//! What tests of a gateway share: requests signed as an SDK signs them, and what is in the answers.

import * as sigv4 from "./auth/sigv4"
import { CryptoError } from "std/crypto/error"
import { parse } from "std/encoding/xml"
import { Request, Response } from "std/http"
import { ParseError } from "std/string"

/// A query of body to service from accessKey, dated now as tests see it, signed by secret, of the session token if
/// not "".
export function request(service: string, accessKey: string, secret: string, body: string,
	token = ""): Request throws CryptoError | ParseError {
	const req = new Request("POST", "http://localhost:4566/", body)
	req.headers.set("content-type", "application/x-www-form-urlencoded; charset=utf-8")
	sign(req, body, service, "us-east-1", accessKey, secret, token, "20150626T140000Z")
	return req
}

/// Signs req, whose body is body, for service in region from accessKey by secret, of the session token if not "", at
/// stamp, as 20150626T140000Z: over its host, its Content-Type and X-Amz-Target if set, X-Amz-Date and the token.
export function sign(req: Request, body: string, service: string, region: string, accessKey: string, secret: string,
	token: string, stamp: string) throws CryptoError {
	req.headers.set("host", `${req.url.host}${if (req.url.port == null) "" else `:${req.url.port}`}`)
	req.headers.set("x-amz-date", stamp)
	if (token != "") {
		req.headers.set("x-amz-security-token", token)
	}
	const signed = ["content-type", "host", "x-amz-date", "x-amz-security-token",
		"x-amz-target"].filter(h => req.headers.has(h)).join(";")
	const header = `AWS4-HMAC-SHA256 Credential=${accessKey}/${stamp.slice(0, 8)}/${region}/${service}/aws4_request, `
		+ `SignedHeaders=${signed}, Signature=`
	req.headers.set("authorization", header + sigv4.signature(req, body, sigv4.parse(header + "0")!, secret))
}

/// The texts of the elements named name in the document of res, in order.
export function texts(res: Response, name: string): string[] throws ParseError {
	return parse(res.body.whole ?? "").elements(name).map(e => e.text())
}

/// The text of the first element named name in the document of res, null if none.
export function text(res: Response, name: string): string | null throws ParseError { return texts(res, name).at(0) }
