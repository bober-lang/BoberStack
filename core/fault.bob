//! What a request fails with, whatever its service or protocol.

/// An error a request is answered with: its code, message and HTTP status, whether the sender is at fault, and the
/// error's other members, as its service's protocol writes them within the error: JSON members or XML elements.
export class Fault {
	status: i32
	code: string
	message: string
	sender: bool
	members: string

	constructor(status: i32, code: string, message: string, sender: bool = status < 500, members: string = "") {
		this.status = status
		this.code = code
		this.message = message
		this.sender = sender
		this.members = members
	}
}
