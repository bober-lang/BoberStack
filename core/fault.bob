//! What a request fails with, whatever its service or protocol.

/// An error a request is answered with; members holds its other members, already in its protocol's JSON or XML.
export class Fault {
	status: i32
	code: string
	message: string
	sender: bool
	members: string
	/// Headers besides every answer's, as S3's x-amz-delete-marker.
	headers: [string, string][] = []

	constructor(status: i32, code: string, message: string, sender: bool = status < 500, members: string = "") {
		this.status = status
		this.code = code
		this.message = message
		this.sender = sender
		this.members = members
	}
}
