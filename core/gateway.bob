//! The HTTP handler in front of every service: it authenticates a request by SigV4, in its Authorization header or
//! its query, or by a SigV2 presigned URL, decodes an aws-chunked body, and hands it to the service its credential scope names, in a transaction
//! over the state.

import * as chunked from "./auth/chunked"
import { accountOf, authenticate, credentials, use } from "./auth/credentials"
import * as sigv2 from "./auth/sigv2"
import * as sigv4 from "./auth/sigv4"
import { Fault } from "./fault"
import { addressed, Internal } from "./internal"
import * as query from "./protocol/query"
import { Caller, Identify } from "./service"
import { Store } from "./state/store"
import { Signal } from "builtin/fiber"
import { HashMap } from "std/collections/hashmap"
import { CryptoError } from "std/crypto/error"
import { bytes } from "std/crypto/random"
import * as hex from "std/encoding/hex"
import { Body, Request, Response } from "std/http"
import { ParseError } from "std/string"

/// A service's answer to a request, its body whole, from caller.
export type Service = (caller: Caller, req: Request) => Response throws IoError | ParseError
/// A service's answer to a fault of the gateway's, in its protocol, under a request id.
export type Faulted = (f: Fault, requestId: string) => Response

/// One request at a time reads and writes the state: each in a transaction of the trees it opens, which commit together
/// if it answers 2xx and are dropped if not, so that a request that fails leaves no trace.
export class Gateway {
	/// By signing name.
	services = new HashMap[string, Service]()
	/// How a service answers the faults the gateway finds once it knows the service, by signing name; in awsQuery's XML
	/// for one not here, and before the service is known.
	faults = new HashMap[string, Faulted]()
	/// The signing name of the service that requests with no authentication at all go to, as S3 serves public objects;
	/// null for none, when they are answered MissingAuthenticationToken. Its caller's account is "" and its ARN "*".
	anonymous: string | null = null
	/// The committed state: each account's tree, from the first request that opens it, and the global one by "", which
	/// holds the credentials issued. Access keys of none are taken, unchecked, for the root of accountOf's account.
	trees = new HashMap[string, Store]()
	/// The names of the trees, as a HashMap lists none, for the endpoints that snapshot them.
	named: string[] = []
	/// The endpoints that are not AWS's, and the snapshots they keep.
	internal = new Internal()
	/// The most bytes a request's body may hold, by signing name: S3's 5 GiB of a PutObject or UploadPart, else std's
	/// 10 MiB. A body is read whole into memory, so a host short of it may lower S3's.
	limits = limits()
	/// How IAM sees a caller, which its requests are authorized by; without it only an account's root is allowed.
	identify: Identify | null = null
	/// Whether a request holds the lock on the trees, and what those waiting for it wait on.
	private busy = false
	private freed = new Signal()

	handle(req: Request): Response throws IoError | ParseError {
		if (addressed(req.url.path)) {
			return this.locked(() => this.internal.handle(req, this, n => this.services.has(n)))
		}
		const id = requestId()
		let auth: sigv4.Authorization | null = null
		try {
			auth = sigv2.presigned(req) ?? sigv4.authorization(req)
		} catch (f: Fault) {
			return query.error(f, id)
		}
		const name = auth?.service ?? this.anonymous
		const service = if (name == null) null else this.services.get(name!)
		if (auth == null && service == null) {
			const why = "Request is missing Authentication Token"
			return query.error(new Fault(403, "MissingAuthenticationToken", why), id)
		}
		if (service == null) {
			return query.error(new Fault(501, "NotImplemented", `The service ${name} is not implemented`), id)
		}
		const limit = this.limits.get(name!) ?? (10 << 20)
		if ((req.body.length ?? 0) > limit) {
			const why = new Fault(400, "EntityTooLarge", "Your proposed upload exceeds the maximum allowed size", true,
				`<ProposedSize>${req.body.length}</ProposedSize><MaxSizeAllowed>${limit}</MaxSizeAllowed>`)
			const faulted = this.faults.get(name!)
			return if (faulted == null) query.error(why, id) else faulted!(why, id)
		}
		const body = req.body.text(limit)
		req.body = new Body(body)
		return this.locked(() => this.serve(name!, service!, req, body, auth, id))
	}

	/// Closes the trees and the snapshots.
	close() {
		for (const t of this.trees.values()) {
			t.close()
		}
		this.trees = new HashMap[string, Store]()
		this.named = []
		this.internal.close()
	}

	/// What f answers, run holding the lock on the trees once the requests before it have let it go.
	private locked(f: () => Response throws IoError | ParseError): Response throws IoError | ParseError {
		while (this.busy) {
			this.freed.wait()
		}
		this.busy = true
		try {
			return f()
		} finally {
			this.busy = false
			this.freed.wake()
		}
	}

	/// The answer to req, with body, by service, named name, holding the lock: the credential of its access key is
	/// checked and its use recorded, an aws-chunked body decoded, and the trees it opens committed if it succeeds, else
	/// closed. Without auth the caller is anonymous.
	private serve(name: string, service: Service, req: Request, body: string, auth: sigv4.Authorization | null,
		id: string): Response throws IoError | ParseError {
		const global = this.trees.get("")
		const known = if (global == null || auth == null) null else credentials(global).get(auth.accessKey)
		let why: Fault | null = null
		try {
			if (known != null) {
				why = authenticate(known, req, body, auth!, now())
				if (why == null) {
					use(global!, auth!.accessKey, known, name, auth!.region, now())
				}
			}
			if (why == null && auth != null && chunked.chunked(req)) {
				req.body = new Body(chunked.decode(req, body, auth!, known?.secret))
			}
		} catch (e: CryptoError | Fault) {
			why = if (e instanceof Fault) e else new Fault(500, "InternalFailure", e.what)
		}
		if (why != null) {
			const faulted = this.faults.get(name)
			return if (faulted == null) query.error(why!, id) else faulted!(why!, id)
		}
		let caller = new Caller("", auth?.region ?? "us-east-1", "*", id, "anonymous", this.trees)
		if (auth != null) {
			const account = if (known == null) accountOf(auth.accessKey) else known.account
			const arn = if (known == null) `arn:aws:iam::${account}:root` else known.arn
			caller = new Caller(account, auth.region, arn, id, known?.userId ?? account, this.trees)
		}
		caller.endpoint = `http://${req.headers.get("host") ?? "localhost:4566"}`
		caller.credential = known
		caller.userAgent = req.headers.get("user-agent") ?? ""
		caller.identify = this.identify
		let res: Response | null = null
		try {
			res = service(caller, req)
		} finally {
			const commit = res != null && res!.status < 300
			for (const [account, tree] of caller.opened) {
				if (commit) {
					if (!this.trees.has(account)) {
						this.named.push(account)
					}
					this.trees.get(account)?.close()
					this.trees.set(account, tree)
				} else {
					tree.close()
				}
			}
		}
		return res!
	}
}

/// The limits on a body that are not std's.
function limits(): HashMap[string, i64] {
	const m = new HashMap[string, i64]()
	m.set("s3", 5 << 30)
	return m
}

/// A random UUID, as AWS's request ids are.
function requestId(): string throws IoError {
	const h = hex.encode(bytes(16))
	return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20, 32)}`
}
