//! The HTTP handler in front of every service: it authenticates a request (SigV4, or a SigV2 presigned URL), decodes an
//! aws-chunked or gzip body, and hands it to the service its credential scope names, in a transaction over the state. A
//! request whose handler holds it, as a long poll with nothing to answer yet, waits without the lock and is run again
//! whole after each request that commits and each tick. tick does, between requests, what services have due.

import * as chunked from "./auth/chunked"
import { accountOf, authenticate, credentials, expired, use } from "./auth/credentials"
import * as sigv2 from "./auth/sigv2"
import * as sigv4 from "./auth/sigv4"
import { Seen } from "./feed"
import { Fault } from "./fault"
import { uuid } from "./random"
import { addressed, Internal } from "./internal"
import * as cbor from "./protocol/cbor"
import * as query from "./protocol/query"
import { Caller, Identify } from "./service"
import { Store } from "./state/store"
import { Signal } from "builtin/fiber"
import { indexOf } from "std/algo"
import { HashMap } from "std/collections/hashmap"
import { Gunzipper } from "std/compress/gzip"
import { CryptoError } from "std/crypto/error"
import { Body, Request, Response } from "std/http"
import { lower, ParseError, split, trim } from "std/string"

/// A service's handler; the request's body is already read whole.
export type Service = (caller: Caller, req: Request) => Response throws IoError | ParseError
/// A service's answer, in its protocol, to a fault the gateway finds.
export type Faulted = (f: Fault, requestId: string, req: Request | null) => Response
/// A service's answer at a host of its own, to the id the host or path names, with the path past that.
export type Hosted = (caller: Caller, req: Request, id: string, path: string) => Response throws IoError | ParseError
/// A service's work between requests: what is due by instant t in the state that caller, an account's root in one of
/// its regions, sees.
export type Timed = (caller: Caller, t: i64) => void throws Fault

/// One request at a time reads and writes the state: each in a transaction of the trees it opens, which commit together
/// if it answers 2xx and are dropped if not, so that a request that fails leaves no trace.
export class Gateway {
	/// By signing name.
	services = new HashMap[string, Service]()
	/// How a service answers the faults the gateway finds, by signing name, or by label at a host of its own; awsQuery's
	/// XML for one not here, or RPC v2 CBOR's to a request of it.
	faults = new HashMap[string, Faulted]()
	/// What tick runs, in order.
	timed: Timed[] = []
	/// The signing name of the service that unauthenticated requests go to, as S3 serves public objects; null answers
	/// them MissingAuthenticationToken.
	anonymous: string | null = null
	/// Services at hosts of their own, with their signing names, by the label after the id, as Lambda's function URLs:
	/// <id>.<label>.<region>.<any domain>, or /_aws/<label>/<id>/<path> on any host. Signed or not.
	hosted = new HashMap[string, [string, Hosted]]()
	/// Each account's committed tree, and the global one by "", which holds the credentials issued. Access keys of none
	/// are taken, unchecked, for the root of accountOf's account.
	trees = new HashMap[string, Store]()
	/// The trees' names, which a HashMap does not list, for the snapshot endpoints.
	named: string[] = []
	internal = new Internal(this, n => this.services.has(n))
	/// The most bytes a body may hold, by signing name, else std's 10 MiB. A body is read whole into memory.
	limits = limits()
	/// The signing names whose requests' Content-Encoding is their content's own, kept as S3 keeps an object's and a
	/// function URL hands its function the body: a gzip body of any other is decoded, after its signature is checked over
	/// it as sent, to at most its limit.
	kept = ["s3", "lambda"]
	/// How IAM sees a caller; without it only an account's root is allowed.
	identify: Identify | null = null
	/// Refuse no request for lack of permission or trust.
	lenient = false
	/// Where the tick's callers say requests come to, as a request's Host says it for its own.
	endpoint = "http://localhost:4566"
	private busy = false
	private freed = new Signal()
	/// Woken by each commit, tick, reset and restore, for the requests held.
	private changed = new Signal()

	handle(req: Request): Response throws IoError | ParseError {
		const seen = this.internal.feed.seen(req)
		const res = this.answer(req, seen)
		seen?.publish(res)
		return res
	}

	private answer(req: Request, seen: Seen | null): Response throws IoError | ParseError {
		const [label, at, path] = this.host(req)
		const hosting = this.hosted.get(label)
		if (hosting == null && addressed(req.url.path)) {
			try {
				return this.locked(() => this.internal.handle(req))!
			} finally {
				this.changed.wake()
			}
		}
		let id = ""
		let auth: sigv4.Authorization | null = null
		try {
			id = uuid()
			seen?.numbered(id)
			auth = sigv2.presigned(req) ?? sigv4.authorization(req)
			if (hosting != null && auth != null && auth!.service != hosting![0]) {
				throw new Fault(403, "InvalidSignatureException",
					`Credential should be scoped to correct service: '${hosting![0]}'.`)
			}
		} catch (f: Fault) {
			const faulted = this.faults.get(label)
			return if (faulted == null) fallback(f, id, req) else faulted!(f, id, req)
		}
		const name = if (hosting != null) hosting![0] else auth?.service ?? this.anonymous
		seen?.routed(name, auth?.region)
		const service: Service | null = if (hosting != null) (c, r) => hosting![1](c, r, at, path)
			else if (name == null) null
			else this.services.get(name!)
		const faulted = this.faults.get(if (hosting != null) label else name ?? "")
		if (auth == null && service == null) {
			const why = "Request is missing Authentication Token"
			return fallback(new Fault(403, "MissingAuthenticationToken", why), id, req)
		}
		if (service == null) {
			return fallback(new Fault(501, "NotImplemented", `The service ${name} is not implemented`), id, req)
		}
		const limit = this.limits.get(name!) ?? (10 << 20)
		if ((req.body.length ?? 0) > limit) {
			return this.oversized(name!, req.body.length!, limit, id, req)
		}
		const body = req.body.text(limit)
		const arrived = now()
		while (true) {
			const res = this.locked(() => {
				req.body = new Body(body)
				return this.serve(name!, service!, faulted, req, body, auth, id, arrived, seen)
			})
			if (res != null) {
				return res!
			}
			this.changed.wait()
		}
	}

	/// The label of the host of its own that a service answers req at, the id it names and the path past it; "" for none.
	private host(req: Request): [string, string, string] {
		const labels = split(lower(req.headers.get("host") ?? ""), ".")
		if (labels.length >= 3 && this.hosted.has(labels[1])) {
			return [labels[1], labels[0], req.url.path]
		}
		const parts = split(req.url.path, "/")
		if (parts.length >= 4 && parts[1] == "_aws" && this.hosted.has(parts[2])) {
			const rest = req.url.path.slice(`/_aws/${parts[2]}/${parts[3]}`.length, req.url.path.length)
			return [parts[2], parts[3], if (rest == "") "/" else rest]
		}
		return ["", "", ""]
	}

	/// Runs what each service has due by instant t in every account's regions, in one transaction of the trees it opens,
	/// which commit together unless it throws; then wakes the requests held.
	tick(t: i64) throws Fault {
		this.acquire()
		const opened: [string, Store][] = []
		let done = false
		try {
			for (const n of this.named.slice(0, this.named.length)) {
				const slash = indexOf(n, "/")
				if (slash < 0) {
					continue
				}
				const account = n.slice(0, slash)
				for (const timed of this.timed) {
					const c = new Caller(account, n.slice(slash + 1, n.length), `arn:aws:iam::${account}:root`, uuid(),
						account, this.trees)
					c.identify = this.identify
					c.lenient = this.lenient
					c.endpoint = this.endpoint
					c.opened = opened
					c.rerun = false
					timed(c, t)
				}
			}
			done = true
		} finally {
			this.commit(opened, done)
			this.release()
			this.changed.wake()
		}
	}

	/// Runs f as a request outside HTTP is run, as SES's SMTP submission: under the lock, given the committed trees and
	/// the list it puts the trees its caller opens in, which commit together unless it throws.
	run(f: (committed: HashMap[string, Store], opened: [string, Store][]) => void throws Fault) throws Fault {
		this.acquire()
		const opened: [string, Store][] = []
		let done = false
		try {
			f(this.trees, opened)
			done = true
		} finally {
			this.commit(opened, done)
			this.release()
		}
	}

	close() {
		for (const t of this.trees.values()) {
			t.close()
		}
		this.trees = new HashMap[string, Store]()
		this.named = []
		this.internal.close()
	}

	/// The answer to a body over limit, as AWS answers it: S3's EntityTooLarge, CloudWatch's RequestEntityTooLarge, Logs'
	/// bare InternalFailure, else a 413 of no body, as STS's and Route 53's front ends; of a size not known, null, for a
	/// body decoded past its limit. Where AWS differs: CloudWatch refuses a body over 40960 bytes, and names that limit.
	private oversized(name: string, size: i64 | null, limit: i64, id: string, req: Request): Response {
		if (name == "s3") {
			const why = new Fault(400, "EntityTooLarge", "Your proposed upload exceeds the maximum allowed size", true,
				`<ProposedSize>${size ?? limit}</ProposedSize><MaxSizeAllowed>${limit}</MaxSizeAllowed>`)
			const faulted = this.faults.get(name)
			return if (faulted == null) query.error(why, id) else faulted!(why, id, null)
		}
		if (name == "monitoring") {
			const sized = if (size == null) "" else ` ${size}`
			const why = new Fault(413, "RequestEntityTooLarge", `Request size${sized} exceeded ${limit} bytes`, true)
			const faulted = this.faults.get(name)
			if (cbor.claims(req)) {
				return if (faulted == null) fallback(why, id, req) else faulted!(why, id, req)
			}
			return query.error(why, id, "http://monitoring.amazonaws.com/doc/2010-08-01/")
		}
		return new Response(if (name == "logs") 400 else 413, if (name == "logs") "<InternalFailure/>" else "")
	}

	private locked(f: () => Response | null throws IoError | ParseError): Response | null throws IoError | ParseError {
		this.acquire()
		try {
			return f()
		} finally {
			this.release()
		}
	}

	private acquire() {
		while (this.busy) {
			this.freed.wait()
		}
		this.busy = true
	}

	private release() {
		this.busy = false
		this.freed.wake()
	}

	/// Replaces the committed trees by those opened if commit, else closes them; wakes the requests held if any was.
	private commit(opened: [string, Store][], commit: bool) {
		for (const [account, tree] of opened) {
			if (commit) {
				if (!this.trees.has(account)) {
					this.named.push(account)
				}
				this.trees.get(account)?.close()
				this.trees.set(account, tree)
			} else {
				tree.close()
			}
		}
		if (commit && opened.length > 0) {
			this.changed.wake()
		}
	}

	/// null if the service held the request.
	private serve(name: string, service: Service, faulted: Faulted | null, req: Request, body: string,
		auth: sigv4.Authorization | null, id: string, arrived: i64,
		seen: Seen | null): Response | null throws IoError | ParseError {
		const global = this.trees.get("")
		const known = if (global == null || auth == null) null else credentials(global).get(auth.accessKey)
		let why: Fault | null = null
		try {
			if (known != null) {
				why = authenticate(known, req, body, auth!, now())
				if (why == null) {
					use(global!, auth!.accessKey, known, name, auth!.region, now())
				}
			} else if (auth != null) {
				why = expired(req, auth!, now())
			}
			if (why == null && auth != null && chunked.chunked(req)) {
				req.body = new Body(chunked.decode(req, body, auth!, known?.secret))
			}
		} catch (e: CryptoError | Fault) {
			why = if (e instanceof Fault) e else new Fault(500, "InternalFailure", e.what)
		}
		if (why != null) {
			return if (faulted == null) fallback(why!, id, req) else faulted!(why!, id, req)
		}
		if (gzipped(req) && !this.kept.includes(name)) {
			const limit = this.limits.get(name) ?? (10 << 20)
			try {
				req.body = new Body(new Body(new Gunzipper(req.body)).text(limit))
			} catch (e: IoError) {
				if (e.kind == "TooLarge") {
					return this.oversized(name, null, limit, id, req)
				}
				// AWS's documentation does not say how it answers a corrupt gzip body
				const corrupt = new Fault(400, "SerializationException",
					"The body is not gzip, as its Content-Encoding says")
				return if (faulted == null) fallback(corrupt, id, req) else faulted!(corrupt, id, req)
			}
		}
		let caller = new Caller("", auth?.region ?? "us-east-1", "*", id, "anonymous", this.trees)
		if (auth != null) {
			const account = if (known == null) accountOf(auth.accessKey) else known.account
			const arn = if (known == null) `arn:aws:iam::${account}:root` else known.arn
			caller = new Caller(account, auth.region, arn, id, known?.userId ?? account, this.trees)
		}
		caller.endpoint = `${req.url.scheme}://${req.headers.get("host") ?? "localhost:4566"}`
		caller.credential = known
		caller.userAgent = req.headers.get("user-agent") ?? ""
		caller.identify = this.identify
		caller.lenient = this.lenient
		caller.arrived = arrived
		seen?.served(caller)
		let res: Response | null = null
		let held = false
		try {
			res = service(caller, req)
			held = caller.held != null && now() < caller.held!
		} finally {
			// S3 answers a form's upload with a redirect when the form asks for one
			this.commit(caller.opened, res != null && (res!.status < 300 || res!.status == 303) && !held)
		}
		return if (held) null else res!
	}
}

/// The answer of the fault f to req of a service that answers none itself.
function fallback(f: Fault, id: string, req: Request): Response {
	return if (cbor.claims(req)) cbor.error(null, f, id) else query.error(f, id)
}

/// Whether gzip is the last coding req's Content-Encoding lists, aws-chunked aside, and so the first to undo.
function gzipped(req: Request): bool {
	const listed = split(lower(req.headers.get("content-encoding") ?? ""), ",")
	const codings = listed.map(c => trim(c)).filter(c => c != "" && c != "aws-chunked")
	return codings.length > 0 && codings[codings.length - 1] == "gzip"
}

function limits(): HashMap[string, i64] {
	const m = new HashMap[string, i64]()
	m.set("s3", 5 << 30)
	return m
}
