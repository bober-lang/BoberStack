import { request, text, ticks } from "./client.test"
import { Fault } from "./fault"
import { Gateway } from "./gateway"
import { Caller } from "./service"
import { Blob, live } from "./state/store"
import { Request, Response } from "std/http"
import { ParseError, parseInt } from "std/string"
import { millisecond, second, sleep } from "std/time"

/// Waits 10 ms of logical time between reading the count of requests and writing it one more, so that overlapping
/// requests would race; fails as the body asks.
function service(caller: Caller, req: Request, log: string[]): Response throws IoError | ParseError {
	const body = req.body.text()
	log.push(`start ${body}`)
	try {
		const count = parseInt(caller.store().get("count") ?? "0")
		sleep(10 * millisecond)
		caller.store().put("count", `${count + 1}`)
		caller.store().put(body, "account")
		caller.global().put(body, "global")
	} catch (f: Fault) {
		return new Response(f.status, f.message)
	}
	log.push(`end ${body}`)
	if (body == "throw") {
		throw new ParseError("syntax", 0)
	}
	return new Response(if (body == "fail") 400 else 200, "")
}

function gateway(log: string[] = []): Gateway {
	const g = new Gateway()
	g.services.set("test", (caller: Caller, req: Request) => service(caller, req, log))
	return g
}

function held(g: Gateway, k: string): [string | null, string | null] {
	return [g.trees.get("000000000000")?.get(k), g.trees.get("")?.get(k)]
}

test "a request that succeeds commits both trees, one that fails neither" {
	const before = live()
	const g = gateway()
	assert g.handle(request("test", "test", "test", "ok")).status == 200
	assert held(g, "ok") == ["account", "global"] && held(g, "count")[0] == "1"
	assert g.handle(request("test", "test", "test", "fail")).status == 400
	assert held(g, "fail") == [null, null] && held(g, "count")[0] == "1"
	assert g.handle(request("test", "test", "test", "throw")) throws new ParseError("syntax", 0)
	assert held(g, "throw") == [null, null] && held(g, "count")[0] == "1"
	assert live()[1] == before[1] + 2
	g.close()
	assert live() == before
}

test "a request parked in its handler holds off the next, whose write is not lost" {
	const before = live()
	const log: string[] = []
	const g = gateway(log)
	const a = async g.handle(request("test", "test", "test", "a"))
	const b = async g.handle(request("test", "test", "test", "b"))
	assert (await a).status == 200 && (await b).status == 200
	assert log == ["start a", "end a", "start b", "end b"]
	assert held(g, "count")[0] == "2" && held(g, "a") == ["account", "global"] && held(g, "b") == ["account", "global"]
	g.close()
	assert live() == before
}

test "a request that opens no tree commits none" {
	const before = live()
	const g = new Gateway()
	g.services.set("test", (caller: Caller, req: Request) => new Response(200, ""))
	assert g.handle(request("test", "test", "test", "")).status == 200 && g.trees.size == 0 && live() == before
}

test "a service called for a request writes into the request's trees" {
	const before = live()
	const g = new Gateway()
	g.services.set("test", (caller: Caller, req: Request) => {
		const sns = caller.internal("sns.amazonaws.com", "arn:aws:sns:us-east-1:000000000000:t", [])
		try {
			sns.regional().put("k",
				`${sns.arn} ${sns.source.slice(0, 11)} ${sns.endpoint} ${caller.regional().get("k")}`)
		} catch (f: Fault) {
			return new Response(f.status, f.message)
		}
		return new Response(if (req.body.text() == "fail") 400 else 200, "")
	})
	assert g.handle(request("test", "test", "test", "fail")).status == 400 && g.trees.size == 0
	assert g.handle(request("test", "test", "test", "ok")).status == 200
	assert g.trees.get("000000000000/us-east-1")?.get("k") == "sns.amazonaws.com arn:aws:sns http://localhost:4566 null"
	g.close()
	assert live() == before
}

/// A long poll of what other requests write, which needs a queue made first: "poll" holds for 5 seconds from its
/// arrival unless there is a value, and marks each of its runs, a mark dropped while it is held.
function polled(log: string[]): Gateway {
	const g = new Gateway()
	g.services.set("test", (caller: Caller, req: Request) => {
		const body = req.body.text()
		try {
			const s = caller.store()
			if (body != "poll") {
				s.put(body, body)
				return new Response(200, "")
			}
			log.push("run")
			s.put("polled", (s.get("polled") ?? "") + "x")
			if (s.get("queue") == null) {
				return new Response(400, "no queue")
			}
			const v = s.get("value")
			if (v == null && now() < caller.arrived + 5 * second) {
				caller.hold(caller.arrived + 5 * second)
			}
			return new Response(200, v ?? "none")
		} catch (f: Fault) {
			return new Response(f.status, f.message)
		}
	})
	return g
}

test "a held request waits without the lock and is answered once a request commits what it waits for" {
	const log: string[] = []
	const g = polled(log)
	assert g.handle(request("test", "test", "test", "queue")).status == 200
	const t = now()
	const p = async g.handle(request("test", "test", "test", "poll"))
	assert g.handle(request("test", "test", "test", "other")).status == 200
	sleep(millisecond)
	assert g.handle(request("test", "test", "test", "value")).status == 200
	const res = await p
	assert res.status == 200 && res.body.whole == "value" && now() - t < second
	assert log == ["run", "run", "run"]
	g.close()
}

test "a held request answers empty at the first tick after its time is up, its held runs leaving no trace" {
	const log: string[] = []
	const g = polled(log)
	assert g.handle(request("test", "test", "test", "queue")).status == 200
	const t = now()
	const p = async g.handle(request("test", "test", "test", "poll"))
	const ticking = async ticks(g, 6)
	const res = await p
	assert res.status == 200 && res.body.whole == "none"
	assert now() - t >= 5 * second && now() - t < 6 * second
	const marks = held(g, "polled")[0]
	assert marks == "x" && log.length == 6
	await ticking
	g.close()
}

test "many held requests are all answered by one commit" {
	const g = polled([])
	assert g.handle(request("test", "test", "test", "queue")).status == 200
	const a = async g.handle(request("test", "test", "test", "poll"))
	const b = async g.handle(request("test", "test", "test", "poll"))
	const c = async g.handle(request("test", "test", "test", "poll"))
	assert g.handle(request("test", "test", "test", "value")).status == 200
	for (const p of [a, b, c]) {
		assert (await p).body.whole == "value"
	}
	g.close()
}

test "a reset runs a held request again, against the state it left" {
	const g = polled([])
	assert g.handle(request("test", "test", "test", "queue")).status == 200
	const p = async g.handle(request("test", "test", "test", "poll"))
	assert g.handle(new Request("POST", "http://localhost:4566/_boberstack/state/reset", "")).status == 200
	const res = await p
	assert res.status == 400 && res.body.whole == "no queue"
	g.close()
}

function blobs(): Gateway {
	const g = new Gateway()
	g.services.set("s3", (caller: Caller, req: Request) => {
		const body = req.body.text()
		try {
			caller.global().put("k", "", Blob.of(body))
		} catch (f: Fault) {
			return new Response(f.status, f.message)
		}
		const crc = req.headers.get("x-amz-checksum-crc32") ?? ""
		return new Response(if (body == "fail") 400 else 200, `${caller.account}|${caller.arn}|${body}|${crc}`)
	})
	return g
}

test "a blob written by a request that fails is freed" {
	const before = live()
	const g = blobs()
	assert g.handle(request("s3", "test", "test", "fail")).status == 400 && live() == before
	assert g.handle(request("s3", "test", "test", "kept")).status == 200 && live()[2] == before[2] + 1
	const kept = g.trees.get("")!.blob("k")!
	assert kept.read() == "kept"
	g.close()
	assert live() == before
}

test "an aws-chunked body reaches the service decoded, or is answered in the service's form" {
	const before = live()
	const g = blobs()
	const chunked = (decoded: string) => {
		const req = request("s3", "test", "test", "5\r\nhello\r\n0\r\nx-amz-checksum-crc32:NhCmhg==\r\n\r\n")
		req.headers.set("x-amz-content-sha256", "STREAMING-UNSIGNED-PAYLOAD-TRAILER")
		req.headers.set("content-encoding", "aws-chunked")
		req.headers.set("x-amz-decoded-content-length", decoded)
		return req
	}
	const ok = g.handle(chunked("5"))
	assert ok.status == 200 && ok.body.text() == "000000000000|arn:aws:iam::000000000000:root|hello|NhCmhg=="
	assert text(g.handle(chunked("6")), "Code") == "IncompleteBody"
	g.faults.set("s3", (f: Fault, id: string, _: Request | null) => new Response(f.status, `${f.code} ${id.length}`))
	const short = g.handle(chunked("6"))
	assert short.status == 400 && short.body.text() == "IncompleteBody 36"
	g.close()
	assert live() == before
}

test "a request with no authentication reaches the service that takes them, or none" {
	const g = blobs()
	const anonymous = new Request("PUT", "http://localhost:4566/bucket/key", "public")
	const refused = g.handle(anonymous)
	assert refused.status == 403 && text(refused, "Code") == "MissingAuthenticationToken"
	g.anonymous = "s3"
	const res = g.handle(anonymous)
	assert res.status == 200 && res.body.text() == "|*|public|"
	g.close()
}

test "a body longer than its service's limit is refused before it is read, by S3 as EntityTooLarge, else as a 413" {
	const g = gateway()
	assert g.limits.get("s3") == 5 << 30 && g.limits.get("test") == null
	g.limits.set("test", 4)
	const res = g.handle(request("test", "test", "test", "large"))
	assert res.status == 413 && res.body.text() == ""
	assert g.handle(request("test", "test", "test", "four")).status == 200
	g.services.set("s3", g.services.get("test")!)
	g.limits.set("s3", 4)
	const s3 = g.handle(request("s3", "s3", "s3", "large"))
	assert s3.status == 400 && text(s3, "Code") == "EntityTooLarge" && text(s3, "MaxSizeAllowed") == "4"
	g.close()
}
