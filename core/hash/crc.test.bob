import { crc32c } from "./crc32c"
import { crc64nvme } from "./crc64nvme"

test "CRC32C" {
	assert crc32c("123456789") == 0xe3069283
	assert crc32c("") == 0
	assert crc32c("56789", crc32c("1234")) == 0xe3069283
}

test "CRC-64/NVME" {
	assert crc64nvme("123456789") == 0xae8b14860a799888
	assert crc64nvme("") == 0
	assert crc64nvme("56789", crc64nvme("1234")) == 0xae8b14860a799888
}
