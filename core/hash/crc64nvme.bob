//! CRC-64/NVME, S3's default checksum: reflected, of the polynomial 0xad93d23594c935a9.

function table(): u64[] {
	const t = new u64[](256)
	for (const n of 0 ... 255) {
		let c = n as u64
		for (const k of 1 ... 8) {
			c = if ((c & 1) == 1) 0x9a6c9329ac4bc9b5 ^ c >> 1 else c >> 1
		}
		t[n] = c
	}
	return t
}

const crcTable = table()

/// The CRC-64/NVME of s after what crc covered.
export function crc64nvme(s: string, crc: u64 = 0): u64 {
	let c = crc ^ 0xffffffffffffffff
	for (const i of 0 ... s.length - 1) {
		c = crcTable[((c ^ (s[i] as u64)) & 0xff) as i32] ^ c >> 8
	}
	return c ^ 0xffffffffffffffff
}
