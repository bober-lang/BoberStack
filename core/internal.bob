//! The endpoints that are not AWS's, unsigned, under /_localstack/ as LocalStack's tools probe them and under
//! /_boberstack/: health and readiness, a reset of the state, and snapshots of it kept in memory under names, which a
//! restore makes the state again.

import { Fault } from "./fault"
import { Store } from "./state/store"
import { startsWith } from "std/algo"
import { HashMap } from "std/collections/hashmap"
import { json, Request, Response } from "std/http"
import { lower, split } from "std/string"
import { rfc3339, second } from "std/time"

/// BoberStack's version, which health and info answer in place of LocalStack's.
export const version = "0.1.0"

/// LocalStack's names of the services it emulates, each with its signing name, by which a gateway serves it; those
/// alike are listed too, so that health names each service as LocalStack does. DynamoDB Streams signs as DynamoDB.
/// Lambda is left out while it implements no operation.
const names: [string, string][] = [["acm", "acm"], ["apigateway", "apigateway"], ["cloudformation", "cloudformation"],
	["cloudwatch", "monitoring"], ["config", "config"], ["dynamodb", "dynamodb"], ["dynamodbstreams", "dynamodb"],
	["ec2", "ec2"], ["es", "es"], ["events", "events"], ["firehose", "firehose"], ["iam", "iam"],
	["kinesis", "kinesis"], ["kms", "kms"], ["logs", "logs"], ["opensearch", "es"], ["redshift", "redshift"],
	["resource-groups", "resource-groups"], ["resourcegroupstaggingapi", "tagging"], ["route53", "route53"],
	["route53resolver", "route53resolver"], ["s3", "s3"], ["scheduler", "scheduler"],
	["secretsmanager", "secretsmanager"], ["ses", "ses"], ["sns", "sns"], ["sqs", "sqs"], ["ssm", "ssm"],
	["stepfunctions", "states"], ["sts", "sts"], ["support", "support"], ["swf", "swf"], ["transcribe", "transcribe"]]

/// The stages of LocalStack's init scripts, of which there are none here, and whether each has completed: all but
/// SHUTDOWN, once serving.
const stages: [string, bool][] = [["BOOT", true], ["START", true], ["READY", true], ["SHUTDOWN", false]]

/// What the endpoints act on, a gateway: its committed trees, by name, and their names, as a HashMap lists none.
export interface State {
	trees: HashMap[string, Store]
	named: string[]
}

/// The state at an instant: a clone of each tree, by name.
class Snapshot {
	name: string
	taken: i64
	trees: [string, Store][]

	constructor(name: string, taken: i64, trees: [string, Store][]) {
		this.name = name
		this.taken = taken
		this.trees = trees
	}

	close() {
		for (const [_, t] of this.trees) {
			t.close()
		}
		this.trees = []
	}
}

/// A snapshot as listed: when it was taken, its trees and the entries they hold.
class Listed {
	name = ""
	taken = ""
	trees = 0
	records = 0
}

class Listing {
	snapshots: Listed[] = []
}

/// The endpoints and the snapshots taken, which outlive a reset.
export class Internal {
	/// When it began, which info's uptime counts from.
	private started = now()
	private snapshots: Snapshot[] = []

	/// The answer to req, a request whose path addressed names, of state, which holds the gateway's lock; serves tells
	/// whether a service of a signing name is there.
	handle(req: Request, state: State, serves: (name: string) => bool): Response {
		const path = split(req.url.path, "/").filter(s => s != "")
		const m = req.method
		const ours = path[0] == "_boberstack"
		const at = path.slice(1, path.length).join("/")
		if (at == "health") {
			return if (m == "GET" || m == "HEAD") this.health(serves) else refused(m)
		}
		if (at == "info") {
			return if (m == "GET") this.info() else refused(m)
		}
		if (at == "state/reset") {
			if (m != "POST") {
				return refused(m)
			}
			reset(state)
			return text(200, "{}")
		}
		if (!ours && path.length >= 2 && path[1] == "init") {
			return if (m == "GET") init(path.slice(2, path.length)) else refused(m)
		}
		if (ours && path.length >= 2 && path[1] == "snapshots") {
			return this.snapshot(m, path.slice(2, path.length), state)
		}
		return text(404, `{"error": "No such endpoint"}`)
	}

	/// Frees the snapshots.
	close() {
		for (const s of this.snapshots) {
			s.close()
		}
		this.snapshots = []
	}

	/// LocalStack's health: each service there, running.
	private health(serves: (name: string) => bool): Response {
		const running = names.filter(n => serves(n[1])).map(n => `"${n[0]}": "running"`)
		return text(200, `{"services": {${running.join(", ")}}, "edition": "community", "version": "${version}"}`)
	}

	/// LocalStack's info, of what BoberStack knows of it.
	private info(): Response {
		const t = now()
		return text(200,
			`{"version": "${version}", "edition": "community", "is_license_activated": false, `
			+ `"server_time_utc": "${rfc3339(t - t % second)}", "uptime": ${(t - this.started) / second}}`)
	}

	/// The answer to a request of method to the snapshots, at the path's segments after /_boberstack/snapshots.
	private snapshot(method: string, at: string[], state: State): Response {
		if (at.length == 0) {
			if (method != "GET") {
				return refused(method)
			}
			const l = new Listing()
			l.snapshots = this.snapshots.map(listed)
			return json(l)
		}
		const name = at[0]
		if (!named(name) || at.length > 2 || at.length == 2 && at[1] != "restore") {
			return text(400, `{"error": "A snapshot's name is 1 to 255 letters, digits, '.', '_' or '-'"}`)
		}
		let i = this.snapshots.length - 1
		while (i >= 0 && this.snapshots[i].name != name) {
			i--
		}
		try {
			if (at.length == 2) {
				if (method != "POST") {
					return refused(method)
				}
				if (i < 0) {
					return missing(name)
				}
				const s = this.snapshots[i]
				const trees = clones(s.trees)
				reset(state)
				for (const [n, t] of trees) {
					state.trees.set(n, t)
					state.named.push(n)
				}
				return json(listed(s))
			}
			if (method == "PUT") {
				const s = new Snapshot(name, now(), clones(state.named.map(n => [n, state.trees.get(n)!])))
				if (i < 0) {
					this.snapshots.push(s)
				} else {
					this.snapshots[i].close()
					this.snapshots[i] = s
				}
				return json(listed(s))
			}
		} catch (f: Fault) {
			// The store's only fault, out of memory, has nothing JSON would escape.
			return text(f.status, `{"error": "${f.message}"}`)
		}
		if (method == "DELETE") {
			if (i < 0) {
				return missing(name)
			}
			this.snapshots[i].close()
			this.snapshots = this.snapshots.filter(s => s.name != name)
			return new Response(204)
		}
		return refused(method)
	}
}

/// Whether path is one of the endpoints': under /_localstack/ or /_boberstack/.
export function addressed(path: string): bool {
	return startsWith(path, "/_localstack/") || startsWith(path, "/_boberstack/")
}

/// Drops the state of state: every tree closed.
function reset(state: State) {
	for (const n of state.named) {
		state.trees.get(n)!.close()
		state.trees.delete(n)
	}
	state.named = []
}

/// A clone of each of trees, by its name; none if one cannot be made.
function clones(trees: [string, Store][]): [string, Store][] throws Fault {
	const out: [string, Store][] = []
	try {
		for (const [n, t] of trees) {
			out.push([n, t.clone()])
		}
	} catch (f: Fault) {
		for (const [_, t] of out) {
			t.close()
		}
		throw f
	}
	return out
}

/// LocalStack's init scripts, of all stages or of the one stage given.
function init(stage: string[]): Response {
	const scripts = `"scripts": []`
	if (stage.length == 0) {
		const done = stages.map(s => `"${s[0]}": ${s[1]}`)
		return text(200, `{"completed": {${done.join(", ")}}, ${scripts}}`)
	}
	const s = stages.find(s => lower(s[0]) == lower(stage[0]))
	if (stage.length > 1 || s == null) {
		return text(404, `no such stage ${stage.join("/")}`, "text/plain")
	}
	return text(200, `{"completed": ${s![1]}, ${scripts}}`)
}

function listed(s: Snapshot): Listed {
	const l = new Listed()
	l.name = s.name
	l.taken = rfc3339(s.taken)
	l.trees = s.trees.length
	for (const [_, t] of s.trees) {
		l.records += t.count()
	}
	return l
}

/// Whether name may name a snapshot.
function named(name: string): bool {
	return name.length > 0 && name.length <= 255
		&& name.every(c => c >= 0x30 && c <= 0x39 || c >= 0x41 && c <= 0x5a || c >= 0x61 && c <= 0x7a || c == 0x2e
		|| c == 0x5f || c == 0x2d)
}

function missing(name: string): Response { return text(404, `{"error": "No snapshot named ${name}"}`) }
/// The answer to a method an endpoint does not take.
function refused(method: string): Response { return text(405, `{"error": "The method ${method} is not allowed here"}`) }

/// body as the answer of status, of the content type given.
function text(status: i32, body: string, contentType = "application/json"): Response {
	const r = new Response(status, body)
	r.headers.set("content-type", contentType)
	return r
}
