//! The awsQuery protocol: parameters form-encoded in the body, results and errors as XML. An operation's input and
//! output are classes whose fields are its members, read and written by reflection under the tags of ./xml and
//! ./model: a list is a T[], a map a [K, V][], a union a union of classes of one field each, its member the field set,
//! and a member whose type does not take null is required.

import { indexOf, startsWith } from "std/algo"
import * as base64 from "std/encoding/base64"
import { Attr, Attribute, encode, Node, OmitEmpty, serialize } from "std/encoding/xml"
import { parseFloat } from "std/float"
import { Request, Response } from "std/http"
import { ParseError, parseInt } from "std/string"
import { Decodable, has, tag } from "std/types"
import { Query } from "std/url"
import { Fault } from "../fault"
import { Caller, Unit } from "../service"

import { Blob, check, choice, dated, Default, instant, nullable, path, Timestamp, Validation,
	Violations } from "./model"

import * as xml from "./xml"

/// The XML namespace of AWS's generic faults, which no service's model declares.
const awsFault = "http://webservices.amazon.com/AWSFault/2005-15-09"
const style = new xml.Style(true, false)

/// A request from caller to the service of API version and XML namespace ns.
export class Call {
	caller: Caller
	params: Query
	ns: string
	validation: Validation
	/// The operation it asks for, "" if its Version is not the service's.
	action: string

	constructor(caller: Caller, params: Query, version: string, ns: string,
		validation: Validation = new Validation("ValidationError")) {
		this.caller = caller
		this.params = params
		this.ns = ns
		this.validation = validation
		this.action = if (params.get("Version") == version) params.get("Action") ?? "" else ""
	}

	/// The answer by h, the handler of its action, which IAM authorizes as actions: h's output or the Fault it throws.
	serve[I extends Decodable, O](h: (caller: Caller, input: I) => O throws Fault, actions: string[] = []): Response {
		const id = this.caller.requestId
		this.caller.actions = actions
		try {
			const out = h(this.caller, decode[I](this.params, this.validation))
			return reply(result(this.action, this.ns, id, out), id)
		} catch (f: Fault) {
			return error(f, id, this.ns)
		}
	}

	/// The answer where its action is none of the service's.
	invalidAction(): Response {
		const p = this.params
		const why = `Could not find operation ${p.get("Action") ?? ""} for version ${p.get("Version") ?? ""}`
		return error(new Fault(400, "InvalidAction", why), this.caller.requestId, awsFault)
	}
}

/// The call of req from caller to the service of API version and XML namespace ns.
export function call(caller: Caller, req: Request, version: string, ns: string,
	validation: Validation = new Validation("ValidationError")): Call throws IoError {
	return new Call(caller, Query.parse(req.body.text()), version, ns, validation)
}

/// The T whose members p holds, or validation's fault where p breaks T's model.
export function decode[T extends Decodable](p: Query,
	validation: Validation = new Validation("ValidationError")): T throws Fault {
	const v = new Violations(validation)
	const r = value[T](p, "", "", [], v)
	v.check()
	return r
}

/// The document answering the operation op of the service of namespace ns with out.
export function result[O](op: string, ns: string, requestId: string, out: O): string {
	const root = new Node("element", `${op}Response`)
	root.attrs.push(new Attribute("xmlns", ns))
	if (O != Unit) {
		xml.put(root, `${op}Result`, out, [], style)
	}
	xml.put(xml.child(root, "ResponseMetadata", []), "RequestId", requestId, [], style)
	return serialize(root)
}

/// xml, the document answering the request requestId.
export function reply(xml: string, requestId: string, status: i32 = 200): Response {
	const res = new Response(status, xml)
	res.headers.set("content-type", "text/xml")
	res.headers.set("x-amzn-requestid", requestId)
	return res
}

class Error {
	Type = "Sender"
	Code = ""
	/// None for a fault of no message, as IAM answers some InvalidInput.
	Message: string @OmitEmpty = ""
}

class ErrorResponse {
	xmlns: string @Attr @OmitEmpty = ""
	Error = new Error()
	RequestId = ""
}

/// The document of the fault f, in the namespace ns if given.
export function error(f: Fault, requestId: string, ns: string = ""): Response {
	const e = new ErrorResponse()
	e.xmlns = ns
	e.Error.Type = if (f.sender) "Sender" else "Receiver"
	e.Error.Code = f.code
	e.Error.Message = f.message
	e.RequestId = requestId
	const xml = encode(e)
	const end = indexOf(xml, "</Error>") // after the message, whose text cannot hold it
	return reply(xml.slice(0, end) + f.members + xml.slice(end, xml.length), requestId, f.status)
}

/// The XML of v's fields, an error's members besides its message.
export function members[T](v: T): string { return xml.members(v, style) }

/// The T that the parameter k of p holds, or those within it, of a member tagged tags.
function value[T extends Decodable](p: Query, k: string, at: string, tags: Type[], v: Violations): T throws Fault {
	const s = p.get(k) ?? ""
	switch (T.kind) {
		case "union":
			if (T.members.filter(M => M.kind == "class").length > 1) {
				return variant[T](p, k, at, v)
			}
			if (T.members.every(M => M.kind == "literal" || M.kind == "null")) {
				return choice[T](s, at, v)
			}
			let last: Fault | null = null
			for (const M of T.members) {
				if (M.kind != "null") {
					try {
						return value[M](p, k, at, tags, v)
					} catch (f: Fault) {
						last = f
					}
				}
			}
			throw last ?? v.fault(s, at, `Member must be a ${T.name}`)
		case "literal": return choice[T](s, at, v)
		case "array":
			// k.member.1 or, flattened, k.1; a map's items k.entry.1.key and k.entry.1.value, or k.1.key.
			const xs: T = []
			const item = if (T.elem.kind == "tuple") "entry" else tag(tags, xml.Member, "member")
			const of = if (has(tags, xml.Flat)) k else `${k}.${item}`
			for (let i = 1; present(p, `${of}.${i}`); i++) {
				xs.push(value[T.elem](p, `${of}.${i}`, `${at}.${i}.member`, tags, v))
			}
			check(xs, at, tags, v)
			return xs
		case "tuple":
			const e = new T() // a map's entry, its value of the member's constraints
			for (const f of T.fields) {
				const key = f.name == "0"
				const n = if (key) tag(tags, xml.Key, "key") else tag(tags, xml.Value, "value")
				e[f.name] = value[f.type](p, `${k}.${n}`, `${at}.${if (key) "key" else "value"}`, if (key) [] else tags,
					v)
			}
			return e
		case "class":
			const r = new T()
			const from: i32[] = []
			for (const f of T.fields) {
				from.push(v.found.length)
				const m = (if (k == "") "" else `${k}.`) + tag(f.tags, xml.Name, f.name)
				if (present(p, m)) {
					r[f.name] = value[f.type](p, m, path(at, f.name), f.tags, v)
				} else if (!nullable(f.type) && !has(f.tags, Default)) {
					v.note(null, path(at, f.name), "Member must not be null")
				}
			}
			v.order(T.fields.map(f => path("", f.name)), from)
			return r
		case "string":
			if (!has(tags, Blob)) {
				check(s, at, tags, v)
				return s
			}
			let b = ""
			try {
				b = base64.decode(s)
			} catch (e: ParseError) {
				throw v.fault(s, at, "Member must be base64")
			}
			check(b, at, tags, v, true)
			return b
		case "bool":
			if (s == "true" || s == "false") {
				return s == "true"
			}
			throw v.fault(s, at, "Member must be true or false")
		case "int":
			let n: T = 0
			try {
				if (T == i64 && has(tags, Timestamp)) {
					return instant(s, dated(tags, "date-time"))
				}
				n = parseInt[T](s)
			} catch (e: ParseError) {
				throw v.fault(s, at, `Member must be ${if (has(tags, Timestamp)) "a timestamp" else "an integer"}`)
			}
			check(n, at, tags, v)
			return n
		case "float":
			const zero: T = 0.0
			switch (s) {
				case "NaN": return zero / zero
				case "Infinity": return 1.0 / zero
				case "-Infinity": return -1.0 / zero
			}
			let x: T = 0.0
			try {
				x = parseFloat[T](s)
			} catch (e: ParseError) {
				throw v.fault(s, at, "Member must be a number")
			}
			check(x, at, tags, v)
			return x
		default: throw v.fault(s, at, `Member must be a ${T.name}`)
	}
}

/// The T, a union, of the one member that p holds within k.
function variant[T extends Decodable](p: Query, k: string, at: string, v: Violations): T throws Fault {
	let r: T | null = null
	let n = 0
	for (const M of T.members) {
		if (M.kind != "class" || M.fields.length == 0) {
			continue
		}
		if (present(p, `${k}.${tag(M.fields[0].tags, xml.Name, M.fields[0].name)}`)) {
			r = value[M](p, k, at, [], v)
			n++
		}
	}
	if (n != 1) {
		throw v.fault(null, at, "Member must have exactly one member set")
	}
	return r!
}

/// Whether p holds the parameter k or one within it.
function present(p: Query, k: string): bool { return p.entries.some(e => e[0] == k || startsWith(e[0], `${k}.`)) }
