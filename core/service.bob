//! What a service's handlers are given and throw, whatever its protocol.

import { Fault } from "./fault"
import { Store } from "./state/store"
import { HashMap } from "std/collections/hashmap"

/// Who sent a request, where, and the id it is answered under; and the state it reads and writes.
export class Caller {
	account: string
	region: string
	/// The identity it acts as, and that identity's unique id: the account's for its root.
	arn: string
	userId: string
	requestId: string
	/// The actions of the operation being served, as IAM names them, set by its service's dispatch.
	actions: string[] = []
	/// The trees the request has opened, by account, the global one by "": clones that its gateway commits together if
	/// it succeeds, and closes if not.
	opened: [string, Store][] = []
	/// The trees committed, by account, which the gateway does not change while the request runs.
	private committed: HashMap[string, Store]

	constructor(account: string, region: string, arn: string, requestId: string, userId: string = account,
		committed: HashMap[string, Store] = new HashMap[string, Store]()) {
		this.account = account
		this.region = region
		this.arn = arn
		this.userId = userId
		this.requestId = requestId
		this.committed = committed
	}

	/// account's state as the request sees it, a clone of its committed tree, or a tree of its own if there is none,
	/// made at the first call; "" names the global state, what all accounts share.
	tree(account: string): Store throws Fault {
		for (const [a, s] of this.opened) {
			if (a == account) {
				return s
			}
		}
		const c = this.committed.get(account)
		const s = if (c == null) new Store() else c.clone()
		this.opened.push([account, s])
		return s
	}

	/// Throws AccessDenied unless the caller may perform the operation's actions on resource, an ARN, given the
	/// resource's own policy if it has one.
	allow(resource: string, policy: string | null = null) throws Fault {
		// Policies are not evaluated yet: everything is allowed.
	}

	/// The state of the caller's account.
	store(): Store throws Fault { return this.tree(this.account) }
	/// The global state.
	global(): Store throws Fault { return this.tree("") }
}

/// The fault of the operation op, which the service does not implement.
export function notImplemented(op: string): Fault {
	return new Fault(501, "NotImplemented", `The operation ${op} is not implemented`)
}

/// The input or output of an operation that has none.
export class Unit {}
