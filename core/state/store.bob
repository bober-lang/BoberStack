//! Service state: an ordered map of byte strings off the collector's heap, on a copy-on-write B-tree (store.c), so that
//! a snapshot, a branch or a transaction is a clone in O(1). Typed tables sit on top, their values as JSON. An entry
//! may hold a blob besides its value: bytes too large to copy, as an S3 object's, in memory mapped from temporary files.

import { Fault } from "../fault"
import { indexOf } from "std/algo"
import { EncodeError, decode, encode } from "std/encoding/json"
import { Body } from "std/http"
import { ParseError } from "std/string"
import { Decodable } from "std/types"

import { blob_abort, blob_join, blob_new, blob_ref, blob_seal, blob_size, blob_span, blob_write, store_bytes,
	store_clone, store_count, store_delete, store_fail, store_free, store_get, store_live, store_new, store_put,
	store_scan } from "./store.c"

/// Keys and values are any bytes. Its memory is C's, freed by close, after which every call traps. A call that cannot
/// allocate throws an InternalFailure and leaves the store as it was.
export class Store {
	private h: u64
	private out = new u64[](3)

	/// An empty store, or a copy of of.
	constructor(of: Store | null = null) throws Fault {
		this.h = if (of == null) store_new() else store_clone(of.handle())
		memory(this.h != 0)
	}

	/// A copy in O(1): the two share memory until either writes.
	clone(): Store throws Fault { return new Store(this) }

	close() {
		store_free(this.handle())
		this.h = 0
	}

	get(key: string): string | null {
		const found = store_get(this.handle(), key, key.length as u64, this.out) == 1
		return if (found) fromBytes(this.out[0], this.out[1]) else null
	}

	/// Puts value under key, and blob with it unless null, which the entry then holds apart from the handle given.
	put(key: string, value: string, blob: Blob | null = null) throws Fault {
		const b = if (blob == null) 0 as u64 else blob.handle()
		memory(store_put(this.handle(), key, key.length as u64, value, value.length as u64, b) == 0)
	}

	/// The blob held under key, null if none: a handle of its own, to close.
	blob(key: string): Blob | null {
		if (store_get(this.handle(), key, key.length as u64, this.out) == 0 || this.out[2] == 0) {
			return null
		}
		blob_ref(this.out[2], 1)
		return new Blob(this.out[2])
	}

	/// Whether key was there.
	delete(key: string): bool throws Fault {
		const r = store_delete(this.handle(), key, key.length as u64)
		memory(r >= 0)
		return r == 1
	}

	/// A page, copied: up to limit entries whose keys start with prefix and, unless after is null, come after it, in
	/// byte order, or before it in the reverse order if descending. The next page is past the last key.
	scan(prefix: string, after: string | null = null, limit = 1000, descending = false): [string, string][] {
		const n = if (limit < this.count()) limit else this.count()
		const out = new u64[](4 * n)
		const bound = if (descending) above(prefix) else null
		// Descending, the scan starts below the least key past the prefix's.
		const from = if (descending && (after == null || bound != null && after! > bound!)) bound else after
		const got = store_scan(this.handle(), prefix, prefix.length as u64, from ?? (0 as u64),
			(from ?? "").length as u64, descending as i32, n as u64, out) as i32
		const page: [string, string][] = []
		for (const i of 0 ... got - 1) {
			page.push([fromBytes(out[4 * i], out[4 * i + 1]), fromBytes(out[4 * i + 2], out[4 * i + 3])])
		}
		return page
	}

	/// The number of entries.
	count(): i32 { return store_count(this.handle()) as i32 }
	/// The bytes of the keys and values held, not of their blobs.
	bytes(): i64 { return store_bytes(this.handle()) as i64 }

	private handle(): u64 {
		const closed = this.h == 0
		assert !closed
		return this.h
	}
}

/// The least key above every key that starts with prefix, null if there is none: prefix without its trailing 0xff
/// bytes, its last byte one more.
function above(prefix: string): string | null {
	let n = prefix.length
	while (n > 0 && prefix[n - 1] == 0xff) {
		n--
	}
	return if (n == 0) null else prefix.slice(0, n - 1) + fromBytes([(prefix[n - 1] + 1) as u8])
}

/// Bytes off the collector's heap, which do not change: a handle to a blob of store.c, which holds it until close, as
/// an entry of a store does once put. A request that writes one must close its handles however it ends, as the
/// collector does not; a blob is freed once neither a handle nor an entry holds it.
export class Blob {
	private h: u64

	private constructor(h: u64) { this.h = h }

	/// The blob of parts one after the other, sharing their memory.
	static join(parts: Blob[]): Blob throws Fault {
		const h = blob_join(parts.map(p => p.handle()), parts.length as u64)
		memory(h != 0)
		return new Blob(h)
	}

	/// Its bytes from at, up to n, copied.
	read(at: i64 = 0, n: i64 = 9223372036854775807): string {
		assert at >= 0 && at <= this.size()
		const end = if (n < this.size() - at) at + n else this.size()
		const out = new u64[](2)
		let s = ""
		for (let i = at; i < end; i += out[1] as i64) {
			blob_span(this.handle(), i as u64, (end - i) as u64, out)
			s += fromBytes(out[0], out[1])
		}
		return s
	}

	/// A body of its bytes from at, up to n, which holds the blob until it is closed, as a server does once it has sent
	/// it; read a chunk at a time, each copied.
	body(at: i64 = 0, n: i64 = 9223372036854775807): Body {
		assert at >= 0 && at <= this.size()
		blob_ref(this.handle(), 1)
		const r = new Reader(new Blob(this.h), at, if (n < this.size() - at) at + n else this.size())
		return new Body(r, r.end - r.at, () => r.blob.close())
	}

	size(): i64 { return blob_size(this.handle()) as i64 }

	/// Gives up the handle; again, nothing.
	close() {
		if (this.h != 0) {
			blob_ref(this.h, -1)
			this.h = 0
		}
	}

	/// Its handle of store.c's, for this module.
	handle(): u64 {
		const closed = this.h == 0
		assert !closed
		return this.h
	}
}

/// What a blob's body reads: its bytes from at to end.
class Reader {
	blob: Blob
	at: i64
	end: i64

	constructor(blob: Blob, at: i64, end: i64) {
		this.blob = blob
		this.at = at
		this.end = end
	}

	read(n: i32): string | null {
		if (this.at >= this.end) {
			return null
		}
		const out = new u64[](2)
		const left = this.end - this.at
		blob_span(this.blob.handle(), this.at as u64, (if (n < left) n as i64 else left) as u64, out)
		this.at += out[1] as i64
		return fromBytes(out[0], out[1])
	}
}

/// A blob being written, from bytes given in pieces. Close it unless finished, however the request ends: what it
/// wrote is freed only then.
export class BlobWriter {
	private h: u64

	constructor() throws Fault {
		this.h = blob_new()
		memory(this.h != 0)
	}

	/// Appends bytes.
	write(bytes: string) throws Fault { memory(blob_write(this.handle(), bytes, bytes.length as u64) == 0) }

	/// The blob of what was written, after which the writer is closed.
	finish(): Blob throws Fault {
		const b = blob_seal(this.handle())
		memory(b != 0)
		this.h = 0
		return new Blob(b)
	}

	/// Frees what was written, unless finished; again, nothing.
	close() {
		if (this.h != 0) {
			blob_abort(this.h)
			this.h = 0
		}
	}

	private handle(): u64 {
		const closed = this.h == 0
		assert !closed
		return this.h
	}
}

/// For tests, which cannot import store.c, as each import compiles a copy: the records, the stores, the blobs and
/// their writers, and the blobs' chunks, not yet freed in the process.
export function live(): [i64, i64, i64, i64] {
	const out = new i64[](4)
	store_live(out)
	return [out[0], out[1], out[2], out[3]]
}

/// For tests: fails the stores' nth allocation from now, a blob's chunk's file counting as one.
export function failAllocation(n: i32) { store_fail(n as i64) }

/// Throws unless ok, as C is out of memory.
function memory(ok: bool) throws Fault {
	if (!ok) {
		throw new Fault(500, "InternalFailure", "The store is out of memory")
	}
}

/// The entries of a store under a name, their values V as JSON. An entry's key is the name, a NUL and its own key, so
/// that tables neither overlap nor scan into each other: a name holds no NUL, a key any bytes.
export class Table[V extends Decodable] {
	private store: Store
	private prefix: string

	constructor(store: Store, name: string) {
		assert indexOf(name, "\x00") < 0
		this.store = store
		this.prefix = name + "\x00"
	}

	get(key: string): V | null {
		const s = this.store.get(this.prefix + key)
		return if (s == null) null else value[V](s)
	}

	/// Throws for a NaN or infinite float, which JSON cannot hold. As Store.put's, with blob.
	put(key: string, v: V, blob: Blob | null = null) throws EncodeError | Fault {
		this.store.put(this.prefix + key, encode(v), blob)
	}

	/// As Store.blob's.
	blob(key: string): Blob | null { return this.store.blob(this.prefix + key) }
	/// Whether key was there.
	delete(key: string): bool throws Fault { return this.store.delete(this.prefix + key) }

	/// A page as Store.scan's of the table's entries whose keys start with prefix.
	scan(after: string | null = null, limit = 1000, prefix = "", descending = false): [string, V][] {
		const page = this.store.scan(this.prefix + prefix, if (after == null) null else this.prefix + after, limit,
			descending)
		return page.map(e => [e[0].slice(this.prefix.length, e[0].length), value[V](e[1])])
	}
}

/// s, which put encoded, as a V; traps if it does not decode, as when the store was written under the table's prefix
/// by other means.
function value[V extends Decodable](s: string): V {
	let v: V | null = null
	try {
		v = decode[V](s)
	} catch (e: ParseError) {}
	return v!
}
