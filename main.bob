import { Gateway } from "./core/gateway"
import { Fault } from "./core/fault"
import { Catalog } from "./services/iam/catalog"
import { stack } from "./stack"
import { decode, help, Short } from "std/encoding/optarg"
import { Server } from "std/http"
import { stderr } from "std/io"
import { name } from "std/process"
import { ParseError } from "std/string"
import { second, sleep } from "std/time"
import managed from "./models/iam-managed-policies.jsonl" @Embed["deflate"]

// The docs of its fields are the help's lines.
class Options {
	/// The address to listen on; every address if empty.
	host = ""
	/// The port to listen on.
	port: u16 = 4566
	/// Refuse no request for lack of permission or trust: a role looked up only to check either need not exist.
	lenient: bool = false
	/// Print this help.
	help: bool @Short["h"] = false
}

function main(): i32 {
	const program = name()
	let o = new Options()
	try {
		o = decode[Options](args())
	} catch (e: ParseError) {
		const a = args()[e.at]
		const why = if (e.kind == "range") `${a} is out of range` else `cannot take the argument ${a}`
		complain(program, `${why}\n${usage(program)}`)
		return 2
	}
	if (o.help) {
		print(usage(program))
		return 0
	}
	let catalog: Catalog | null = null
	try {
		catalog = new Catalog(managed)
	} catch (e: ParseError) {
		complain(program, `the AWS managed policies do not parse at byte ${e.at}`)
		return 1
	}
	const server = new Server()
	server.addr = `${o.host}:${o.port}`
	const g = stack(catalog!)
	g.lenient = o.lenient
	try {
		server.listen()
		// The line LocalStack prints once it serves, which the tools that start it wait for.
		print("Ready.")
		const ticking = async tick(program, g)
		server.serve(g.handle)
	} catch (e: IoError | ParseError) {
		complain(program, if (e instanceof IoError) e.message() else `cannot listen on ${server.addr}: not an address`)
		return 1
	}
	return 0
}

/// The one fiber that does, each second, what is due: schedules fire, long polls end.
function tick(program: string, g: Gateway) {
	while (true) {
		sleep(second)
		try {
			g.tick(now())
		} catch (f: Fault) {
			complain(program, `tick: ${f.code}: ${f.message}`)
		}
	}
}

function usage(program: string): string { return `usage: ${program} [options]\n${help[Options]()}` }

function complain(program: string, why: string) {
	try {
		stderr.write(`${program}: ${why}\n`)
	} catch (e: IoError) {} // nowhere left to say so
}
