import { AppleContainers } from "./core/container/apple"
import { ContainerError, Containers } from "./core/container/container"
import { DockerContainers } from "./core/container/docker"
import { Gateway } from "./core/gateway"
import { Fault } from "./core/fault"
import { uuid } from "./core/random"
import { Runner } from "./services/lambda/runner"
import { Catalog } from "./services/iam/catalog"
import { stack } from "./stack"
import { decode, help, Short } from "std/encoding/optarg"
import { readFile } from "std/fs"
import { Server } from "std/http"
import { stderr } from "std/io"
import { os } from "std/os"
import { env, name } from "std/process"
import { ParseError } from "std/string"
import * as tls from "std/tls"
import { second, sleep } from "std/time"
import managed from "./models/iam-managed-policies.jsonl" @Embed["deflate"]

// The docs of its fields are the help's lines.
class Options {
	/// The address to listen on; every address if empty.
	host = ""
	/// The port to listen on.
	port: u16 = 4566
	/// The PEM certificate chain to serve HTTPS with too, on the same port; with --key.
	cert = ""
	/// The PEM private key of --cert.
	key = ""
	/// Refuse no request for lack of permission or trust: a role looked up only to check either need not exist.
	lenient: bool = false
	/// What runs Lambda's functions: docker, apple or none; if empty, Docker if its daemon answers, else Apple's on macOS.
	containers = ""
	/// The seconds a function's environment is kept once idle.
	idle: u32 = 300
	/// Print this help.
	help: bool @Short["h"] = false
}

function main(): i32 {
	const program = name()
	let o = new Options()
	try {
		o = decode[Options](args())
	} catch (e: ParseError) {
		const a = args()[e.at]
		const why = if (e.kind == "range") `${a} is out of range` else `cannot take the argument ${a}`
		complain(program, `${why}\n${usage(program)}`)
		return 2
	}
	if (o.help) {
		print(usage(program))
		return 0
	}
	if (!["", "docker", "apple", "none"].includes(o.containers)) {
		complain(program, `--containers takes docker, apple or none, not ${o.containers}\n${usage(program)}`)
		return 2
	}
	let catalog: Catalog | null = null
	try {
		catalog = new Catalog(managed)
	} catch (e: ParseError) {
		complain(program, `the AWS managed policies do not parse at byte ${e.at}`)
		return 1
	}
	if ((o.cert == "") != (o.key == "")) {
		complain(program, `--cert and --key go together\n${usage(program)}`)
		return 2
	}
	const server = new Server()
	server.addr = `${o.host}:${o.port}`
	if (o.cert != "") {
		server.tls = new tls.Config()
		server.clear = true
		try {
			server.tls!.cert = readFile(o.cert)
			server.tls!.key = readFile(o.key)
		} catch (e: IoError) {
			complain(program, e.message())
			return 1
		}
	}
	const runner = runnerOf(o)
	const g = stack(catalog!, runner)
	g.lenient = o.lenient
	try {
		server.listen()
		runner.sweep()
		// The line LocalStack prints once it serves, which the tools that start it wait for.
		print("Ready.")
		const ticking = async tick(program, g)
		server.serve(g.handle)
	} catch (e: IoError | ParseError) {
		complain(program, if (e instanceof IoError) e.message() else `cannot listen on ${server.addr}: not an address`)
		return 1
	}
	return 0
}

/// The one fiber that does, each second, what is due: schedules fire, long polls end.
function tick(program: string, g: Gateway) {
	while (true) {
		sleep(second)
		try {
			g.tick(now())
		} catch (f: Fault) {
			complain(program, `tick: ${f.code}: ${f.message}`)
		}
	}
}

/// What runs functions in the containers o names, else in the first that answers; in none if none does, which
/// invocations then answer with what was looked for.
function runnerOf(o: Options): Runner {
	let c: Containers | null = null
	let host = ""
	const tried: string[] = []
	if (o.containers == "" || o.containers == "docker") {
		const d = new DockerContainers()
		try {
			host = d.host()
			c = d
		} catch (e: ContainerError) {
			tried.push(`Docker's daemon at ${d.daemon}: ${e.message}`)
		}
	}
	if (c == null && (o.containers == "apple" || (o.containers == "" && os == "macos"))) {
		const a = new AppleContainers()
		try {
			host = a.host()
			c = a
		} catch (e: ContainerError) {
			tried.push(`Apple's container daemon: ${e.message}`)
		}
	}
	const missing = if (o.containers == "none") "This server runs no functions: --containers is none."
		else `No container runtime answered: ${tried.join("; ")}.`
	let generation = ""
	try {
		generation = uuid()
	} catch (f: Fault) {} // no randomness to draw: runs then share a generation
	const r = new Runner(c, missing, generation)
	r.endpoint = `http://${host}:${o.port}`
	r.label = `${o.port}`
	r.idle = (o.idle as i64) * second
	const cache = env("XDG_CACHE_HOME") ?? `${env("HOME") ?? "/tmp"}/.cache`
	r.cache = `${cache}/boberstack/lambda`
	return r
}

function usage(program: string): string { return `usage: ${program} [options]\n${help[Options]()}` }

function complain(program: string, why: string) {
	try {
		stderr.write(`${program}: ${why}\n`)
	} catch (e: IoError) {} // nowhere left to say so
}
