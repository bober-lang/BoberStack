	const req = new Request("POST", "/", "{}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.NoInputAndOutput")
	api.handle(h, caller(""), req)
	const want = new Unit()
	assert h.input == `${want}`
}

class AwsJson10NoInputAndOutput {
	...api.Unimplemented

	noInputAndOutput(c: Caller, input: Unit): api.NoInputAndOutputOutput throws Fault {
		return new api.NoInputAndOutputOutput()
	}
}

test "AwsJson10NoInputAndOutput response" {
	const req = new Request("POST", "/", "{}")
	req.headers.set("X-Amz-Target", "JsonRpc10.NoInputAndOutput")
	const res = api.handle(new AwsJson10NoInputAndOutput(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("Content-Type") == "application/x-amz-json-1.0"
	assert sameJson(res, `{}`)
}

test "AwsJson10ServerPopulatesDefaultsWhenMissingInRequestBody request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\n\"defaults\": {}\n}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.OperationWithDefaults")
	api.handle(h, caller(""), req)
	const want = new api.OperationWithDefaultsInput()
	want.defaults = { ...new api.Defaults(), defaultString: "hi", defaultBoolean: true, defaultList: [],
		defaultDocumentMap: "{}", defaultDocumentString: "\"hi\"", defaultDocumentBoolean: "true",
		defaultDocumentList: "[]", defaultTimestamp: 0, defaultBlob: "abc", defaultByte: 1, defaultShort: 1,
		defaultInteger: 10, defaultLong: 100, defaultFloat: 1.0, defaultDouble: 1.0, defaultMap: [], defaultEnum: "FOO",
		defaultIntEnum: 1, emptyString: "", falseBoolean: false, emptyBlob: "", zeroByte: 0, zeroShort: 0,
		zeroInteger: 0, zeroLong: 0, zeroFloat: 0.0, zeroDouble: 0.0 }
	want.topLevelDefault = "hi"
	want.otherTopLevelDefault = 0
	assert h.input == `${want}`
}

class AwsJson10ServerPopulatesDefaultsInResponseWhenMissingInParams {
	...api.Unimplemented

	operationWithDefaults(c: Caller,
		input: api.OperationWithDefaultsInput): api.OperationWithDefaultsOutput throws Fault {
		return new api.OperationWithDefaultsOutput()
	}
}

test "AwsJson10ServerPopulatesDefaultsInResponseWhenMissingInParams response" {
	const req = new Request("POST", "/", "{}")
	req.headers.set("X-Amz-Target", "JsonRpc10.OperationWithDefaults")
	const res = api.handle(new AwsJson10ServerPopulatesDefaultsInResponseWhenMissingInParams(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("Content-Type") == "application/x-amz-json-1.0"
	assert sameJson(res,
		`{
    "defaultString": "hi",
    "defaultBoolean": true,
    "defaultList": [],
    "defaultDocumentMap": {},
    "defaultDocumentString": "hi",
    "defaultDocumentBoolean": true,
    "defaultDocumentList": [],
    "defaultTimestamp": 0,
    "defaultBlob": "YWJj",
    "defaultByte": 1,
    "defaultShort": 1,
    "defaultInteger": 10,
    "defaultLong": 100,
    "defaultFloat": 1.0,
    "defaultDouble": 1.0,
    "defaultMap": {},
    "defaultEnum": "FOO",
    "defaultIntEnum": 1,
    "emptyString": "",
    "falseBoolean": false,
    "emptyBlob": "",
    "zeroByte": 0,
    "zeroShort": 0,
    "zeroInteger": 0,
    "zeroLong": 0,
    "zeroFloat": 0.0,
    "zeroDouble": 0.0
}`)
}

test "AwsJson10ServerPopulatesNestedDefaultsWhenMissingInRequestBody request" {
	const h = new Got()
	const req = new Request("POST", "/",
		"{\n    \"topLevel\": {\n        \"dialog\": {\n            \"language\": \"en\"\n        },\n        \"dialogList\": [\n            {\n            },\n            {\n                \"farewell\": {}\n            },\n            {\n                \"language\": \"it\",\n                \"greeting\": \"ciao\",\n                \"farewell\": {\n                    \"phrase\": \"arrivederci\"\n                }\n            }\n        ],\n        \"dialogMap\": {\n            \"emptyDialog\": {\n            },\n            \"partialEmptyDialog\": {\n                \"language\": \"en\",\n                \"farewell\": {}\n            },\n            \"nonEmptyDialog\": {\n                \"greeting\": \"konnichiwa\",\n                \"farewell\": {\n                    \"phrase\": \"sayonara\"\n                }\n            }\n        }\n    }\n}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.OperationWithNestedStructure")
	api.handle(h, caller(""), req)
	const want = new api.OperationWithNestedStructureInput()
	want.topLevel = { ...new api.TopLevel(), dialog: { ...new api.Dialog(), language: "en", greeting: "hi" },
		dialogList: [{ ...new api.Dialog(), greeting: "hi" },
		{ ...new api.Dialog(), greeting: "hi", farewell: { ...new api.Farewell(), phrase: "bye" } },
		{ ...new api.Dialog(), language: "it", greeting: "ciao",
		farewell: { ...new api.Farewell(), phrase: "arrivederci" } }],
		dialogMap: [["emptyDialog", { ...new api.Dialog(), greeting: "hi" }],
		["partialEmptyDialog",
		{ ...new api.Dialog(), language: "en", greeting: "hi", farewell: { ...new api.Farewell(), phrase: "bye" } }],
		["nonEmptyDialog",
		{ ...new api.Dialog(), greeting: "konnichiwa", farewell: { ...new api.Farewell(), phrase: "sayonara" } }]] }
	assert h.input == `${want}`
}

test "NonQueryCompatibleAwsJson10ForbidsQueryModeHeader request" {
	const h = new Got()
	const req = new Request("POST", "/", "{}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.QueryIncompatibleOperation")
	api.handle(h, caller(""), req)
	const want = new Unit()
	assert h.input == `${want}`
}

test "AwsJson10SupportsNaNFloatInputs request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\n    \"floatValue\": \"NaN\",\n    \"doubleValue\": \"NaN\"\n}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.SimpleScalarProperties")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarPropertiesInput()
	want.floatValue = 0.0 / 0.0
	want.doubleValue = 0.0 / 0.0
	assert h.input == `${want}`
}

test "AwsJson10SupportsInfinityFloatInputs request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\n    \"floatValue\": \"Infinity\",\n    \"doubleValue\": \"Infinity\"\n}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.SimpleScalarProperties")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarPropertiesInput()
	want.floatValue = 1.0 / 0.0
	want.doubleValue = 1.0 / 0.0
	assert h.input == `${want}`
}

test "AwsJson10SupportsNegativeInfinityFloatInputs request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\n    \"floatValue\": \"-Infinity\",\n    \"doubleValue\": \"-Infinity\"\n}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0")
	req.headers.set("X-Amz-Target", "JsonRpc10.SimpleScalarProperties")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarPropertiesInput()
	want.floatValue = -1.0 / 0.0
	want.doubleValue = -1.0 / 0.0
	assert h.input == `${want}`
}

class AwsJson10SupportsNaNFloatInputs {
	...api.Unimplemented

	simpleScalarProperties(c: Caller,
		input: api.SimpleScalarPropertiesInput): api.SimpleScalarPropertiesOutput throws Fault {
		const out = new api.SimpleScalarPropertiesOutput()
		out.floatValue = 0.0 / 0.0
		out.doubleValue = 0.0 / 0.0
		return out
	}
}

test "AwsJson10SupportsNaNFloatInputs response" {
	const req = new Request("POST", "/", "{}")
	req.headers.set("X-Amz-Target", "JsonRpc10.SimpleScalarProperties")
	const res = api.handle(new AwsJson10SupportsNaNFloatInputs(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("Content-Type") == "application/x-amz-json-1.0"
	assert sameJson(res, `{
    "floatValue": "NaN",
    "doubleValue": "NaN"
}`)
}

