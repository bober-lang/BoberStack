test "AwsJson10MustSupportParametersInContentType request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\"value\":5}")
	req.headers.set("Content-Type", "application/x-amz-json-1.0; charset=utf-8")
	req.headers.set("X-Amz-Target", "JsonRpc10.ContentTypeParameters")
	api.handle(h, caller(""), req)
	const want = new api.ContentTypeParametersInput()
	want.value = 5
	assert h.input == `${want}`
}

