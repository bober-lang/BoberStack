test "AwsJson11MustSupportParametersInContentType request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\"value\":5}")
	req.headers.set("Content-Type", "application/x-amz-json-1.1; charset=utf-8")
	req.headers.set("X-Amz-Target", "JsonProtocol.ContentTypeParameters")
	api.handle(h, caller(""), req)
	const want = new api.ContentTypeParametersInput()
	want.value = 5
	assert h.input == `${want}`
}

