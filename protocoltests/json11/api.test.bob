	req.headers.set("X-Amz-Target", "JsonProtocol.JsonUnions")
	const res = api.handle(new AwsJson11DeserializeStructureUnionValue(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("Content-Type") == "application/x-amz-json-1.1"
	assert sameJson(res, `{
    "contents": {
        "structureValue": {
            "hi": "hello"
        }
    }
}`)
}

test "serializes_string_shapes request" {
	const h = new Got()
	const req = new Request("POST", "/", "{\"String\":\"abc xyz\"}")
	req.headers.set("Content-Type", "application/x-amz-json-1.1")
	req.headers.set("X-Amz-Target", "JsonProtocol.KitchenSinkOperation")
	api.handle(h, caller(""), req)
	const want = new api.KitchenSink()
	want.String = "abc xyz"
	assert h.input == `${want}`
}

test "serializes_string_shapes_with_jsonvalue_trait request" {
	const h = new Got()
	const req = new Request("POST", "/",
		"{\"JsonValue\":\"{\\\"string\\\":\\\"value\\\",\\\"number\\\":1234.5,\\\"boolTrue\\\":true,\\\"boolFalse\\\":false,\\\"array\\\":[1,2,3,4],\\\"object\\\":{\\\"key\\\":\\\"value\\\"},\\\"null\\\":null}\"}")
	req.headers.set("Content-Type", "application/x-amz-json-1.1")
	req.headers.set("X-Amz-Target", "JsonProtocol.KitchenSinkOperation")
	api.handle(h, caller(""), req)
	const want = new api.KitchenSink()
	want.JsonValue = "{\"string\":\"value\",\"number\":1234.5,\"boolTrue\":true,\"boolFalse\":false,\"array\":[1,2,3,4],\"object\":{\"key\":\"value\"},\"null\":null}"
	assert h.input == `${want}`
}

