test "serializes_recursive_structure_shapes request" {
	const h = new Got()
	const req = new Request("POST", "/",
		"{\"String\":\"top-value\",\"Boolean\":false,\"RecursiveStruct\":{\"String\":\"nested-value\",\"Boolean\":true,\"RecursiveList\":[{\"String\":\"string-only\"},{\"RecursiveStruct\":{\"MapOfStrings\":{\"color\":\"red\",\"size\":\"large\"}}}]}}")
	req.headers.set("Content-Type", "application/x-amz-json-1.1")
	req.headers.set("X-Amz-Target", "JsonProtocol.KitchenSinkOperation")
	api.handle(h, caller(""), req)
	const want = new api.KitchenSink()
	want.String = "top-value"
	want.Boolean = false
	want.RecursiveStruct = { ...new api.KitchenSink(), String: "nested-value", Boolean: true,
		RecursiveList: [{ ...new api.KitchenSink(), String: "string-only" },
		{ ...new api.KitchenSink(),
		RecursiveStruct: { ...new api.KitchenSink(), MapOfStrings: [["color", "red"], ["size", "large"]] } }] }
	assert h.input == `${want}`
}

