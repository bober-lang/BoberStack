test "AwsQuerySupportsInfinityFloatInputs request" {
	const h = new Got()
	const req = new Request("POST", "/", "Action=SimpleInputParams&Version=2020-01-08&FloatValue=Infinity&Boo=Infinity")
	req.headers.set("Content-Type", "application/x-www-form-urlencoded")
	api.handle(h, caller(""), req)
	const want = new api.SimpleInputParamsInput()
	want.FloatValue = 1.0 / 0.0
	want.Boo = 1.0 / 0.0
	assert h.input == `${want}`
}

test "AwsQuerySupportsNegativeInfinityFloatInputs request" {
	const h = new Got()
	const req = new Request("POST", "/",
		"Action=SimpleInputParams&Version=2020-01-08&FloatValue=-Infinity&Boo=-Infinity")
	req.headers.set("Content-Type", "application/x-www-form-urlencoded")
	api.handle(h, caller(""), req)
	const want = new api.SimpleInputParamsInput()
	want.FloatValue = -1.0 / 0.0
	want.Boo = -1.0 / 0.0
	assert h.input == `${want}`
}

class QuerySimpleScalarProperties {
	...api.Unimplemented

	simpleScalarXmlProperties(c: Caller, input: Unit): api.SimpleScalarXmlPropertiesOutput throws Fault {
		const out = new api.SimpleScalarXmlPropertiesOutput()
		out.stringValue = "string"
		out.emptyStringValue = ""
		out.trueBooleanValue = true
		out.falseBooleanValue = false
		out.byteValue = 1
		out.shortValue = 2
		out.integerValue = 3
		out.longValue = 4
		out.floatValue = 5.5
		out.doubleValue = 6.5
		return out
	}
}

test "QuerySimpleScalarProperties response" {
	const res = api.handle(new QuerySimpleScalarProperties(), caller(""),
		new Request("POST", "/", "Action=SimpleScalarXmlProperties&Version=2020-01-08"))
	assert res.status == 200
	assert res.headers.get("Content-Type") == "text/xml"
	assert same(res,
		`<SimpleScalarXmlPropertiesResponse xmlns="https://example.com/">
    <SimpleScalarXmlPropertiesResult>
        <stringValue>string</stringValue>
        <emptyStringValue/>
        <trueBooleanValue>true</trueBooleanValue>
        <falseBooleanValue>false</falseBooleanValue>
        <byteValue>1</byteValue>
        <shortValue>2</shortValue>
        <integerValue>3</integerValue>
        <longValue>4</longValue>
        <floatValue>5.5</floatValue>
        <DoubleDribble>6.5</DoubleDribble>
    </SimpleScalarXmlPropertiesResult>
</SimpleScalarXmlPropertiesResponse>
`)
}

