class QueryXmlEnums {
	...api.Unimplemented

	xmlEnums(c: Caller, input: Unit): api.XmlEnumsOutput throws Fault {
		const out = new api.XmlEnumsOutput()
		out.fooEnum1 = "Foo"
		out.fooEnum2 = "0"
		out.fooEnum3 = "1"
		out.fooEnumList = ["Foo", "0"]
		out.fooEnumSet = ["Foo", "0"]
		out.fooEnumMap = [["hi", "Foo"], ["zero", "0"]]
		return out
	}
}

test "QueryXmlEnums response" {
	const res = api.handle(new QueryXmlEnums(), caller(""),
		new Request("POST", "/", "Action=XmlEnums&Version=2020-01-08"))
	assert res.status == 200
	assert res.headers.get("Content-Type") == "text/xml"
	assert same(res,
		`<XmlEnumsResponse xmlns="https://example.com/">
    <XmlEnumsResult>
        <fooEnum1>Foo</fooEnum1>
        <fooEnum2>0</fooEnum2>
        <fooEnum3>1</fooEnum3>
        <fooEnumList>
            <member>Foo</member>
            <member>0</member>
        </fooEnumList>
        <fooEnumSet>
            <member>Foo</member>
            <member>0</member>
        </fooEnumSet>
        <fooEnumMap>
            <entry>
                <key>hi</key>
                <value>Foo</value>
            </entry>
            <entry>
                <key>zero</key>
                <value>0</value>
            </entry>
        </fooEnumMap>
    </XmlEnumsResult>
</XmlEnumsResponse>
`)
}

