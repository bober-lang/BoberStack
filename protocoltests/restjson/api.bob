		case "DuplexStreamWithDistinctStreams": return c.fail(notImplemented("DuplexStreamWithDistinctStreams"))
		case "DuplexStreamWithInitialMessages": return c.fail(notImplemented("DuplexStreamWithInitialMessages"))
		case "EmptyInputAndEmptyOutput": return c.serve(h.emptyInputAndEmptyOutput)
		case "EndpointOperation": return c.serve(h.endpointOperation)
		case "EndpointWithHostLabelOperation": return c.serve(h.endpointWithHostLabelOperation)
		case "FractionalSeconds": return c.serve(h.fractionalSeconds)
		case "GreetingWithErrors": return c.serve(h.greetingWithErrors)
		case "HostWithPathOperation": return c.serve(h.hostWithPathOperation)
		case "HttpChecksumRequired": return c.serve(h.httpChecksumRequired)
		case "HttpEmptyPrefixHeaders": return c.serve(h.httpEmptyPrefixHeaders)
		case "HttpEnumPayload": return c.serve(h.httpEnumPayload)
		case "HttpPayloadTraits": return c.serve(h.httpPayloadTraits)
		case "HttpPayloadTraitsWithMediaType": return c.serve(h.httpPayloadTraitsWithMediaType)
		case "HttpPayloadWithStructure": return c.serve(h.httpPayloadWithStructure)
		case "HttpPayloadWithUnion": return c.serve(h.httpPayloadWithUnion)
		case "HttpPrefixHeaders": return c.serve(h.httpPrefixHeaders)
		case "HttpPrefixHeadersInResponse": return c.serve(h.httpPrefixHeadersInResponse)
		case "HttpQueryParamsOnlyOperation": return c.serve(h.httpQueryParamsOnlyOperation)
		case "HttpRequestWithFloatLabels": return c.serve(h.httpRequestWithFloatLabels)
		case "HttpRequestWithGreedyLabelInPath": return c.serve(h.httpRequestWithGreedyLabelInPath)
		case "HttpRequestWithLabels": return c.serve(h.httpRequestWithLabels)
