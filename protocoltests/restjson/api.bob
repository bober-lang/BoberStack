/// The members of ComplexError besides its message.
export class ComplexError {
	Header: string | null @rest.Header["X-Header"]
	TopLevel: string | null
	Nested: ComplexNestedErrorData | null
}

export function complexError(members: ComplexError = new ComplexError()): Fault {
	return new Fault(403, "ComplexError", "", true, restjson.members(members))
}

export function fooError(): Fault { return new Fault(500, "FooError", "") }
export function invalidGreeting(message: string): Fault { return new Fault(400, "InvalidGreeting", message) }

