test "RestJsonInputAndOutputWithStringHeaders request" {
	const h = new Got()
	const req = new Request("POST", "/InputAndOutputWithHeaders", "")
	req.headers.set("X-String", "Hello")
	req.headers.set("X-StringList", "a, b, c")
	req.headers.set("X-StringSet", "a, b, c")
	api.handle(h, caller(""), req)
	const want = new api.InputAndOutputWithHeadersIO()
	want.headerString = "Hello"
	want.headerStringList = ["a", "b", "c"]
	want.headerStringSet = ["a", "b", "c"]
	assert h.input == `${want}`
}

