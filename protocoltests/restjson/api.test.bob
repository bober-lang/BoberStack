test "RestJsonTimestampFormatHeaders request" {
	const h = new Got()
	const req = new Request("POST", "/TimestampFormatHeaders", "")
	req.headers.set("X-memberEpochSeconds", "1576540098")
	req.headers.set("X-memberHttpDate", "Mon, 16 Dec 2019 23:48:18 GMT")
	req.headers.set("X-memberDateTime", "2019-12-16T23:48:18Z")
	req.headers.set("X-defaultFormat", "Mon, 16 Dec 2019 23:48:18 GMT")
	req.headers.set("X-targetEpochSeconds", "1576540098")
	req.headers.set("X-targetHttpDate", "Mon, 16 Dec 2019 23:48:18 GMT")
	req.headers.set("X-targetDateTime", "2019-12-16T23:48:18Z")
	api.handle(h, caller(""), req)
	const want = new api.TimestampFormatHeadersIO()
	want.memberEpochSeconds = 1576540098000000000
	want.memberHttpDate = 1576540098000000000
	want.memberDateTime = 1576540098000000000
	want.defaultFormat = 1576540098000000000
	want.targetEpochSeconds = 1576540098000000000
	want.targetHttpDate = 1576540098000000000
	want.targetDateTime = 1576540098000000000
	assert h.input == `${want}`
}

class RestJsonTimestampFormatHeaders {
	...api.Unimplemented

	timestampFormatHeaders(c: Caller, input: api.TimestampFormatHeadersIO): api.TimestampFormatHeadersIO throws Fault {
		const out = new api.TimestampFormatHeadersIO()
		out.memberEpochSeconds = 1576540098000000000
		out.memberHttpDate = 1576540098000000000
		out.memberDateTime = 1576540098000000000
		out.defaultFormat = 1576540098000000000
		out.targetEpochSeconds = 1576540098000000000
		out.targetHttpDate = 1576540098000000000
		out.targetDateTime = 1576540098000000000
		return out
	}
}

test "RestJsonTimestampFormatHeaders response" {
	const req = new Request("POST", "/TimestampFormatHeaders", "")
	const res = api.handle(new RestJsonTimestampFormatHeaders(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("X-memberEpochSeconds") == "1576540098"
	assert res.headers.get("X-memberHttpDate") == "Mon, 16 Dec 2019 23:48:18 GMT"
	assert res.headers.get("X-memberDateTime") == "2019-12-16T23:48:18Z"
	assert res.headers.get("X-defaultFormat") == "Mon, 16 Dec 2019 23:48:18 GMT"
	assert res.headers.get("X-targetEpochSeconds") == "1576540098"
	assert res.headers.get("X-targetHttpDate") == "Mon, 16 Dec 2019 23:48:18 GMT"
	assert res.headers.get("X-targetDateTime") == "2019-12-16T23:48:18Z"
}

test "RestJsonUnitInputAndOutput request" {
	const h = new Got()
	const req = new Request("POST", "/UnitInputAndOutput", "")
	api.handle(h, caller(""), req)
	const want = new Unit()
	assert h.input == `${want}`
}

test "RestJsonUnitInputAllowsAccept request" {
	const h = new Got()
	const req = new Request("POST", "/UnitInputAndOutput", "")
	req.headers.set("Accept", "application/json")
	api.handle(h, caller(""), req)
	const want = new Unit()
	assert h.input == `${want}`
}
