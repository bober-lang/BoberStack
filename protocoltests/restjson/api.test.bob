test "RestJsonServerPopulatesDefaultsWhenMissingInRequestBody request" {
	const h = new Got()
	const req = new Request("POST", "/OperationWithDefaults", "{\n\"defaults\": {}\n}")
	req.headers.set("Content-Type", "application/json")
	api.handle(h, caller(""), req)
	const want = new api.OperationWithDefaultsInput()
	want.defaults = { ...new api.Defaults(), defaultString: "hi", defaultBoolean: true, defaultList: [],
		defaultDocumentMap: "{}", defaultDocumentString: "\"hi\"", defaultDocumentBoolean: "true",
		defaultDocumentList: "[]", defaultTimestamp: 0, defaultBlob: "abc", defaultByte: 1, defaultShort: 1,
		defaultInteger: 10, defaultLong: 100, defaultFloat: 1.0, defaultDouble: 1.0, defaultMap: [], defaultEnum: "FOO",
		defaultIntEnum: 1, emptyString: "", falseBoolean: false, emptyBlob: "", zeroByte: 0, zeroShort: 0,
		zeroInteger: 0, zeroLong: 0, zeroFloat: 0.0, zeroDouble: 0.0 }
	want.topLevelDefault = "hi"
	want.otherTopLevelDefault = 0
	assert h.input == `${want}`
}

