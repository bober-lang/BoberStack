test "RestJsonJsonEnums request" {
	const h = new Got()
	const req = new Request("PUT", "/JsonEnums",
		"{\n    \"fooEnum1\": \"Foo\",\n    \"fooEnum2\": \"0\",\n    \"fooEnum3\": \"1\",\n    \"fooEnumList\": [\n        \"Foo\",\n        \"0\"\n    ],\n    \"fooEnumSet\": [\n        \"Foo\",\n        \"0\"\n    ],\n    \"fooEnumMap\": {\n        \"hi\": \"Foo\",\n        \"zero\": \"0\"\n    }\n}")
	req.headers.set("Content-Type", "application/json")
	api.handle(h, caller(""), req)
	const want = new api.JsonEnumsInputOutput()
	want.fooEnum1 = "Foo"
	want.fooEnum2 = "0"
	want.fooEnum3 = "1"
	want.fooEnumList = ["Foo", "0"]
	want.fooEnumSet = ["Foo", "0"]
	want.fooEnumMap = [["hi", "Foo"], ["zero", "0"]]
	assert h.input == `${want}`
}

