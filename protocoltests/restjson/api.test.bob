test "RestJsonSerializesDenseSetMap request" {
	const h = new Got()
	const req = new Request("POST", "/JsonMaps",
		"{\n    \"denseSetMap\": {\n        \"x\": [],\n        \"y\": [\"a\", \"b\"]\n    }\n}")
