test "RestJsonHttpResponseCodeRequired response" {
	const req = new Request("GET", "/responseCodeRequired", "")
	const res = api.handle(new RestJsonHttpResponseCodeRequired(), caller(""), req)
	assert res.status == 201
	assert res.headers.get("Content-Type") == "application/json"
	assert sameJson(res, `{}`)
}

test "RestJsonSimpleScalarProperties request" {
	const h = new Got()
	const req = new Request("PUT", "/SimpleScalarProperties",
		"{\n    \"stringValue\": \"string\",\n    \"trueBooleanValue\": true,\n    \"falseBooleanValue\": false,\n    \"byteValue\": 1,\n    \"shortValue\": 2,\n    \"integerValue\": 3,\n    \"longValue\": 4,\n    \"floatValue\": 5.5,\n    \"DoubleDribble\": 6.5\n}")
	req.headers.set("Content-Type", "application/json")
	req.headers.set("X-Foo", "Foo")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarPropertiesInputOutput()
	want.foo = "Foo"
	want.stringValue = "string"
	want.trueBooleanValue = true
	want.falseBooleanValue = false
	want.byteValue = 1
	want.shortValue = 2
	want.integerValue = 3
	want.longValue = 4
	want.floatValue = 5.5
	want.doubleValue = 6.5
	assert h.input == `${want}`
}

test "RestJsonServersDontSerializeNullStructureValues request" {
	const h = new Got()
	const req = new Request("PUT", "/SimpleScalarProperties", "{\n    \"stringValue\": null\n}")
	req.headers.set("Content-Type", "application/json")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarPropertiesInputOutput()
	assert h.input == `${want}`
}

