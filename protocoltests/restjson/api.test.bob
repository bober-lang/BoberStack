test "RestJsonSparseJsonMaps request" {
	const h = new Got()
	const req = new Request("POST", "/SparseJsonMaps",
		"{\n    \"sparseStructMap\": {\n        \"foo\": {\n            \"hi\": \"there\"\n        },\n        \"baz\": {\n            \"hi\": \"bye\"\n        }\n    }\n}")
	req.headers.set("Content-Type", "application/json")
	api.handle(h, caller(""), req)
	const want = new api.SparseJsonMapsInputOutput()
	want.sparseStructMap = [["foo", { ...new api.GreetingStruct(), hi: "there" }],
		["baz", { ...new api.GreetingStruct(), hi: "bye" }]]
	assert h.input == `${want}`
}

