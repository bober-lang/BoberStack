	normal: i64 | null @model.Timestamp
	dateTime: i64 | null @model.Timestamp["date-time"]
	dateTimeOnTarget: i64 | null @model.Timestamp["date-time"]
	epochSeconds: i64 | null @model.Timestamp["epoch-seconds"]
	epochSecondsOnTarget: i64 | null @model.Timestamp["epoch-seconds"]
	httpDate: i64 | null @model.Timestamp["http-date"]
	httpDateOnTarget: i64 | null @model.Timestamp["http-date"]
}

export class XmlUnionShape$stringValue {
	stringValue: string
}

export class XmlUnionShape$booleanValue {
	booleanValue: bool
}

export class XmlUnionShape$byteValue {
	byteValue: i8
}

export class XmlUnionShape$shortValue {
	shortValue: i16
}

export class XmlUnionShape$integerValue {
	integerValue: i32
}

export class XmlUnionShape$longValue {
	longValue: i64
}

export class XmlUnionShape$floatValue {
	floatValue: f32
}

export class XmlUnionShape$doubleValue {
	doubleValue: f64
}

export class XmlUnionShape$unionValue {
	unionValue: XmlUnionShape = new XmlUnionShape$stringValue()
}

export class XmlUnionShape$structValue {
	structValue: XmlNestedUnionStruct = new XmlNestedUnionStruct()
}

export type XmlUnionShape = XmlUnionShape$stringValue | XmlUnionShape$booleanValue | XmlUnionShape$byteValue
	| XmlUnionShape$shortValue | XmlUnionShape$integerValue | XmlUnionShape$longValue | XmlUnionShape$floatValue
	| XmlUnionShape$doubleValue | XmlUnionShape$unionValue | XmlUnionShape$structValue

export class XmlUnionsRequest {
	unionValue: XmlUnionShape | null
}

export class XmlUnionsResponse {
	unionValue: XmlUnionShape | null
}

/// The members of ComplexError besides its message.
export class ComplexError {
	Header: string | null @rest.Header["X-Header"]
	TopLevel: string | null
	Nested: ComplexNestedErrorData | null
}

export function complexError(message: string, members: ComplexError = new ComplexError()): Fault {
	return new Fault(403, "ComplexError", message, true, restxml.members(members))
}

export function invalidGreeting(message: string): Fault { return new Fault(400, "InvalidGreeting", message) }

