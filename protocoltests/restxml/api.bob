/// The answer of h to req.
export function handle(h: RestXmlProtocol, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = restxml.call(caller, req, service, routes)
	switch (c.operation) {
		case "AllQueryStringTypes": return c.serve(h.allQueryStringTypes)
		case "BodyWithXmlName": return c.serve(h.bodyWithXmlName)
		case "ConstantAndVariableQueryString": return c.serve(h.constantAndVariableQueryString)
		case "ConstantQueryString": return c.serve(h.constantQueryString)
		case "ContentTypeParameters": return c.serve(h.contentTypeParameters)
		case "DatetimeOffsets": return c.serve(h.datetimeOffsets)
		case "EmptyInputAndEmptyOutput": return c.serve(h.emptyInputAndEmptyOutput)
		case "EndpointOperation": return c.serve(h.endpointOperation)
		case "EndpointWithHostLabelHeaderOperation": return c.serve(h.endpointWithHostLabelHeaderOperation)
		case "EndpointWithHostLabelOperation": return c.serve(h.endpointWithHostLabelOperation)
		case "FlattenedXmlMap": return c.serve(h.flattenedXmlMap)
		case "FlattenedXmlMapWithXmlName": return c.serve(h.flattenedXmlMapWithXmlName)
		case "FlattenedXmlMapWithXmlNamespace": return c.serve(h.flattenedXmlMapWithXmlNamespace)
		case "FractionalSeconds": return c.serve(h.fractionalSeconds)
		case "GreetingWithErrors": return c.serve(h.greetingWithErrors)
		case "HttpEmptyPrefixHeaders": return c.serve(h.httpEmptyPrefixHeaders)
		case "HttpEnumPayload": return c.serve(h.httpEnumPayload)
		case "HttpPayloadTraits": return c.serve(h.httpPayloadTraits)
		case "HttpPayloadTraitsWithMediaType": return c.serve(h.httpPayloadTraitsWithMediaType)
		case "HttpPayloadWithMemberXmlName": return c.serve(h.httpPayloadWithMemberXmlName)
		case "HttpPayloadWithStructure": return c.serve(h.httpPayloadWithStructure)
		case "HttpPayloadWithUnion": return c.serve(h.httpPayloadWithUnion)
		case "HttpPayloadWithXmlName": return c.serve(h.httpPayloadWithXmlName)
		case "HttpPayloadWithXmlNamespace": return c.serve(h.httpPayloadWithXmlNamespace)
		case "HttpPayloadWithXmlNamespaceAndPrefix": return c.serve(h.httpPayloadWithXmlNamespaceAndPrefix)
		case "HttpPrefixHeaders": return c.serve(h.httpPrefixHeaders)
		case "HttpRequestWithFloatLabels": return c.serve(h.httpRequestWithFloatLabels)
		case "HttpRequestWithGreedyLabelInPath": return c.serve(h.httpRequestWithGreedyLabelInPath)
		case "HttpRequestWithLabels": return c.serve(h.httpRequestWithLabels)
		case "HttpRequestWithLabelsAndTimestampFormat": return c.serve(h.httpRequestWithLabelsAndTimestampFormat)
		case "HttpResponseCode": return c.serve(h.httpResponseCode)
		case "HttpStringPayload": return c.serve(h.httpStringPayload)
		case "IgnoreQueryParamsInResponse": return c.serve(h.ignoreQueryParamsInResponse)
		case "InputAndOutputWithHeaders": return c.serve(h.inputAndOutputWithHeaders)
		case "NestedXmlMapWithXmlName": return c.fail(notImplemented("NestedXmlMapWithXmlName"))
		case "NestedXmlMaps": return c.serve(h.nestedXmlMaps)
		case "NoInputAndNoOutput": return c.serve(h.noInputAndNoOutput)
		case "NoInputAndOutput": return c.serve(h.noInputAndOutput)
		case "NullAndEmptyHeadersClient": return c.serve(h.nullAndEmptyHeadersClient)
		case "NullAndEmptyHeadersServer": return c.serve(h.nullAndEmptyHeadersServer)
		case "OmitsNullSerializesEmptyString": return c.serve(h.omitsNullSerializesEmptyString)
		case "PutWithContentEncoding": return c.serve(h.putWithContentEncoding)
		case "QueryIdempotencyTokenAutoFill": return c.serve(h.queryIdempotencyTokenAutoFill)
		case "QueryParamsAsStringListMap": return c.serve(h.queryParamsAsStringListMap)
		case "QueryPrecedence": return c.serve(h.queryPrecedence)
		case "RecursiveShapes": return c.serve(h.recursiveShapes)
		case "SimpleScalarProperties": return c.serve(h.simpleScalarProperties)
		case "TimestampFormatHeaders": return c.serve(h.timestampFormatHeaders)
		case "XmlAttributes": return c.serve(h.xmlAttributes)
		case "XmlAttributesInMiddle": return c.serve(h.xmlAttributesInMiddle)
		case "XmlAttributesOnPayload": return c.serve(h.xmlAttributesOnPayload)
		case "XmlBlobs": return c.serve(h.xmlBlobs)
		case "XmlEmptyBlobs": return c.serve(h.xmlEmptyBlobs)
		case "XmlEmptyLists": return c.serve(h.xmlEmptyLists)
		case "XmlEmptyMaps": return c.serve(h.xmlEmptyMaps)
		case "XmlEmptyStrings": return c.serve(h.xmlEmptyStrings)
		case "XmlEnums": return c.serve(h.xmlEnums)
		case "XmlIntEnums": return c.serve(h.xmlIntEnums)
		case "XmlLists": return c.serve(h.xmlLists)
		case "XmlMapWithXmlNamespace": return c.serve(h.xmlMapWithXmlNamespace)
		case "XmlMaps": return c.serve(h.xmlMaps)
		case "XmlMapsXmlName": return c.serve(h.xmlMapsXmlName)
		case "XmlNamespaces": return c.serve(h.xmlNamespaces)
		case "XmlTimestamps": return c.serve(h.xmlTimestamps)
		case "XmlUnions": return c.serve(h.xmlUnions)
		default: return c.unknownOperation()
	}
}
