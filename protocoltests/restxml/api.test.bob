test "RestXmlQueryStringMap request" {
	const h = new Got()
	const req = new Request("GET", "/AllQueryStringTypesInput?QueryParamsStringKeyA=Foo&QueryParamsStringKeyB=Bar", "")
	api.handle(h, caller(""), req)
	const want = new api.AllQueryStringTypesInput()
	want.queryParamsMapOfStrings = [["QueryParamsStringKeyA", "Foo"], ["QueryParamsStringKeyB", "Bar"]]
	assert h.input == `${want}`
}

test "BodyWithXmlName request" {
	const h = new Got()
	const req = new Request("PUT", "/BodyWithXmlName", "<Ahoy><nested><name>Phreddy</name></nested></Ahoy>")
	req.headers.set("Content-Type", "application/xml")
	api.handle(h, caller(""), req)
	const want = new api.BodyWithXmlNameInputOutput()
	want.nested = { ...new api.PayloadWithXmlName(), name: "Phreddy" }
	assert h.input == `${want}`
}

