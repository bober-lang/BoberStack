test "BodyWithXmlName response" {
	const req = new Request("PUT", "/BodyWithXmlName", "")
	const res = api.handle(new BodyWithXmlName(), caller(""), req)
	assert res.status == 200
	assert res.headers.get("Content-Type") == "application/xml"
	assert same(res, `<Ahoy><nested><name>Phreddy</name></nested></Ahoy>`)
}

