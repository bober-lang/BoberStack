	const h = new Got()
	const req = new Request("PUT", "/RecursiveShapes",
		"<RecursiveShapesRequest>\n    <nested>\n        <foo>Foo1</foo>\n        <nested>\n            <bar>Bar1</bar>\n            <recursiveMember>\n                <foo>Foo2</foo>\n                <nested>\n                    <bar>Bar2</bar>\n                </nested>\n            </recursiveMember>\n        </nested>\n    </nested>\n</RecursiveShapesRequest>\n")
	req.headers.set("Content-Type", "application/xml")
	api.handle(h, caller(""), req)
	const want = new api.RecursiveShapesRequest()
	want.nested = { ...new api.RecursiveShapesInputOutputNested1(), foo: "Foo1",
		nested: { ...new api.RecursiveShapesInputOutputNested2(), bar: "Bar1",
		recursiveMember: { ...new api.RecursiveShapesInputOutputNested1(), foo: "Foo2",
		nested: { ...new api.RecursiveShapesInputOutputNested2(), bar: "Bar2" } } } }
	assert h.input == `${want}`
}

