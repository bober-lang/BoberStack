test "RpcV2CborSimpleScalarProperties request" {
	const h = new Got()
	const req = new Request("POST", "/service/RpcV2Protocol/operation/SimpleScalarProperties",
		base64.decode("v2lieXRlVmFsdWUFa2RvdWJsZVZhbHVl+z/+OVgQYk3TcWZhbHNlQm9vbGVhblZhbHVl9GpmbG9hdFZhbHVl+kD0AABsaW50ZWdlclZhbHVlGQEAaWxvbmdWYWx1ZRkmkWpzaG9ydFZhbHVlGSaqa3N0cmluZ1ZhbHVlZnNpbXBsZXB0cnVlQm9vbGVhblZhbHVl9WlibG9iVmFsdWVDZm9v/w=="))
	req.headers.set("smithy-protocol", "rpc-v2-cbor")
	req.headers.set("Content-Type", "application/cbor")
	req.headers.set("Accept", "application/cbor")
	api.handle(h, caller(""), req)
	const want = new api.SimpleScalarStructure()
	want.byteValue = 5
	want.doubleValue = 1.889
	want.falseBooleanValue = false
	want.floatValue = 7.625
	want.integerValue = 256
	want.longValue = 9873
	want.shortValue = 9898
	want.stringValue = "simple"
	want.trueBooleanValue = true
	want.blobValue = "foo"
	assert h.input == `${want}`
}

