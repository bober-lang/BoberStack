/// The answer of h to req.
export function handle(h: ACM, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "AddTagsToCertificate": return c.serve(h.addTagsToCertificate, ["acm:AddTagsToCertificate"])
		case "CreateAcmeDomainValidation": return c.serve(h.createAcmeDomainValidation, [])
		case "CreateAcmeEndpoint": return c.serve(h.createAcmeEndpoint, [])
		case "CreateAcmeExternalAccountBinding": return c.serve(h.createAcmeExternalAccountBinding, [])
		case "DeleteAcmeDomainValidation": return c.serve(h.deleteAcmeDomainValidation, [])
		case "DeleteAcmeEndpoint": return c.serve(h.deleteAcmeEndpoint, [])
		case "DeleteAcmeExternalAccountBinding": return c.serve(h.deleteAcmeExternalAccountBinding, [])
		case "DeleteCertificate": return c.serve(h.deleteCertificate, ["acm:DeleteCertificate"])
		case "DescribeAcmeAccount": return c.serve(h.describeAcmeAccount, [])
		case "DescribeAcmeDomainValidation": return c.serve(h.describeAcmeDomainValidation, [])
		case "DescribeAcmeEndpoint": return c.serve(h.describeAcmeEndpoint, [])
		case "DescribeAcmeExternalAccountBinding": return c.serve(h.describeAcmeExternalAccountBinding, [])
		case "DescribeCertificate": return c.serve(h.describeCertificate, ["acm:DescribeCertificate"])
		case "ExportCertificate": return c.serve(h.exportCertificate, ["acm:ExportCertificate"])
		case "GetAccountConfiguration": return c.serve(h.getAccountConfiguration, ["acm:GetAccountConfiguration"])
		case "GetAcmeExternalAccountBindingCredentials": return c.serve(h.getAcmeExternalAccountBindingCredentials, [])
		case "GetCertificate": return c.serve(h.getCertificate, ["acm:GetCertificate"])
		case "ImportCertificate": return c.serve(h.importCertificate,
			["acm:AddTagsToCertificate", "acm:ImportCertificate"])
		case "ListAcmeAccounts": return c.serve(h.listAcmeAccounts, [])
		case "ListAcmeDomainValidations": return c.serve(h.listAcmeDomainValidations, [])
		case "ListAcmeEndpoints": return c.serve(h.listAcmeEndpoints, [])
		case "ListAcmeExternalAccountBindings": return c.serve(h.listAcmeExternalAccountBindings, [])
		case "ListCertificateDomainValidations": return c.serve(h.listCertificateDomainValidations,
			["acm:ListCertificateDomainValidations"])
		case "ListCertificates": return c.serve(h.listCertificates, ["acm:ListCertificates"])
		case "ListTagsForCertificate": return c.serve(h.listTagsForCertificate, ["acm:ListTagsForCertificate"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["acm:ListTagsForResource"])
		case "PutAccountConfiguration": return c.serve(h.putAccountConfiguration, ["acm:PutAccountConfiguration"])
		case "RemoveTagsFromCertificate": return c.serve(h.removeTagsFromCertificate, ["acm:RemoveTagsFromCertificate"])
		case "RenewCertificate": return c.serve(h.renewCertificate, ["acm:RenewCertificate"])
		case "RequestCertificate": return c.serve(h.requestCertificate,
			["acm:AddTagsToCertificate", "acm:RequestCertificate"])
		case "ResendValidationEmail": return c.serve(h.resendValidationEmail, ["acm:ResendValidationEmail"])
		case "RevokeAcmeAccount": return c.serve(h.revokeAcmeAccount, [])
		case "RevokeAcmeExternalAccountBinding": return c.serve(h.revokeAcmeExternalAccountBinding, [])
		case "RevokeCertificate": return c.serve(h.revokeCertificate, ["acm:RevokeCertificate"])
		case "SearchCertificates": return c.serve(h.searchCertificates, ["acm:SearchCertificates"])
		case "TagResource": return c.serve(h.tagResource, ["acm:TagResource"])
		case "UntagResource": return c.serve(h.untagResource, ["acm:UntagResource"])
		case "UpdateAcmeDomainValidation": return c.serve(h.updateAcmeDomainValidation, [])
		case "UpdateAcmeEndpoint": return c.serve(h.updateAcmeEndpoint, [])
		case "UpdateCertificateOptions": return c.serve(h.updateCertificateOptions, ["acm:UpdateCertificateOptions"])
		default: return c.unknownOperation()
	}
}
