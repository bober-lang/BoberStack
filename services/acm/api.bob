}

export type X509AttributeFilter = X509AttributeFilter$Subject | X509AttributeFilter$SubjectAlternativeName
	| X509AttributeFilter$ExtendedKeyUsage | X509AttributeFilter$KeyUsage | X509AttributeFilter$KeyAlgorithm
	| X509AttributeFilter$SerialNumber | X509AttributeFilter$NotAfter | X509AttributeFilter$NotBefore

