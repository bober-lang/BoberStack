export function accessDeniedException(message: string): Fault {
	return new Fault(403, "AccessDeniedException", message)
}

export function conflictException(message: string): Fault { return new Fault(400, "ConflictException", message) }

export function internalServerException(message: string): Fault {
	return new Fault(500, "InternalServerException", message)
}

export function invalidArgsException(message: string): Fault { return new Fault(400, "InvalidArgsException", message) }
export function invalidArnException(message: string): Fault { return new Fault(400, "InvalidArnException", message) }

export function invalidDomainValidationOptionsException(message: string): Fault {
	return new Fault(400, "InvalidDomainValidationOptionsException", message)
}

export function invalidParameterException(message: string): Fault {
	return new Fault(400, "InvalidParameterException", message)
}

export function invalidStateException(message: string): Fault {
	return new Fault(400, "InvalidStateException", message)
}

export function invalidTagException(message: string): Fault { return new Fault(400, "InvalidTagException", message) }

export function limitExceededException(message: string): Fault {
	return new Fault(400, "LimitExceededException", message)
}

export function requestInProgressException(message: string): Fault {
	return new Fault(400, "RequestInProgressException", message)
}

export function resourceInUseException(message: string): Fault {
	return new Fault(400, "ResourceInUseException", message)
}

export function resourceNotFoundException(message: string): Fault {
	return new Fault(400, "ResourceNotFoundException", message)
}

export function serviceQuotaExceededException(message: string): Fault {
	return new Fault(400, "ServiceQuotaExceededException", message)
}

export function tagPolicyException(message: string): Fault { return new Fault(400, "TagPolicyException", message) }

/// The members of ThrottlingException besides its message.
export class ThrottlingException {
	throttlingReasons: ThrottlingReason[] | null
}

export function throttlingException(message: string, members: ThrottlingException = new ThrottlingException()): Fault {
	return new Fault(400, "ThrottlingException", message, true, json.members(members))
}

export function tooManyTagsException(message: string): Fault { return new Fault(400, "TooManyTagsException", message) }
export function validationException(message: string): Fault { return new Fault(400, "ValidationException", message) }

export interface ACM {
	addTagsToCertificate(caller: Caller, input: AddTagsToCertificateRequest): Unit throws Fault

	createAcmeDomainValidation(caller: Caller,
		input: CreateAcmeDomainValidationRequest): CreateAcmeDomainValidationResponse throws Fault

	createAcmeEndpoint(caller: Caller, input: CreateAcmeEndpointRequest): CreateAcmeEndpointResponse throws Fault

	createAcmeExternalAccountBinding(caller: Caller,
		input: CreateAcmeExternalAccountBindingRequest): CreateAcmeExternalAccountBindingResponse throws Fault

	deleteAcmeDomainValidation(caller: Caller, input: DeleteAcmeDomainValidationRequest): Unit throws Fault
	deleteAcmeEndpoint(caller: Caller, input: DeleteAcmeEndpointRequest): Unit throws Fault
	deleteAcmeExternalAccountBinding(caller: Caller, input: DeleteAcmeExternalAccountBindingRequest): Unit throws Fault
	deleteCertificate(caller: Caller, input: DeleteCertificateRequest): Unit throws Fault
	describeAcmeAccount(caller: Caller, input: DescribeAcmeAccountRequest): DescribeAcmeAccountResponse throws Fault

	describeAcmeDomainValidation(caller: Caller,
		input: DescribeAcmeDomainValidationRequest): DescribeAcmeDomainValidationResponse throws Fault

	describeAcmeEndpoint(caller: Caller, input: DescribeAcmeEndpointRequest): DescribeAcmeEndpointResponse throws Fault

	describeAcmeExternalAccountBinding(caller: Caller,
		input: DescribeAcmeExternalAccountBindingRequest): DescribeAcmeExternalAccountBindingResponse throws Fault

	describeCertificate(caller: Caller, input: DescribeCertificateRequest): DescribeCertificateResponse throws Fault
	exportCertificate(caller: Caller, input: ExportCertificateRequest): ExportCertificateResponse throws Fault
	getAccountConfiguration(caller: Caller, input: Unit): GetAccountConfigurationResponse throws Fault
	getAcmeExternalAccountBindingCredentials(caller: Caller, input: GetAcmeExternalAccountBindingCredentialsRequest): GetAcmeExternalAccountBindingCredentialsResponse throws Fault
	getCertificate(caller: Caller, input: GetCertificateRequest): GetCertificateResponse throws Fault
	importCertificate(caller: Caller, input: ImportCertificateRequest): ImportCertificateResponse throws Fault
	listAcmeAccounts(caller: Caller, input: ListAcmeAccountsRequest): ListAcmeAccountsResponse throws Fault

	listAcmeDomainValidations(caller: Caller,
		input: ListAcmeDomainValidationsRequest): ListAcmeDomainValidationsResponse throws Fault

	listAcmeEndpoints(caller: Caller, input: ListAcmeEndpointsRequest): ListAcmeEndpointsResponse throws Fault

	listAcmeExternalAccountBindings(caller: Caller,
		input: ListAcmeExternalAccountBindingsRequest): ListAcmeExternalAccountBindingsResponse throws Fault

	listCertificateDomainValidations(caller: Caller,
		input: ListCertificateDomainValidationsRequest): ListCertificateDomainValidationsResponse throws Fault

	listCertificates(caller: Caller, input: ListCertificatesRequest): ListCertificatesResponse throws Fault

	listTagsForCertificate(caller: Caller,
		input: ListTagsForCertificateRequest): ListTagsForCertificateResponse throws Fault

	listTagsForResource(caller: Caller, input: ListTagsForResourceRequest): ListTagsForResourceResponse throws Fault
	putAccountConfiguration(caller: Caller, input: PutAccountConfigurationRequest): Unit throws Fault
	removeTagsFromCertificate(caller: Caller, input: RemoveTagsFromCertificateRequest): Unit throws Fault
	renewCertificate(caller: Caller, input: RenewCertificateRequest): Unit throws Fault
	requestCertificate(caller: Caller, input: RequestCertificateRequest): RequestCertificateResponse throws Fault
	resendValidationEmail(caller: Caller, input: ResendValidationEmailRequest): Unit throws Fault
	revokeAcmeAccount(caller: Caller, input: RevokeAcmeAccountRequest): Unit throws Fault
	revokeAcmeExternalAccountBinding(caller: Caller, input: RevokeAcmeExternalAccountBindingRequest): Unit throws Fault
	revokeCertificate(caller: Caller, input: RevokeCertificateRequest): RevokeCertificateResponse throws Fault
	searchCertificates(caller: Caller, input: SearchCertificatesRequest): SearchCertificatesResponse throws Fault
	tagResource(caller: Caller, input: TagResourceRequest): Unit throws Fault
	untagResource(caller: Caller, input: UntagResourceRequest): Unit throws Fault
	updateAcmeDomainValidation(caller: Caller, input: UpdateAcmeDomainValidationRequest): Unit throws Fault
	updateAcmeEndpoint(caller: Caller, input: UpdateAcmeEndpointRequest): Unit throws Fault
	updateCertificateOptions(caller: Caller, input: UpdateCertificateOptionsRequest): Unit throws Fault
}

