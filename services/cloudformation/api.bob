/// The answer of h to req.
export function handle(h: CloudFormation, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = query.call(caller, req, version, ns)
	switch (c.action) {
		case "ActivateOrganizationsAccess": return c.serve(h.activateOrganizationsAccess,
			["cloudformation:ActivateOrganizationsAccess", "iam:CreateServiceLinkedRole", "iam:GetRole"])
		case "ActivateType": return c.serve(h.activateType, ["cloudformation:ActivateType", "iam:PassRole"])
		case "BatchDescribeTypeConfigurations": return c.serve(h.batchDescribeTypeConfigurations,
			["cloudformation:BatchDescribeTypeConfigurations"])
		case "CancelUpdateStack": return c.serve(h.cancelUpdateStack, ["cloudformation:CancelUpdateStack"])
		case "ContinueUpdateRollback": return c.serve(h.continueUpdateRollback,
			["cloudformation:ContinueUpdateRollback", "iam:PassRole"])
		case "CreateChangeSet": return c.serve(h.createChangeSet,
			["cloudformation:CreateChangeSet", "iam:PassRole", "cloudformation:TagResource",
			"cloudformation:UntagResource"])
		case "CreateGeneratedTemplate": return c.serve(h.createGeneratedTemplate,
			["cloudformation:CreateGeneratedTemplate"])
		case "CreateStack": return c.serve(h.createStack,
			["cloudformation:CreateStack", "iam:PassRole", "cloudformation:TagResource"])
		case "CreateStackInstances": return c.serve(h.createStackInstances, ["cloudformation:CreateStackInstances"])
		case "CreateStackRefactor": return c.serve(h.createStackRefactor, ["cloudformation:CreateStackRefactor"])
		case "CreateStackSet": return c.serve(h.createStackSet,
			["cloudformation:CreateStackSet", "iam:PassRole", "cloudformation:TagResource"])
		case "DeactivateOrganizationsAccess": return c.serve(h.deactivateOrganizationsAccess,
			["cloudformation:DeactivateOrganizationsAccess"])
		case "DeactivateType": return c.serve(h.deactivateType, ["cloudformation:DeactivateType"])
		case "DeleteChangeSet": return c.serve(h.deleteChangeSet, ["cloudformation:DeleteChangeSet"])
		case "DeleteGeneratedTemplate": return c.serve(h.deleteGeneratedTemplate,
			["cloudformation:DeleteGeneratedTemplate"])
		case "DeleteStack": return c.serve(h.deleteStack, ["cloudformation:DeleteStack", "iam:PassRole"])
		case "DeleteStackInstances": return c.serve(h.deleteStackInstances, ["cloudformation:DeleteStackInstances"])
		case "DeleteStackSet": return c.serve(h.deleteStackSet, ["cloudformation:DeleteStackSet"])
		case "DeregisterType": return c.serve(h.deregisterType, ["cloudformation:DeregisterType"])
		case "DescribeAccountLimits": return c.serve(h.describeAccountLimits, ["cloudformation:DescribeAccountLimits"])
		case "DescribeChangeSet": return c.serve(h.describeChangeSet, ["cloudformation:DescribeChangeSet"])
		case "DescribeChangeSetHooks": return c.serve(h.describeChangeSetHooks,
			["cloudformation:DescribeChangeSetHooks"])
		case "DescribeEvents": return c.serve(h.describeEvents, ["cloudformation:DescribeEvents"])
		case "DescribeGeneratedTemplate": return c.serve(h.describeGeneratedTemplate,
			["cloudformation:DescribeGeneratedTemplate"])
		case "DescribeOrganizationsAccess": return c.serve(h.describeOrganizationsAccess,
			["cloudformation:DescribeOrganizationsAccess"])
		case "DescribePublisher": return c.serve(h.describePublisher, ["cloudformation:DescribePublisher"])
		case "DescribeResourceScan": return c.serve(h.describeResourceScan, ["cloudformation:DescribeResourceScan"])
		case "DescribeStackDriftDetectionStatus": return c.serve(h.describeStackDriftDetectionStatus,
			["cloudformation:DescribeStackDriftDetectionStatus"])
		case "DescribeStackEvents": return c.serve(h.describeStackEvents, ["cloudformation:DescribeStackEvents"])
		case "DescribeStackInstance": return c.serve(h.describeStackInstance, ["cloudformation:DescribeStackInstance"])
		case "DescribeStackRefactor": return c.serve(h.describeStackRefactor, ["cloudformation:DescribeStackRefactor"])
		case "DescribeStackResource": return c.serve(h.describeStackResource, ["cloudformation:DescribeStackResource"])
		case "DescribeStackResourceDrifts": return c.serve(h.describeStackResourceDrifts,
			["cloudformation:DescribeStackResourceDrifts"])
		case "DescribeStackResources": return c.serve(h.describeStackResources,
			["cloudformation:DescribeStackResources"])
		case "DescribeStackSet": return c.serve(h.describeStackSet, ["cloudformation:DescribeStackSet"])
		case "DescribeStackSetOperation": return c.serve(h.describeStackSetOperation,
			["cloudformation:DescribeStackSetOperation"])
		case "DescribeStacks": return c.serve(h.describeStacks,
			["cloudformation:DescribeStacks", "cloudformation:ListStacks"])
		case "DescribeType": return c.serve(h.describeType, ["cloudformation:DescribeType"])
		case "DescribeTypeRegistration": return c.serve(h.describeTypeRegistration,
			["cloudformation:DescribeTypeRegistration"])
		case "DetectStackDrift": return c.serve(h.detectStackDrift,
			["cloudformation:DetectStackDrift", "cloudformation:DetectStackResourceDrift"])
		case "DetectStackResourceDrift": return c.serve(h.detectStackResourceDrift,
