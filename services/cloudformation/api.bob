		case "GetTemplateSummary": return c.serve(h.getTemplateSummary, ["cloudformation:GetTemplateSummary"])
		case "ImportStacksToStackSet": return c.serve(h.importStacksToStackSet,
			["cloudformation:ImportStacksToStackSet"])
		case "ListChangeSets": return c.serve(h.listChangeSets, ["cloudformation:ListChangeSets"])
		case "ListExports": return c.serve(h.listExports, ["cloudformation:ListExports"])
		case "ListGeneratedTemplates": return c.serve(h.listGeneratedTemplates,
			["cloudformation:ListGeneratedTemplates"])
		case "ListHookResults": return c.serve(h.listHookResults,
			["cloudformation:ListAllHookResults", "cloudformation:ListHookResults"])
		case "ListImports": return c.serve(h.listImports, ["cloudformation:ListImports"])
		case "ListResourceScanRelatedResources": return c.serve(h.listResourceScanRelatedResources,
			["cloudformation:ListResourceScanRelatedResources"])
		case "ListResourceScanResources": return c.serve(h.listResourceScanResources,
			["cloudformation:ListResourceScanResources"])
		case "ListResourceScans": return c.serve(h.listResourceScans, ["cloudformation:ListResourceScans"])
		case "ListStackInstanceResourceDrifts": return c.serve(h.listStackInstanceResourceDrifts,
			["cloudformation:ListStackInstanceResourceDrifts"])
		case "ListStackInstances": return c.serve(h.listStackInstances, ["cloudformation:ListStackInstances"])
		case "ListStackRefactorActions": return c.serve(h.listStackRefactorActions,
			["cloudformation:ListStackRefactorActions"])
		case "ListStackRefactors": return c.serve(h.listStackRefactors, ["cloudformation:ListStackRefactors"])
		case "ListStackResources": return c.serve(h.listStackResources, ["cloudformation:ListStackResources"])
		case "ListStackSetAutoDeploymentTargets": return c.serve(h.listStackSetAutoDeploymentTargets,
			["cloudformation:ListStackSetAutoDeploymentTargets"])
		case "ListStackSetOperationResults": return c.serve(h.listStackSetOperationResults,
			["cloudformation:ListStackSetOperationResults"])
		case "ListStackSetOperations": return c.serve(h.listStackSetOperations,
			["cloudformation:ListStackSetOperations"])
		case "ListStackSets": return c.serve(h.listStackSets, ["cloudformation:ListStackSets"])
		case "ListStacks": return c.serve(h.listStacks, ["cloudformation:ListStacks"])
		case "ListTypeRegistrations": return c.serve(h.listTypeRegistrations, ["cloudformation:ListTypeRegistrations"])
		case "ListTypeVersions": return c.serve(h.listTypeVersions, ["cloudformation:ListTypeVersions"])
		case "ListTypes": return c.serve(h.listTypes, ["cloudformation:ListTypes"])
		case "PublishType": return c.serve(h.publishType, ["cloudformation:PublishType"])
		case "RecordHandlerProgress": return c.serve(h.recordHandlerProgress, ["cloudformation:RecordHandlerProgress"])
		case "RegisterPublisher": return c.serve(h.registerPublisher, ["cloudformation:RegisterPublisher"])
		case "RegisterType": return c.serve(h.registerType, ["iam:PassRole", "cloudformation:RegisterType"])
		case "RemoveAlias": return c.serve(h.removeAlias, ["cloudformation:RemoveAlias"])
		case "RollbackStack": return c.serve(h.rollbackStack, ["iam:PassRole", "cloudformation:RollbackStack"])
		case "SetAlias": return c.serve(h.setAlias, ["cloudformation:SetAlias"])
		case "SetStackPolicy": return c.serve(h.setStackPolicy, ["cloudformation:SetStackPolicy"])
		case "SetTypeConfiguration": return c.serve(h.setTypeConfiguration, ["cloudformation:SetTypeConfiguration"])
		case "SetTypeDefaultVersion": return c.serve(h.setTypeDefaultVersion, ["cloudformation:SetTypeDefaultVersion"])
		case "SignalResource": return c.serve(h.signalResource, ["cloudformation:SignalResource"])
		case "StartResourceScan": return c.serve(h.startResourceScan, ["cloudformation:StartResourceScan"])
		case "StopStackSetOperation": return c.serve(h.stopStackSetOperation, ["cloudformation:StopStackSetOperation"])
		case "TestType": return c.serve(h.testType, ["cloudformation:TestType"])
		case "UpdateGeneratedTemplate": return c.serve(h.updateGeneratedTemplate,
			["cloudformation:UpdateGeneratedTemplate"])
		case "UpdateStack": return c.serve(h.updateStack,
			["iam:PassRole", "cloudformation:SetStackPolicy", "cloudformation:TagResource",
			"cloudformation:UntagResource", "cloudformation:UpdateStack"])
		case "UpdateStackInstances": return c.serve(h.updateStackInstances, ["cloudformation:UpdateStackInstances"])
		case "UpdateStackSet": return c.serve(h.updateStackSet,
			["iam:PassRole", "cloudformation:TagResource", "cloudformation:UntagResource",
			"cloudformation:UpdateStackSet"])
		case "UpdateTerminationProtection": return c.serve(h.updateTerminationProtection,
			["cloudformation:UpdateTerminationProtection"])
		case "ValidateTemplate": return c.serve(h.validateTemplate, ["cloudformation:ValidateTemplate"])
		default: return c.invalidAction()
	}
