/// The answer of h to req.
export function handle(h: CloudWatch, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = query.call(caller, req, version, ns)
	switch (c.action) {
		case "AssociateDatasetKmsKey": return c.serve(h.associateDatasetKmsKey, [])
		case "CreateResourceMetricsConfiguration": return c.serve(h.createResourceMetricsConfiguration,
			["cloudwatch:CreateResourceMetricsConfiguration"])
		case "DeleteAlarmMuteRule": return c.serve(h.deleteAlarmMuteRule, ["cloudwatch:DeleteAlarmMuteRule"])
		case "DeleteAlarms": return c.serve(h.deleteAlarms, ["cloudwatch:DeleteAlarms"])
		case "DeleteAnomalyDetector": return c.serve(h.deleteAnomalyDetector, ["cloudwatch:DeleteAnomalyDetector"])
		case "DeleteDashboards": return c.serve(h.deleteDashboards, ["cloudwatch:DeleteDashboards"])
		case "DeleteInsightRules": return c.serve(h.deleteInsightRules, ["cloudwatch:DeleteInsightRules"])
		case "DeleteMetricDataQueryDefinition": return c.serve(h.deleteMetricDataQueryDefinition,
			["cloudwatch:DeleteMetricDataQueryDefinition"])
		case "DeleteMetricStream": return c.serve(h.deleteMetricStream, ["cloudwatch:DeleteMetricStream"])
		case "DeleteResourceMetricsConfiguration": return c.serve(h.deleteResourceMetricsConfiguration,
			["cloudwatch:DeleteResourceMetricsConfiguration"])
		case "DescribeAlarmContributors": return c.serve(h.describeAlarmContributors, [])
		case "DescribeAlarmHistory": return c.serve(h.describeAlarmHistory, ["cloudwatch:DescribeAlarmHistory"])
		case "DescribeAlarms": return c.serve(h.describeAlarms, ["cloudwatch:DescribeAlarms"])
		case "DescribeAlarmsForMetric": return c.serve(h.describeAlarmsForMetric,
