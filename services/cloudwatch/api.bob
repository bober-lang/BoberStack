/// The answer of h to req of awsJson.
export function handleJson(h: CloudWatch, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "AssociateDatasetKmsKey": return c.serve(h.associateDatasetKmsKey, [])
		case "CreateResourceMetricsConfiguration": return c.serve(h.createResourceMetricsConfiguration,
			["cloudwatch:CreateResourceMetricsConfiguration"])
		case "DeleteAlarmMuteRule": return c.serve(h.deleteAlarmMuteRule, ["cloudwatch:DeleteAlarmMuteRule"])
