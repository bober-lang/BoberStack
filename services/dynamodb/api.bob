	Delete: DeleteVectorIndexAction | null
}

export class WarmThroughput {
	ReadUnitsPerSecond: i64 | null
	WriteUnitsPerSecond: i64 | null
}

export class WriteRequest {
	PutRequest: PutRequest | null
	DeleteRequest: DeleteRequest | null
}

export function backupInUseException(message: string): Fault { return new Fault(400, "BackupInUseException", message) }

export function backupNotFoundException(message: string): Fault {
	return new Fault(400, "BackupNotFoundException", message)
}

/// The members of ConditionalCheckFailedException besides its message.
export class ConditionalCheckFailedException {
	Item: [string, AttributeValue][] | null
}

export function conditionalCheckFailedException(message: string,
	members: ConditionalCheckFailedException = new ConditionalCheckFailedException()): Fault {
	return new Fault(400, "ConditionalCheckFailedException", message, true, json.members(members))
}

