	VectorWriteRequestBytes: f64 | null
}

export class VectorIndex {
	IndexName: string
	VectorAttribute: VectorAttributeDefinition = new VectorAttributeDefinition()
	SearchSchema: SearchSchemaElement[] | null
	Projection: Projection = new Projection()
	Dimensions: i64
	DistanceFunction: VectorDistanceFunction = "COSINE"
}

export class VectorIndexDescription {
	IndexName: string | null
	SearchSchema: SearchSchemaElement[] | null
	Projection: Projection | null
	VectorAttribute: VectorAttributeDefinition | null
	Dimensions: i64 | null
	DistanceFunction: VectorDistanceFunction | null
