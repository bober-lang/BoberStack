/// The answer of h to req.
export function handle(h: DynamoDB, caller: Caller, req: Request): Response throws IoError {
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "BatchExecuteStatement": return c.serve(h.batchExecuteStatement,
			["dynamodb:PartiQLDelete", "dynamodb:PartiQLInsert", "dynamodb:PartiQLSelect", "dynamodb:PartiQLUpdate"])
