//! Amazon DynamoDB: tables with their secondary indexes, tags and time to live; items, read and written one at a time,
//! in batches and in transactions; Query and Scan; and PartiQL's statements, as the operations they amount to. A
//! request is one transaction over the state, so a write, its indexes' entries and its stream record commit together;
//! a write that changes nothing writes no record, as AWS's. A write also puts its change record on each Kinesis
//! streaming destination of the table, within the request, as the account, as DynamoDB's service-linked role would; a
//! record the stream refuses is dropped.
//!
//! Known differences from AWS, as nothing runs but requests: tables, indexes, destinations and time to live change
//! status at once; expired items are never deleted; point-in-time recovery is stored but nothing can be restored. An
//! SSE-KMS key is checked but never used, so disabling it does not make the table INACCESSIBLE_ENCRYPTION_CREDENTIALS.

import { Fault } from "../../core/fault"
import { uuid } from "../../core/random"
import { result } from "../../core/protocol/json"
import { Violations } from "../../core/protocol/model"
import { Caller, requestTags, Unit } from "../../core/service"
import * as service from "../../core/service"
import * as api from "./api"
import * as kinesisApi from "../kinesis/api"

import { Action, apply, condition, Context, copy, holds, invalid, Item, Node, project, projection, same, shown, Step,
	typeName, update, validation } from "./expression"

import { encode, escaped } from "./key"
import { attributes, expected, filter, unmixed, updates } from "./legacy"
import { format, parse } from "./number"
import { joined, statement, Statement, Term } from "./partiql"

import { attribute, Change, Definition, Destination, entries, Index, indexKeyOf, items, Key, keyNames, keyOf, parsed,
	projected, sizeOf, stored, Stream, streamKey, Tables, Token, typeOf } from "./records"

import { keyArn } from "../kms/kms"
import { indexOf, lastIndexOf, startsWith } from "std/algo"
import * as b64 from "std/encoding/base64"
import { ParseError, replace } from "std/string"
import { millisecond, minute } from "std/time"

export class Handler {
	...api.Unimplemented

	/// What Kinesis streaming destinations are, which the stack sets.
	kinesis: kinesisApi.Kinesis | null = null

	createTable(caller: Caller, input: api.CreateTableInput): api.CreateTableOutput throws Fault {
		named(input.TableName, "tableName")
		const tags = tagged([], input.Tags ?? [])
		// The other actions its dispatch names are authorized of replicas, resource policies and tags.
		caller.actions = if (tags.length == 0) ["dynamodb:CreateTable"]
			else ["dynamodb:CreateTable", "dynamodb:TagResource"]
		caller.allow(arn(caller, input.TableName), null, requestTags(tags))
		const db = new Tables(caller.regional())
		const d = new Definition()
		d.name = input.TableName
		const defined = definitions(input.AttributeDefinitions, input.KeySchema)
		d.attributes = defined
		const [hash, range] = schema(input.KeySchema!, defined, null)
		d.hash = hash
		d.range = range
		d.billing = input.BillingMode ?? "PROVISIONED"
		const [read, write] = throughput(d.billing, input.ProvisionedThroughput, null)
		d.read = read
		d.write = write
		const used = [hash.name]
		if (range != null) {
			used.push(range!.name)
		}
		for (const l of input.LocalSecondaryIndexes ?? []) {
			if (range == null) {
				throw invalidParameters("Table KeySchema does not have a range key, which is required when specifying a "
					+ "LocalSecondaryIndex")
			}
			const x = index(d, l.IndexName, l.KeySchema, l.Projection, false)
			if (x.hash.name != hash.name) {
				throw invalidParameters(`Index KeySchema does not have the same leading hash key as table KeySchema for `
					+ `index: ${l.IndexName}. index hash key: ${x.hash.name}, table hash key: ${hash.name}`)
			}
			if (x.range == null) {
				throw invalidParameters(`Index KeySchema for a LocalSecondaryIndex must have a range key: ${l.IndexName}`)
			}
			used.push(x.range!.name)
		}
		for (const g of input.GlobalSecondaryIndexes ?? []) {
			const x = index(d, g.IndexName, g.KeySchema, g.Projection, true)
			const [r, w] = throughput(d.billing, g.ProvisionedThroughput, g.IndexName)
			x.read = r
			x.write = w
			used.push(x.hash.name)
			if (x.range != null) {
				used.push(x.range!.name)
			}
		}
		for (const [n, _] of defined) {
			if (!used.includes(n)) {
				throw invalidParameters("Number of attributes in KeySchema does not exactly match number of attributes "
					+ "defined in AttributeDefinitions")
			}
		}
		if (db.get(d.name) != null) {
			throw api.resourceInUseException(`Table already exists: ${d.name}`)
		}
		d.id = uuid()
		d.created = now()
		d.onDemandSince = if (d.billing == "PAY_PER_REQUEST") d.created else 0
		d.tableClass = input.TableClass ?? "STANDARD"
		d.deletionProtection = input.DeletionProtectionEnabled ?? false
		encryption(caller, d, input.SSESpecification)
		d.tags = tagged([], input.Tags ?? [])
		stream(db, d, input.StreamSpecification, false)
		db.save(d)
		const r = new api.CreateTableOutput()
		r.TableDescription = describe(caller, d, "ACTIVE")
		return r
	}

	describeTable(caller: Caller, input: api.DescribeTableInput): api.DescribeTableOutput throws Fault {
		caller.actions = ["dynamodb:DescribeTable"]
		const d = table(caller, input.TableName)
		const r = new api.DescribeTableOutput()
		r.Table = describe(caller, d, "ACTIVE")
		return r
	}

	listTables(caller: Caller, input: api.ListTablesInput): api.ListTablesOutput throws Fault {
		caller.allow(arn(caller, "*"))
		const n = input.Limit ?? 100
		if (n < 1 || n > 100) {
			const why = if (n < 1) "greater than or equal to 1" else "less than or equal to 100"
			throw new Violations(api.service.validation).fault(`${n}`, "limit", `Member must have value ${why}`)
		}
		const got = new Tables(caller.regional()).definitions.scan(input.ExclusiveStartTableName, n + 1)
		const r = new api.ListTablesOutput()
		r.TableNames = got.slice(0, if (got.length > n) n else got.length).map(e => e[0])
		r.LastEvaluatedTableName = if (got.length > n) got[n - 1][0] else null
		return r
	}

	deleteTable(caller: Caller, input: api.DeleteTableInput): api.DeleteTableOutput throws Fault {
		const d = table(caller, input.TableName)
		if (d.deletionProtection) {
			throw validation("Resource cannot be deleted as it is currently protected against deletion. Disable "
				+ "deletion protection first.")
		}
		const db = new Tables(caller.regional())
		clear(db, items(d.name))
		for (const x of d.indexes) {
			clear(db, entries(d.name, x.name))
		}
		if (d.stream) {
			close(db, d)
		}
		db.definitions.delete(d.name)
		const r = new api.DeleteTableOutput()
		r.TableDescription = describe(caller, d, "DELETING")
		return r
	}

	updateTable(caller: Caller, input: api.UpdateTableInput): api.UpdateTableOutput throws Fault {
		caller.actions = ["dynamodb:UpdateTable"]
		const d = table(caller, input.TableName)
		const db = new Tables(caller.regional())
		if (input.BillingMode != null && input.BillingMode != d.billing) {
			d.billing = input.BillingMode!
			d.onDemandSince = if (d.billing == "PAY_PER_REQUEST") now() else d.onDemandSince
			if (d.billing == "PAY_PER_REQUEST") {
				d.read = 0
				d.write = 0
				for (const x of d.indexes) {
					x.read = 0
					x.write = 0
				}
			}
		}
		if (input.ProvisionedThroughput != null || d.billing == "PROVISIONED" && d.read == 0) {
			const [r, w] = throughput(d.billing, input.ProvisionedThroughput, null)
			d.read = r
			d.write = w
		}
		if (input.AttributeDefinitions != null) {
			for (const a of input.AttributeDefinitions!) {
				const was = d.attributes.find(e => e[0] == a.AttributeName)
				if (was != null && was[1] != a.AttributeType) {
					throw invalidParameters(`Cannot change the type of an existing attribute: ${a.AttributeName}`)
				}
				if (was == null) {
					d.attributes.push([a.AttributeName, a.AttributeType])
				}
			}
		}
		for (const u of input.GlobalSecondaryIndexUpdates ?? []) {
			if (u.Create != null) {
				const c = u.Create!
				const x = index(d, c.IndexName, c.KeySchema, c.Projection, true)
				const [r, w] = throughput(d.billing, c.ProvisionedThroughput, c.IndexName)
				x.read = r
				x.write = w
				backfill(db, d, x)
			} else if (u.Delete != null) {
				const name = u.Delete!.IndexName
				const x = d.indexes.find(i => i.global && i.name == name)
				if (x == null) {
					throw api.resourceNotFoundException(`Requested resource not found: Index: ${name} not found`)
				}
				clear(db, entries(d.name, name))
				d.indexes = d.indexes.filter(i => i.name != name)
			} else if (u.Update != null) {
				const x = d.indexes.find(i => i.global && i.name == u.Update!.IndexName)
				if (x == null) {
					throw api.resourceNotFoundException(`Requested resource not found: Index: ${u.Update!.IndexName} not found`)
				}
				const [r, w] = throughput(d.billing, u.Update!.ProvisionedThroughput, x!.name)
				x!.read = r
				x!.write = w
			}
		}
		stream(db, d, input.StreamSpecification, true)
		d.tableClass = input.TableClass ?? d.tableClass
		d.deletionProtection = input.DeletionProtectionEnabled ?? d.deletionProtection
		encryption(caller, d, input.SSESpecification)
		db.save(d)
		const r = new api.UpdateTableOutput()
		r.TableDescription = describe(caller, d, "ACTIVE")
		return r
	}

	tagResource(caller: Caller, input: api.TagResourceInput): Unit throws Fault {
		const d = resource(caller, input.ResourceArn)
		d.tags = tagged(d.tags, input.Tags)
		new Tables(caller.regional()).save(d)
		return new Unit()
	}

	untagResource(caller: Caller, input: api.UntagResourceInput): Unit throws Fault {
		const d = resource(caller, input.ResourceArn)
		d.tags = d.tags.filter(t => !input.TagKeys.includes(t[0]))
		new Tables(caller.regional()).save(d)
		return new Unit()
	}

	listTagsOfResource(caller: Caller, input: api.ListTagsOfResourceInput): api.ListTagsOfResourceOutput throws Fault {
		const d = resource(caller, input.ResourceArn)
		const r = new api.ListTagsOfResourceOutput()
		r.Tags = d.tags.map(t => ({ ...new api.Tag(), Key: t[0], Value: t[1] }))
		return r
	}

	describeTimeToLive(caller: Caller, input: api.DescribeTimeToLiveInput): api.DescribeTimeToLiveOutput throws Fault {
		caller.actions = ["dynamodb:DescribeTimeToLive"]
		const d = table(caller, input.TableName)
		const r = new api.DescribeTimeToLiveOutput()
		r.TimeToLiveDescription = new api.TimeToLiveDescription()
		r.TimeToLiveDescription!.TimeToLiveStatus = if (d.ttlEnabled) "ENABLED" else "DISABLED"
		r.TimeToLiveDescription!.AttributeName = if (d.ttlEnabled) d.ttl else null
		return r
	}

	updateTimeToLive(caller: Caller, input: api.UpdateTimeToLiveInput): api.UpdateTimeToLiveOutput throws Fault {
		caller.actions = ["dynamodb:UpdateTimeToLive"]
		const d = table(caller, input.TableName)
		const s = input.TimeToLiveSpecification
		if (s.Enabled == d.ttlEnabled) {
			throw validation(`TimeToLive is already ${if (s.Enabled) "enabled" else "disabled"}`)
		}
		if (!s.Enabled && s.AttributeName != d.ttl) {
			throw validation("TimeToLive is active on a different AttributeName: current AttributeName is " + d.ttl)
		}
		d.ttlEnabled = s.Enabled
		d.ttl = s.AttributeName
		new Tables(caller.regional()).save(d)
		const r = new api.UpdateTimeToLiveOutput()
		r.TimeToLiveSpecification = s
		return r
	}

	enableKinesisStreamingDestination(caller: Caller,
		input: api.KinesisStreamingDestinationInput): api.KinesisStreamingDestinationOutput throws Fault {
		const d = table(caller, input.TableName)
		const precision = input.EnableKinesisStreamingConfiguration?.ApproximateCreationDateTimePrecision
			?? "MILLISECOND"
		const s = new kinesisApi.DescribeStreamSummaryInput()
		s.StreamARN = input.StreamArn
		try {
			if (this.kinesis == null) {
				throw validation("There is no Kinesis")
			}
			this.kinesis!.describeStreamSummary(account(caller, ["kinesis:DescribeStreamSummary"]), s)
		} catch (f: Fault) {
			throw validation(`Stream ${input.StreamArn} does not exist`)
		}
		d.destinations = d.destinations.filter(x => x.arn != input.StreamArn)
		d.destinations.push({ ...new Destination(), arn: input.StreamArn, precision: `${precision}` })
		new Tables(caller.regional()).save(d)
		return destination(d, input.StreamArn, "ENABLING", input.EnableKinesisStreamingConfiguration)
	}

	disableKinesisStreamingDestination(caller: Caller,
		input: api.KinesisStreamingDestinationInput): api.KinesisStreamingDestinationOutput throws Fault {
		const d = table(caller, input.TableName)
		const x = enabled(d, input.StreamArn)
		x.status = "DISABLED"
		new Tables(caller.regional()).save(d)
		return destination(d, input.StreamArn, "DISABLING", input.EnableKinesisStreamingConfiguration)
	}

	updateKinesisStreamingDestination(caller: Caller,
		input: api.UpdateKinesisStreamingDestinationInput): api.UpdateKinesisStreamingDestinationOutput throws Fault {
		const d = table(caller, input.TableName)
		const x = enabled(d, input.StreamArn)
		x.precision = `${input.UpdateKinesisStreamingConfiguration?.ApproximateCreationDateTimePrecision ?? x.precision}`
		new Tables(caller.regional()).save(d)
		const r = new api.UpdateKinesisStreamingDestinationOutput()
		r.TableName = d.name
		r.StreamArn = x.arn
		r.DestinationStatus = "UPDATING"
		r.UpdateKinesisStreamingConfiguration = input.UpdateKinesisStreamingConfiguration
		return r
	}

	describeKinesisStreamingDestination(caller: Caller, input: api.DescribeKinesisStreamingDestinationInput): api.DescribeKinesisStreamingDestinationOutput throws Fault {
		const d = table(caller, input.TableName)
		const r = new api.DescribeKinesisStreamingDestinationOutput()
		r.TableName = d.name
		r.KinesisDataStreamDestinations = d.destinations.map(x => ({ ...new api.KinesisDataStreamDestination(),
			StreamArn: x.arn, DestinationStatus: x.status as api.DestinationStatus,
			ApproximateCreationDateTimePrecision: x.precision as api.ApproximateCreationDateTimePrecision }))
		return r
	}

	/// Puts db's outbox's records on their Kinesis streams, as the account, and empties it; one refused is dropped.
	private flush(caller: Caller, db: Tables) throws Fault {
		for (const [a, k, data] of db.outbox) {
			const r = new kinesisApi.PutRecordInput()
			r.StreamARN = a
			r.PartitionKey = k
			r.Data = `{"awsRegion":"${caller.region}",${data}`
			try {
				this.kinesis!.putRecord(account(caller, ["kinesis:PutRecord"]), r)
			} catch (f: Fault) {}
		}
		db.outbox = []
	}

	describeLimits(caller: Caller, input: api.DescribeLimitsInput): api.DescribeLimitsOutput throws Fault {
		caller.allow("*")
		const r = new api.DescribeLimitsOutput()
		r.AccountMaxReadCapacityUnits = 80000
		r.AccountMaxWriteCapacityUnits = 80000
		r.TableMaxReadCapacityUnits = 40000
		r.TableMaxWriteCapacityUnits = 40000
		return r
	}

	/// Unauthorized, as AWS's.
	describeEndpoints(caller: Caller, input: api.DescribeEndpointsRequest): api.DescribeEndpointsResponse throws Fault {
		const r = new api.DescribeEndpointsResponse()
		const host = caller.endpoint.slice(indexOf(caller.endpoint, "//") + 2, caller.endpoint.length)
		r.Endpoints = [{ ...new api.Endpoint(), Address: host, CachePeriodInMinutes: 1440 }]
		return r
	}

	describeContinuousBackups(caller: Caller,
		input: api.DescribeContinuousBackupsInput): api.DescribeContinuousBackupsOutput throws Fault {
		const r = new api.DescribeContinuousBackupsOutput()
		r.ContinuousBackupsDescription = backups(table(caller, input.TableName))
		return r
	}

	updateContinuousBackups(caller: Caller,
		input: api.UpdateContinuousBackupsInput): api.UpdateContinuousBackupsOutput throws Fault {
		const d = table(caller, input.TableName)
		const s = input.PointInTimeRecoverySpecification
		if (s.PointInTimeRecoveryEnabled && !d.recovery) {
			d.recoverySince = now()
		}
		d.recovery = s.PointInTimeRecoveryEnabled
		d.recoveryDays = if (d.recovery) s.RecoveryPeriodInDays ?? 35 else 0
		new Tables(caller.regional()).save(d)
		const r = new api.UpdateContinuousBackupsOutput()
		r.ContinuousBackupsDescription = backups(d)
		return r
	}

	putItem(caller: Caller, input: api.PutItemInput): api.PutItemOutput throws Fault {
		let cond: Node | null = null
		try {
			unmixed([["Expected", input.Expected != null], ["ConditionalOperator", input.ConditionalOperator != null]],
				[["ConditionExpression", input.ConditionExpression != null]])
			const c = new Context(input.ExpressionAttributeNames, input.ExpressionAttributeValues)
			cond = conditional(c, input.ConditionExpression, input.ExpressionAttributeNames,
				input.ExpressionAttributeValues) ?? expected(input.Expected, input.ConditionalOperator)
			allOldOrNone(input.ReturnValues)
			values(input.Item)
		} catch (f: Fault) {
			throw counted(f)
		}
		caller.actions = ["dynamodb:PutItem"]
		const d = table(caller, input.TableName, null, d => keys(d, [input.Item], input.Item.map(a => a[0])))
		const db = new Tables(caller.regional())
		const k = itemKey(d, input.Item)
		const before = db.item(d, k)
		check(cond, before, input.ReturnValuesOnConditionCheckFailure)
		write(db, d, k, before, input.Item)
		this.flush(caller, db)
		const r = new api.PutItemOutput()
		r.Attributes = if (input.ReturnValues == "ALL_OLD") before else null
		r.ConsumedCapacity = consumed(input.ReturnConsumedCapacity, d.name, writeUnits(before, input.Item), false)
		return r
	}

	getItem(caller: Caller, input: api.GetItemInput): api.GetItemOutput throws Fault {
		unmixed([["AttributesToGet", input.AttributesToGet != null]],
			[["ProjectionExpression", input.ProjectionExpression != null]])
		const c = new Context(input.ExpressionAttributeNames, null)
		const paths = if (input.ProjectionExpression == null) attributes(input.AttributesToGet)
			else projection(input.ProjectionExpression!, c)
		placeholders(c, input.ProjectionExpression != null, input.ExpressionAttributeNames, null)
		caller.actions = ["dynamodb:GetItem"]
		const d = table(caller, input.TableName, null, d => keys(d, [input.Key], attributesOf(paths)))
		const db = new Tables(caller.regional())
		const found = db.item(d, keyFrom(d, input.Key))
		const r = new api.GetItemOutput()
		r.Item = if (found == null) null else if (paths == null) found else project(found!, paths!)
		r.ConsumedCapacity = consumed(input.ReturnConsumedCapacity, d.name,
			readUnits(if (found == null) 0 else sizeOf(found!), input.ConsistentRead ?? false), true)
		return r
	}

	deleteItem(caller: Caller, input: api.DeleteItemInput): api.DeleteItemOutput throws Fault {
		let cond: Node | null = null
		try {
			unmixed([["Expected", input.Expected != null], ["ConditionalOperator", input.ConditionalOperator != null]],
				[["ConditionExpression", input.ConditionExpression != null]])
			const c = new Context(input.ExpressionAttributeNames, input.ExpressionAttributeValues)
			cond = conditional(c, input.ConditionExpression, input.ExpressionAttributeNames,
				input.ExpressionAttributeValues) ?? expected(input.Expected, input.ConditionalOperator)
			allOldOrNone(input.ReturnValues)
		} catch (f: Fault) {
			throw counted(f)
		}
		caller.actions = ["dynamodb:DeleteItem"]
		const d = table(caller, input.TableName, null, d => keys(d, [input.Key], input.Key.map(a => a[0])))
		const db = new Tables(caller.regional())
		const k = keyFrom(d, input.Key)
		const before = db.item(d, k)
		check(cond, before, input.ReturnValuesOnConditionCheckFailure)
		if (before != null) {
			write(db, d, k, before, null)
			this.flush(caller, db)
		}
		const r = new api.DeleteItemOutput()
		r.Attributes = if (input.ReturnValues == "ALL_OLD") before else null
		r.ConsumedCapacity = consumed(input.ReturnConsumedCapacity, d.name, writeUnits(before, null), false)
		return r
	}

	updateItem(caller: Caller, input: api.UpdateItemInput): api.UpdateItemOutput throws Fault {
		let actions: Action[] = []
		let cond: Node | null = null
		try {
			unmixed([["Expected", input.Expected != null], ["ConditionalOperator", input.ConditionalOperator != null],
				["AttributeUpdates", input.AttributeUpdates != null]],
				[["ConditionExpression", input.ConditionExpression != null],
				["UpdateExpression", input.UpdateExpression != null]])
			const c = new Context(input.ExpressionAttributeNames, input.ExpressionAttributeValues)
			actions = if (input.UpdateExpression == null) updates(input.AttributeUpdates ?? [])
				else update(input.UpdateExpression!, c)
			cond = conditional(c, input.ConditionExpression, input.ExpressionAttributeNames,
				input.ExpressionAttributeValues, input.UpdateExpression != null)
				?? expected(input.Expected, input.ConditionalOperator)
		} catch (f: Fault) {
			throw counted(f)
		}
		const changed = input.Key.map(a => a[0])
		for (const a of actions) {
			if (!changed.includes(a.path[0].name)) {
				changed.push(a.path[0].name)
			}
		}
		const d = table(caller, input.TableName, null, d => keys(d, [input.Key], changed))
		const db = new Tables(caller.regional())
		const k = keyFrom(d, input.Key)
		for (const a of actions) {
			if (keyNames(d, null).includes(a.path[0].name)) {
				throw invalidParameters(`Cannot update attribute ${a.path[0].name}. This attribute is part of the key`)
			}
		}
		const before = db.item(d, k)
		check(cond, before, input.ReturnValuesOnConditionCheckFailure)
		const after = apply(actions, before ?? copy(input.Key))
		values(after)
		write(db, d, k, before, after)
		this.flush(caller, db)
		const paths = actions.map(a => a.path)
		const r = new api.UpdateItemOutput()
		r.Attributes = switch (input.ReturnValues ?? "NONE") {
			case "ALL_OLD": before
			case "ALL_NEW": after
			case "UPDATED_OLD": if (before == null) null else nonEmpty(project(before!, paths))
			case "UPDATED_NEW": nonEmpty(project(after, paths))
			default: null
		}
		r.ConsumedCapacity = consumed(input.ReturnConsumedCapacity, d.name, writeUnits(before, after), false)
		return r
	}

	query(caller: Caller, input: api.QueryInput): api.QueryOutput throws Fault {
		unmixed([["AttributesToGet", input.AttributesToGet != null], ["QueryFilter", input.QueryFilter != null],
			["ConditionalOperator", input.ConditionalOperator != null], ["KeyConditions", input.KeyConditions != null]],
			[["ProjectionExpression", input.ProjectionExpression != null],
			["FilterExpression", input.FilterExpression != null],
			["KeyConditionExpression", input.KeyConditionExpression != null]])
		const c = new Context(input.ExpressionAttributeNames, input.ExpressionAttributeValues)
		const old = input.KeyConditions != null
		if (input.KeyConditionExpression == null && !old) {
			throw validation("Either the KeyConditions or KeyConditionExpression parameter must be specified in the "
				+ "request.")
		}
		const keyed = if (old) filter(input.KeyConditions, null)!
			else condition(input.KeyConditionExpression!, "KeyConditionExpression", c)
		const kept = if (input.FilterExpression == null) filter(input.QueryFilter, input.ConditionalOperator)
			else condition(input.FilterExpression!, "FilterExpression", c)
		const paths = if (input.ProjectionExpression == null) attributes(input.AttributesToGet)
			else projection(input.ProjectionExpression!, c)
		placeholders(c, !old, input.ExpressionAttributeNames, input.ExpressionAttributeValues)
		limited(input.Limit)
		const d = table(caller, input.TableName, input.IndexName, d => {
			const x = indexed(d, input.IndexName, null)
			const out = keys(d, [], attributesOf(paths))
			if (x == null) {
				const [hash, _] = keyConditions(d, x, keyed, old)
				out.push(["dynamodb:LeadingKeys", [text(hash.args[1].value!)]])
			}
			return out
		})
		const x = indexed(d, input.IndexName, input.ConsistentRead)
		const select = selected(input.Select, paths, x, input.AttributesToGet != null)
		const [hash, range] = keyConditions(d, x, keyed, old)
		const prefix = (if (x == null) items(d.name) else entries(d.name, x!.name)) + encode(hash.args[1].value!)
		let from = prefix
		if (range != null && range!.kind == "begins_with") {
			from = prefix + escaped(scalar(range!.args[1].value!))
		} else if (range != null && range!.kind != "<" && range!.kind != "<=") {
			const lo = encode(range!.args[1].value!)
			from = prefix + lo.slice(0, lo.length - 1)
		}
		const p = read(new Tables(caller.regional()), d, x, prefix, from, input.ScanIndexForward ?? true,
			start(d, x, input.ExclusiveStartKey), input.Limit, keyed, kept, 0, 1)
		return { ...new api.QueryOutput(), Items: shaped(caller, d, x, p.items, select, paths), Count: p.items.length,
			ScannedCount: p.scanned, LastEvaluatedKey: p.last,
			ConsumedCapacity: consumed(input.ReturnConsumedCapacity, d.name,
			readUnits(p.bytes, input.ConsistentRead ?? false), true) }
	}

	scan(caller: Caller, input: api.ScanInput): api.ScanOutput throws Fault {
		unmixed([["AttributesToGet", input.AttributesToGet != null], ["ScanFilter", input.ScanFilter != null],
			["ConditionalOperator", input.ConditionalOperator != null]],
			[["ProjectionExpression", input.ProjectionExpression != null],
			["FilterExpression", input.FilterExpression != null]])
		const c = new Context(input.ExpressionAttributeNames, input.ExpressionAttributeValues)
		const kept = if (input.FilterExpression == null) filter(input.ScanFilter, input.ConditionalOperator)
			else condition(input.FilterExpression!, "FilterExpression", c)
		const paths = if (input.ProjectionExpression == null) attributes(input.AttributesToGet)
			else projection(input.ProjectionExpression!, c)
		placeholders(c, input.FilterExpression != null || input.ProjectionExpression != null,
			input.ExpressionAttributeNames, input.ExpressionAttributeValues)
		limited(input.Limit)
		if (input.Segment != null && input.TotalSegments == null) {
			throw validation("The TotalSegments parameter is required but was not present in the request when Segment "
				+ "parameter is present")
		}
		if (input.TotalSegments != null && input.Segment == null) {
			throw validation("The Segment parameter is required but was not present in the request when parameter "
				+ "TotalSegments is present")
		}
		const segment = input.Segment ?? 0
		const total = input.TotalSegments ?? 1
		if (total < 1 || total > 1000000) {
			throw new Violations(api.service.validation).fault(`${total}`, "totalSegments",
				if (total < 1) "Member must have value greater than or equal to 1"
				else "Member must have value less than or equal to 1000000")
		}
		if (segment < 0 || segment >= total) {
			throw validation("The Segment parameter is zero-based and must be less than parameter TotalSegments")
		}
		caller.actions = ["dynamodb:Scan"]
		const d = table(caller, input.TableName, input.IndexName, d => keys(d, [], attributesOf(paths)))
		const x = indexed(d, input.IndexName, input.ConsistentRead)
		const select = selected(input.Select, paths, x, input.AttributesToGet != null)
		const prefix = if (x == null) items(d.name) else entries(d.name, x!.name)
		const p = read(new Tables(caller.regional()), d, x, prefix, prefix, true, start(d, x, input.ExclusiveStartKey),
			input.Limit, null, kept, segment, total)
		return { ...new api.ScanOutput(), Items: shaped(caller, d, x, p.items, select, paths), Count: p.items.length,
			ScannedCount: p.scanned, LastEvaluatedKey: p.last,
			ConsumedCapacity: consumed(input.ReturnConsumedCapacity, d.name,
			readUnits(p.bytes, input.ConsistentRead ?? false), true) }
	}

	batchGetItem(caller: Caller, input: api.BatchGetItemInput): api.BatchGetItemOutput throws Fault {
		let n = 0
		for (const [_, ka] of input.RequestItems) {
			n += ka.Keys.length
		}
		if (n > 100) {
			throw validation("Too many items requested for the BatchGetItem call")
		}
		const db = new Tables(caller.regional())
		const r = new api.BatchGetItemOutput()
		r.Responses = []
		r.UnprocessedKeys = []
		const used: api.ConsumedCapacity[] = []
		for (const [name, ka] of input.RequestItems) {
			unmixed([["AttributesToGet", ka.AttributesToGet != null]],
				[["ProjectionExpression", ka.ProjectionExpression != null]])
			const c = new Context(ka.ExpressionAttributeNames, null)
			const paths = if (ka.ProjectionExpression == null) attributes(ka.AttributesToGet)
				else projection(ka.ProjectionExpression!, c)
			placeholders(c, ka.ProjectionExpression != null, ka.ExpressionAttributeNames, null)
			const d = table(caller, name, null, d => keys(d, ka.Keys, attributesOf(paths)))
			const seen: string[] = []
			const found: Item[] = []
			let bytes: i64 = 0
			for (const key of ka.Keys) {
				const k = keyFrom(d, key)
				if (seen.includes(k)) {
					throw validation("Provided list of item keys contains duplicates")
				}
				seen.push(k)
				const item = db.item(d, k)
				if (item != null) {
					bytes += sizeOf(item!)
					found.push(if (paths == null) item! else project(item!, paths!))
				}
			}
			r.Responses!.push([d.name, found])
			const u = consumed(input.ReturnConsumedCapacity, d.name, readUnits(bytes, ka.ConsistentRead ?? false), true)
			if (u != null) {
				used.push(u!)
			}
		}
		r.ConsumedCapacity = if (input.ReturnConsumedCapacity == null || input.ReturnConsumedCapacity == "NONE") null
			else used
		return r
	}

	batchWriteItem(caller: Caller, input: api.BatchWriteItemInput): api.BatchWriteItemOutput throws Fault {
		let n = 0
		for (const [_, requests] of input.RequestItems) {
			n += requests.length
		}
		if (n > 25) {
			throw validation("Too many items requested for the BatchWriteItem call")
		}
		const db = new Tables(caller.regional())
		const used: api.ConsumedCapacity[] = []
		for (const [name, requests] of input.RequestItems) {
			const d = table(caller, name, null, d => {
				const given: Item[] = []
				const names: string[] = []
				for (const w of requests) {
					const i = w.PutRequest?.Item ?? w.DeleteRequest?.Key ?? []
					given.push(i)
					for (const [n, _] of i) {
						if (!names.includes(n)) {
							names.push(n)
						}
					}
				}
				return keys(d, given, names)
			})
			const seen: string[] = []
			let units = 0.0
			for (const w of requests) {
				if ((w.PutRequest == null) == (w.DeleteRequest == null)) {
					throw validation("Supplied AttributeValue has more than one datatypes set, must contain exactly one of "
						+ "the supported datatypes")
				}
				const item = if (w.PutRequest != null) w.PutRequest!.Item else null
				if (item != null) {
					values(item!)
				}
				const k = if (item != null) itemKey(d, item!) else keyFrom(d, w.DeleteRequest!.Key)
				if (seen.includes(k)) {
					throw validation("Provided list of item keys contains duplicates")
				}
				seen.push(k)
				const before = db.item(d, k)
				if (item != null || before != null) {
					write(db, d, k, before, item)
				}
				units += writeUnits(before, item)
			}
			const u = consumed(input.ReturnConsumedCapacity, d.name, units, false)
			if (u != null) {
				used.push(u!)
			}
		}
		this.flush(caller, db)
		const r = new api.BatchWriteItemOutput()
		r.UnprocessedItems = []
		r.ConsumedCapacity = if (used.length == 0) null else used
		return r
	}

	transactGetItems(caller: Caller, input: api.TransactGetItemsInput): api.TransactGetItemsOutput throws Fault {
		if (input.TransactItems.length > 100) {
			throw new Violations(api.service.validation).fault(null, "transactItems",
				"Member must have length less than or equal to 100")
		}
		const db = new Tables(caller.regional())
		const r = new api.TransactGetItemsOutput()
		r.Responses = []
		for (const t of input.TransactItems) {
			const g = t.Get
			const c = new Context(g.ExpressionAttributeNames, null)
			const paths = if (g.ProjectionExpression == null) null else projection(g.ProjectionExpression!, c)
			placeholders(c, paths != null, g.ExpressionAttributeNames, null)
			const d = table(caller, g.TableName, null, d => keys(d, [g.Key], attributesOf(paths)))
			const item = db.item(d, keyFrom(d, g.Key))
			r.Responses!.push({ ...new api.ItemResponse(),
				Item: if (item == null) null else if (paths == null) item else project(item!, paths!) })
		}
		return r
	}

	transactWriteItems(caller: Caller, input: api.TransactWriteItemsInput): api.TransactWriteItemsOutput throws Fault {
		if (input.TransactItems.length > 100) {
			throw new Violations(api.service.validation).fault(null, "transactItems",
				"Member must have length less than or equal to 100")
		}
		const db = new Tables(caller.regional())
		const planned: Planned[] = []
		for (const t of input.TransactItems) {
			planned.push(plan(caller, db, t))
		}
		for (let i = 0; i < planned.length; i++) {
			for (let j = 0; j < i; j++) {
				if (planned[i].d.name == planned[j].d.name && planned[i].k == planned[j].k) {
					throw validation("Transaction request cannot include multiple operations on one item")
				}
			}
		}
		// A token used within 10 minutes answers for its request, written once, and refuses another.
		const request = result({ ...new api.TransactWriteItemsInput(), TransactItems: input.TransactItems })
		const token = if (input.ClientRequestToken == null) null else db.tokens.get(input.ClientRequestToken!)
		if (token != null && now() - token!.at < 10 * minute) {
			if (token!.request != request) {
				throw api.idempotentParameterMismatchException("DynamoDB rejected the request because you retried a "
					+ "request with a different payload but with an idempotent token that was already used.")
			}
			return new api.TransactWriteItemsOutput()
		}
		const reasons: api.CancellationReason[] = []
		let failed = false
		for (const p of planned) {
			const reason = new api.CancellationReason()
			reason.Code = "None"
			if (p.test != null && !holds(p.test!, p.before ?? [])) {
				failed = true
				reason.Code = "ConditionalCheckFailed"
				reason.Message = "The conditional request failed"
				reason.Item = if (p.onFailure == "ALL_OLD") p.before else null
			}
			reasons.push(reason)
		}
		if (failed) {
			const codes = reasons.map(r => r.Code ?? "None").join(", ")
			throw api.transactionCanceledException(`Transaction cancelled, please refer cancellation reasons for specific reasons [${codes}]`,
				{ ...new api.TransactionCanceledException(), CancellationReasons: reasons })
		}
		for (const p of planned) {
			if (p.kind == "Put") {
				write(db, p.d, p.k, p.before, p.item)
			} else if (p.kind == "Delete" && p.before != null) {
				write(db, p.d, p.k, p.before, null)
			} else if (p.kind == "Update") {
				const after = apply(p.actions, p.before ?? copy(p.item!))
				values(after)
				write(db, p.d, p.k, p.before, after)
			}
		}
		if (input.ClientRequestToken != null) {
			db.tokens.put(input.ClientRequestToken!, { ...new Token(), at: now(), request: request })
		}
		this.flush(caller, db)
		return new api.TransactWriteItemsOutput()
	}

	executeStatement(caller: Caller, input: api.ExecuteStatementInput): api.ExecuteStatementOutput throws Fault {
		const s = statement(input.Statement, input.Parameters)
		const inner = partiql(caller, s)
		if (s.kind != "select") {
			this.change(inner, s, input.ReturnValuesOnConditionCheckFailure)
			return { ...new api.ExecuteStatementOutput(), Items: [] }
		}
		let from: Item | null = null
		if (input.NextToken != null) {
			try {
				from = parsed(b64.decode(input.NextToken!))
			} catch (e: ParseError) {
				throw validation("Invalid NextToken")
			}
		}
		const r = this.scan(inner,
			{ ...new api.ScanInput(), TableName: s.table, IndexName: s.index, Limit: input.Limit,
			ConsistentRead: input.ConsistentRead, ProjectionExpression: s.projection, FilterExpression: joined(s.terms),
			ExpressionAttributeNames: namesOf(s.names, s.terms), ExpressionAttributeValues: valuesOf([], s.terms),
			ExclusiveStartKey: from, ReturnConsumedCapacity: input.ReturnConsumedCapacity })
		return { ...new api.ExecuteStatementOutput(), Items: r.Items, LastEvaluatedKey: r.LastEvaluatedKey,
			NextToken: if (r.LastEvaluatedKey == null) null else base64(stored(r.LastEvaluatedKey!)),
			ConsumedCapacity: r.ConsumedCapacity }
	}

	batchExecuteStatement(caller: Caller,
		input: api.BatchExecuteStatementInput): api.BatchExecuteStatementOutput throws Fault {
		const out: api.BatchStatementResponse[] = []
		for (const q of input.Statements) {
			const r = new api.BatchStatementResponse()
			try {
				const s = statement(q.Statement, q.Parameters)
				const inner = partiql(caller, s)
				if (s.kind == "select") {
					r.Item = this.got(inner, s, q.ConsistentRead)
				} else {
					this.change(inner, s, q.ReturnValuesOnConditionCheckFailure)
				}
				r.TableName = s.table
			} catch (f: Fault) {
				const code = if (f.code == "ValidationException") "ValidationError"
					else if (lastIndexOf(f.code, "Exception") == f.code.length - 9) f.code.slice(0, f.code.length - 9)
					else f.code
				r.Error = { ...new api.BatchStatementError(), Code: code as api.BatchStatementErrorCodeEnum,
					Message: f.message }
			}
			out.push(r)
		}
		return { ...new api.BatchExecuteStatementOutput(), Responses: out }
	}

	executeTransaction(caller: Caller, input: api.ExecuteTransactionInput): api.ExecuteTransactionOutput throws Fault {
		const ss: Statement[] = []
		for (let i = 0; i < input.TransactStatements.length; i++) {
			const t = input.TransactStatements[i]
			try {
				ss.push(statement(t.Statement, t.Parameters))
			} catch (f: Fault) {
				throw if (f.code
					== "ValidationException") validation(`Validation failed in TransactStatements[${i}]: ` + f.message)
					else f
			}
		}
		const reads = ss.filter(s => s.kind == "select").length
		if (reads > 0 && reads < ss.length) {
			throw validation("ExecuteTransaction API does not support both read and write operations in the same "
				+ "request.")
		}
		const r = new api.ExecuteTransactionOutput()
		const writes: api.TransactWriteItem[] = []
		let inner = caller
		for (let i = 0; i < ss.length; i++) {
			inner = partiql(caller, ss[i])
			if (reads > 0) {
				r.Responses = r.Responses ?? []
				r.Responses!.push({ ...new api.ItemResponse(), Item: this.got(inner, ss[i], true) })
			} else {
				writes.push(transacted(inner, ss[i], input.TransactStatements[i].ReturnValuesOnConditionCheckFailure))
			}
		}
		if (writes.length > 0) {
			this.transactWriteItems(inner,
				{ ...new api.TransactWriteItemsInput(), TransactItems: writes,
				ClientRequestToken: input.ClientRequestToken })
		}
		return r
	}

	got(caller: Caller, s: Statement, consistent: bool | null): Item | null throws Fault {
		const d = table(caller, s.table)
		const [key, rest] = keyed(d, s.terms)
		const item = this.getItem(caller,
			{ ...new api.GetItemInput(), TableName: s.table, Key: key, ConsistentRead: consistent }).Item
		if (item == null
			|| rest.length > 0
			&& !holds(condition(joined(rest)!, "ConditionExpression",
			new Context(namesOf([], rest), valuesOf([], rest))), item!)) {
			return null
		}
		return if (s.projection == null) item else project(item!, projection(s.projection!, new Context(s.names, null)))
	}

	change(caller: Caller, s: Statement, onFailure: api.ReturnValuesOnConditionCheckFailure | null) throws Fault {
		const w = transacted(caller, s, onFailure)
		if (w.Put != null) {
			const p = w.Put!
			try {
				this.putItem(caller,
					{ ...new api.PutItemInput(), TableName: p.TableName, Item: p.Item,
					ConditionExpression: p.ConditionExpression, ExpressionAttributeNames: p.ExpressionAttributeNames })
			} catch (f: Fault) {
				throw if (f.code == "ConditionalCheckFailedException") api.duplicateItemException("Duplicate primary key exists in table")
					else f
			}
		} else if (w.Update != null) {
			const u = w.Update!
			this.updateItem(caller,
				{ ...new api.UpdateItemInput(), TableName: u.TableName, Key: u.Key,
				UpdateExpression: u.UpdateExpression, ConditionExpression: u.ConditionExpression,
				ExpressionAttributeNames: u.ExpressionAttributeNames,
				ExpressionAttributeValues: u.ExpressionAttributeValues,
				ReturnValuesOnConditionCheckFailure: onFailure })
		} else {
			const x = w.Delete!
			this.deleteItem(caller,
				{ ...new api.DeleteItemInput(), TableName: x.TableName, Key: x.Key,
				ConditionExpression: x.ConditionExpression, ExpressionAttributeNames: x.ExpressionAttributeNames,
				ExpressionAttributeValues: x.ExpressionAttributeValues,
				ReturnValuesOnConditionCheckFailure: onFailure })
		}
	}
}

/// The caller allowed to do s as dynamodb:PartiQL<verb>; then the account's root, as which its operations are served.
function partiql(caller: Caller, s: Statement): Caller throws Fault {
	caller.actions = [if (s.kind == "select") "dynamodb:PartiQLSelect"
		else if (s.kind == "insert") "dynamodb:PartiQLInsert"
		else if (s.kind == "update") "dynamodb:PartiQLUpdate"
		else "dynamodb:PartiQLDelete"]
	const a = arn(caller, s.table)
	caller.allow(if (s.index == null) a else `${a}/index/${s.index!}`)
	return caller.internal(`arn:aws:iam::${caller.account}:root`, "", [])
}

/// The write s as a transaction's: an INSERT a Put of an item whose key no other has, an UPDATE an Update of one that
/// exists.
function transacted(caller: Caller, s: Statement,
	onFailure: api.ReturnValuesOnConditionCheckFailure | null): api.TransactWriteItem throws Fault {
	const d = table(caller, s.table)
	const w = new api.TransactWriteItem()
	const exists: [string, string][] = [["#key", d.hash.name]]
	if (s.kind == "insert") {
		w.Put = { ...new api.Put(), TableName: s.table, Item: s.item, ConditionExpression: "attribute_not_exists(#key)",
			ExpressionAttributeNames: exists, ReturnValuesOnConditionCheckFailure: onFailure }
		return w
	}
	const [key, rest] = keyed(d, s.terms)
	const test = joined(rest)
	if (s.kind == "update") {
		w.Update = { ...new api.Update(), TableName: s.table, Key: key, UpdateExpression: s.update,
			ConditionExpression: "attribute_exists(#key)" + (if (test == null) "" else ` AND ${test!}`),
			ExpressionAttributeNames: namesOf([...exists, ...s.names], rest),
			ExpressionAttributeValues: valuesOf(s.values, rest), ReturnValuesOnConditionCheckFailure: onFailure }
	} else {
		w.Delete = { ...new api.Delete(), TableName: s.table, Key: key, ConditionExpression: test,
			ExpressionAttributeNames: namesOf([], rest), ExpressionAttributeValues: valuesOf([], rest),
			ReturnValuesOnConditionCheckFailure: onFailure }
	}
	return w
}

function keyed(d: Definition, terms: Term[]): [Item, Term[]] throws Fault {
	const key: Item = []
	const rest: Term[] = []
	for (const t of terms) {
		if (t.name != null && (t.name == d.hash.name || d.range != null && t.name == d.range!.name)
			&& !key.some(e => e[0] == t.name)) {
			key.push([t.name!, t.value!])
		} else {
			rest.push(t)
		}
	}
	if (key.length < (if (d.range == null) 1 else 2)) {
		throw validation("Where clause does not contain a mandatory equality on all key attributes")
	}
	return [key, rest]
}

function namesOf(names: [string, string][], terms: Term[]): [string, string][] | null {
	const out: [string, string][] = []
	out.append(names)
	for (const t of terms) {
		out.append(t.names)
	}
	return if (out.length == 0) null else out
}

function valuesOf(values: Item, terms: Term[]): Item | null {
	const out: Item = []
	out.append(values)
	for (const t of terms) {
		out.append(t.values)
	}
	return if (out.length == 0) null else out
}

/// A write of a transaction, read but not done.
class Planned {
	kind = ""
	d = new Definition()
	k = ""
	before: Item | null = null
	item: Item | null = null
	actions: Action[] = []
	test: Node | null = null
	onFailure = ""
}

function plan(caller: Caller, db: Tables, t: api.TransactWriteItem): Planned throws Fault {
	const p = new Planned()
	const set = [t.Put != null, t.Update != null, t.Delete != null, t.ConditionCheck != null].filter(b => b).length
	if (set != 1) {
		throw validation("TransactItems can only contain one of Check, Put, Update or Delete")
	}
	let name = ""
	let c = new Context(null, null)
	let expression: string | null = null
	if (t.Put != null) {
		const x = t.Put!
		p.kind = "Put"
		name = x.TableName
		c = new Context(x.ExpressionAttributeNames, x.ExpressionAttributeValues)
		expression = x.ConditionExpression
		p.onFailure = x.ReturnValuesOnConditionCheckFailure ?? "NONE"
		values(x.Item)
		p.item = x.Item
	} else if (t.Update != null) {
		const x = t.Update!
		p.kind = "Update"
		name = x.TableName
		c = new Context(x.ExpressionAttributeNames, x.ExpressionAttributeValues)
		p.actions = update(x.UpdateExpression, c)
		expression = x.ConditionExpression
		p.onFailure = x.ReturnValuesOnConditionCheckFailure ?? "NONE"
		p.item = x.Key
	} else if (t.Delete != null) {
		const x = t.Delete!
		p.kind = "Delete"
		name = x.TableName
		c = new Context(x.ExpressionAttributeNames, x.ExpressionAttributeValues)
		expression = x.ConditionExpression
		p.onFailure = x.ReturnValuesOnConditionCheckFailure ?? "NONE"
		p.item = x.Key
	} else {
		const x = t.ConditionCheck!
		p.kind = "ConditionCheck"
		name = x.TableName
		c = new Context(x.ExpressionAttributeNames, x.ExpressionAttributeValues)
		expression = x.ConditionExpression
		p.onFailure = x.ReturnValuesOnConditionCheckFailure ?? "NONE"
		p.item = x.Key
	}
	p.test = if (expression == null) null else condition(expression!, "ConditionExpression", c)
	c.unused()
	caller.actions = [`dynamodb:${p.kind}Item`]
	const given = p.item!
	const names = given.map(a => a[0])
	for (const a of p.actions) {
		if (!names.includes(a.path[0].name)) {
			names.push(a.path[0].name)
		}
	}
	p.d = table(caller, name, null, d => keys(d, [given], names))
	p.k = if (p.kind == "Put") itemKey(p.d, p.item!) else keyFrom(p.d, p.item!)
	if (p.kind == "Update") {
		for (const a of p.actions) {
			if (keyNames(p.d, null).includes(a.path[0].name)) {
				throw invalidParameters(`Cannot update attribute ${a.path[0].name}. This attribute is part of the key`)
			}
		}
	}
	p.before = db.item(p.d, p.k)
	return p
}

class Page {
	items: Item[] = []
	scanned = 0
	bytes: i64 = 0
	last: Item | null = null
}

const pageBytes: i64 = 1048576

/// A page of the entries of the table d, or its index x if not null, whose keys start with prefix: those keyed holds
/// for, then of them those filter keeps.
function read(db: Tables, d: Definition, x: Index | null, prefix: string, from: string, forward: bool,
	start: string | null, limit: i32 | null, keyed: Node | null, filter: Node | null, segment: i32,
	total: i32): Page throws Fault {
	const p = new Page()
	let after = if (!forward) start else if (start != null && start! > from) start! else from
	let matched = false // keyed holds for a range of keys: past its first, its first miss ends it
	while (true) {
		const chunk = db.store.scan(prefix, after, 100, !forward)
		for (const [k, v] of chunk) {
			const item = parsed(v)
			if (keyed != null && !holds(keyed!, item)) {
				if (matched) {
					return p
				}
				continue
			}
			matched = true
			if (total > 1 && segmentOf(k.slice(prefix.length, k.length), d, x) % total != segment) {
				continue
			}
			p.scanned++
			p.bytes += sizeOf(item)
			if (filter == null || holds(filter!, item)) {
				p.items.push(item)
			}
			if (limit != null && p.scanned == limit! || p.bytes >= pageBytes) {
				p.last = project(item, keyNames(d, x).map(n => [{ ...new Step(), name: n }]))
				return p
			}
		}
		if (chunk.length < 100) {
			return p
		}
		after = chunk[chunk.length - 1][0]
	}
}

/// The segment of an entry, of the hash of its partition key.
function segmentOf(k: string, d: Definition, x: Index | null): i32 {
	let h: u32 = 2166136261
	const n = partitionLength(k, (if (x == null) d.hash else x!.hash).type == "N")
	for (let i = 0; i < n; i++) {
		h = (h ^ (k[i] as u32)) * 16777619
	}
	return (h % 1000003) as i32
}

function partitionLength(k: string, numeric: bool): i32 {
	if (numeric) {
		// its sign, then for one not zero its exponent, digits and end
		if (k[0] == 2) {
			return 1
		}
		const end: u8 = if (k[0] == 1) 255 else 0
		for (let i = 2; i < k.length; i++) {
			if (k[i] == end) {
				return i + 1
			}
		}
		return k.length
	}
	for (let i = 0; i + 1 < k.length; i++) {
		if (k[i] == 0) {
			if (k[i + 1] == 1) {
				return i + 2
			}
			i++
		}
	}
	return k.length
}

function start(d: Definition, x: Index | null, key: Item | null): string | null throws Fault {
	if (key == null) {
		return null
	}
	const names = keyNames(d, x)
	const ok = key!.length == names.length && names.every(n => attribute(key!, n) != null)
		&& key!.every(e => typeOf(e[1]) != "")
	if (!ok) {
		throw validation("The provided starting key is invalid: The provided key element does not match the schema")
	}
	values(key!)
	if (x == null) {
		return items(d.name) + keyOf(d, key!)
	}
	const k = indexKeyOf(d, x!, key!)
	if (k == null) {
		throw validation("The provided starting key is invalid: The provided key element does not match the schema")
	}
	return entries(d.name, x!.name) + k!
}

/// The items of a page as Select and a projection expression ask for them; those of a local index with the rest of
/// their attributes from the table where all are asked for.
function shaped(caller: Caller, d: Definition, x: Index | null, found: Item[], select: string,
	paths: Step[][] | null): Item[] | null throws Fault {
	if (select == "COUNT") {
		return null
	}
	const db = new Tables(caller.regional())
	const out: Item[] = []
	for (const item of found) {
		let full = item
		if (x != null && !x!.global && x!.projection != "ALL" && select == "ALL_ATTRIBUTES") {
			full = db.item(d, keyOf(d, item)) ?? item
		}
		out.push(if (paths == null) full else project(full, paths!))
	}
	return out
}

function selected(select: api.Select | null, paths: Step[][] | null, x: Index | null, old: bool): string throws Fault {
	if (select == "COUNT" && paths != null) {
		const by = if (old) "AttributesToGet" else "ProjectionExpression"
		throw validation(`1 validation error detected: Cannot specify the ${by} when choosing to get only the Count`)
	}
	if (select == "SPECIFIC_ATTRIBUTES" && paths == null) {
		throw validation("1 validation error detected: Must specify the AttributesToGet or ProjectionExpression when "
			+ "choosing to get SPECIFIC_ATTRIBUTES")
	}
	if (select == "ALL_PROJECTED_ATTRIBUTES" && x == null) {
		throw validation("One or more parameter values were invalid: Select type ALL_PROJECTED_ATTRIBUTES can only be "
			+ "used when querying an index")
	}
	if (select == "ALL_ATTRIBUTES" && x != null && x!.global && x!.projection != "ALL") {
		throw validation(`One or more parameter values were invalid: Select type ALL_ATTRIBUTES is not supported for `
			+ `global secondary index ${x!.name} because its projection type is not ALL`)
	}
	if (paths != null) {
		return "SPECIFIC_ATTRIBUTES"
	}
	return select ?? (if (x == null) "ALL_ATTRIBUTES" else "ALL_PROJECTED_ATTRIBUTES")
}

function limited(limit: i32 | null) throws Fault {
	if (limit != null && limit! < 1) {
		throw new Violations(api.service.validation).fault(`${limit!}`, "limit",
			"Member must have value greater than or equal to 1")
	}
}

function indexed(d: Definition, name: string | null, consistent: bool | null): Index | null throws Fault {
	if (name == null) {
		return null
	}
	const x = d.indexes.find(i => i.name == name)
	if (x == null) {
		throw validation(`The table does not have the specified index: ${name}`)
	}
	if (x!.global && consistent == true) {
		throw validation("Consistent reads are not supported on global secondary indexes")
	}
	return x
}

function keyConditions(d: Definition, x: Index | null, n: Node, old: bool): [Node, Node | null] throws Fault {
	const hash = if (x == null) d.hash else x!.hash
	const range = if (x == null) d.range else x!.range
	const parts = if (n.kind == "and") n.args else [n]
	const found: Node[] = []
	for (const p of parts) {
		if (!["=", "<", "<=", ">", ">=", "between", "begins_with"].includes(p.kind)) {
			if (old) {
				throw invalidParameters("Attempted conditional constraint is not an indexable operation")
			}
			throw invalid("KeyConditionExpression", "Invalid operator used in KeyConditionExpression")
		}
		let args = p.args
		if (args.length == 2 && args[0].kind == "value" && args[1].kind == "path") {
			const flipped: [string, string][] = [["<", ">"], [">", "<"], ["<=", ">="], [">=", "<="], ["=", "="]]
			p.kind = flipped.find(e => e[0] == p.kind)![1]
			args = [args[1], args[0]]
			p.args = args
		}
		const named = args.filter(a => a.kind == "path")
		if (named.length > 1) {
			throw invalid("KeyConditionExpression",
				"Invalid condition in KeyConditionExpression: Multiple attribute names used in one condition")
		}
		if (named.length == 0 || args[0].kind != "path" || args.slice(1, args.length).some(a => a.kind != "value")) {
			throw invalid("KeyConditionExpression",
				"Invalid condition in KeyConditionExpression: Only attribute " + "names and values are allowed")
		}
		if (args[0].path.length > 1) {
			throw invalid("KeyConditionExpression",
				"KeyConditionExpressions cannot have conditions on nested attributes")
		}
		found.push(p)
	}
	const h = found.find(p => p.args[0].path[0].name == hash.name)
	if (h == null) {
		throw validation(`Query condition missed key schema element: ${hash.name}`)
	}
	if (h!.kind != "=") {
		throw validation("Query key condition not supported")
	}
	const rest = found.filter(p => p != h)
	if (rest.length > 1 || rest.length == 1 && (range == null || rest[0].args[0].path[0].name != range!.name)) {
		throw validation(if (range == null) "Query key condition not supported"
			else `Query condition missed key schema element: ${range!.name}`)
	}
	for (const p of found) {
		const k = if (p == h) hash else range!
		for (const a of p.args.slice(1, p.args.length)) {
			if (typeOf(a.value!) != k.type) {
				throw invalidParameters("Condition parameter type does not match schema type")
			}
			values([["", a.value!]])
		}
	}
	return [h!, rest.at(0)]
}

/// The context keys of fine-grained access to the items given: dynamodb:LeadingKeys and dynamodb:Attributes.
function keys(d: Definition, given: Item[], attributes: string[]): service.Context {
	const leading: string[] = []
	for (const i of given) {
		const v = attribute(i, d.hash.name)
		if (v != null && !leading.includes(text(v!))) {
			leading.push(text(v!))
		}
	}
	const out: service.Context = []
	if (leading.length > 0) {
		out.push(["dynamodb:LeadingKeys", leading])
	}
	if (attributes.length > 0) {
		out.push(["dynamodb:Attributes", attributes])
	}
	return out
}

function attributesOf(paths: Step[][] | null): string[] {
	const out: string[] = []
	for (const p of paths ?? []) {
		if (!out.includes(p[0].name)) {
			out.push(p[0].name)
		}
	}
	return out
}

function text(v: api.AttributeValue): string { return if (v instanceof api.AttributeValue$N) v.N else scalar(v) }

function scalar(v: api.AttributeValue): string {
	if (v instanceof api.AttributeValue$S) {
		return v.S
	}
	if (v instanceof api.AttributeValue$B) {
		return v.B
	}
	return ""
}

/// Puts after, or deletes the item if null, at the key k of table d, with d's indexes' entries, and appends its record
/// to d's stream, if enabled, unless it changes nothing.
function write(db: Tables, d: Definition, k: string, before: Item | null, after: Item | null) throws Fault {
	if (after != null) {
		const size = sizeOf(after!)
		if (size > 409600) {
			throw validation("Item size has exceeded the maximum allowed size")
		}
		indexTypes(d, after!)
	}
	for (const x of d.indexes) {
		const old = if (before == null) null else indexKeyOf(d, x, before!)
		const now = if (after == null) null else indexKeyOf(d, x, after!)
		if (old != null) {
			db.store.delete(entries(d.name, x.name) + old!)
			x.count--
			x.size -= sizeOf(projected(d, x, before!))
		}
		if (now != null) {
			const p = projected(d, x, after!)
			db.store.put(entries(d.name, x.name) + now!, stored(p))
			x.count++
			x.size += sizeOf(p)
		}
	}
	if (before != null) {
		d.count--
		d.size -= sizeOf(before!)
	}
	if (after != null) {
		db.store.put(items(d.name) + k, stored(after!))
		d.count++
		d.size += sizeOf(after!)
	} else {
		db.store.delete(items(d.name) + k)
	}
	db.save(d)
	if (before != null && after != null
		&& same({ ...new api.AttributeValue$M(), M: before! }, { ...new api.AttributeValue$M(), M: after! })) {
		return
	}
	if (d.stream) {
		changed(db, d, before, after)
	}
	for (const x of d.destinations.filter(x => x.status == "ACTIVE")) {
		db.outbox.push([x.arn, d.name, streamed(d, x, before, after)])
	}
}

/// The Kinesis record of the write of d that replaces before with after, as DynamoDB writes it, but for its leading
/// awsRegion member.
function streamed(d: Definition, x: Destination, before: Item | null, after: Item | null): string throws Fault {
	const t = now()
	const at = if (x.precision == "MICROSECOND") t / 1000 else t / millisecond
	const k = project(after ?? before!, keyNames(d, null).map(n => [{ ...new Step(), name: n }]))
	let dynamodb = `"ApproximateCreationDateTime":${at},"Keys":${inner(k)}`
	let size = sizeOf(k)
	if (after != null) {
		dynamodb += `,"NewImage":${inner(after!)}`
		size += sizeOf(after!)
	}
	if (before != null) {
		dynamodb += `,"OldImage":${inner(before!)}`
		size += sizeOf(before!)
	}
	const kind = if (before == null) "INSERT" else if (after == null) "REMOVE" else "MODIFY"
	return `"dynamodb":{${dynamodb},"SizeBytes":${size},"ApproximateCreationDateTimePrecision":"${x.precision}"},`
		+ `"eventID":"${uuid()}","eventName":"${kind}","userIdentity":null,"recordFormat":"application/json",`
		+ `"tableName":"${d.name}","eventSource":"aws:dynamodb"}`
}

function inner(item: Item): string {
	const s = stored(item)
	return s.slice(8, s.length - 1)
}

function changed(db: Tables, d: Definition, before: Item | null, after: Item | null) throws Fault {
	const key = streamKey(d.name, d.streamLabel)
	const s = db.streams.get(key)!
	const c = new Change()
	c.at = now()
	c.id = replace(uuid(), "-", "")
	c.kind = if (before == null) "INSERT" else if (after == null) "REMOVE" else "MODIFY"
	const k = project(after ?? before!, keyNames(d, null).map(n => [{ ...new Step(), name: n }]))
	c.keys = stored(k)
	c.size = sizeOf(k)
	if (after != null && (s.view == "NEW_IMAGE" || s.view == "NEW_AND_OLD_IMAGES")) {
		c.newImage = stored(after!)
		c.size += sizeOf(after!)
	}
	if (before != null && (s.view == "OLD_IMAGE" || s.view == "NEW_AND_OLD_IMAGES")) {
		c.oldImage = stored(before!)
		c.size += sizeOf(before!)
	}
	db.append(key, s, c)
}

function indexTypes(d: Definition, item: Item) throws Fault {
	for (const x of d.indexes) {
		for (const k of [x.hash, x.range]) {
			if (k == null) {
				continue
			}
			const v = attribute(item, k!.name)
			if (v == null) {
				continue
			}
			const t = typeName(v!)
			if (t != k!.type) {
				throw invalidParameters(`Type mismatch for Index Key ${k!.name} Expected: ${k!.type} Actual: ${t} `
					+ `IndexName: ${x.name}`)
			}
			if (t != "N" && scalar(v!) == "") {
				throw validation("One or more parameter values are not valid. A value specified for a secondary index key "
					+ `is not supported. The AttributeValue for a key attribute cannot contain an empty string value. `
					+ `IndexName: ${x.name}, IndexKey: ${k!.name}`)
			}
		}
	}
}

function backfill(db: Tables, d: Definition, x: Index) throws Fault {
	let after: string | null = null
	while (true) {
		const chunk = db.store.scan(items(d.name), after, 100)
		for (const [_, v] of chunk) {
			const item = parsed(v)
			const k = indexKeyOf(d, x, item)
			if (k != null) {
				const p = projected(d, x, item)
				db.store.put(entries(d.name, x.name) + k!, stored(p))
				x.count++
				x.size += sizeOf(p)
			}
		}
		if (chunk.length < 100) {
			return
		}
		after = chunk[chunk.length - 1][0]
	}
}

function clear(db: Tables, prefix: string) throws Fault {
	while (true) {
		const chunk = db.store.scan(prefix, null, 100)
		for (const [k, _] of chunk) {
			db.store.delete(k)
		}
		if (chunk.length < 100) {
			return
		}
	}
}

function itemKey(d: Definition, item: Item): string throws Fault {
	for (const k of [d.hash, d.range]) {
		if (k == null) {
			continue
		}
		const v = attribute(item, k!.name)
		if (v == null) {
			throw invalidParameters(`Missing the key ${k!.name} in the item`)
		}
		const t = typeName(v!)
		if (t != k!.type) {
			throw invalidParameters(`Type mismatch for key ${k!.name} expected: ${k!.type} actual: ${t}`)
		}
		emptyKey(k!, v!)
	}
	return keyOf(d, item)
}

function keyFrom(d: Definition, key: Item): string throws Fault {
	const names = keyNames(d, null)
	if (key.length != names.length) {
		throw validation("The provided key element does not match the schema")
	}
	for (const k of [d.hash, d.range]) {
		if (k == null) {
			continue
		}
		const v = attribute(key, k!.name)
		if (v == null || typeName(v!) != k!.type) {
			throw validation("The provided key element does not match the schema")
		}
		emptyKey(k!, v!)
	}
	values(key)
	return keyOf(d, key)
}

function emptyKey(k: Key, v: api.AttributeValue) throws Fault {
	if (k.type != "N" && scalar(v) == "") {
		throw validation("One or more parameter values are not valid. The AttributeValue for a key attribute cannot "
			+ `contain an empty string value. Key: ${k.name}`)
	}
}

/// Throws if a value of item is not one DynamoDB stores; writes its numbers as DynamoDB gives them back, in plain
/// notation.
function values(item: Item) throws Fault {
	for (const [_, v] of item) {
		value(v)
	}
}

function value(v: api.AttributeValue): void throws Fault {
	if (v instanceof api.AttributeValue$N) {
		v.N = format(parse(v.N))
	} else if (v instanceof api.AttributeValue$NULL) {
		if (!v.NULL) {
			throw invalidParameters("Null attribute value types must have the value of true")
		}
	} else if (v instanceof api.AttributeValue$M) {
		values(v.M)
	} else if (v instanceof api.AttributeValue$L) {
		for (const x of v.L) {
			value(x)
		}
	} else if (v instanceof api.AttributeValue$SS) {
		distinct(v.SS, "string", `[${v.SS.map(s => `"${s}"`).join(", ")}] `)
	} else if (v instanceof api.AttributeValue$BS) {
		distinct(v.BS, "binary", `[${v.BS.map(s => `"${base64(s)}"`).join(",")}]of type BS `)
	} else if (v instanceof api.AttributeValue$NS) {
		if (v.NS.length == 0) {
			throw invalidParameters("An number set  may not be empty")
		}
		const seen: api.AttributeValue[] = []
		for (let i = 0; i < v.NS.length; i++) {
			v.NS[i] = format(parse(v.NS[i]))
			const x: api.AttributeValue = { ...new api.AttributeValue$N(), N: v.NS[i] }
			for (const y of seen) {
				if (same(x, y)) {
					throw invalidParameters("Input collection contains duplicates.")
				}
			}
			seen.push(x)
		}
	}
}

function distinct(xs: string[], kind: string, shown: string) throws Fault {
	if (xs.length == 0) {
		throw invalidParameters(`An ${kind} set  may not be empty`)
	}
	for (let i = 0; i < xs.length; i++) {
		if (xs.indexOf(xs[i]) != i) {
			throw invalidParameters(`Input collection ${shown}contains duplicates.`)
		}
	}
}

function check(test: Node | null, before: Item | null,
	onFailure: api.ReturnValuesOnConditionCheckFailure | null) throws Fault {
	if (test != null && !holds(test!, before ?? [])) {
		const m = new api.ConditionalCheckFailedException()
		m.Item = if (onFailure == "ALL_OLD") before else null
		throw api.conditionalCheckFailedException("The conditional request failed", m)
	}
}

function conditional(c: Context, expression: string | null, names: [string, string][] | null, values: Item | null,
	updates: bool = false): Node | null throws Fault {
	const n = if (expression == null) null else condition(expression!, "ConditionExpression", c)
	placeholders(c, n != null || updates, names, values)
	return n
}

function placeholders(c: Context, expressions: bool, names: [string, string][] | null,
	values: Item | null) throws Fault {
	if (!expressions && values != null) {
		throw validation("ExpressionAttributeValues can only be specified when using expressions")
	}
	if (!expressions && names != null) {
		throw validation("ExpressionAttributeNames can only be specified when using expressions")
	}
	if (values != null && values!.length == 0) {
		throw validation("ExpressionAttributeValues must not be empty")
	}
	if (names != null && names!.length == 0) {
		throw validation("ExpressionAttributeNames must not be empty")
	}
	c.unused()
}

function allOldOrNone(r: api.ReturnValue | null) throws Fault {
	if (r != null && r != "ALL_OLD" && r != "NONE") {
		throw validation("ReturnValues can only be ALL_OLD or NONE")
	}
}

/// A ValidationException's message counted, as DynamoDB words those of PutItem, UpdateItem and DeleteItem's parameters.
function counted(f: Fault): Fault {
	if (f.code != "ValidationException" || startsWith(f.message, "1 validation error")
		|| startsWith(f.message, "Supplied AttributeValue")) {
		return f
	}
	return new Fault(f.status, f.code, `1 validation error detected: ${f.message}`, f.sender, f.members)
}

function nonEmpty(item: Item): Item | null { return if (item.length == 0) null else item }

function consumed(mode: api.ReturnConsumedCapacity | null, table: string, units: f64,
	read: bool): api.ConsumedCapacity | null {
	if (mode == null || mode == "NONE") {
		return null
	}
	const c = new api.ConsumedCapacity()
	c.TableName = table
	c.CapacityUnits = units
	c.ReadCapacityUnits = if (read) units else null
	c.WriteCapacityUnits = if (read) null else units
	if (mode == "INDEXES") {
		c.Table = { ...new api.Capacity(), CapacityUnits: units, ReadCapacityUnits: c.ReadCapacityUnits,
			WriteCapacityUnits: c.WriteCapacityUnits }
	}
	return c
}

/// The units of a read of bytes: one for each 4 KB begun, at least one, half as many if not consistent.
function readUnits(bytes: i64, consistent: bool): f64 {
	const n = (if (bytes == 0) 1 else (bytes + 4095) / 4096) as f64
	return if (consistent) n else n / 2.0
}

/// The units of a write that replaces before with after: one for each 1 KB begun of the larger.
function writeUnits(before: Item | null, after: Item | null): f64 {
	const a = if (before == null) 0 else sizeOf(before!)
	const b = if (after == null) 0 else sizeOf(after!)
	const n = if (a > b) a else b
	return (if (n == 0) 1 else (n + 1023) / 1024) as f64
}

function arn(caller: Caller, name: string): string {
	return `arn:aws:dynamodb:${caller.region}:${caller.account}:table/${name}`
}

/// The caller DynamoDB is when it writes Kinesis: the account itself, as DynamoDB's service-linked role is.
function account(caller: Caller, actions: string[]): Caller {
	const c = caller.internal("dynamodb.amazonaws.com", "", actions)
	c.arn = `arn:aws:iam::${caller.account}:root`
	c.userId = caller.account
	return c
}

function enabled(d: Definition, a: string): Destination throws Fault {
	for (const x of d.destinations) {
		if (x.arn == a && x.status == "ACTIVE") {
			return x
		}
	}
	throw validation(`Table ${d.name} is not streaming to ${a}`)
}

function destination(d: Definition, a: string, status: api.DestinationStatus,
	c: api.EnableKinesisStreamingConfiguration | null): api.KinesisStreamingDestinationOutput {
	const r = new api.KinesisStreamingDestinationOutput()
	r.TableName = d.name
	r.StreamArn = a
	r.DestinationStatus = status
	r.EnableKinesisStreamingConfiguration = c
	return r
}

function table(caller: Caller, name: string, index: string | null = null,
	context: (d: Definition) => service.Context throws Fault = d => []): Definition throws Fault {
	const n = if (startsWith(name, "arn:")) name.slice(lastIndexOf(name, "/") + 1, name.length) else name
	named(n, "tableName")
	const d = new Tables(caller.regional()).get(n)
	const a = arn(caller, n)
	caller.allow(if (index == null) a else `${a}/index/${index}`, null, if (d == null) [] else context(d!))
	if (d == null) {
		throw api.resourceNotFoundException(`Requested resource not found: Table: ${n} not found`)
	}
	return d!
}

function resource(caller: Caller, a: string): Definition throws Fault {
	const prefix = `arn:aws:dynamodb:${caller.region}:${caller.account}:table/`
	if (!startsWith(a, prefix) || indexOf(a, "/index/") >= 0) {
		throw validation(`Invalid TableArn: Invalid ResourceArn provided as input ${a}`)
	}
	caller.allow(a)
	const d = new Tables(caller.regional()).get(a.slice(prefix.length, a.length))
	if (d == null) {
		throw api.resourceNotFoundException(`Requested resource not found: ResourcArn: ${a} not found`)
	}
	return d!
}

function named(name: string, m: string) throws Fault {
	const v = new Violations(api.service.validation)
	if (name.length < 3) {
		v.note(name, m, "Member must have length greater than or equal to 3")
	} else if (name.length > 255) {
		v.note(name, m, "Member must have length less than or equal to 255")
	}
	if (!name.every(c => c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 46
		|| c == 45)) {
		v.note(name, m, "Member must satisfy regular expression pattern: [a-zA-Z0-9_.-]+")
	}
	v.check()
}

/// The encryption at rest spec asks of d, null to keep it: SSE-KMS under its key, alias/aws/dynamodb if none.
function encryption(caller: Caller, d: Definition, spec: api.SSESpecification | null) throws Fault {
	if (spec == null) {
		return
	}
	if (spec!.Enabled != true) {
		d.kmsKey = null
		return
	}
	if (spec!.SSEType == "AES256") {
		throw validation("One or more parameter values were invalid: SSEType AES256 is not supported")
	}
	try {
		d.kmsKey = keyArn(caller, "dynamodb", spec!.KMSMasterKeyId ?? "alias/aws/dynamodb")
	} catch (e: Fault) {
		if (e.status >= 500 || startsWith(e.code, "AccessDenied")) {
			throw e
		}
		throw validation(e.message)
	}
}

function invalidParameters(why: string): Fault {
	return validation(`One or more parameter values were invalid: ${why}`)
}

function definitions(given: api.AttributeDefinition[] | null,
	keys: api.KeySchemaElement[] | null): [string, string][] throws Fault {
	const v = new Violations(api.service.validation)
	if (given == null) {
		v.note(null, "attributeDefinitions", "Member must not be null")
	}
	if (keys == null) {
		v.note(null, "keySchema", "Member must not be null")
	}
	v.check()
	const out: [string, string][] = []
	for (const a of given!) {
		if (out.some(e => e[0] == a.AttributeName)) {
			throw invalidParameters(`Duplicate AttributeName in AttributeDefinitions: ${a.AttributeName}`)
		}
		out.push([a.AttributeName, a.AttributeType])
	}
	return out
}

function schema(keys: api.KeySchemaElement[], defined: [string, string][],
	index: string | null): [Key, Key | null] throws Fault {
	const what = if (index == null) "KeySchema" else `KeySchema of index ${index}`
	if (keys.length < 1 || keys.length > 2) {
		throw new Violations(api.service.validation).fault(null, "keySchema",
			if (keys.length < 1) "Member must have length greater than or equal to 1"
			else "Member must have length less than or equal to 2")
	}
	if (keys[0].KeyType != "HASH") {
		throw invalidParameters(`Invalid ${what}: The first KeySchemaElement is not a HASH key type`)
	}
	if (keys.length == 2 && keys[1].KeyType != "RANGE") {
		throw invalidParameters(`Invalid ${what}: The second KeySchemaElement is not a RANGE key type`)
	}
	if (keys.length == 2 && keys[0].AttributeName == keys[1].AttributeName) {
		throw invalidParameters(`Invalid ${what}: Both the Hash Key and the Range Key element in the KeySchema have `
			+ "the same name")
	}
	const out: Key[] = []
	for (const k of keys) {
		const t = defined.find(e => e[0] == k.AttributeName)
		if (t == null) {
			throw invalidParameters("Some index key attributes are not defined in AttributeDefinitions. Keys: "
				+ `[${keys.map(k => k.AttributeName).join(", ")}], AttributeDefinitions: `
				+ `[${defined.map(e => e[0]).join(", ")}]`)
		}
		out.push({ ...new Key(), name: k.AttributeName, type: t![1] })
	}
	return [out[0], out.at(1)]
}

function throughput(billing: string, given: api.ProvisionedThroughput | null,
	index: string | null): [i64, i64] throws Fault {
	if (billing == "PAY_PER_REQUEST") {
		if (given != null) {
			throw invalidParameters("Neither ReadCapacityUnits nor WriteCapacityUnits can be specified when "
				+ "BillingMode is PAY_PER_REQUEST")
		}
		return [0, 0]
	}
	if (given == null) {
		throw invalidParameters(if (index
			== null) "ReadCapacityUnits and WriteCapacityUnits must both be specified when BillingMode is PROVISIONED"
			else `ProvisionedThroughput is not specified for index: ${index}`)
	}
	for (const [n, m] of [[given!.ReadCapacityUnits, "readCapacityUnits"],
		[given!.WriteCapacityUnits, "writeCapacityUnits"]] as [i64, string][]) {
		if (n < 1) {
			throw new Violations(api.service.validation).fault(`${n}`, `provisionedThroughput.${m}`,
				"Member must have value greater than or equal to 1")
		}
	}
	return [given!.ReadCapacityUnits, given!.WriteCapacityUnits]
}

function index(d: Definition, name: string, keys: api.KeySchemaElement[], p: api.Projection,
	global: bool): Index throws Fault {
	named(name, "indexName")
	if (d.indexes.some(x => x.name == name)) {
		throw invalidParameters(`Duplicate index name: ${name}`)
	}
	const x = new Index()
	x.name = name
	x.global = global
	const [h, r] = schema(keys, d.attributes, name)
	x.hash = h
	x.range = r
	x.projection = p.ProjectionType ?? "KEYS_ONLY"
	x.nonKey = p.NonKeyAttributes ?? []
	if (x.projection == "INCLUDE" && x.nonKey.length == 0) {
		throw validation("One or more parameter values were invalid: NonKeyAttributes must not be empty when "
			+ "ProjectionType is INCLUDE")
	}
	if (x.projection != "INCLUDE" && p.NonKeyAttributes != null) {
		throw invalidParameters(`ProjectionType is ${x.projection}, but NonKeyAttributes is specified`)
	}
	d.indexes.push(x)
	return x
}

/// Sets the stream of d as s specifies it: enabled, a new stream, of a label no other of d's name has had.
function stream(db: Tables, d: Definition, s: api.StreamSpecification | null, updating: bool) throws Fault {
	if (s == null) {
		return
	}
	if (s!.StreamEnabled && s!.StreamViewType == null) {
		throw validation("One or more parameter values were invalid: StreamViewType is required when StreamEnabled is "
			+ "true")
	}
	if (updating && s!.StreamEnabled == d.stream) {
		throw validation(if (d.stream) `Table already has an enabled stream: TableName: ${d.name}`
			else `Table does not have an enabled stream: TableName: ${d.name}`)
	}
	if (d.stream) {
		close(db, d)
	}
	d.stream = s!.StreamEnabled
	if (!d.stream) {
		return
	}
	d.streamView = s!.StreamViewType!
	let t = now()
	while (db.streams.get(streamKey(d.name, stamp(t))) != null) {
		t += millisecond
	}
	d.streamLabel = stamp(t)
	const made = new Stream()
	made.table = d.name
	made.label = d.streamLabel
	made.view = d.streamView
	made.hash = d.hash
	made.range = d.range
	made.created = t
	made.shard = `shardId-${pad(t / millisecond, 20)}-${d.id.slice(0, 8)}`
	db.saveStream(streamKey(d.name, d.streamLabel), made)
}

function close(db: Tables, d: Definition) throws Fault {
	const key = streamKey(d.name, d.streamLabel)
	const s = db.streams.get(key)!
	s.enabled = false
	db.saveStream(key, s)
}

/// The label of a stream made at t, ns since 1970, to the millisecond as AWS's are: 2015-05-11T21:21:33.291.
function stamp(t: i64): string {
	const ms = t / 1000000
	const days = ms / 86400000
	let rest = ms % 86400000
	// days since 1970 to a civil date, after Howard Hinnant's algorithm
	const z = days + 719468
	const era = z / 146097
	const doe = z - era * 146097
	const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
	const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
	const mp = (5 * doy + 2) / 153
	const day = doy - (153 * mp + 2) / 5 + 1
	const month = if (mp < 10) mp + 3 else mp - 9
	const year = yoe + era * 400 + (if (month <= 2) 1 else 0)
	const h = rest / 3600000
	rest %= 3600000
	return `${year}-${pad(month, 2)}-${pad(day, 2)}T${pad(h, 2)}:${pad(rest / 60000, 2)}:${pad(rest / 1000 % 60, 2)}`
		+ `.${pad(rest % 1000, 3)}`
}

function pad(n: i64, width: i32): string {
	let s = `${n}`
	while (s.length < width) {
		s = "0" + s
	}
	return s
}

function tagged(tags: [string, string][], given: api.Tag[]): [string, string][] throws Fault {
	const out = tags.filter(t => !given.some(g => g.Key == t[0]))
	out.append(given.map(g => [g.Key, g.Value]))
	if (out.length > 50) {
		throw api.limitExceededException("The number of tags on the resource exceeds the limit of 50")
	}
	return out
}

function base64(s: string): string { return b64.encode(s) }

function describe(caller: Caller, d: Definition, status: api.TableStatus): api.TableDescription {
	const t = new api.TableDescription()
	t.TableName = d.name
	t.TableArn = arn(caller, d.name)
	t.TableId = d.id
	t.TableStatus = status
	t.CreationDateTime = d.created
	t.AttributeDefinitions = d.attributes.map(e => ({ ...new api.AttributeDefinition(), AttributeName: e[0],
		AttributeType: e[1] as api.ScalarAttributeType }))
	t.KeySchema = keySchema(d.hash, d.range)
	t.ProvisionedThroughput = provisioned(d.read, d.write)
	t.TableSizeBytes = d.size
	t.ItemCount = d.count
	t.BillingModeSummary = if (d.billing == "PAY_PER_REQUEST") ({ ...new api.BillingModeSummary(),
		BillingMode: "PAY_PER_REQUEST", LastUpdateToPayPerRequestDateTime: d.onDemandSince })
		else null
	const locals = d.indexes.filter(x => !x.global)
	const globals = d.indexes.filter(x => x.global)
	t.LocalSecondaryIndexes = if (locals.length == 0) null
		else locals.map(x => ({ ...new api.LocalSecondaryIndexDescription(), IndexName: x.name,
		KeySchema: keySchema(x.hash, x.range), Projection: projectionOf(x), IndexSizeBytes: x.size, ItemCount: x.count,
		IndexArn: `${t.TableArn!}/index/${x.name}` }))
	t.GlobalSecondaryIndexes = if (globals.length == 0) null
		else globals.map(x => ({ ...new api.GlobalSecondaryIndexDescription(), IndexName: x.name,
		KeySchema: keySchema(x.hash, x.range), Projection: projectionOf(x), IndexStatus: "ACTIVE",
		ProvisionedThroughput: provisioned(x.read, x.write), IndexSizeBytes: x.size, ItemCount: x.count,
		IndexArn: `${t.TableArn!}/index/${x.name}` }))
	if (d.stream) {
		t.StreamSpecification = { ...new api.StreamSpecification(), StreamEnabled: true,
			StreamViewType: d.streamView as api.StreamViewType }
	}
	if (d.streamLabel != "") {
		t.LatestStreamLabel = d.streamLabel
		t.LatestStreamArn = `${t.TableArn!}/stream/${d.streamLabel}`
	}
	t.TableClassSummary = if (d.tableClass == "STANDARD") null
		else ({ ...new api.TableClassSummary(), TableClass: d.tableClass as api.TableClass })
	t.DeletionProtectionEnabled = d.deletionProtection
	if (d.kmsKey != null) {
		const e = new api.SSEDescription()
		e.Status = "ENABLED"
		e.SSEType = "KMS"
		e.KMSMasterKeyArn = d.kmsKey
		t.SSEDescription = e
	}
	return t
}

/// Restorable from when recovery was enabled to five minutes ago, as AWS's are.
function backups(d: Definition): api.ContinuousBackupsDescription {
	const p = new api.PointInTimeRecoveryDescription()
	p.PointInTimeRecoveryStatus = if (d.recovery) "ENABLED" else "DISABLED"
	if (d.recovery) {
		const latest = now() - 5 * minute
		p.RecoveryPeriodInDays = d.recoveryDays
		p.EarliestRestorableDateTime = d.recoverySince
		p.LatestRestorableDateTime = if (latest > d.recoverySince) latest else d.recoverySince
	}
	return { ...new api.ContinuousBackupsDescription(), ContinuousBackupsStatus: "ENABLED",
		PointInTimeRecoveryDescription: p }
}

function keySchema(hash: Key, range: Key | null): api.KeySchemaElement[] {
	const out = [{ ...new api.KeySchemaElement(), AttributeName: hash.name, KeyType: "HASH" as api.KeyType }]
	if (range != null) {
		out.push({ ...new api.KeySchemaElement(), AttributeName: range!.name, KeyType: "RANGE" as api.KeyType })
	}
	return out
}

function provisioned(read: i64, write: i64): api.ProvisionedThroughputDescription {
	return { ...new api.ProvisionedThroughputDescription(), NumberOfDecreasesToday: 0, ReadCapacityUnits: read,
		WriteCapacityUnits: write }
}

function projectionOf(x: Index): api.Projection {
	return { ...new api.Projection(), ProjectionType: x.projection as api.ProjectionType,
		NonKeyAttributes: if (x.nonKey.length == 0) null else x.nonKey }
}
