/// The answer of h to req.
export function handle(h: EventBridge, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "ActivateEventSource": return c.serve(h.activateEventSource, ["events:ActivateEventSource"])
		case "CancelReplay": return c.serve(h.cancelReplay, ["events:CancelReplay"])
		case "CreateApiDestination": return c.serve(h.createApiDestination, ["events:CreateApiDestination"])
		case "CreateArchive": return c.serve(h.createArchive, ["events:CreateArchive", "events:TagResource"])
		case "CreateConnection": return c.serve(h.createConnection, ["events:CreateConnection"])
		case "CreateEndpoint": return c.serve(h.createEndpoint, ["events:CreateEndpoint", "iam:PassRole"])
		case "CreateEventBus": return c.serve(h.createEventBus, ["events:CreateEventBus", "events:TagResource"])
		case "CreatePartnerEventSource": return c.serve(h.createPartnerEventSource, ["events:CreatePartnerEventSource"])
		case "DeactivateEventSource": return c.serve(h.deactivateEventSource, ["events:DeactivateEventSource"])
		case "DeauthorizeConnection": return c.serve(h.deauthorizeConnection, ["events:DeauthorizeConnection"])
		case "DeleteApiDestination": return c.serve(h.deleteApiDestination, ["events:DeleteApiDestination"])
		case "DeleteArchive": return c.serve(h.deleteArchive, ["events:DeleteArchive"])
		case "DeleteConnection": return c.serve(h.deleteConnection, ["events:DeleteConnection"])
		case "DeleteEndpoint": return c.serve(h.deleteEndpoint, ["events:DeleteEndpoint"])
		case "DeleteEventBus": return c.serve(h.deleteEventBus, ["events:DeleteEventBus"])
		case "DeletePartnerEventSource": return c.serve(h.deletePartnerEventSource, ["events:DeletePartnerEventSource"])
		case "DeleteRule": return c.serve(h.deleteRule, ["events:DeleteRule"])
		case "DescribeApiDestination": return c.serve(h.describeApiDestination, ["events:DescribeApiDestination"])
		case "DescribeArchive": return c.serve(h.describeArchive, ["events:DescribeArchive"])
		case "DescribeConnection": return c.serve(h.describeConnection, ["events:DescribeConnection"])
		case "DescribeEndpoint": return c.serve(h.describeEndpoint, ["events:DescribeEndpoint"])
		case "DescribeEventBus": return c.serve(h.describeEventBus, ["events:DescribeEventBus"])
		case "DescribeEventSource": return c.serve(h.describeEventSource, ["events:DescribeEventSource"])
		case "DescribePartnerEventSource": return c.serve(h.describePartnerEventSource,
			["events:DescribePartnerEventSource"])
		case "DescribeReplay": return c.serve(h.describeReplay, ["events:DescribeReplay"])
		case "DescribeRule": return c.serve(h.describeRule, ["events:DescribeRule"])
		case "DisableRule": return c.serve(h.disableRule, ["events:DisableRule"])
		case "EnableRule": return c.serve(h.enableRule, ["events:EnableRule"])
		case "ListApiDestinations": return c.serve(h.listApiDestinations, ["events:ListApiDestinations"])
		case "ListArchives": return c.serve(h.listArchives, ["events:ListArchives"])
		case "ListConnections": return c.serve(h.listConnections, ["events:ListConnections"])
		case "ListEndpoints": return c.serve(h.listEndpoints, ["events:ListEndpoints"])
		case "ListEventBuses": return c.serve(h.listEventBuses, ["events:ListEventBuses"])
		case "ListEventSources": return c.serve(h.listEventSources, ["events:ListEventSources"])
		case "ListPartnerEventSourceAccounts": return c.serve(h.listPartnerEventSourceAccounts,
			["events:ListPartnerEventSourceAccounts"])
		case "ListPartnerEventSources": return c.serve(h.listPartnerEventSources, ["events:ListPartnerEventSources"])
		case "ListReplays": return c.serve(h.listReplays, ["events:ListReplays"])
		case "ListRuleNamesByTarget": return c.serve(h.listRuleNamesByTarget, ["events:ListRuleNamesByTarget"])
		case "ListRules": return c.serve(h.listRules, ["events:ListRules"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["events:ListTagsForResource"])
		case "ListTargetsByRule": return c.serve(h.listTargetsByRule, ["events:ListTargetsByRule"])
		case "PutEvents": return c.serve(h.putEvents, ["events:PutEvents"])
		case "PutPartnerEvents": return c.serve(h.putPartnerEvents, ["events:PutPartnerEvents"])
		case "PutPermission": return c.serve(h.putPermission, ["events:PutPermission"])
		case "PutRule": return c.serve(h.putRule, ["iam:PassRole", "events:PutRule", "events:TagResource"])
		case "PutTargets": return c.serve(h.putTargets, ["iam:PassRole", "events:PutTargets"])
		case "RemovePermission": return c.serve(h.removePermission, ["events:RemovePermission"])
		case "RemoveTargets": return c.serve(h.removeTargets, ["events:RemoveTargets"])
		case "StartReplay": return c.serve(h.startReplay, ["events:StartReplay", "events:TagResource"])
		case "TagResource": return c.serve(h.tagResource, ["events:TagResource"])
		case "TestEventPattern": return c.serve(h.testEventPattern, ["events:TestEventPattern"])
		case "UntagResource": return c.serve(h.untagResource, ["events:UntagResource"])
		case "UpdateApiDestination": return c.serve(h.updateApiDestination, ["events:UpdateApiDestination"])
		case "UpdateArchive": return c.serve(h.updateArchive, ["events:UpdateArchive"])
		case "UpdateConnection": return c.serve(h.updateConnection, ["events:UpdateConnection"])
		case "UpdateEndpoint": return c.serve(h.updateEndpoint, ["iam:PassRole", "events:UpdateEndpoint"])
		case "UpdateEventBus": return c.serve(h.updateEventBus, ["events:UpdateEventBus"])
		default: return c.unknownOperation()
	}
}
