export function accessDeniedException(message: string): Fault {
	return new Fault(400, "AccessDeniedException", message)
}

export function concurrentModificationException(message: string): Fault {
	return new Fault(400, "ConcurrentModificationException", message)
}

export function illegalStatusException(message: string): Fault {
	return new Fault(400, "IllegalStatusException", message)
}

export function internalException(message: string): Fault { return new Fault(500, "InternalException", message) }

export function invalidEventPatternException(message: string): Fault {
	return new Fault(400, "InvalidEventPatternException", message)
}

export function invalidStateException(message: string): Fault {
	return new Fault(400, "InvalidStateException", message)
}

export function limitExceededException(message: string): Fault {
	return new Fault(400, "LimitExceededException", message)
}

export function managedRuleException(message: string): Fault { return new Fault(400, "ManagedRuleException", message) }

export function operationDisabledException(message: string): Fault {
	return new Fault(400, "OperationDisabledException", message)
}

export function policyLengthExceededException(message: string): Fault {
	return new Fault(400, "PolicyLengthExceededException", message)
}

export function resourceAlreadyExistsException(message: string): Fault {
	return new Fault(400, "ResourceAlreadyExistsException", message)
}

export function resourceNotFoundException(message: string): Fault {
	return new Fault(400, "ResourceNotFoundException", message)
}

export function throttlingException(message: string): Fault { return new Fault(400, "ThrottlingException", message) }

export interface EventBridge {
	activateEventSource(caller: Caller, input: ActivateEventSourceRequest): Unit throws Fault
	cancelReplay(caller: Caller, input: CancelReplayRequest): CancelReplayResponse throws Fault
	createApiDestination(caller: Caller, input: CreateApiDestinationRequest): CreateApiDestinationResponse throws Fault
	createArchive(caller: Caller, input: CreateArchiveRequest): CreateArchiveResponse throws Fault
	createConnection(caller: Caller, input: CreateConnectionRequest): CreateConnectionResponse throws Fault
	createEndpoint(caller: Caller, input: CreateEndpointRequest): CreateEndpointResponse throws Fault
	createEventBus(caller: Caller, input: CreateEventBusRequest): CreateEventBusResponse throws Fault

	createPartnerEventSource(caller: Caller,
		input: CreatePartnerEventSourceRequest): CreatePartnerEventSourceResponse throws Fault

	deactivateEventSource(caller: Caller, input: DeactivateEventSourceRequest): Unit throws Fault

	deauthorizeConnection(caller: Caller,
		input: DeauthorizeConnectionRequest): DeauthorizeConnectionResponse throws Fault

	deleteApiDestination(caller: Caller, input: DeleteApiDestinationRequest): DeleteApiDestinationResponse throws Fault
	deleteArchive(caller: Caller, input: DeleteArchiveRequest): DeleteArchiveResponse throws Fault
	deleteConnection(caller: Caller, input: DeleteConnectionRequest): DeleteConnectionResponse throws Fault
	deleteEndpoint(caller: Caller, input: DeleteEndpointRequest): DeleteEndpointResponse throws Fault
	deleteEventBus(caller: Caller, input: DeleteEventBusRequest): Unit throws Fault
	deletePartnerEventSource(caller: Caller, input: DeletePartnerEventSourceRequest): Unit throws Fault
	deleteRule(caller: Caller, input: DeleteRuleRequest): Unit throws Fault

	describeApiDestination(caller: Caller,
		input: DescribeApiDestinationRequest): DescribeApiDestinationResponse throws Fault

	describeArchive(caller: Caller, input: DescribeArchiveRequest): DescribeArchiveResponse throws Fault
	describeConnection(caller: Caller, input: DescribeConnectionRequest): DescribeConnectionResponse throws Fault
	describeEndpoint(caller: Caller, input: DescribeEndpointRequest): DescribeEndpointResponse throws Fault
	describeEventBus(caller: Caller, input: DescribeEventBusRequest): DescribeEventBusResponse throws Fault
	describeEventSource(caller: Caller, input: DescribeEventSourceRequest): DescribeEventSourceResponse throws Fault

	describePartnerEventSource(caller: Caller,
		input: DescribePartnerEventSourceRequest): DescribePartnerEventSourceResponse throws Fault

	describeReplay(caller: Caller, input: DescribeReplayRequest): DescribeReplayResponse throws Fault
	describeRule(caller: Caller, input: DescribeRuleRequest): DescribeRuleResponse throws Fault
	disableRule(caller: Caller, input: DisableRuleRequest): Unit throws Fault
	enableRule(caller: Caller, input: EnableRuleRequest): Unit throws Fault
	listApiDestinations(caller: Caller, input: ListApiDestinationsRequest): ListApiDestinationsResponse throws Fault
	listArchives(caller: Caller, input: ListArchivesRequest): ListArchivesResponse throws Fault
	listConnections(caller: Caller, input: ListConnectionsRequest): ListConnectionsResponse throws Fault
	listEndpoints(caller: Caller, input: ListEndpointsRequest): ListEndpointsResponse throws Fault
	listEventBuses(caller: Caller, input: ListEventBusesRequest): ListEventBusesResponse throws Fault
	listEventSources(caller: Caller, input: ListEventSourcesRequest): ListEventSourcesResponse throws Fault

	listPartnerEventSourceAccounts(caller: Caller,
		input: ListPartnerEventSourceAccountsRequest): ListPartnerEventSourceAccountsResponse throws Fault

	listPartnerEventSources(caller: Caller,
		input: ListPartnerEventSourcesRequest): ListPartnerEventSourcesResponse throws Fault

	listReplays(caller: Caller, input: ListReplaysRequest): ListReplaysResponse throws Fault

	listRuleNamesByTarget(caller: Caller,
		input: ListRuleNamesByTargetRequest): ListRuleNamesByTargetResponse throws Fault

	listRules(caller: Caller, input: ListRulesRequest): ListRulesResponse throws Fault
	listTagsForResource(caller: Caller, input: ListTagsForResourceRequest): ListTagsForResourceResponse throws Fault
	listTargetsByRule(caller: Caller, input: ListTargetsByRuleRequest): ListTargetsByRuleResponse throws Fault
