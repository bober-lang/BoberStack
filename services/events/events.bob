//! Amazon EventBridge: event buses, the default one there without being made, and their resource policies; rules of
//! an event pattern or a schedule; their targets; and PutEvents, which matches each event against the rules of its bus
//! and delivers it, as its targets' Input, InputPath or InputTransformer make it, within the request, by calling the
//! SQS and SNS handlers directly: to an SQS queue, an SNS topic, or another bus of the account and region, whose rules
//! it is matched against in turn, a bus it has passed through not again. Where AWS differs:
//!
//! - Targets of any other kind (Lambda, Step Functions, CloudWatch Logs, Kinesis, API destinations, ...) are stored and
//!   listed but nothing is delivered to them.
//! - There are no timers: delivery is never retried (a target's RetryPolicy is stored only), and schedules are
//!   validated and stored but never fire. A delivery the target refuses goes to the target's dead-letter queue, as
//!   the event's input alone without AWS's error attributes, or is dropped.
//! - Archives and replays, API destinations and connections, partner event sources, endpoints, Pipes and Scheduler
//!   are not implemented.
//! - A fault in an event pattern does not say where in the pattern it is.

import { busArn, Bus, ruleArn, Rule, save, Tables, Target, within } from "./records"
import * as api from "./api"
import { list, matches, member, members, str, validate } from "./pattern"
import { Fault } from "../../core/fault"
import { result } from "../../core/protocol/json"
import * as json from "../../core/protocol/json"
import { Caller, Context, requestTags, resourceTags, Unit } from "../../core/service"
import { Table } from "../../core/state/store"
import * as snsApi from "../sns/api"
import * as sqsApi from "../sqs/api"
import { endsWith, indexOf, startsWith } from "std/algo"
import { isDigit, lbrace, lbracket } from "std/ascii"
import { bytes } from "std/crypto/random"
import * as hex from "std/encoding/hex"
import * as std from "std/encoding/json"
import { ParseError, parseInt, split } from "std/string"
import { rfc3339, second } from "std/time"
import { Decodable } from "std/types"

/// Who EventBridge is when it delivers.
const principal = "events.amazonaws.com"
/// What AWS says when a resource would pass its quota.
const exceeded = "The requested resource exceeds the maximum number allowed."

/// The service, of the operations implemented.
export class Handler {
	...api.Unimplemented

	/// The services delivered to.
	sqs: sqsApi.SQS
	sns: snsApi.SNS

	constructor(sqs: sqsApi.SQS, sns: snsApi.SNS) {
		this.sqs = sqs
		this.sns = sns
	}

	createEventBus(caller: Caller, input: api.CreateEventBusRequest): api.CreateEventBusResponse throws Fault {
		const arn = busArn(caller.region, caller.account, input.Name)
		const tags = tagged([], input.Tags ?? [])
		// TagResource is authorized only of a bus made with tags.
		caller.actions = if (tags.length == 0) ["events:CreateEventBus"]
			else ["events:CreateEventBus", "events:TagResource"]
		caller.allow(arn, null, requestTags(tags))
		if (input.EventSourceName != null) {
			throw api.resourceNotFoundException(`Event source ${input.EventSourceName} does not exist.`)
		}
		if (indexOf(input.Name, "/") >= 0) {
			throw validation("Event bus name must not contain '/'.")
		}
		const db = tables(caller)
		if (db.buses.get(input.Name) != null) {
			throw api.resourceAlreadyExistsException(`Event bus ${input.Name} already exists.`)
		}
		const b = new Bus()
		b.name = input.Name
		b.description = input.Description
		b.created = now()
		b.modified = b.created
		b.tags = tags
		save(db.buses, b.name, b)
		const r = new api.CreateEventBusResponse()
		r.EventBusArn = arn
		r.Description = b.description
		return r
	}

	deleteEventBus(caller: Caller, input: api.DeleteEventBusRequest): Unit throws Fault {
		caller.allow(busArn(caller.region, caller.account, input.Name))
		if (input.Name == "default") {
			throw validation("Cannot delete event bus default.")
		}
		const db = tables(caller)
		for (const [k, _] of all(db.rules, within(input.Name, ""))) {
			db.rules.delete(k)
		}
		for (const [k, _] of all(db.targets, within(input.Name, ""))) {
			db.targets.delete(k)
		}
		db.buses.delete(input.Name)
		return new Unit()
	}

	describeEventBus(caller: Caller, input: api.DescribeEventBusRequest): api.DescribeEventBusResponse throws Fault {
		const name = busName(caller, input.Name)
		caller.allow(busArn(caller.region, caller.account, name))
		const b = bus(tables(caller), name)
		const r = new api.DescribeEventBusResponse()
		r.Name = b.name
		r.Arn = busArn(caller.region, caller.account, b.name)
		r.Description = b.description
		r.Policy = b.policy
		r.CreationTime = b.created
		r.LastModifiedTime = b.modified
		return r
	}

	listEventBuses(caller: Caller, input: api.ListEventBusesRequest): api.ListEventBusesResponse throws Fault {
		caller.allow(busArn(caller.region, caller.account, "*"))
		const buses = all(tables(caller).buses, input.NamePrefix ?? "").map(e => e[1])
		const [page, next] = part(buses, input.NextToken, input.Limit)
		const r = new api.ListEventBusesResponse()
		r.EventBuses = page.map(b => {
			const w = new api.EventBus()
			w.Name = b.name
			w.Arn = busArn(caller.region, caller.account, b.name)
			w.Description = b.description
			w.Policy = b.policy
			w.CreationTime = b.created
			w.LastModifiedTime = b.modified
			return w
		})
		r.NextToken = next
		return r
	}

	putPermission(caller: Caller, input: api.PutPermissionRequest): Unit throws Fault {
		caller.allow(busArn(caller.region, caller.account, input.EventBusName ?? "default"))
		const db = tables(caller)
		const b = bus(db, input.EventBusName ?? "default")
		const arn = busArn(caller.region, caller.account, b.name)
		if (input.Policy != null) {
			if (members(input.Policy!).length == 0) {
				throw validation("Parameter Policy is not valid.")
			}
			b.policy = input.Policy
		} else {
			if (input.Action == null || input.Principal == null || input.StatementId == null) {
				throw validation("Parameter(s) Action, Principal and StatementId must be specified.")
			}
			const sid = input.StatementId!
			const statements = statementsOf(b.policy)
			if (statements.some(s => sidOf(s) == sid)) {
				throw api.resourceAlreadyExistsException("Statement with the provided id already exists.")
			}
			const who = if (input.Principal == "*") `"*"`
				else `{"AWS":${std.quoted(`arn:aws:iam::${input.Principal}:root`)}}`
			const c = input.Condition
			const condition = if (c == null) ""
				else `,"Condition":{${std.quoted(c.Type)}:{${std.quoted(c.Key)}:${std.quoted(c.Value)}}}`
			statements.push(`{"Sid":${std.quoted(sid)},"Effect":"Allow","Principal":${who},`
				+ `"Action":${std.quoted(input.Action!)},"Resource":${std.quoted(arn)}${condition}}`)
			b.policy = policyOf(statements)
		}
		b.modified = now()
		save(db.buses, b.name, b)
		return new Unit()
	}

	removePermission(caller: Caller, input: api.RemovePermissionRequest): Unit throws Fault {
		caller.allow(busArn(caller.region, caller.account, input.EventBusName ?? "default"))
		const db = tables(caller)
		const b = bus(db, input.EventBusName ?? "default")
		if (input.RemoveAllPermissions) {
			b.policy = null
		} else {
			if (input.StatementId == null) {
				throw validation("Parameter StatementId must be specified.")
			}
			if (b.policy == null) {
				throw api.resourceNotFoundException("EventBus does not have a policy.")
			}
			const statements = statementsOf(b.policy)
			const kept = statements.filter(s => sidOf(s) != input.StatementId)
			if (kept.length == statements.length) {
				throw api.resourceNotFoundException("Statement with the provided id does not exist.")
			}
			b.policy = if (kept.length == 0) null else policyOf(kept)
		}
		b.modified = now()
		save(db.buses, b.name, b)
		return new Unit()
	}

	putRule(caller: Caller, input: api.PutRuleRequest): api.PutRuleResponse throws Fault {
		if (input.EventPattern != null) {
			validate(input.EventPattern!)
		}
		const name = busName(caller, input.EventBusName)
		const r = new Rule()
		r.name = input.Name
		r.bus = name
		const arn = ruleArn(caller.region, caller.account, r)
		const tags = tagged([], input.Tags ?? [])
		// iam:PassRole is authorized of a role passed, which nothing here assumes; TagResource of a rule made with tags.
		caller.actions = if (tags.length == 0) ["events:PutRule"] else ["events:PutRule", "events:TagResource"]
		const context = requestTags(tags)
		if (input.EventPattern != null) {
			const source = member(input.EventPattern!, "source")
			const detailType = member(input.EventPattern!, "detail-type")
			if (source != null) {
				context.push(["events:source", texts(source!)])
			}
			if (detailType != null) {
				context.push(["events:detail-type", texts(detailType!)])
			}
		}
		caller.allow(arn, null, context)
		const db = tables(caller)
		bus(db, name)
		if (input.EventPattern == null && input.ScheduleExpression == null) {
			throw validation("Parameter(s) EventPattern or ScheduleExpression must be specified.")
		}
		if (input.ScheduleExpression != null) {
			if (name != "default") {
				throw validation("ScheduleExpression is supported only on the default event bus.")
			}
			if (!schedule(input.ScheduleExpression!)) {
				throw validation("Parameter ScheduleExpression is not valid.")
			}
		}
		const k = within(name, input.Name)
		const was = db.rules.get(k)
		// Tags are those the rule was made with: AWS ignores those of an update.
		r.tags = if (was == null) tagged([], input.Tags ?? []) else was.tags
		r.pattern = input.EventPattern
		r.schedule = input.ScheduleExpression
		r.state = input.State ?? "ENABLED"
		r.description = input.Description
		r.role = input.RoleArn
		save(db.rules, k, r)
		const out = new api.PutRuleResponse()
		out.RuleArn = arn
		return out
	}

	describeRule(caller: Caller, input: api.DescribeRuleRequest): api.DescribeRuleResponse throws Fault {
		const r = allowed(caller, input.Name, input.EventBusName)
		const w = new api.DescribeRuleResponse()
		w.Name = r.name
		w.Arn = ruleArn(caller.region, caller.account, r)
		w.EventPattern = r.pattern
		w.ScheduleExpression = r.schedule
		w.State = stateOf(r.state)
		w.Description = r.description
		w.RoleArn = r.role
		w.EventBusName = r.bus
		w.CreatedBy = caller.account
		return w
	}

	listRules(caller: Caller, input: api.ListRulesRequest): api.ListRulesResponse throws Fault {
		const name = busName(caller, input.EventBusName)
		caller.allow(rules(caller, name))
		const db = tables(caller)
		const b = bus(db, name)
		const rules = all(db.rules, within(b.name, input.NamePrefix ?? "")).map(e => e[1])
		const [page, next] = part(rules, input.NextToken, input.Limit)
		const out = new api.ListRulesResponse()
		out.Rules = page.map(r => {
			const w = new api.Rule()
			w.Name = r.name
			w.Arn = ruleArn(caller.region, caller.account, r)
			w.EventPattern = r.pattern
			w.State = stateOf(r.state)
			w.Description = r.description
			w.ScheduleExpression = r.schedule
			w.RoleArn = r.role
			w.EventBusName = r.bus
			return w
		})
		out.NextToken = next
		return out
	}

	deleteRule(caller: Caller, input: api.DeleteRuleRequest): Unit throws Fault {
		const name = busName(caller, input.EventBusName)
		const r = new Rule()
		r.name = input.Name
		r.bus = name
		caller.allow(ruleArn(caller.region, caller.account, r))
		const db = tables(caller)
		const k = within(name, input.Name)
		if (db.rules.get(k) == null) {
			return new Unit()
		}
		// Force lets only a managed rule's owner delete it, and no rule here is managed.
		if (all(db.targets, within(k, "")).length > 0) {
			throw validation("Rule can't be deleted since it has targets.")
		}
		db.rules.delete(k)
		return new Unit()
	}

	enableRule(caller: Caller, input: api.EnableRuleRequest): Unit throws Fault {
		return setState(caller, input.Name, input.EventBusName, "ENABLED")
	}

	disableRule(caller: Caller, input: api.DisableRuleRequest): Unit throws Fault {
		return setState(caller, input.Name, input.EventBusName, "DISABLED")
	}

	listRuleNamesByTarget(caller: Caller,
		input: api.ListRuleNamesByTargetRequest): api.ListRuleNamesByTargetResponse throws Fault {
		const name = busName(caller, input.EventBusName)
		caller.allow(rules(caller, name))
		const db = tables(caller)
		const b = bus(db, name)
		const names: string[] = []
		for (const [k, t] of all(db.targets, within(b.name, ""))) {
			const rule = split(k, "\x00")[1]
			if (t.arn == input.TargetArn && (names.length == 0 || names[names.length - 1] != rule)) {
				names.push(rule)
			}
		}
		const [page, next] = part(names, input.NextToken, input.Limit)
		const out = new api.ListRuleNamesByTargetResponse()
		out.RuleNames = page
		out.NextToken = next
		return out
	}

	putTargets(caller: Caller, input: api.PutTargetsRequest): api.PutTargetsResponse throws Fault {
		// iam:PassRole is authorized of a target's role, which nothing here assumes.
		caller.actions = ["events:PutTargets"]
		const r = allowed(caller, input.Rule, input.EventBusName, [["events:TargetArn", input.Targets.map(t => t.Arn)]])
		const db = tables(caller)
		const k = within(r.bus, r.name)
		const ids = all(db.targets, within(k, "")).map(e => e[1].id)
		for (const t of input.Targets) {
			checkTarget(t)
			if (!ids.some(id => id == t.Id)) {
				ids.push(t.Id)
			}
		}
		if (ids.length > 5) {
			throw api.limitExceededException(exceeded)
		}
		for (const t of input.Targets) {
			const rec = new Target()
			rec.id = t.Id
			rec.arn = t.Arn
			rec.given = result(t)
			save(db.targets, within(k, t.Id), rec)
		}
		const out = new api.PutTargetsResponse()
		out.FailedEntries = []
		return out
	}

	removeTargets(caller: Caller, input: api.RemoveTargetsRequest): api.RemoveTargetsResponse throws Fault {
		const r = allowed(caller, input.Rule, input.EventBusName)
		const db = tables(caller)
		for (const id of input.Ids) {
			db.targets.delete(within(within(r.bus, r.name), id))
		}
		const out = new api.RemoveTargetsResponse()
		out.FailedEntries = []
		return out
	}

	listTargetsByRule(caller: Caller, input: api.ListTargetsByRuleRequest): api.ListTargetsByRuleResponse throws Fault {
		const r = allowed(caller, input.Rule, input.EventBusName)
		const targets = all(tables(caller).targets, within(within(r.bus, r.name), "")).map(e => e[1])
		const [page, next] = part(targets, input.NextToken, input.Limit)
		const out = new api.ListTargetsByRuleResponse()
		out.Targets = page.map(t => given(t))
		out.NextToken = next
		return out
	}

	tagResource(caller: Caller, input: api.TagResourceRequest): api.TagResourceResponse throws Fault {
		caller.allow(input.ResourceARN)
		retag(caller, input.ResourceARN, tags => tagged(tags, input.Tags))
		return new api.TagResourceResponse()
	}

	untagResource(caller: Caller, input: api.UntagResourceRequest): api.UntagResourceResponse throws Fault {
		caller.allow(input.ResourceARN)
		retag(caller, input.ResourceARN, tags => tags.filter(t => !input.TagKeys.some(k => k == t[0])))
		return new api.UntagResourceResponse()
	}

	listTagsForResource(caller: Caller,
		input: api.ListTagsForResourceRequest): api.ListTagsForResourceResponse throws Fault {
		caller.allow(input.ResourceARN)
		let tags: [string, string][] = []
		retag(caller, input.ResourceARN, t => {
			tags = t
			return t
		})
		const out = new api.ListTagsForResourceResponse()
		out.Tags = tags.map(t => ({ ...new api.Tag(), Key: t[0], Value: t[1] }))
		return out
	}

	testEventPattern(caller: Caller, input: api.TestEventPatternRequest): api.TestEventPatternResponse throws Fault {
		validate(input.EventPattern)
		caller.allow("*")
		const fields = members(input.Event)
		for (const f of ["id", "account", "source", "time", "region", "resources", "detail-type"]) {
			if (!fields.some(e => e[0] == f)) {
				throw validation("Parameter Event is not valid.")
			}
		}
		const out = new api.TestEventPatternResponse()
		out.Result = matches(input.EventPattern, input.Event)
		return out
	}

	putEvents(caller: Caller, input: api.PutEventsRequest): api.PutEventsResponse throws Fault {
		let size = 0
		for (const e of input.Entries) {
			size += (if (e.Time == null) 0 else 14) + (e.Source ?? "").length + (e.DetailType ?? "").length
				+ (e.Detail ?? "").length
			for (const r of e.Resources ?? []) {
				size += r.length
			}
		}
		if (size > 256 * 1024) {
			throw validation("Total size of the entries in the request is over the limit.")
		}
		const db = tables(caller)
		// The request is authorized as a whole, on each bus it names, of each entry's source and detail type.
		for (const e of input.Entries) {
			let name = ""
			try {
				name = busName(caller, e.EventBusName)
			} catch (f: Fault) {
				continue
			}
			const context: Context = []
			if (e.Source != null) {
				context.push(["events:source", e.Source!])
			}
			if (e.DetailType != null) {
				context.push(["events:detail-type", e.DetailType!])
			}
			caller.allow(busArn(caller.region, caller.account, name), db.buses.get(name)?.policy ?? null, context)
		}
		const out = new api.PutEventsResponse()
		out.Entries = []
		for (const e of input.Entries) {
			const w = new api.PutEventsResultEntry()
			try {
				w.EventId = this.putEvent(caller, db, e)
			} catch (f: Fault) {
				w.ErrorCode = f.code
				w.ErrorMessage = f.message
				out.FailedEntryCount++
			}
			out.Entries!.push(w)
		}
		return out
	}

	/// The id of the event of the entry e, put on its bus and delivered; or the fault of the entry.
	private putEvent(caller: Caller, db: Tables, e: api.PutEventsRequestEntry): string throws Fault {
		if (e.Source == null) {
			throw required("Source")
		}
		if (e.DetailType == null) {
			throw required("DetailType")
		}
		if (e.Detail == null) {
			throw required("Detail")
		}
		if (e.Detail!.length == 0 || e.Detail![0] != lbrace || (members(e.Detail!).length == 0 && e.Detail != "{}")) {
			throw new Fault(400, "MalformedDetail", "Detail is malformed.")
		}
		let name = ""
		try {
			name = busName(caller, e.EventBusName)
		} catch (f: Fault) {
			throw new Fault(400, "NotFound", f.message)
		}
		const b = db.buses.get(name)
		if (b == null) {
			throw new Fault(400, "NotFound", `Event bus ${name} does not exist.`)
		}
		if (startsWith(e.Source!, "aws.")) {
			throw new Fault(400, "NotAuthorizedForSourceException", "Not authorized for the source.")
		}
		const id = uuid()
		const t = e.Time ?? now()
		const resources = (e.Resources ?? []).map(r => std.quoted(r)).join(",")
		const event = `{"version":"0","id":${std.quoted(id)},"detail-type":${std.quoted(e.DetailType!)},`
			+ `"source":${std.quoted(e.Source!)},"account":${std.quoted(caller.account)},`
			+ `"time":${std.quoted(rfc3339(t - t % second))},"region":${std.quoted(caller.region)},`
			+ `"resources":[${resources}],"detail":${e.Detail}}`
		this.route(caller, db, name, event, [])
		return id
	}

	/// Delivers event to the targets of the rules of the bus named name that it matches; visited holds the buses it has
	/// passed through.
	private route(caller: Caller, db: Tables, name: string, event: string, visited: string[]) throws Fault {
		visited.push(name)
		for (const [_, r] of all(db.rules, within(name, ""))) {
			if (r.state == "DISABLED" || r.pattern == null || !matches(r.pattern!, event)) {
				continue
			}
			for (const [_, t] of all(db.targets, within(within(name, r.name), ""))) {
				this.deliver(caller, db, r, given(t), event, visited)
			}
		}
	}

	/// Delivers event, as t's input makes it, to t, a target of r; one that t refuses to t's dead-letter queue, if
	/// it has one.
	private deliver(caller: Caller, db: Tables, r: Rule, t: api.Target, event: string, visited: string[]) throws Fault {
		const source = ruleArn(caller.region, caller.account, r)
		const body = inputOf(t, event, r.name, source)
		try {
			const [service, region, account, resource] = parts(t.Arn)
			if (service == "events" && region == caller.region && account == caller.account
				&& startsWith(resource, "event-bus/")) {
				const next = resource.slice(10, resource.length)
				if (!visited.some(v => v == next) && db.buses.get(next) != null) {
					this.route(caller, db, next, event, visited)
				}
			} else {
				this.send(caller, source, t.Arn, body, t.SqsParameters?.MessageGroupId ?? null, idOf(event))
			}
		} catch (f: Fault) {
			const dlq = t.DeadLetterConfig?.Arn ?? null
			if (dlq == null) {
				return
			}
			try {
				this.send(caller, source, dlq!, body, null, idOf(event))
			} catch (g: Fault) {} // dropped, as by AWS when its dead-letter queue refuses it too
		}
	}

	/// Sends body to the queue or topic of the ARN arn, on behalf of the rule of the ARN source, in the group of a
	/// FIFO queue, deduplicated by the event's id; to anything else, nothing.
	private send(caller: Caller, source: string, arn: string, body: string, group: string | null,
		id: string) throws Fault {
		const [service, _, account, resource] = parts(arn)
		if (service == "sqs") {
			const m = new sqsApi.SendMessageRequest()
			m.QueueUrl = `${caller.endpoint}/${account}/${resource}`
			m.MessageBody = body
			if (endsWith(resource, ".fifo")) {
				m.MessageGroupId = group
				m.MessageDeduplicationId = id
			}
			this.sqs.sendMessage(caller.internal(principal, source, ["sqs:SendMessage"]), m)
		} else if (service == "sns") {
			const m = new snsApi.PublishInput()
			m.TopicArn = arn
			m.Message = body
			this.sns.publish(caller.internal(principal, source, ["sns:Publish"]), m)
		}
	}
}

/// The ARN that names every rule of the bus named name, as a listing's access denied names it.
function rules(caller: Caller, name: string): string {
	const r = new Rule()
	r.name = "*"
	r.bus = name
	return ruleArn(caller.region, caller.account, r)
}

/// The strings of the JSON array v, or of v if it is a string.
function texts(v: string): string[] {
	const out: string[] = []
	for (const x of if (v.length > 0 && v[0] == lbracket) list(v) else [v]) {
		const t = str(x)
		if (t != null) {
			out.push(t!)
		}
	}
	return out
}

/// The tables of the caller's regional tree, where the default bus is from the first request on.
function tables(caller: Caller): Tables throws Fault {
	const db = new Tables(caller.regional())
	if (db.buses.get("default") == null) {
		const b = new Bus()
		b.name = "default"
		b.created = now()
		b.modified = b.created
		save(db.buses, "default", b)
	}
	return db
}

/// The name of the bus that given names, by its name or its ARN, the default bus if null.
function busName(caller: Caller, given: string | null): string throws Fault {
	const g = given ?? "default"
	if (!startsWith(g, "arn:")) {
		return g
	}
	const prefix = busArn(caller.region, caller.account, "")
	if (!startsWith(g, prefix)) {
		throw api.resourceNotFoundException(`Event bus ${g} does not exist.`)
	}
	return g.slice(prefix.length, g.length)
}

/// The bus named name of db.
function bus(db: Tables, name: string): Bus throws Fault {
	const b = db.buses.get(name)
	if (b == null) {
		throw api.resourceNotFoundException(`Event bus ${name} does not exist.`)
	}
	return b
}

/// The rule named name of the bus that busName takes from given, which caller is allowed to act on.
function allowed(caller: Caller, name: string, given: string | null, context: Context = []): Rule throws Fault {
	const b = busName(caller, given)
	const r = new Rule()
	r.name = name
	r.bus = b
	const db = tables(caller)
	const found = db.rules.get(within(b, name))
	const keys = resourceTags(found?.tags ?? [])
	keys.append(context)
	caller.allow(ruleArn(caller.region, caller.account, r), null, keys)
	bus(db, b)
	if (found == null) {
		throw api.resourceNotFoundException(`Rule ${name} does not exist on EventBus ${b}.`)
	}
	return found
}

/// Sets the state of the rule named name of the bus given names.
function setState(caller: Caller, name: string, given: string | null, state: string): Unit throws Fault {
	const r = allowed(caller, name, given)
	r.state = state
	save(tables(caller).rules, within(r.bus, r.name), r)
	return new Unit()
}

/// The state s of a rule as the wire has it.
function stateOf(s: string): api.RuleState {
	switch (s) {
		case "DISABLED": return "DISABLED"
		case "ENABLED_WITH_ALL_CLOUDTRAIL_MANAGEMENT_EVENTS": return "ENABLED_WITH_ALL_CLOUDTRAIL_MANAGEMENT_EVENTS"
		default: return "ENABLED"
	}
}

/// Whether s is a schedule expression: rate(n unit), n a positive whole number and unit minute, hour or day, plural
/// unless n is 1; or cron of six fields.
function schedule(s: string): bool {
	if (startsWith(s, "cron(") && endsWith(s, ")")) {
		return split(s.slice(5, s.length - 1), " ").filter(f => f != "").length == 6
	}
	if (!startsWith(s, "rate(") || !endsWith(s, ")")) {
		return false
	}
	const words = split(s.slice(5, s.length - 1), " ")
	if (words.length != 2 || words[0].length == 0 || words[0].length > 9 || !words[0].every(isDigit)) {
		return false
	}
	let n = 0
	try {
		n = parseInt(words[0])
	} catch (e: ParseError) {
		return false
	}
	const unit = if (n == 1) words[1] else if (endsWith(words[1], "s")) words[1].slice(0, words[1].length - 1) else ""
	return n > 0 && (unit == "minute" || unit == "hour" || unit == "day")
}

/// Throws unless t is a target that can be stored: an ARN, at most one of its input's three forms, and a group for a
/// FIFO queue.
function checkTarget(t: api.Target) throws Fault {
	if (!startsWith(t.Arn, "arn:") || split(t.Arn, ":").length < 6) {
		throw validation("Provided Arn is not in correct format.")
	}
	const forms: i32 = (if (t.Input == null) 0 else 1) + (if (t.InputPath == null) 0 else 1)
		+ (if (t.InputTransformer == null) 0 else 1)
	if (forms > 1) {
		throw validation(`Only one of Input, InputPath, or InputTransformer must be provided for target ${t.Id}.`)
	}
	if (t.Input != null && t.Input!.length > 0 && list(`[${t.Input}]`).length != 1) {
		throw validation(`Input for target ${t.Id} is not valid JSON.`)
	}
	const [service, _, __, resource] = parts(t.Arn)
	if (service == "sqs" && endsWith(resource, ".fifo") && t.SqsParameters?.MessageGroupId == null) {
		throw validation(`Parameter(s) SqsParameters must be specified for target: ${t.Id}.`)
	}
}

/// The service, region, account and resource of the ARN a.
function parts(a: string): [string, string, string, string] {
	const p = split(a, ":")
	if (p.length < 6) {
		return ["", "", "", ""]
	}
	return [p[2], p[3], p[4], p.slice(5, p.length).join(":")]
}

/// The target as PutTargets took it.
function given(t: Target): api.Target {
	try {
		return json.decode[api.Target](t.given, api.validation)
	} catch (f: Fault) {
		return new api.Target() // stored as it decoded
	}
}

/// What a target of the rule named rule, of the ARN arn, is sent of event: its Input, the part of event its
/// InputPath selects, event as its InputTransformer rewrites it, or the whole of event.
export function inputOf(t: api.Target, event: string, rule: string, arn: string): string {
	if (t.Input != null) {
		return t.Input!
	}
	if (t.InputPath != null) {
		return pick(event, t.InputPath!) ?? ""
	}
	const x = t.InputTransformer
	if (x == null) {
		return event
	}
	const values: [string, string | null][] = [["aws.events.rule-arn", std.quoted(arn)],
		["aws.events.rule-name", std.quoted(rule)], ["aws.events.event", event], ["aws.events.event.json", event],
		["aws.events.event.ingestion-time", std.quoted(rfc3339(now() - now() % second))]]
	for (const [k, p] of x.InputPathsMap ?? []) {
		values.push([k, pick(event, p)])
	}
	return render(x.InputTemplate, values)
}

/// template with each <name> of values replaced by its value, JSON or null if the path found none: within a string,
/// the text of a string, else its JSON, escaped; outside one, the JSON, null if none.
function render(template: string, values: [string, string | null][]): string {
	let out = ""
	let quoted = false
	let i = 0
	while (i < template.length) {
		const c = template.slice(i, i + 1)
		const close = if (c == "<") indexOf(template, ">", i) else -1
		const found = if (close < 0) null else values.find(v => v[0] == template.slice(i + 1, close))
		if (found == null) {
			if (c == "\"") {
				quoted = !quoted
			} else if (c == "\\" && i + 1 < template.length) {
				out += c
				i++
				out += template.slice(i, i + 1)
				i++
				continue
			}
			out += c
			i++
			continue
		}
		const v = found[1]
		if (!quoted) {
			out += v ?? "null"
		} else {
			const s = if (v == null) "" else str(v!) ?? v!
			const q = std.quoted(s)
			out += q.slice(1, q.length - 1)
		}
		i = close + 1
	}
	return out
}

/// The JSON at the path p, as $.detail.items[0].sku, of the JSON v; null if there is none.
export function pick(v: string, p: string): string | null {
	if (!startsWith(p, "$")) {
		return null
	}
	let at: string | null = v
	for (const step of split(p.slice(1, p.length), ".")) {
		if (step == "" || at == null) {
			continue
		}
		const bracket = indexOf(step, "[")
		const key = if (bracket < 0) step else step.slice(0, bracket)
		if (key != "") {
			at = member(at!, key)
		}
		let rest = if (bracket < 0) "" else step.slice(bracket, step.length)
		while (at != null && startsWith(rest, "[")) {
			const end = indexOf(rest, "]")
			let n = -1
			try {
				n = parseInt(rest.slice(1, end))
			} catch (e: ParseError) {}
			const items = list(at!)
			at = if (n >= 0 && n < items.length) items[n] else null
			rest = rest.slice(end + 1, rest.length)
		}
	}
	return at
}

/// The id of the event, the JSON of one.
function idOf(event: string): string { return str(member(event, "id") ?? "") ?? "" }

/// The statements of the policy p, none if null.
function statementsOf(p: string | null): string[] {
	if (p == null) {
		return []
	}
	const s = member(p!, "Statement")
	return if (s == null) [] else if (s.length > 0 && s[0] == lbracket) list(s) else [s]
}

/// The Sid of the statement s, "" if none.
function sidOf(s: string): string { return str(member(s, "Sid") ?? "") ?? "" }

/// The policy of statements.
function policyOf(statements: string[]): string {
	return `{"Version":"2012-10-17","Statement":[${statements.join(",")}]}`
}

/// Changes the tags of the bus or rule of the ARN a by edit.
function retag(caller: Caller, a: string, edit: (tags: [string, string][]) => [string, string][]) throws Fault {
	const db = tables(caller)
	const prefix = `arn:aws:events:${caller.region}:${caller.account}:`
	const resource = if (startsWith(a, prefix)) a.slice(prefix.length, a.length) else ""
	if (startsWith(resource, "event-bus/")) {
		const b = bus(db, resource.slice(10, resource.length))
		b.tags = edit(b.tags)
		save(db.buses, b.name, b)
		return
	}
	if (!startsWith(resource, "rule/")) {
		throw validation(`Parameter ResourceARN is not valid.`)
	}
	const path = split(resource.slice(5, resource.length), "/")
	const name = path[path.length - 1]
	const b = if (path.length == 1) "default" else path.slice(0, path.length - 1).join("/")
	bus(db, b)
	const r = db.rules.get(within(b, name))
	if (r == null) {
		throw api.resourceNotFoundException(`Rule ${name} does not exist on EventBus ${b}.`)
	}
	r.tags = edit(r.tags)
	save(db.rules, within(b, name), r)
}

/// tags with given set over them by key.
function tagged(tags: [string, string][], given: api.Tag[]): [string, string][] {
	const out = tags.filter(t => !given.some(g => g.Key == t[0]))
	out.append(given.map(g => [g.Key, g.Value]))
	return out
}

/// All the records of t whose keys start with prefix, with their keys.
function all[V extends Decodable](t: Table[V], prefix: string): [string, V][] {
	return t.scan(null, 2147483647, prefix)
}

/// A page of items: up to limit (100 if null) from the one that token, the index of the first, names; and the token
/// of the next page, null after the last.
function part[T](items: T[], token: string | null, limit: i32 | null): [T[], string | null] throws Fault {
	let from = 0
	try {
		from = if (token == null) 0 else parseInt(token!)
	} catch (e: ParseError) {
		throw validation("The NextToken is not valid.")
	}
	if (from < 0 || from > items.length) {
		throw validation("The NextToken is not valid.")
	}
	const n = limit ?? 100
	const to = if (from + n < items.length) from + n else items.length
	return [items.slice(from, to), if (to < items.length) `${to}` else null]
}

/// The fault of a PutEvents entry that leaves out the member m.
function required(m: string): Fault {
	return new Fault(400, "InvalidArgument", `Parameter ${m} is not valid. Reason: ${m} is a required argument.`)
}

/// A ValidationException for the reason why.
function validation(why: string): Fault { return new Fault(400, api.validation.code, why) }

/// A random UUID, an event's id.
function uuid(): string throws Fault {
	let h = ""
	try {
		h = hex.encode(bytes(16))
	} catch (e: IoError) {
		throw new Fault(500, "InternalException", "No randomness for an event's id")
	}
	return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20, 32)}`
}
