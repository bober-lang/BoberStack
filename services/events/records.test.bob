import { busArn, Rule, ruleArn, within } from "./records"

test "ARNs and keys" {
	assert busArn("eu-west-1", "123456789012", "b") == "arn:aws:events:eu-west-1:123456789012:event-bus/b"
	const r = new Rule()
	r.name = "r"
	r.bus = "default"
	assert ruleArn("eu-west-1", "123456789012", r) == "arn:aws:events:eu-west-1:123456789012:rule/r"
	r.bus = "b"
	assert ruleArn("eu-west-1", "123456789012", r) == "arn:aws:events:eu-west-1:123456789012:rule/b/r"
	assert within("b", "r") == "b\x00r"
}
