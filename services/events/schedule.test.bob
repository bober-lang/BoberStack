import { next, parse } from "./schedule"
import { hour, load, parseRfc3339, rfc3339, utc, Zone } from "std/time"

function after(s: string, t: string, zone: Zone = utc, from = ""): string | null {
	const e = parse(s, true)
	assert e != null
	const at = next(e!, parseRfc3339(t), zone, if (from == "") 0 else parseRfc3339(from))
	return if (at == null) null else rfc3339(at!)
}

test "rates fire at their start and every period after" {
	assert after("rate(5 minutes)", "2026-01-01T00:00:00Z", utc, "2026-01-01T00:00:30Z") == "2026-01-01T00:00:30Z"
	assert after("rate(5 minutes)", "2026-01-01T00:00:30Z", utc, "2026-01-01T00:00:30Z") == "2026-01-01T00:05:30Z"
	assert after("rate(1 hour)", "2026-01-01T07:59:00Z", utc, "2026-01-01T00:00:00Z") == "2026-01-01T08:00:00Z"
	assert after("rate(2 days)", "2026-01-02T00:00:00Z", utc, "2026-01-01T00:00:00Z") == "2026-01-03T00:00:00Z"
}

test "crons, by the table" {
	const cases: [string, string, string | null][] = [
		["cron(0 10 * * ? *)", "2024-01-01T10:00:00Z", "2024-01-02T10:00:00Z"],
		["cron(5,35 14 * * ? *)", "2024-01-01T14:05:00Z", "2024-01-01T14:35:00Z"],
		["cron(0/15 * * * ? *)", "2024-01-01T23:50:00Z", "2024-01-02T00:00:00Z"],
		["cron(1/10 * * * ? *)", "2024-01-01T00:00:00Z", "2024-01-01T00:01:00Z"],
		["cron(1/10 * * * ? *)", "2024-01-01T00:51:00Z", "2024-01-01T01:01:00Z"],
		// Saturday night to Monday evening, by weekday names; and an hour range that wraps past midnight.
		["cron(0 18 ? * MON-FRI *)", "2026-11-21T00:00:00Z", "2026-11-23T18:00:00Z"],
		["cron(0/30 20-2 ? * mon-fri *)", "2026-11-23T02:00:00Z", "2026-11-23T02:30:00Z"],
		["cron(0/30 20-2 ? * MON-FRI *)", "2026-11-23T02:30:00Z", "2026-11-23T20:00:00Z"],
		["cron(0 8 1 * ? *)", "2024-01-01T08:00:00Z", "2024-02-01T08:00:00Z"],
		["cron(0 0 1 JAN,JUL ? *)", "2024-01-01T00:00:00Z", "2024-07-01T00:00:00Z"],
		["cron(0 0 31 * ? *)", "2024-01-31T00:00:00Z", "2024-03-31T00:00:00Z"],
		// The last day of February, in a leap year and not; and of a month of 30 days.
		["cron(0 0 L * ? *)", "2024-02-01T00:00:00Z", "2024-02-29T00:00:00Z"],
		["cron(0 0 L * ? *)", "2023-02-01T00:00:00Z", "2023-02-28T00:00:00Z"],
		["cron(0 0 L * ? *)", "2023-04-01T00:00:00Z", "2023-04-30T00:00:00Z"],
		["cron(0 0 29 2 ? *)", "2024-03-01T00:00:00Z", "2028-02-29T00:00:00Z"],
		// The weekday nearest a day: the 1st a Saturday goes to Monday the 3rd, the 15th a Sunday to the 16th, the
		// 31st a Sunday back to Friday the 29th, as does the last weekday of July 2022.
		["cron(0 0 1W * ? *)", "2021-12-15T00:00:00Z", "2022-01-03T00:00:00Z"],
		["cron(0 0 15W * ? *)", "2022-05-01T00:00:00Z", "2022-05-16T00:00:00Z"],
		["cron(0 0 31W * ? *)", "2022-07-01T00:00:00Z", "2022-07-29T00:00:00Z"],
		["cron(0 0 LW * ? *)", "2022-07-01T00:00:00Z", "2022-07-29T00:00:00Z"],
		["cron(0 0 31W * ? *)", "2022-06-01T00:00:00Z", "2022-06-30T00:00:00Z"],
		// The last Friday, the second Tuesday; L alone is Saturday, the week's last day.
		["cron(15 10 ? * 6L 2022-2023)", "2022-01-01T00:00:00Z", "2022-01-28T10:15:00Z"],
		["cron(15 10 ? * FRIL 2022-2023)", "2022-02-01T00:00:00Z", "2022-02-25T10:15:00Z"],
		["cron(15 10 ? * 6L 2022-2023)", "2023-12-29T10:15:00Z", null],
		["cron(0 12 ? * 3#2 *)", "2026-11-01T00:00:00Z", "2026-11-10T12:00:00Z"],
		["cron(0 12 ? * TUE#5 *)", "2026-11-01T00:00:00Z", "2026-12-29T12:00:00Z"],
		["cron(0 0 ? * L *)", "2026-11-23T00:00:00Z", "2026-11-28T00:00:00Z"],
		["cron(0 0 ? * 1 *)", "2026-11-23T00:00:00Z", "2026-11-29T00:00:00Z"],
		// Years run from 1970 to 2199.
		["cron(0 0 1 1 ? 2199)", "2026-01-01T00:00:00Z", "2199-01-01T00:00:00Z"],
		["cron(0 0 1 1 ? 2199)", "2199-01-01T00:00:00Z", null],
		["cron(0 0 1 1 ? 2020-2025/5)", "2020-01-01T00:00:00Z", "2025-01-01T00:00:00Z"],
		["cron(0 0 1 1 ? *)", "1960-06-01T00:00:00Z", "1970-01-01T00:00:00Z"]
	]
	for (const [e, t, want] of cases) {
		test `${e} after ${t}` {
			assert after(e, t) == want
		}
	}
}

test "expressions that are none" {
	const bad = ["rate(5 minute)", "rate(0 minutes)", "rate(5 weeks)", "rate(-1 days)", "rate(5)", "cron(0 10 * * * *)",
		"cron(0 10 ? * ? *)", "cron(0 10 * * ?)", "cron(60 10 * * ? *)", "cron(0 24 * * ? *)", "cron(0 0 32 * ? *)",
		"cron(0 0 1 13 ? *)", "cron(0 0 ? * 8 *)", "cron(0 0 ? * 3#1,6#3 *)", "cron(0 0 1 1 ? 1969)",
		"cron(0 0 1 1 ? 2200)", "cron(0 0 1 1 ? 2023-2022)", "cron(0 0 ? * 3#6 *)", "cron(0 0 1 FOO ? *)",
		"cron(0/0 * * * ? *)", "at(2030-01-01T00:00)", "at(2030-02-30T00:00:00)", "daily"]
	for (const s of bad) {
		test `${s}` {
			assert parse(s, true) == null
		}
	}
	assert parse("at(2030-01-01T00:00:00)") == null && parse("at(2030-01-01T00:00:00)", true) != null
	assert parse("rate(1 hours)") == null && parse("rate(1 hours)", true)!.every == hour
}

test "a time zone's changes: a reading skipped does not fire, one read twice fires at the later" {
	const ny = load("America/New_York")
	// 2:30 is skipped on 2026-03-08, which springs forward from 2:00 to 3:00.
	assert after("cron(30 2 * * ? *)", "2026-03-07T08:00:00Z", ny) == "2026-03-09T06:30:00Z"
	assert after("cron(30 2 * * ? *)", "2026-03-06T08:00:00Z", ny) == "2026-03-07T07:30:00Z"
	// 1:30 is read twice on 2026-11-01, at 5:30 and at 6:30 UTC.
	assert after("cron(30 1 * * ? *)", "2026-10-31T12:00:00Z", ny) == "2026-11-01T06:30:00Z"
	assert after("cron(30 1 * * ? *)", "2026-11-01T06:30:00Z", ny) == "2026-11-02T06:30:00Z"
	assert after("cron(0 9 * * ? *)", "2026-11-01T00:00:00Z", ny) == "2026-11-01T14:00:00Z"
	assert after("at(2030-01-01T00:00:00)", "2026-01-01T00:00:00Z", ny) == "2030-01-01T05:00:00Z"
	assert after("at(2030-07-01T00:00:00)", "2026-01-01T00:00:00Z", ny) == "2030-07-01T04:00:00Z"
	assert after("at(2030-01-01T00:00:00)", "2030-01-01T05:00:00Z", ny) == null
	// A rate is of durations: 24 hours across a change of the clock.
	assert after("rate(1 day)", "2026-03-08T04:00:00Z", ny, "2026-03-07T05:00:00Z") == "2026-03-08T05:00:00Z"
}
