		throw notImplemented("UpdateDestination")
	}
}

/// The answer of h to req.
export function handle(h: Firehose, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "CreateDeliveryStream": return c.serve(h.createDeliveryStream,
			["firehose:CreateDeliveryStream", "iam:PassRole", "firehose:TagDeliveryStream"])
		case "DeleteDeliveryStream": return c.serve(h.deleteDeliveryStream, ["firehose:DeleteDeliveryStream"])
		case "DescribeDeliveryStream": return c.serve(h.describeDeliveryStream, ["firehose:DescribeDeliveryStream"])
		case "ListDeliveryStreams": return c.serve(h.listDeliveryStreams, ["firehose:ListDeliveryStreams"])
		case "ListTagsForDeliveryStream": return c.serve(h.listTagsForDeliveryStream,
			["firehose:ListTagsForDeliveryStream"])
		case "PutRecord": return c.serve(h.putRecord, ["firehose:PutRecord"])
		case "PutRecordBatch": return c.serve(h.putRecordBatch, ["firehose:PutRecordBatch"])
		case "StartDeliveryStreamEncryption": return c.serve(h.startDeliveryStreamEncryption,
			["firehose:StartDeliveryStreamEncryption"])
		case "StopDeliveryStreamEncryption": return c.serve(h.stopDeliveryStreamEncryption,
			["firehose:StopDeliveryStreamEncryption"])
		case "TagDeliveryStream": return c.serve(h.tagDeliveryStream, ["firehose:TagDeliveryStream"])
		case "UntagDeliveryStream": return c.serve(h.untagDeliveryStream, ["firehose:UntagDeliveryStream"])
		case "UpdateDestination": return c.serve(h.updateDestination, ["iam:PassRole", "firehose:UpdateDestination"])
		default: return c.unknownOperation()
	}
}
