export function concurrentModificationException(message: string): Fault {
	return new Fault(400, "ConcurrentModificationException", message)
}

export function invalidArgumentException(message: string): Fault {
	return new Fault(400, "InvalidArgumentException", message)
}

/// The members of InvalidKMSResourceException besides its message.
export class InvalidKMSResourceException {
	code: string | null
}

export function invalidKMSResourceException(message: string,
	members: InvalidKMSResourceException = new InvalidKMSResourceException()): Fault {
	return new Fault(400, "InvalidKMSResourceException", message, true, json.members(members))
}

/// The members of InvalidSourceException besides its message.
export class InvalidSourceException {
	code: string | null
}

export function invalidSourceException(message: string,
	members: InvalidSourceException = new InvalidSourceException()): Fault {
	return new Fault(400, "InvalidSourceException", message, true, json.members(members))
}

export function limitExceededException(message: string): Fault {
	return new Fault(400, "LimitExceededException", message)
}

export function resourceInUseException(message: string): Fault {
	return new Fault(400, "ResourceInUseException", message)
}

export function resourceNotFoundException(message: string): Fault {
	return new Fault(400, "ResourceNotFoundException", message)
}

export function serviceUnavailableException(message: string): Fault {
	return new Fault(503, "ServiceUnavailableException", message)
}

export interface Firehose {
	createDeliveryStream(caller: Caller, input: CreateDeliveryStreamInput): CreateDeliveryStreamOutput throws Fault
	deleteDeliveryStream(caller: Caller, input: DeleteDeliveryStreamInput): DeleteDeliveryStreamOutput throws Fault

	describeDeliveryStream(caller: Caller,
		input: DescribeDeliveryStreamInput): DescribeDeliveryStreamOutput throws Fault

	listDeliveryStreams(caller: Caller, input: ListDeliveryStreamsInput): ListDeliveryStreamsOutput throws Fault

	listTagsForDeliveryStream(caller: Caller,
		input: ListTagsForDeliveryStreamInput): ListTagsForDeliveryStreamOutput throws Fault

	putRecord(caller: Caller, input: PutRecordInput): PutRecordOutput throws Fault
	putRecordBatch(caller: Caller, input: PutRecordBatchInput): PutRecordBatchOutput throws Fault

	startDeliveryStreamEncryption(caller: Caller,
		input: StartDeliveryStreamEncryptionInput): StartDeliveryStreamEncryptionOutput throws Fault

	stopDeliveryStreamEncryption(caller: Caller,
		input: StopDeliveryStreamEncryptionInput): StopDeliveryStreamEncryptionOutput throws Fault

	tagDeliveryStream(caller: Caller, input: TagDeliveryStreamInput): TagDeliveryStreamOutput throws Fault
	untagDeliveryStream(caller: Caller, input: UntagDeliveryStreamInput): UntagDeliveryStreamOutput throws Fault
	updateDestination(caller: Caller, input: UpdateDestinationInput): UpdateDestinationOutput throws Fault
}

/// Every operation, not implemented: a service mixes it in and declares those it implements.
export class Unimplemented {
	createDeliveryStream(caller: Caller, input: CreateDeliveryStreamInput): CreateDeliveryStreamOutput throws Fault {
		throw notImplemented("CreateDeliveryStream")
	}

	deleteDeliveryStream(caller: Caller, input: DeleteDeliveryStreamInput): DeleteDeliveryStreamOutput throws Fault {
		throw notImplemented("DeleteDeliveryStream")
	}

	describeDeliveryStream(caller: Caller,
		input: DescribeDeliveryStreamInput): DescribeDeliveryStreamOutput throws Fault {
		throw notImplemented("DescribeDeliveryStream")
	}

	listDeliveryStreams(caller: Caller, input: ListDeliveryStreamsInput): ListDeliveryStreamsOutput throws Fault {
		throw notImplemented("ListDeliveryStreams")
	}

	listTagsForDeliveryStream(caller: Caller,
		input: ListTagsForDeliveryStreamInput): ListTagsForDeliveryStreamOutput throws Fault {
		throw notImplemented("ListTagsForDeliveryStream")
	}

	putRecord(caller: Caller, input: PutRecordInput): PutRecordOutput throws Fault { throw notImplemented("PutRecord") }

	putRecordBatch(caller: Caller, input: PutRecordBatchInput): PutRecordBatchOutput throws Fault {
		throw notImplemented("PutRecordBatch")
	}

	startDeliveryStreamEncryption(caller: Caller,
		input: StartDeliveryStreamEncryptionInput): StartDeliveryStreamEncryptionOutput throws Fault {
