//! The destinations other than S3, and the sources other than DirectPut and Kinesis, which a delivery stream stores as
//! the JSON of their configuration and describes by it, as AWS shapes it: the S3 configuration within as an S3
//! destination's description, a VPC's with its id, and secrets left out.

import { Fault } from "../../core/fault"
import * as protocol from "../../core/protocol/json"
import * as api from "./api"
import { quoted } from "std/encoding/json"

/// The kinds of destination a CreateDeliveryStream gives besides S3, each with its configuration's JSON.
export function configured(input: api.CreateDeliveryStreamInput): [string, string][] {
	const out: [string, string][] = []
	if (input.RedshiftDestinationConfiguration != null) {
		out.push(["Redshift", protocol.put(input.RedshiftDestinationConfiguration!, [])])
	}
	if (input.ElasticsearchDestinationConfiguration != null) {
		out.push(["Elasticsearch", protocol.put(input.ElasticsearchDestinationConfiguration!, [])])
	}
	if (input.AmazonopensearchserviceDestinationConfiguration != null) {
		out.push(["Amazonopensearchservice", protocol.put(input.AmazonopensearchserviceDestinationConfiguration!, [])])
	}
	if (input.SplunkDestinationConfiguration != null) {
		out.push(["Splunk", protocol.put(input.SplunkDestinationConfiguration!, [])])
	}
	if (input.HttpEndpointDestinationConfiguration != null) {
		out.push(["HttpEndpoint", protocol.put(input.HttpEndpointDestinationConfiguration!, [])])
	}
	if (input.AmazonOpenSearchServerlessDestinationConfiguration != null) {
		out.push(["AmazonOpenSearchServerless",
			protocol.put(input.AmazonOpenSearchServerlessDestinationConfiguration!, [])])
	}
	if (input.SnowflakeDestinationConfiguration != null) {
		out.push(["Snowflake", protocol.put(input.SnowflakeDestinationConfiguration!, [])])
	}
	if (input.IcebergDestinationConfiguration != null) {
		out.push(["Iceberg", protocol.put(input.IcebergDestinationConfiguration!, [])])
	}
	return out
}

/// The kind of destination an UpdateDestination changes besides S3, with the JSON of its update as a configuration
/// names its members; null if none.
export function updated(input: api.UpdateDestinationInput): [string, string] | null {
	let kind = ""
	let json = ""
	if (input.RedshiftDestinationUpdate != null) {
		kind = "Redshift"
		json = protocol.put(input.RedshiftDestinationUpdate!, [])
	} else if (input.ElasticsearchDestinationUpdate != null) {
		kind = "Elasticsearch"
		json = protocol.put(input.ElasticsearchDestinationUpdate!, [])
	} else if (input.AmazonopensearchserviceDestinationUpdate != null) {
		kind = "Amazonopensearchservice"
		json = protocol.put(input.AmazonopensearchserviceDestinationUpdate!, [])
	} else if (input.SplunkDestinationUpdate != null) {
		kind = "Splunk"
		json = protocol.put(input.SplunkDestinationUpdate!, [])
	} else if (input.HttpEndpointDestinationUpdate != null) {
		kind = "HttpEndpoint"
		json = protocol.put(input.HttpEndpointDestinationUpdate!, [])
	} else if (input.AmazonOpenSearchServerlessDestinationUpdate != null) {
		kind = "AmazonOpenSearchServerless"
		json = protocol.put(input.AmazonOpenSearchServerlessDestinationUpdate!, [])
	} else if (input.SnowflakeDestinationUpdate != null) {
		kind = "Snowflake"
		json = protocol.put(input.SnowflakeDestinationUpdate!, [])
	} else if (input.IcebergDestinationUpdate != null) {
		kind = "Iceberg"
		json = protocol.put(input.IcebergDestinationUpdate!, [])
	} else {
		return null
	}
	return [kind, json]
}

/// The configuration's JSON config changed by the update's JSON given: its members replacing config's, those of its
/// S3 updates merged into config's S3 configurations; of a destination of another kind, as given alone.
export function merged(config: string, given: string, same: bool): string throws Fault {
	const out: [string, string][] = if (same) protocol.object(config, "") else []
	for (const [k0, v] of protocol.object(given, "")) {
		const k = if (k0 == "S3Update") "S3Configuration"
			else if (k0 == "S3BackupUpdate") "S3BackupConfiguration"
			else k0
		let at = -1
		for (let i = 0; i < out.length; i++) {
			if (out[i][0] == k) {
				at = i
			}
		}
		if (at < 0) {
			out.push([k, v])
		} else if (k == "S3Configuration" || k == "S3BackupConfiguration") {
			out[at] = [k, merged(out[at][1], v, true)]
		} else {
			out[at] = [k, v]
		}
	}
	return joined(out)
}

/// The description of the destination of kind, as its configuration's JSON config gives it, into r; s3 describes its
/// S3 configurations.
export function describe(r: api.DestinationDescription, kind: string, config: string,
	s3: (c: api.S3DestinationConfiguration) => api.S3DestinationDescription) throws Fault {
	const out: [string, string][] = []
	for (const [k, v] of protocol.object(config, "")) {
		if (k == "S3Configuration" || k == "S3BackupConfiguration") {
			const name = if (k == "S3Configuration") "S3DestinationDescription" else "S3BackupDescription"
			out.push([name, protocol.put(s3(protocol.decode[api.S3DestinationConfiguration](v)), [])])
		} else if (k == "VpcConfiguration") {
			const members = protocol.object(v, "")
			members.push(["VpcId", quoted("")])
			out.push(["VpcConfigurationDescription", joined(members)])
		} else if (k != "Password" && k != "PrivateKey" && k != "KeyPassphrase") {
			out.push([k, v])
		}
	}
	const json = joined(out)
	switch (kind) {
		case "Redshift": r.RedshiftDestinationDescription = protocol.decode[api.RedshiftDestinationDescription](json)
		case "Elasticsearch": r.ElasticsearchDestinationDescription = protocol.decode[api.ElasticsearchDestinationDescription](json)
		case "Amazonopensearchservice": r.AmazonopensearchserviceDestinationDescription = protocol.decode[api.AmazonopensearchserviceDestinationDescription](json)
		case "Splunk": r.SplunkDestinationDescription = protocol.decode[api.SplunkDestinationDescription](json)
		case "HttpEndpoint": r.HttpEndpointDestinationDescription = protocol.decode[api.HttpEndpointDestinationDescription](json)
		case "AmazonOpenSearchServerless": r.AmazonOpenSearchServerlessDestinationDescription = protocol.decode[api.AmazonOpenSearchServerlessDestinationDescription](json)
		case "Snowflake": r.SnowflakeDestinationDescription = protocol.decode[api.SnowflakeDestinationDescription](json)
		default: r.IcebergDestinationDescription = protocol.decode[api.IcebergDestinationDescription](json)
	}
}

/// The source of kind MSKAsSource or DatabaseAsSource that its configuration's JSON config describes, delivering
/// from the time started.
export function source(kind: string, config: string, started: i64): api.SourceDescription throws Fault {
	const r = new api.SourceDescription()
	if (kind == "MSKAsSource") {
		const m = protocol.decode[api.MSKSourceDescription](config)
		m.DeliveryStartTimestamp = started
		r.MSKSourceDescription = m
	} else {
		r.DatabaseSourceDescription = protocol.decode[api.DatabaseSourceDescription](config)
	}
	return r
}

/// The string member name of the JSON object json, null if it has none.
export function member(json: string, name: string): string | null throws Fault {
	for (const [k, v] of protocol.object(json, "")) {
		if (k == name) {
			return protocol.decode[string](v)
		}
	}
	return null
}

/// The JSON object of members, each a key and its value's JSON.
function joined(members: [string, string][]): string {
	return `{${members.map(m => `${quoted(m[0])}:${m[1]}`).join(",")}}`
}
