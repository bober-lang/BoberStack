export function accountNotManagementOrDelegatedAdministratorException(message: string): Fault {
	return new Fault(400, "AccountNotManagementOrDelegatedAdministratorException", message)
}

export function callerIsNotManagementAccountException(message: string): Fault {
	return new Fault(400, "CallerIsNotManagementAccountException", message)
}

export function concurrentModificationException(message: string): Fault {
	return new Fault(409, "ConcurrentModification", message)
}

export function credentialReportExpiredException(message: string): Fault {
	return new Fault(410, "ReportExpired", message)
}

export function credentialReportNotPresentException(message: string): Fault {
	return new Fault(410, "ReportNotPresent", message)
}

export function credentialReportNotReadyException(message: string): Fault {
	return new Fault(404, "ReportInProgress", message)
}

export function deleteConflictException(message: string): Fault { return new Fault(409, "DeleteConflict", message) }

export function duplicateCertificateException(message: string): Fault {
	return new Fault(409, "DuplicateCertificate", message)
}

export function duplicateSSHPublicKeyException(message: string): Fault {
	return new Fault(400, "DuplicateSSHPublicKey", message)
}

export function entityAlreadyExistsException(message: string): Fault {
	return new Fault(409, "EntityAlreadyExists", message)
}

export function entityTemporarilyUnmodifiableException(message: string): Fault {
	return new Fault(409, "EntityTemporarilyUnmodifiable", message)
}

export function featureDisabledException(message: string): Fault { return new Fault(404, "FeatureDisabled", message) }
export function featureEnabledException(message: string): Fault { return new Fault(409, "FeatureEnabled", message) }

export function invalidAuthenticationCodeException(message: string): Fault {
	return new Fault(403, "InvalidAuthenticationCode", message)
}

export function invalidCertificateException(message: string): Fault {
	return new Fault(400, "InvalidCertificate", message)
}

export function invalidInputException(message: string): Fault { return new Fault(400, "InvalidInput", message) }
export function invalidPublicKeyException(message: string): Fault { return new Fault(400, "InvalidPublicKey", message) }
export function invalidUserTypeException(message: string): Fault { return new Fault(400, "InvalidUserType", message) }
export function keyPairMismatchException(message: string): Fault { return new Fault(400, "KeyPairMismatch", message) }
export function limitExceededException(message: string): Fault { return new Fault(409, "LimitExceeded", message) }

export function malformedCertificateException(message: string): Fault {
	return new Fault(400, "MalformedCertificate", message)
}

export function malformedPolicyDocumentException(message: string): Fault {
	return new Fault(400, "MalformedPolicyDocument", message)
}

export function nameConflictException(message: string): Fault { return new Fault(409, "NameConflict", message) }
export function noSuchEntityException(message: string): Fault { return new Fault(404, "NoSuchEntity", message) }

export function openIdIdpCommunicationErrorException(message: string): Fault {
	return new Fault(400, "OpenIdIdpCommunicationError", message)
}

export function organizationNotFoundException(message: string): Fault {
	return new Fault(400, "OrganizationNotFoundException", message)
}

export function organizationNotInAllFeaturesModeException(message: string): Fault {
	return new Fault(400, "OrganizationNotInAllFeaturesModeException", message)
}

export function passwordPolicyViolationException(message: string): Fault {
	return new Fault(400, "PasswordPolicyViolation", message)
}

export function policyEvaluationException(message: string): Fault { return new Fault(500, "PolicyEvaluation", message) }

export function policyNotAttachableException(message: string): Fault {
	return new Fault(400, "PolicyNotAttachable", message)
}

export function reportGenerationLimitExceededException(message: string): Fault {
	return new Fault(409, "ReportGenerationLimitExceeded", message)
}

export function roleModifiedException(message: string): Fault { return new Fault(409, "RoleModified", message) }

export function roleTemplateDisabledException(message: string): Fault {
	return new Fault(400, "RoleTemplateDisabled", message)
}

export function serviceAccessNotEnabledException(message: string): Fault {
	return new Fault(400, "ServiceAccessNotEnabledException", message)
}

export function serviceFailureException(message: string): Fault { return new Fault(500, "ServiceFailure", message) }

export function serviceNotSupportedException(message: string): Fault {
	return new Fault(404, "NotSupportedService", message)
}

export function unmodifiableEntityException(message: string): Fault {
	return new Fault(400, "UnmodifiableEntity", message)
}

export function unrecognizedPublicKeyEncodingException(message: string): Fault {
	return new Fault(400, "UnrecognizedPublicKeyEncoding", message)
}

