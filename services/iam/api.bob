export function featureEnabledException(message: string): Fault { return new Fault(409, "FeatureEnabled", message) }

export function invalidAuthenticationCodeException(message: string): Fault {
	return new Fault(403, "InvalidAuthenticationCode", message)
}

export function invalidCertificateException(message: string): Fault {
	return new Fault(400, "InvalidCertificate", message)
}

export function invalidInputException(message: string): Fault { return new Fault(400, "InvalidInput", message) }
export function invalidPublicKeyException(message: string): Fault { return new Fault(400, "InvalidPublicKey", message) }
export function invalidUserTypeException(message: string): Fault { return new Fault(400, "InvalidUserType", message) }
export function keyPairMismatchException(message: string): Fault { return new Fault(400, "KeyPairMismatch", message) }
export function limitExceededException(message: string): Fault { return new Fault(409, "LimitExceeded", message) }

export function malformedCertificateException(message: string): Fault {
	return new Fault(400, "MalformedCertificate", message)
}

export function malformedPolicyDocumentException(message: string): Fault {
	return new Fault(400, "MalformedPolicyDocument", message)
}

export function nameConflictException(message: string): Fault { return new Fault(409, "NameConflict", message) }
