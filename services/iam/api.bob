/// The answer of h to req.
export function handle(h: IAM, caller: Caller, req: Request): Response throws IoError {
	const c = query.call(caller, req, version, ns)
	switch (c.action) {
		case "AcceptDelegationRequest": return c.serve(h.acceptDelegationRequest)
		case "AcquireRole": return c.serve(h.acquireRole)
		case "AddClientIDToOpenIDConnectProvider": return c.serve(h.addClientIDToOpenIDConnectProvider)
		case "AddRoleToInstanceProfile": return c.serve(h.addRoleToInstanceProfile)
		case "AddUserToGroup": return c.serve(h.addUserToGroup)
		case "AssociateDelegationRequest": return c.serve(h.associateDelegationRequest)
		case "AttachGroupPolicy": return c.serve(h.attachGroupPolicy)
		case "AttachRolePolicy": return c.serve(h.attachRolePolicy)
		case "AttachUserPolicy": return c.serve(h.attachUserPolicy)
		case "ChangePassword": return c.serve(h.changePassword)
		case "CreateAccessKey": return c.serve(h.createAccessKey)
		case "CreateAccountAlias": return c.serve(h.createAccountAlias)
		case "CreateDelegationRequest": return c.serve(h.createDelegationRequest)
		case "CreateGroup": return c.serve(h.createGroup)
		case "CreateInstanceProfile": return c.serve(h.createInstanceProfile)
		case "CreateLoginProfile": return c.serve(h.createLoginProfile)
		case "CreateOpenIDConnectProvider": return c.serve(h.createOpenIDConnectProvider)
		case "CreatePolicy": return c.serve(h.createPolicy)
		case "CreatePolicyVersion": return c.serve(h.createPolicyVersion)
		case "CreateRole": return c.serve(h.createRole)
		case "CreateSAMLProvider": return c.serve(h.createSAMLProvider)
		case "CreateServiceLinkedRole": return c.serve(h.createServiceLinkedRole)
		case "CreateServiceSpecificCredential": return c.serve(h.createServiceSpecificCredential)
		case "CreateUser": return c.serve(h.createUser)
		case "CreateVirtualMFADevice": return c.serve(h.createVirtualMFADevice)
		case "DeactivateMFADevice": return c.serve(h.deactivateMFADevice)
		case "DeleteAccessKey": return c.serve(h.deleteAccessKey)
		case "DeleteAccountAlias": return c.serve(h.deleteAccountAlias)
		case "DeleteAccountPasswordPolicy": return c.serve(h.deleteAccountPasswordPolicy)
		case "DeleteGroup": return c.serve(h.deleteGroup)
		case "DeleteGroupPolicy": return c.serve(h.deleteGroupPolicy)
		case "DeleteInstanceProfile": return c.serve(h.deleteInstanceProfile)
		case "DeleteLoginProfile": return c.serve(h.deleteLoginProfile)
		case "DeleteOpenIDConnectProvider": return c.serve(h.deleteOpenIDConnectProvider)
		case "DeletePolicy": return c.serve(h.deletePolicy)
		case "DeletePolicyVersion": return c.serve(h.deletePolicyVersion)
		case "DeleteRole": return c.serve(h.deleteRole)
		case "DeleteRolePermissionsBoundary": return c.serve(h.deleteRolePermissionsBoundary)
		case "DeleteRolePolicy": return c.serve(h.deleteRolePolicy)
		case "DeleteSAMLProvider": return c.serve(h.deleteSAMLProvider)
		case "DeleteSSHPublicKey": return c.serve(h.deleteSSHPublicKey)
		case "DeleteServerCertificate": return c.serve(h.deleteServerCertificate)
		case "DeleteServiceLinkedRole": return c.serve(h.deleteServiceLinkedRole)
		case "DeleteServiceSpecificCredential": return c.serve(h.deleteServiceSpecificCredential)
		case "DeleteSigningCertificate": return c.serve(h.deleteSigningCertificate)
		case "DeleteUser": return c.serve(h.deleteUser)
