}

function bounded(db: Tables, name: string): User throws Fault {
	const u = db.users.get(key(name))
	if (u == null) {
		throw api.noSuchEntityException(`User ${name} was not found.`)
	}
	return u
}

function unbound(a: string, id: string): string throws Fault {
	if (a == "") {
		throw api.noSuchEntityException(`Principal ${id} does not have scope`)
	}
	return a
}
