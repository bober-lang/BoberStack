	deleteRolePolicy(caller: Caller, input: api.DeleteRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		modifiable(role(db, input.RoleName))
		const owner = key(role(db, input.RoleName).name)
		inline(db.roleInline, owner, input.PolicyName, "role")
		db.roleInline.delete(within(owner, key(input.PolicyName)))
