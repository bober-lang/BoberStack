//! AWS Identity and Access Management: users and their access keys, roles, managed policies and their versions, and
//! the policies attached to or embedded in users and roles, and AWS's managed policies, which any account may attach
//! but none change. Every request is authorized by the policies that apply to its caller, as core/service's Caller.allow
//! evaluates them.

import { Credential, credentials, id, secret } from "../../core/auth/credentials"
import * as auth from "../../core/auth/policy"
import { Fault } from "../../core/fault"
import { Violations } from "../../core/protocol/model"
import { Caller, Unit } from "../../core/service"
import { Table } from "../../core/state/store"
import * as api from "./api"
import { Catalog } from "./catalog"

import { AccessKey, arn, Attachment, Inline, key, number, Policy, Role, save, stamp, Tables, User, Version,
	within } from "./records"

import { endsWith, indexOf, lastIndexOf, sortBy, startsWith } from "std/algo"
import { isAlphanumeric, isDigit, isGraphic } from "std/ascii"
import { HashMap } from "std/collections/hashmap"
import * as base64 from "std/encoding/base64"
import { lower, ParseError, parseInt } from "std/string"
import { Decodable } from "std/types"
import { escape } from "std/url"

/// The service, of the operations implemented.
export class Handler {
	...api.Unimplemented

	/// AWS's managed policies.
	catalog: Catalog

	constructor(catalog: Catalog) { this.catalog = catalog }

	createUser(caller: Caller, input: api.CreateUserRequest): api.CreateUserResponse throws Fault {
		tagging(caller, input.Tags)
		caller.allow(arn(caller.account, "user", input.Path ?? "/", input.UserName))
		const db = new Tables(caller.store())
		const k = key(named(input.UserName, "userName", 64))
		if (db.users.get(k) != null) {
			throw api.entityAlreadyExistsException(`User with name ${input.UserName} already exists.`)
		}
		const u = new User()
		u.name = input.UserName
		u.path = path(input.Path, "path")
		u.id = id("AIDA", 17)
		u.created = stamp()
		u.tags = tagged([], input.Tags ?? [], "User")
		if (input.PermissionsBoundary != null) {
			u.boundary = bound(caller, db, this.catalog, "", input.PermissionsBoundary!)
		}
		save(db.users, k, u)
		const r = new api.CreateUserResponse()
		r.User = userOf(caller.account, u, true)
		return r
	}

	getUser(caller: Caller, input: api.GetUserRequest): api.GetUserResponse throws Fault {
		onUser(caller, input.UserName)
		const r = new api.GetUserResponse()
		r.User = userOf(caller.account, owner(caller, new Tables(caller.store()), input.UserName), true)
		return r
	}

	listUsers(caller: Caller, input: api.ListUsersRequest): api.ListUsersResponse throws Fault {
		caller.allow(arn(caller.account, "user", "/", ""))
		const prefix = input.PathPrefix ?? "/"
		const [users, next] = page(new Tables(caller.store()).users, "", input.Marker, input.MaxItems,
			u => startsWith(u.path, prefix))
		const r = new api.ListUsersResponse()
		r.Users = users.map(u => userOf(caller.account, u, false))
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	updateUser(caller: Caller, input: api.UpdateUserRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		const was = key(u.name)
		const name = named(input.NewUserName ?? u.name, "newUserName", 64)
		const k = key(name)
		if (k != was && db.users.get(k) != null) {
			throw api.entityAlreadyExistsException(`User with name ${name} already exists.`)
		}
		u.name = name
		if (input.NewPath != null) {
			u.path = path(input.NewPath, "newPath")
		}
		db.users.delete(was)
		save(db.users, k, u)
		move(db.keys, was, k, a => {
			a.user = name
		})
		move(db.userAttached, was, k, a => {})
		move(db.userInline, was, k, p => {})
		const issued = credentials(caller.global())
		for (const [_, a] of db.keys.scan(null, 2, within(k, ""))) {
			const c = issued.get(a.id)!
			c.arn = arn(caller.account, "user", u.path, u.name)
			save(issued, a.id, c)
		}
		return new Unit()
	}

	deleteUser(caller: Caller, input: api.DeleteUserRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const k = key(user(db, input.UserName).name)
		if (db.keys.scan(null, 1, within(k, "")).length > 0) {
			throw api.deleteConflictException("Cannot delete entity, must delete access keys first.")
		}
		if (db.userAttached.scan(null, 1, within(k, "")).length > 0) {
			throw api.deleteConflictException("Cannot delete entity, must detach all policies first.")
		}
		if (db.userInline.scan(null, 1, within(k, "")).length > 0) {
			throw api.deleteConflictException("Cannot delete entity, must delete policies first.")
		}
		bound(caller, db, this.catalog, db.users.get(k)!.boundary, "")
		db.users.delete(k)
		return new Unit()
	}

	tagUser(caller: Caller, input: api.TagUserRequest): Unit throws Fault {
		keys(input.Tags)
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		u.tags = tagged(u.tags, input.Tags, "User")
		save(db.users, key(u.name), u)
		return new Unit()
	}

	untagUser(caller: Caller, input: api.UntagUserRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		u.tags = u.tags.filter(t => !input.TagKeys.some(k => lower(k) == lower(t[0])))
		save(db.users, key(u.name), u)
		return new Unit()
	}

	listUserTags(caller: Caller, input: api.ListUserTagsRequest): api.ListUserTagsResponse throws Fault {
		onUser(caller, input.UserName)
		const [tags,
			next] = tagPage(user(new Tables(caller.store()), input.UserName).tags, input.Marker, input.MaxItems)
		const r = new api.ListUserTagsResponse()
		r.Tags = tags
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	createAccessKey(caller: Caller, input: api.CreateAccessKeyRequest): api.CreateAccessKeyResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		const k = key(u.name)
		if (db.keys.scan(null, 2, within(k, "")).length == 2) {
			throw api.limitExceededException("Cannot exceed quota for AccessKeysPerUser: 2")
		}
		const a = new AccessKey()
		a.user = u.name
		a.id = id("AKIA", 16)
		a.created = stamp()
		a.serial = db.next()
		save(db.keys, within(k, a.id), a)
		const c = new Credential()
		c.secret = secret()
		c.account = caller.account
		c.arn = identity(caller.account, u)
		c.userId = u.id
		save(credentials(caller.global()), a.id, c)
		const r = new api.CreateAccessKeyResponse()
		r.AccessKey.UserName = u.name
		r.AccessKey.AccessKeyId = a.id
		r.AccessKey.Status = "Active"
		r.AccessKey.SecretAccessKey = c.secret
		r.AccessKey.CreateDate = a.created
		return r
	}

	listAccessKeys(caller: Caller, input: api.ListAccessKeysRequest): api.ListAccessKeysResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		const all = db.keys.scan(null, 2147483647, within(key(u.name), "")).map(e => e[1])
		sortBy(all, (a, b) => a.serial > b.serial)
		const [keys, next] = part(all, input.Marker, input.MaxItems)
		const r = new api.ListAccessKeysResponse()
		r.AccessKeyMetadata = keys.map(a => {
			const m = new api.AccessKeyMetadata()
			m.UserName = if (a.user == "") null else a.user // the root's
			m.AccessKeyId = a.id
			m.Status = if (a.status == "Active") "Active" else "Inactive"
			m.CreateDate = a.created
			return m
		})
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	updateAccessKey(caller: Caller, input: api.UpdateAccessKeyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const k = within(key(owner(caller, db, input.UserName).name), input.AccessKeyId)
		const a = accessKey(db, k, input.AccessKeyId)
		a.status = input.Status
		save(db.keys, k, a)
		const issued = credentials(caller.global())
		const c = issued.get(a.id)!
		c.status = input.Status
		save(issued, a.id, c)
		return new Unit()
	}

	deleteAccessKey(caller: Caller, input: api.DeleteAccessKeyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const k = within(key(owner(caller, db, input.UserName).name), input.AccessKeyId)
		accessKey(db, k, input.AccessKeyId)
		db.keys.delete(k)
		// Kept, so that the key is refused rather than taken for a root's, as one never issued is.
		const issued = credentials(caller.global())
		const c = issued.get(input.AccessKeyId)!
		c.status = "Deleted"
		save(issued, input.AccessKeyId, c)
		return new Unit()
	}

	createRole(caller: Caller, input: api.CreateRoleRequest): api.CreateRoleResponse throws Fault {
		tagging(caller, input.Tags)
		caller.allow(arn(caller.account, "role", input.Path ?? "/", input.RoleName))
		const db = new Tables(caller.store())
		const k = key(named(input.RoleName, "roleName", 64))
		if (db.roles.get(k) != null) {
			throw api.entityAlreadyExistsException(`Role with name ${input.RoleName} already exists.`)
		}
		const r = new Role()
		r.name = input.RoleName
		r.path = path(input.Path, "path")
		r.id = id("AROA", 17)
		r.created = stamp()
		r.trust = document(input.AssumeRolePolicyDocument, "trust")
		r.description = input.Description
		r.maxSession = input.MaxSessionDuration ?? 3600
		r.tags = tagged([], input.Tags ?? [], "Role")
		if (input.PermissionsBoundary != null) {
			r.boundary = bound(caller, db, this.catalog, "", input.PermissionsBoundary!)
		}
		save(db.roles, k, r)
		const out = new api.CreateRoleResponse()
		out.Role = roleOf(caller.account, r, true)
		// Which IAM does not answer on creation.
		out.Role.Description = null
		out.Role.MaxSessionDuration = null
		out.Role.MaxSigninSessionDuration = null
		return out
	}

	getRole(caller: Caller, input: api.GetRoleRequest): api.GetRoleResponse throws Fault {
		onRole(caller, input.RoleName)
		const r = new api.GetRoleResponse()
		r.Role = roleOf(caller.account, role(new Tables(caller.store()), input.RoleName), true)
		r.Role.RoleLastUsed = new api.RoleLastUsed()
		return r
	}

	listRoles(caller: Caller, input: api.ListRolesRequest): api.ListRolesResponse throws Fault {
		caller.allow(arn(caller.account, "role", "/", ""))
		const prefix = input.PathPrefix ?? "/"
		const [roles, next] = page(new Tables(caller.store()).roles, "", input.Marker, input.MaxItems,
			r => startsWith(r.path, prefix))
		const r = new api.ListRolesResponse()
		r.Roles = roles.map(x => roleOf(caller.account, x, false))
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	updateAssumeRolePolicy(caller: Caller, input: api.UpdateAssumeRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const r = role(db, input.RoleName)
		r.trust = document(input.PolicyDocument, "trust")
		save(db.roles, key(r.name), r)
		return new Unit()
	}

	deleteRole(caller: Caller, input: api.DeleteRoleRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const k = key(role(db, input.RoleName).name)
		if (db.roleAttached.scan(null, 1, within(k, "")).length > 0) {
			throw api.deleteConflictException("Cannot delete entity, must detach all policies first.")
		}
		if (db.roleInline.scan(null, 1, within(k, "")).length > 0) {
			throw api.deleteConflictException("Cannot delete entity, must delete policies first.")
		}
		bound(caller, db, this.catalog, db.roles.get(k)!.boundary, "")
		db.roles.delete(k)
		return new Unit()
	}

	tagRole(caller: Caller, input: api.TagRoleRequest): Unit throws Fault {
		keys(input.Tags)
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const r = role(db, input.RoleName)
		r.tags = tagged(r.tags, input.Tags, "Role")
		save(db.roles, key(r.name), r)
		return new Unit()
	}

	untagRole(caller: Caller, input: api.UntagRoleRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const r = role(db, input.RoleName)
		r.tags = r.tags.filter(t => !input.TagKeys.some(k => lower(k) == lower(t[0])))
		save(db.roles, key(r.name), r)
		return new Unit()
	}

	listRoleTags(caller: Caller, input: api.ListRoleTagsRequest): api.ListRoleTagsResponse throws Fault {
		onRole(caller, input.RoleName)
		const [tags,
			next] = tagPage(role(new Tables(caller.store()), input.RoleName).tags, input.Marker, input.MaxItems)
		const r = new api.ListRoleTagsResponse()
		r.Tags = tags
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	putUserPermissionsBoundary(caller: Caller, input: api.PutUserPermissionsBoundaryRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		u.boundary = bound(caller, db, this.catalog, u.boundary, input.PermissionsBoundary)
		save(db.users, key(u.name), u)
		return new Unit()
	}

	deleteUserPermissionsBoundary(caller: Caller, input: api.DeleteUserPermissionsBoundaryRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		u.boundary = bound(caller, db, this.catalog, u.boundary, "")
		save(db.users, key(u.name), u)
		return new Unit()
	}

	putRolePermissionsBoundary(caller: Caller, input: api.PutRolePermissionsBoundaryRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const r = role(db, input.RoleName)
		r.boundary = bound(caller, db, this.catalog, r.boundary, input.PermissionsBoundary)
		save(db.roles, key(r.name), r)
		return new Unit()
	}

	deleteRolePermissionsBoundary(caller: Caller, input: api.DeleteRolePermissionsBoundaryRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const r = role(db, input.RoleName)
		r.boundary = bound(caller, db, this.catalog, r.boundary, "")
		save(db.roles, key(r.name), r)
		return new Unit()
	}

	createPolicy(caller: Caller, input: api.CreatePolicyRequest): api.CreatePolicyResponse throws Fault {
		tagging(caller, input.Tags)
		caller.allow(arn(caller.account, "policy", input.Path ?? "/", input.PolicyName))
		const db = new Tables(caller.store())
		const k = key(named(input.PolicyName, "policyName", 128))
		if (db.policies.get(k) != null) {
			const why = `A policy called ${input.PolicyName} already exists. Duplicate names are not allowed.`
			throw api.entityAlreadyExistsException(why)
		}
		const p = new Policy()
		p.name = input.PolicyName
		p.path = path(input.Path, "path")
		p.id = id("ANPA", 17)
		p.created = stamp()
		p.updated = p.created
		p.serial = db.next()
		p.description = input.Description
		p.tags = tagged([], input.Tags ?? [], "Policy")
		const v = new Version()
		v.id = "v1"
		v.document = document(input.PolicyDocument, "identity")
		v.created = p.created
		save(db.policies, k, p)
		save(db.versions, within(k, number(1)), v)
		const r = new api.CreatePolicyResponse()
		r.Policy = policyOf(caller.account, p, true)
		r.Policy.Description = null // which IAM does not answer on creation
		return r
	}

	getPolicy(caller: Caller, input: api.GetPolicyRequest): api.GetPolicyResponse throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const a = input.PolicyArn
		const p = managed(caller, db, this.catalog, a)
		if (aws(a)) {
			const [attached, bounding] = uses(db)
			p.attachments = attached.get(a) ?? 0
			p.bounds = bounding.get(a) ?? 0
		}
		const r = new api.GetPolicyResponse()
		r.Policy = policyOf(if (aws(a)) "aws" else caller.account, p, true)
		return r
	}

	/// The account's policies in the order they were made, then AWS's in the order of their dates, as AWS made them.
	listPolicies(caller: Caller, input: api.ListPoliciesRequest): api.ListPoliciesResponse throws Fault {
		caller.allow(arn(caller.account, "policy", "/", ""))
		const db = new Tables(caller.store())
		const prefix = input.PathPrefix ?? "/"
		const scope = input.Scope ?? "All"
		const attached = input.OnlyAttached
		const boundaries = input.PolicyUsageFilter == "PermissionsBoundary"
		const keep = (p: Policy) => startsWith(p.path, prefix) && (!attached || p.attachments > 0)
			&& (!boundaries || p.bounds > 0)
		const listed: [string, Policy][] = [] // the account and the policy
		if (scope != "AWS") {
			const local = db.policies.scan(null, 2147483647).map(e => e[1]).filter(keep)
			sortBy(local, (a, b) => a.serial < b.serial)
			for (const p of local) {
				listed.push([caller.account, p])
			}
		}
		if (scope != "Local") {
			const [counts, bounding] = uses(db)
			for (const i of this.catalog.dated()) {
				const p = this.catalog.policy(i)
				const a = arn("aws", "policy", p.path, p.name)
				p.attachments = counts.get(a) ?? 0
				p.bounds = bounding.get(a) ?? 0
				if (keep(p)) {
					listed.push(["aws", p])
				}
			}
		}
		const [found, next] = part(listed, input.Marker, input.MaxItems)
		const r = new api.ListPoliciesResponse()
		r.Policies = found.map(e => policyOf(e[0], e[1], false))
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	deletePolicy(caller: Caller, input: api.DeletePolicyRequest): Unit throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = owned(caller, db, input.PolicyArn, "delete policies")
		const k = key(p.name)
		const versions = db.versions.scan(null, 2, within(k, ""))
		if (versions.length > 1) {
			throw api.deleteConflictException("This policy has more than one version. Before you delete a policy, you "
				+ "must delete the policy's versions. The default version is deleted with the policy.")
		}
		if (p.attachments > 0 || p.bounds > 0) {
			throw api.deleteConflictException("Cannot delete a policy attached to entities.")
		}
		db.versions.delete(versions[0][0])
		db.policies.delete(k)
		return new Unit()
	}

	createPolicyVersion(caller: Caller,
		input: api.CreatePolicyVersionRequest): api.CreatePolicyVersionResponse throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = owned(caller, db, input.PolicyArn, "create versions for policies")
		const k = key(p.name)
		const d = document(input.PolicyDocument, "identity")
		if (db.versions.scan(null, 5, within(k, "")).length == 5) {
			throw api.limitExceededException("A managed policy can have up to 5 versions. Before you create a new "
				+ "version, you must delete an existing version.")
		}
		const v = new Version()
		v.id = `v${p.next}`
		v.document = d
		v.created = stamp()
		save(db.versions, within(k, number(p.next)), v)
		p.next++
		p.updated = v.created
		if (input.SetAsDefault) {
			p.defaultVersion = v.id
		}
		save(db.policies, k, p)
		const r = new api.CreatePolicyVersionResponse()
		r.PolicyVersion = versionOf(p, v, false)
		return r
	}

	getPolicyVersion(caller: Caller, input: api.GetPolicyVersionRequest): api.GetPolicyVersionResponse throws Fault {
		versionId(input.VersionId)
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const a = input.PolicyArn
		const p = managed(caller, db, this.catalog, a)
		let v: Version | null = null
		if (aws(a)) {
			v = this.catalog.version(this.catalog.find(a), input.VersionId)
		} else {
			v = version(db, p, a, input.VersionId)[1]
		}
		if (v == null) {
			throw unknownVersion(a, input.VersionId)
		}
		const r = new api.GetPolicyVersionResponse()
		r.PolicyVersion = versionOf(p, v, true)
		return r
	}

	/// A policy's versions, the latest first.
	listPolicyVersions(caller: Caller,
		input: api.ListPolicyVersionsRequest): api.ListPolicyVersionsResponse throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const a = input.PolicyArn
		const p = managed(caller, db, this.catalog, a)
		let all = if (aws(a)) this.catalog.versions(this.catalog.find(a)) else []
		if (!aws(a)) {
			const made = db.versions.scan(null, 5, within(key(p.name), ""))
			for (let i = made.length - 1; i >= 0; i--) {
				all.push(made[i][1])
			}
		}
		const [versions, next] = part(all, input.Marker, input.MaxItems)
		const r = new api.ListPolicyVersionsResponse()
		r.Versions = versions.map(v => versionOf(p, v, false))
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	deletePolicyVersion(caller: Caller, input: api.DeletePolicyVersionRequest): Unit throws Fault {
		versionId(input.VersionId)
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = owned(caller, db, input.PolicyArn, "delete policy versions for policies",
			`version ${input.VersionId} does not exist or is not attachable.`)
		const [k, v] = version(db, p, input.PolicyArn, input.VersionId)
		if (v.id == p.defaultVersion) {
			throw api.deleteConflictException("Cannot delete the default version of a policy.")
		}
		db.versions.delete(k)
		return new Unit()
	}

	setDefaultPolicyVersion(caller: Caller, input: api.SetDefaultPolicyVersionRequest): Unit throws Fault {
		versionId(input.VersionId)
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = owned(caller, db, input.PolicyArn, "update policies")
		p.defaultVersion = version(db, p, input.PolicyArn, input.VersionId)[1].id
		p.updated = stamp()
		save(db.policies, key(p.name), p)
		return new Unit()
	}

	tagPolicy(caller: Caller, input: api.TagPolicyRequest): Unit throws Fault {
		keys(input.Tags)
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = taggable(caller, db, input.PolicyArn)
		p.tags = tagged(p.tags, input.Tags, "Policy")
		save(db.policies, key(p.name), p)
		return new Unit()
	}

	untagPolicy(caller: Caller, input: api.UntagPolicyRequest): Unit throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const p = taggable(caller, db, input.PolicyArn)
		p.tags = p.tags.filter(t => !input.TagKeys.some(k => lower(k) == lower(t[0])))
		save(db.policies, key(p.name), p)
		return new Unit()
	}

	/// None of AWS's.
	listPolicyTags(caller: Caller, input: api.ListPolicyTagsRequest): api.ListPolicyTagsResponse throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const a = input.PolicyArn
		const [tags, next] = tagPage(managed(caller, db, this.catalog, a).tags, input.Marker, input.MaxItems)
		const r = new api.ListPolicyTagsResponse()
		r.Tags = tags
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	attachUserPolicy(caller: Caller, input: api.AttachUserPolicyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		attach(caller, db, this.catalog, db.userAttached, key(user(db, input.UserName).name), input.PolicyArn, "user")
		return new Unit()
	}

	detachUserPolicy(caller: Caller, input: api.DetachUserPolicyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		detach(caller, db, db.userAttached, key(user(db, input.UserName).name), input.PolicyArn)
		return new Unit()
	}

	listAttachedUserPolicies(caller: Caller,
		input: api.ListAttachedUserPoliciesRequest): api.ListAttachedUserPoliciesResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const owner = key(user(db, input.UserName).name)
		const [policies, next] = attached(db.userAttached, owner, input.PathPrefix, input.Marker, input.MaxItems)
		const r = new api.ListAttachedUserPoliciesResponse()
		r.AttachedPolicies = policies
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	attachRolePolicy(caller: Caller, input: api.AttachRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		attach(caller, db, this.catalog, db.roleAttached, key(role(db, input.RoleName).name), input.PolicyArn, "role")
		return new Unit()
	}

	detachRolePolicy(caller: Caller, input: api.DetachRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		detach(caller, db, db.roleAttached, key(role(db, input.RoleName).name), input.PolicyArn)
		return new Unit()
	}

	listAttachedRolePolicies(caller: Caller,
		input: api.ListAttachedRolePoliciesRequest): api.ListAttachedRolePoliciesResponse throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const owner = key(role(db, input.RoleName).name)
		const [policies, next] = attached(db.roleAttached, owner, input.PathPrefix, input.Marker, input.MaxItems)
		const r = new api.ListAttachedRolePoliciesResponse()
		r.AttachedPolicies = policies
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	/// The users, then the roles, a managed policy is attached to, or that it bounds, each in the order of their names.
	listEntitiesForPolicy(caller: Caller,
		input: api.ListEntitiesForPolicyRequest): api.ListEntitiesForPolicyResponse throws Fault {
		onPolicy(caller, input.PolicyArn)
		const db = new Tables(caller.store())
		const a = input.PolicyArn
		managed(caller, db, this.catalog, a)
		const prefix = input.PathPrefix ?? "/"
		const f = input.EntityFilter
		// There are no groups.
		const boundaries = input.PolicyUsageFilter == "PermissionsBoundary"
		const entities: [bool, string, string][] = [] // whether a user's, the name and the id
		const users = if (f != null && f != "User") []
			else if (boundaries) db.users.scan(null, 2147483647).filter(e => e[1].boundary == a).map(e => e[1])
			else db.userAttached.scan(null,
			2147483647).filter(e => e[1].arn == a).map(e => db.users.get(e[0].slice(0, indexOf(e[0], "\x00")))!)
		for (const u of users) {
			if (startsWith(u.path, prefix)) {
				entities.push([true, u.name, u.id])
			}
		}
		const roles = if (f != null && f != "Role") []
			else if (boundaries) db.roles.scan(null, 2147483647).filter(e => e[1].boundary == a).map(e => e[1])
			else db.roleAttached.scan(null,
			2147483647).filter(e => e[1].arn == a).map(e => db.roles.get(e[0].slice(0, indexOf(e[0], "\x00")))!)
		for (const x of roles) {
			if (startsWith(x.path, prefix)) {
				entities.push([false, x.name, x.id])
			}
		}
		const [found, next] = part(entities, input.Marker, input.MaxItems)
		const r = new api.ListEntitiesForPolicyResponse()
		r.PolicyGroups = []
		r.PolicyUsers = found.filter(e => e[0]).map(e => ({ ...new api.PolicyUser(), UserName: e[1], UserId: e[2] }))
		r.PolicyRoles = found.filter(e => !e[0]).map(e => ({ ...new api.PolicyRole(), RoleName: e[1], RoleId: e[2] }))
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	putUserPolicy(caller: Caller, input: api.PutUserPolicyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const owner = key(user(db, input.UserName).name)
		embed(db.userInline, owner, input.PolicyName, input.PolicyDocument)
		return new Unit()
	}

	getUserPolicy(caller: Caller, input: api.GetUserPolicyRequest): api.GetUserPolicyResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = user(db, input.UserName)
		const p = inline(db.userInline, key(u.name), input.PolicyName, "user")
		const r = new api.GetUserPolicyResponse()
		r.UserName = u.name
		r.PolicyName = p.name
		r.PolicyDocument = escape(p.document, "component")
		return r
	}

	listUserPolicies(caller: Caller, input: api.ListUserPoliciesRequest): api.ListUserPoliciesResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const owner = key(user(db, input.UserName).name)
		const [policies, next] = page(db.userInline, within(owner, ""), input.Marker, input.MaxItems, p => true)
		const r = new api.ListUserPoliciesResponse()
		r.PolicyNames = policies.map(p => p.name)
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	deleteUserPolicy(caller: Caller, input: api.DeleteUserPolicyRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const owner = key(user(db, input.UserName).name)
		inline(db.userInline, owner, input.PolicyName, "user")
		db.userInline.delete(within(owner, key(input.PolicyName)))
		return new Unit()
	}

	putRolePolicy(caller: Caller, input: api.PutRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const owner = key(role(db, input.RoleName).name)
		embed(db.roleInline, owner, input.PolicyName, input.PolicyDocument)
		return new Unit()
	}

	getRolePolicy(caller: Caller, input: api.GetRolePolicyRequest): api.GetRolePolicyResponse throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const x = role(db, input.RoleName)
		const p = inline(db.roleInline, key(x.name), input.PolicyName, "role")
		const r = new api.GetRolePolicyResponse()
		r.RoleName = x.name
		r.PolicyName = p.name
		r.PolicyDocument = escape(p.document, "component")
		return r
	}

	listRolePolicies(caller: Caller, input: api.ListRolePoliciesRequest): api.ListRolePoliciesResponse throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const owner = key(role(db, input.RoleName).name)
		const [policies, next] = page(db.roleInline, within(owner, ""), input.Marker, input.MaxItems, p => true)
		const r = new api.ListRolePoliciesResponse()
		r.PolicyNames = policies.map(p => p.name)
		r.IsTruncated = next != null
		r.Marker = next
		return r
	}

	deleteRolePolicy(caller: Caller, input: api.DeleteRolePolicyRequest): Unit throws Fault {
		onRole(caller, input.RoleName)
		const db = new Tables(caller.store())
		const owner = key(role(db, input.RoleName).name)
		inline(db.roleInline, owner, input.PolicyName, "role")
		db.roleInline.delete(within(owner, key(input.PolicyName)))
		return new Unit()
	}
}

/// Throws unless the caller may perform the operation on the user named name, or if null on itself: on its ARN, of its
/// path if it exists, which IAM's message names as user <name>.
function onUser(caller: Caller, name: string | null) throws Fault {
	const a = caller.arn
	const n = name ?? (if (indexOf(a, ":user/") >= 0) a.slice(lastIndexOf(a, "/") + 1, a.length) else "")
	if (n == "") {
		caller.allow(a)
		return
	}
	const u = new Tables(caller.store()).users.get(key(n))
	caller.allow(arn(caller.account, "user", u?.path ?? "/", u?.name ?? n), null, [], `user ${n}`)
}

/// Throws unless the caller may perform the operation on the role named name, as onUser on a user.
function onRole(caller: Caller, name: string) throws Fault {
	const r = new Tables(caller.store()).roles.get(key(name))
	caller.allow(arn(caller.account, "role", r?.path ?? "/", r?.name ?? name), null, [], `role ${name}`)
}

/// Throws unless the caller may perform the operation on the managed policy of ARN a, which IAM's message names as
/// policy <a>.
function onPolicy(caller: Caller, a: string) throws Fault { caller.allow(a, null, [], `policy ${a}`) }

/// Drops the tagging action of the operation's, its last, unless tags are given.
function tagging(caller: Caller, tags: api.Tag[] | null) {
	if (tags == null || tags.length == 0) {
		caller.actions = caller.actions.slice(0, caller.actions.length - 1)
	}
}

/// The user named name.
function user(db: Tables, name: string): User throws Fault {
	const u = db.users.get(key(name))
	if (u == null) {
		throw api.noSuchEntityException(`The user with name ${name} cannot be found.`)
	}
	return u
}

/// The user named name, or if none the caller, which must then be a user or the account's root.
function owner(caller: Caller, db: Tables, name: string | null): User throws Fault {
	if (name != null) {
		return user(db, name)
	}
	if (caller.arn == arn(caller.account, "root", "", "")) {
		const found = db.root.get("")
		if (found != null) {
			return found
		}
		const r = { ...new User(), path: "", id: caller.account, created: stamp() }
		save(db.root, "", r)
		return r
	}
	if (indexOf(caller.arn, ":user/") < 0) {
		throw new Fault(400, "ValidationError", "Must specify userName when calling with non-User credentials")
	}
	return user(db, caller.arn.slice(lastIndexOf(caller.arn, "/") + 1, caller.arn.length))
}

/// The role named name.
function role(db: Tables, name: string): Role throws Fault {
	const r = db.roles.get(key(name))
	if (r == null) {
		throw api.noSuchEntityException(`The role with name ${name} cannot be found.`)
	}
	return r
}

/// The managed policy of the caller's account that a names.
function policy(caller: Caller, db: Tables, a: string, missing = "was not found."): Policy throws Fault {
	if (!startsWith(a, "arn:aws:iam::") || indexOf(a, ":policy/") < 0) {
		throw api.invalidInputException(`ARN ${a} is not valid.`)
	}
	const p = db.policies.get(key(a.slice(lastIndexOf(a, "/") + 1, a.length)))
	if (p == null || arn(caller.account, "policy", p.path, p.name) != a) {
		throw api.noSuchEntityException(`Policy ${a} ${missing}`)
	}
	return p
}

/// The managed policy that a names, the caller's account's or AWS's; one of AWS's counts no attachments.
function managed(caller: Caller, db: Tables, catalog: Catalog, a: string,
	missing = "was not found."): Policy throws Fault {
	if (!aws(a)) {
		return policy(caller, db, a, missing)
	}
	const i = catalog.find(a)
	if (i < 0) {
		throw api.noSuchEntityException(`Policy ${a} ${missing}`)
	}
	return catalog.policy(i)
}

/// The managed policy of the caller's account that a names, to do what is denied on AWS's, as "delete policies"; if
/// there is none, missing says so, after its ARN.
function owned(caller: Caller, db: Tables, a: string, what: string, missing = "was not found."): Policy throws Fault {
	if (aws(a)) {
		throw new Fault(403, "AccessDenied", `Cannot ${what} outside your own account.`)
	}
	return policy(caller, db, a, missing)
}

/// The managed policy of the caller's account that a names, to be tagged; AWS's take none.
function taggable(caller: Caller, db: Tables, a: string): Policy throws Fault {
	if (aws(a)) {
		throw api.invalidInputException("Tags not supported for policies in this domain")
	}
	return policy(caller, db, a)
}

/// The ARN a of the permissions boundary to set in place of the one of ARN was, "" for none, of the caller's account's
/// or AWS's, whose count of those it bounds it keeps.
function bound(caller: Caller, db: Tables, catalog: Catalog, was: string, a: string): string throws Fault {
	if (a != "") {
		managed(caller, db, catalog, a, "does not exist or is not attachable.")
	}
	if (was != a) {
		count(db, was, -1)
		count(db, a, 1)
	}
	return a
}

/// Adds by to the number of those the account's managed policy of ARN a bounds, if a is one.
function count(db: Tables, a: string, by: i32) throws Fault {
	const p = if (a == "" || aws(a)) null else db.policies.get(key(a.slice(lastIndexOf(a, "/") + 1, a.length)))
	if (p != null) {
		p.bounds += by
		save(db.policies, key(p.name), p)
	}
}

/// Whether a is the ARN of one of AWS's managed policies, of the account aws.
function aws(a: string): bool { return startsWith(a, "arn:aws:iam::aws:") }

/// The number of users and roles each managed policy is attached to, and the number it bounds, by its ARN.
function uses(db: Tables): [HashMap[string, i32], HashMap[string, i32]] {
	const n = new HashMap[string, i32]()
	for (const t of [db.userAttached, db.roleAttached]) {
		for (const [_, at] of t.scan(null, 2147483647)) {
			n.set(at.arn, (n.get(at.arn) ?? 0) + 1)
		}
	}
	const b = new HashMap[string, i32]()
	const boundaries = db.users.scan(null, 2147483647).map(e => e[1].boundary)
	boundaries.append(db.roles.scan(null, 2147483647).map(e => e[1].boundary))
	for (const x of boundaries) {
		b.set(x, (b.get(x) ?? 0) + 1)
	}
	return [n, b]
}

/// The key and version of p, of the ARN a, whose id is v.
function version(db: Tables, p: Policy, a: string, v: string): [string, Version] throws Fault {
	let n = 0
	try {
		n = if (startsWith(v, "v")) parseInt(v.slice(1, v.length)) else 0
	} catch (e: ParseError) {}
	const k = within(key(p.name), number(n))
	const found = db.versions.get(k)
	if (found == null || found.id != v) {
		throw unknownVersion(a, v)
	}
	return [k, found]
}

/// v, if it is a version id.
function versionId(v: string): string throws Fault {
	let digits = 1
	while (digits < v.length && isDigit(v[digits])) {
		digits++
	}
	const rest = v.slice(digits, v.length)
	if (!startsWith(v, "v") || digits == 1 || v[1] == 48
		|| rest != "" && (rest[0] != 46 || !rest.slice(1, rest.length).every(c => isAlphanumeric(c) || c == 45))) {
		throw new Violations(api.validation).fault(v, "versionId",
			"Member must satisfy regular expression pattern: v[1-9][0-9]*(\\.[A-Za-z0-9-]*)?")
	}
	return v
}

/// The fault of the version v, of the policy of ARN a, that does not exist.
function unknownVersion(a: string, v: string): Fault {
	return api.noSuchEntityException(`Policy ${a} version ${v} does not exist or is not attachable.`)
}

/// The access key k of the user that k names, whose id is id.
function accessKey(db: Tables, k: string, id: string): AccessKey throws Fault {
	const a = db.keys.get(k)
	if (a == null) {
		throw api.noSuchEntityException(`The Access Key with id ${id} cannot be found.`)
	}
	return a
}

/// Attaches the policy of ARN a to the user or role, as kind names it, of key owner, whose attachments are in t, unless
/// it is already; a service role's policy of AWS's is reserved to the roles AWS makes.
function attach(caller: Caller, db: Tables, catalog: Catalog, t: Table[Attachment], owner: string, a: string,
	kind: string) throws Fault {
	const p = managed(caller, db, catalog, a, "does not exist or is not attachable.")
	if (aws(a) && startsWith(p.path, "/aws-service-role/")) {
		throw api.policyNotAttachableException(`Cannot attach AWS reserved policy to an IAM ${kind}.`)
	}
	const k = within(owner, placed(caller, a))
	if (t.get(k) == null) {
		const at = new Attachment()
		at.name = p.name
		at.path = p.path
		at.arn = a
		at.serial = db.next()
		save(t, k, at)
		if (!aws(a)) {
			p.attachments++
			save(db.policies, key(p.name), p)
		}
	}
}

/// Detaches the policy of ARN a from the user or role of key owner, whose attachments are in t.
function detach(caller: Caller, db: Tables, t: Table[Attachment], owner: string, a: string) throws Fault {
	const k = within(owner, placed(caller, a))
	const at = t.get(k)
	if (at == null || at.arn != a) {
		throw api.noSuchEntityException(`Policy ${a} was not found.`)
	}
	t.delete(k)
	if (!aws(a)) {
		const p = policy(caller, db, a)
		p.attachments--
		save(db.policies, key(p.name), p)
	}
}

/// The place of the managed policy of ARN a among those of a listing or attached to a user or role: its key, then its
/// account's, the caller's or aws, as AWS's may share a name with the account's own.
function placed(caller: Caller, a: string): string {
	return within(key(a.slice(lastIndexOf(a, "/") + 1, a.length)), if (aws(a)) "aws" else caller.account)
}

/// A page of the policies attached to the user or role of key owner, of t, whose paths start with prefix, in the order
/// attached.
function attached(t: Table[Attachment], owner: string, prefix: string | null, marker: string | null,
	max: i32 | null): [api.AttachedPolicy[], string | null] throws Fault {
	const all = t.scan(null, 2147483647,
		within(owner, "")).map(e => e[1]).filter(a => startsWith(a.path, prefix ?? "/"))
	sortBy(all, (a, b) => a.serial < b.serial)
	const [policies, next] = part(all, marker, max)
	return [policies.map(a => ({ ...new api.AttachedPolicy(), PolicyName: a.name, PolicyArn: a.arn })), next]
}

/// Puts the policy named name of the document doc into the user or role of key owner, whose inline policies are in t.
function embed(t: Table[Inline], owner: string, name: string, doc: string) throws Fault {
	const p = new Inline()
	p.name = named(name, "policyName", 128)
	p.document = document(doc, "identity")
	save(t, within(owner, key(name)), p)
}

/// The inline policy named name of the user or role, as kind names it, of key owner, of t.
function inline(t: Table[Inline], owner: string, name: string, kind: string): Inline throws Fault {
	const p = t.get(within(owner, key(name)))
	if (p == null) {
		throw api.noSuchEntityException(`The ${kind} policy with name ${name} cannot be found.`)
	}
	return p
}

/// Moves the records of t that belong to the key from to the key to, each as edit changes it.
function move[V extends Decodable](t: Table[V], from: string, to: string, edit: (v: V) => void) throws Fault {
	for (const [k, v] of t.scan(null, 2147483647, within(from, ""))) {
		t.delete(k)
		edit(v)
		save(t, within(to, k.slice(from.length + 1, k.length)), v)
	}
}

/// A page of the records of t whose keys start with prefix, those that keep takes, after the one that marker names, of
/// at most max (100 if null, 1 to 1000); and the marker of the next page, null after the last.
function page[V extends Decodable](t: Table[V], prefix: string, marker: string | null, max: i32 | null,
	keep: (v: V) => bool): [V[], string | null] throws Fault {
	const n = max ?? 100
	const got = take(t, prefix, cursor(marker, prefix), n + 1, keep)
	return [got.slice(0, if (got.length < n) got.length else n).map(e => e[1]),
		if (got.length > n) base64.encode(got[n - 1][0]) else null]
}

/// The key after which the page that marker names starts, null for the first; a key of a table, its names', starts
/// with prefix.
function cursor(marker: string | null, prefix: string): string | null throws Fault {
	if (marker == null) {
		return null
	}
	let k = ""
	try {
		k = base64.decode(marker!)
	} catch (e: ParseError) {
		throw invalidMarker()
	}
	if (!startsWith(k, prefix) || !k.every(c => c == 0 || isGraphic(c))) {
		throw invalidMarker()
	}
	return k
}

/// The fault of a marker that names no page.
function invalidMarker(): Fault { return new Fault(400, api.validation.code, "Invalid Marker.") }

/// Up to n records of t, with their keys, whose keys start with prefix and come after after, those that keep takes.
function take[V extends Decodable](t: Table[V], prefix: string, after: string | null, n: i32,
	keep: (v: V) => bool): [string, V][] {
	const out: [string, V][] = []
	let from = after
	while (true) {
		const chunk = t.scan(from, 100, prefix)
		for (const [k, v] of chunk) {
			if (keep(v)) {
				out.push([k, v])
				if (out.length == n) {
					return out
				}
			}
		}
		if (chunk.length < 100) {
			return out
		}
		from = chunk[chunk.length - 1][0]
	}
}

/// A page of items as page has one, its marker the index of the first of the next.
function part[T](items: T[], marker: string | null, max: i32 | null): [T[], string | null] throws Fault {
	const n = max ?? 100
	let from = 0
	try {
		from = if (marker == null) 0 else parseInt(marker)
	} catch (e: ParseError) {
		throw invalidMarker()
	}
	if (from < 0 || from > items.length) {
		throw invalidMarker()
	}
	const to = if (from + n < items.length) from + n else items.length
	return [items.slice(from, to), if (to < items.length) `${to}` else null]
}

/// A page of tags as part has one.
function tagPage(tags: [string, string][], marker: string | null,
	max: i32 | null): [api.Tag[], string | null] throws Fault {
	const [page, next] = part(tags, marker, max)
	return [page.map(t => ({ ...new api.Tag(), Key: t[0], Value: t[1] })), next]
}

/// tags with given set over them by key, whatever its case, of a resource of a kind, as User, in the order IAM lists
/// them: a policy's as added, a user's or role's the latest first; at most 50.
function tagged(tags: [string, string][], given: api.Tag[], kind: string): [string, string][] throws Fault {
	for (let i = 0; i < given.length; i++) {
		for (let j = 0; j < i; j++) {
			if (lower(given[i].Key) == lower(given[j].Key)) {
				throw api.invalidInputException("Duplicate tag keys found. Please note that Tag keys are case insensitive.")
			}
		}
	}
	const kept = tags.filter(t => !given.some(g => lower(g.Key) == lower(t[0])))
	const out: [string, string][] = if (kind == "Policy") kept else []
	for (const g of given) {
		out.push([g.Key, g.Value])
	}
	if (kind != "Policy") {
		out.append(kept)
	}
	if (out.length > 50) {
		throw api.limitExceededException(`Cannot exceed quota for TagsPer${kind}: 50`)
	}
	return out
}

/// Throws unless the key of each of tags is one: of a letter, digit, space or _.:/=+-@ or more, as IAM checks them.
function keys(tags: api.Tag[] | null) throws Fault {
	const v = new Violations(api.validation)
	const given = tags ?? []
	for (let i = 0; i < given.length; i++) {
		const k = given[i].Key
		const at = `tags.${i + 1}.member.key`
		if (k.length == 0) {
			v.note(k, at, "Member must have length greater than or equal to 1")
		}
		if (!k.every(c => c >= 128 || isAlphanumeric(c) || indexOf(" _.:/=+-@", chr(c)) >= 0) || k.length == 0) {
			v.note(k, at, "Member must satisfy regular expression pattern: [\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]+")
		}
	}
	v.check()
}

/// name, of the member m, if it is a name of at most max characters of IAM's: as IAM checks one, its characters
/// first, their fault in IAM's own words.
function named(name: string, m: string, max: i32): string throws Fault {
	if (name.length < 1 || !name.every(c => isAlphanumeric(c) || indexOf("_+=,.@-", chr(c)) >= 0)) {
		throw invalidValue(m, "It must contain only alphanumeric characters and/or the following: +=,.@_-")
	}
	if (name.length > max) {
		throw new Violations(api.validation).fault(name, m, `Member must have length less than or equal to ${max}`)
	}
	return name
}

/// The path p of the member m, / if null; one starts and ends with a /, its characters checked first, as by named.
function path(p: string | null, m: string): string throws Fault {
	const s = p ?? "/"
	if (!startsWith(s, "/") || !endsWith(s, "/") || !s.every(isGraphic)) {
		throw invalidValue(m,
			"It must begin and end with / and contain only alphanumeric characters and/or / characters.")
	}
	if (s.length > 512) {
		throw new Violations(api.validation).fault(s, m, "Member must have length less than or equal to 512")
	}
	return s
}

/// The fault of a value of the member m not of the pattern that why words.
function invalidValue(m: string, why: string): Fault {
	return new Fault(400, api.validation.code, `The specified value for ${m} is invalid. ${why}`)
}

/// d, if it is a policy document of kind k, as IAM checks one.
function document(d: string, k: auth.Kind): string throws Fault {
	auth.parse(d, k)
	return d
}

/// tags as IAM gives them, none if there are none.
function tagsOf(tags: [string, string][]): api.Tag[] | null {
	return if (tags.length == 0) null else tags.map(t => ({ ...new api.Tag(), Key: t[0], Value: t[1] }))
}

/// u of account as IAM gives it, with its tags if full.
function userOf(account: string, u: User, full: bool): api.User {
	const w = new api.User()
	w.Path = u.path
	w.UserName = u.name
	w.UserId = u.id
	w.Arn = identity(account, u)
	w.CreateDate = u.created
	w.PermissionsBoundary = if (full) boundaryOf(u.boundary) else null
	w.Tags = if (full) tagsOf(u.tags) else null
	return w
}

/// The permissions boundary of ARN a as IAM gives it, none if "".
function boundaryOf(a: string): api.AttachedPermissionsBoundary | null {
	return if (a == "") null
		else ({ ...new api.AttachedPermissionsBoundary(), PermissionsBoundaryType: "PermissionsBoundaryPolicy",
		PermissionsBoundaryArn: a })
}

/// The ARN of u of account: the root's if u is.
function identity(account: string, u: User): string {
	return if (u.name == "") arn(account, "root", "", "") else arn(account, "user", u.path, u.name)
}

/// r of account as IAM gives it, its trust policy URL-encoded, with its tags if full.
function roleOf(account: string, r: Role, full: bool): api.Role {
	const w = new api.Role()
	w.Path = r.path
	w.RoleName = r.name
	w.RoleId = r.id
	w.Arn = arn(account, "role", r.path, r.name)
	w.CreateDate = r.created
	w.AssumeRolePolicyDocument = escape(r.trust, "component")
	w.Description = r.description
	w.MaxSessionDuration = r.maxSession
	w.MaxSigninSessionDuration = r.maxSession
	w.PermissionsBoundary = if (full) boundaryOf(r.boundary) else null
	w.Tags = if (full) tagsOf(r.tags) else null
	return w
}

/// p of account as IAM gives it, with its description and tags if full: none for AWS's, an empty list.
function policyOf(account: string, p: Policy, full: bool): api.Policy {
	const w = new api.Policy()
	w.PolicyName = p.name
	w.PolicyId = p.id
	w.Arn = arn(account, "policy", p.path, p.name)
	w.Path = p.path
	w.DefaultVersionId = p.defaultVersion
	w.AttachmentCount = p.attachments
	w.PermissionsBoundaryUsageCount = p.bounds
	w.IsAttachable = true
	w.Description = if (full) p.description else null
	w.CreateDate = p.created
	w.UpdateDate = p.updated
	w.Tags = if (!full) null else if (account == "aws") [] else tagsOf(p.tags)
	return w
}

/// v of p as IAM gives it, with its document URL-encoded if full.
function versionOf(p: Policy, v: Version, full: bool): api.PolicyVersion {
	const w = new api.PolicyVersion()
	w.Document = if (full) escape(v.document, "component") else null
	w.VersionId = v.id
	w.IsDefaultVersion = v.id == p.defaultVersion
	w.CreateDate = v.created
	return w
}
