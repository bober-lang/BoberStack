//! IAM's login profiles: a user's password to sign in to the console with, kept to the account's password policy. The
//! operations of the Handler of ./iam that it mixes in.

import { Fault } from "../../core/fault"
import { Caller, Unit } from "../../core/service"
import * as api from "./api"
import { onUser, owner } from "./common"
import { key, Login, save, stamp, Tables, User } from "./records"
import { indexOf } from "std/algo"
import { isDigit, isLower, isUpper } from "std/ascii"
import { CryptoError } from "std/crypto/error"
import { sha256 } from "std/crypto/hash"
import * as hex from "std/encoding/hex"

/// The operations on login profiles.
export class Logins {
	createLoginProfile(caller: Caller,
		input: api.CreateLoginProfileRequest): api.CreateLoginProfileResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		if (db.logins.get(key(u.name)) != null) {
			throw api.entityAlreadyExistsException(`Login Profile for user ${u.name} already exists.`)
		}
		if (input.Password == null) {
			throw new Fault(400, api.validation.code,
				"1 validation error detected: Value at 'password' failed to satisfy constraint: Member must not be null")
		}
		conform(db, input.Password!)
		const l = new Login()
		l.password = digest(input.Password!)
		l.created = stamp()
		l.reset = input.PasswordResetRequired
		l.maxSession = input.MaxSigninSessionDuration
		save(db.logins, key(u.name), l)
		const r = new api.CreateLoginProfileResponse()
		r.LoginProfile = profileOf(u, l)
		return r
	}

	getLoginProfile(caller: Caller, input: api.GetLoginProfileRequest): api.GetLoginProfileResponse throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		const r = new api.GetLoginProfileResponse()
		r.LoginProfile = profileOf(u, login(db, u))
		return r
	}

	updateLoginProfile(caller: Caller, input: api.UpdateLoginProfileRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		const l = login(db, u)
		if (input.Password != null) {
			conform(db, input.Password!)
			l.password = digest(input.Password!)
		}
		l.reset = input.PasswordResetRequired ?? l.reset
		l.maxSession = if (input.ResetMaxSigninSessionDuration ?? false) null
			else input.MaxSigninSessionDuration ?? l.maxSession
		save(db.logins, key(u.name), l)
		return new Unit()
	}

	deleteLoginProfile(caller: Caller, input: api.DeleteLoginProfileRequest): Unit throws Fault {
		onUser(caller, input.UserName)
		const db = new Tables(caller.store())
		const u = owner(caller, db, input.UserName)
		login(db, u)
		db.logins.delete(key(u.name))
		return new Unit()
	}

	/// Of the calling user only, the old password given, the new one kept to the account's password policy.
	changePassword(caller: Caller, input: api.ChangePasswordRequest): Unit throws Fault {
		if (indexOf(caller.arn, ":user/") < 0) {
			throw api.invalidUserTypeException("Only IAM Users can change their own password.")
		}
		const db = new Tables(caller.store())
		const u = owner(caller, db, null)
		const l = login(db, u)
		if (digest(input.OldPassword) != l.password) {
			throw api.invalidUserTypeException("The old password is incorrect.")
		}
		conform(db, input.NewPassword)
		l.password = digest(input.NewPassword)
		l.reset = false
		save(db.logins, key(u.name), l)
		return new Unit()
	}
}

/// password's SHA-256, in hex.
function digest(password: string): string throws Fault {
	try {
		return hex.encode(sha256(password))
	} catch (e: CryptoError) {
		throw new Fault(500, "ServiceFailure", "Request processing has failed due to an internal error.")
	}
}

/// The login profile of u.
function login(db: Tables, u: User): Login throws Fault {
	const l = db.logins.get(key(u.name))
	if (l == null) {
		throw api.noSuchEntityException(`Login Profile for User ${u.name} cannot be found.`)
	}
	return l
}

/// Throws unless password keeps to the account's password policy, if it has one: the first rule it breaks, in AWS's
/// words.
function conform(db: Tables, password: string) throws Fault {
	const p = db.account.get("")?.passwords
	if (p == null) {
		return
	}
	const has = (f: (c: u8) => bool) => {
		for (let i = 0; i < password.length; i++) {
			if (f(password[i])) {
				return true
			}
		}
		return false
	}
	let why = ""
	if (password.length < p!.length) {
		why = `Password should have a minimum length of ${p!.length}`
	} else if (p!.upper && !has(isUpper)) {
		why = "Password should have at least one uppercase letter"
	} else if (p!.lower && !has(isLower)) {
		why = "Password should have at least one lowercase letter"
	} else if (p!.numbers && !has(isDigit)) {
		why = "Password should have at least one number"
	} else if (p!.symbols && !has(c => !isUpper(c) && !isLower(c) && !isDigit(c))) {
		why = "Password should have at least one symbol"
	}
	if (why != "") {
		throw api.passwordPolicyViolationException(why)
	}
}

/// l, of u, as IAM gives it.
function profileOf(u: User, l: Login): api.LoginProfile {
	const p = new api.LoginProfile()
	p.UserName = u.name
	p.CreateDate = l.created
	p.PasswordResetRequired = l.reset
	p.MaxSigninSessionDuration = l.maxSession
	return p
}
