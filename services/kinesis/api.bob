/// The answer of h to req.
export function handle(h: Kinesis, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "linked"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "AcknowledgeDeadLetterQueueRecords": return c.serve(h.acknowledgeDeadLetterQueueRecords,
			["kinesis:AcknowledgeDeadLetterQueueRecords"])
		case "AcknowledgeQueueRecords": return c.serve(h.acknowledgeQueueRecords, ["kinesis:AcknowledgeQueueRecords"])
		case "AddTagsToStream": return c.serve(h.addTagsToStream, ["kinesis:AddTagsToStream"])
		case "CreateChannel": return c.serve(h.createChannel,
			["kinesis:AssociateStreamsWithChannel", "kinesis:CreateChannel", "iam:PassRole", "kinesis:TagResource"])
		case "CreateQueue": return c.serve(h.createQueue,
			["kinesis:AssociateStreamsWithQueue", "kinesis:CreateQueue", "kinesis:TagResource"])
		case "CreateStream": return c.serve(h.createStream, ["kinesis:AddTagsToStream", "kinesis:CreateStream"])
		case "DecreaseStreamRetentionPeriod": return c.serve(h.decreaseStreamRetentionPeriod,
			["kinesis:DecreaseStreamRetentionPeriod"])
		case "DeleteChannel": return c.serve(h.deleteChannel, ["kinesis:DeleteChannel"])
		case "DeleteQueue": return c.serve(h.deleteQueue, ["kinesis:DeleteQueue"])
		case "DeleteResourcePolicy": return c.serve(h.deleteResourcePolicy, ["kinesis:DeleteResourcePolicy"])
		case "DeleteStream": return c.serve(h.deleteStream, ["kinesis:DeleteStream"])
		case "DeregisterStreamConsumer": return c.serve(h.deregisterStreamConsumer,
			["kinesis:DeregisterStreamConsumer"])
		case "DescribeAccountSettings": return c.serve(h.describeAccountSettings, ["kinesis:DescribeAccountSettings"])
		case "DescribeChannel": return c.serve(h.describeChannel, ["kinesis:DescribeChannel"])
		case "DescribeLimits": return c.serve(h.describeLimits, ["kinesis:DescribeLimits"])
		case "DescribeQueue": return c.serve(h.describeQueue, ["kinesis:DescribeQueue"])
		case "DescribeStream": return c.serve(h.describeStream, ["kinesis:DescribeStream"])
		case "DescribeStreamConsumer": return c.serve(h.describeStreamConsumer, ["kinesis:DescribeStreamConsumer"])
		case "DescribeStreamSummary": return c.serve(h.describeStreamSummary, ["kinesis:DescribeStreamSummary"])
		case "DisableEnhancedMonitoring": return c.serve(h.disableEnhancedMonitoring,
			["kinesis:DisableEnhancedMonitoring"])
		case "EnableEnhancedMonitoring": return c.serve(h.enableEnhancedMonitoring,
			["kinesis:EnableEnhancedMonitoring"])
		case "GetRecords": return c.serve(h.getRecords, ["kinesis:GetRecords"])
		case "GetResourcePolicy": return c.serve(h.getResourcePolicy, ["kinesis:GetResourcePolicy"])
		case "GetShardIterator": return c.serve(h.getShardIterator, ["kinesis:GetShardIterator"])
		case "IncreaseStreamRetentionPeriod": return c.serve(h.increaseStreamRetentionPeriod,
			["kinesis:IncreaseStreamRetentionPeriod"])
		case "ListChannels": return c.serve(h.listChannels, ["kinesis:ListChannels"])
		case "ListQueues": return c.serve(h.listQueues, ["kinesis:ListQueues"])
		case "ListShards": return c.serve(h.listShards, ["kinesis:ListShards"])
		case "ListStreamConsumers": return c.serve(h.listStreamConsumers, ["kinesis:ListStreamConsumers"])
		case "ListStreams": return c.serve(h.listStreams, ["kinesis:ListStreams"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["kinesis:ListTagsForResource"])
		case "ListTagsForStream": return c.serve(h.listTagsForStream, ["kinesis:ListTagsForStream"])
		case "MergeShards": return c.serve(h.mergeShards, ["kinesis:MergeShards"])
		case "PutRecord": return c.serve(h.putRecord, ["kinesis:PutRecord"])
		case "PutRecords": return c.serve(h.putRecords, ["kinesis:PutRecords"])
		case "PutResourcePolicy": return c.serve(h.putResourcePolicy, ["kinesis:PutResourcePolicy"])
		case "ReceiveDeadLetterQueueRecords": return c.serve(h.receiveDeadLetterQueueRecords,
			["kinesis:ReceiveDeadLetterQueueRecords"])
		case "ReceiveQueueRecords": return c.serve(h.receiveQueueRecords,
			["kinesis:ReceiveQueueRecords", "kinesis:ReceiveQueueRecords"])
		case "RegisterStreamConsumer": return c.serve(h.registerStreamConsumer,
			["kinesis:RegisterStreamConsumer", "kinesis:TagResource"])
		case "RemoveTagsFromStream": return c.serve(h.removeTagsFromStream, ["kinesis:RemoveTagsFromStream"])
		case "RestoreDeadLetterQueueRecords": return c.serve(h.restoreDeadLetterQueueRecords,
			["kinesis:RestoreDeadLetterQueueRecords"])
		case "SplitShard": return c.serve(h.splitShard, ["kinesis:SplitShard"])
		case "StartStreamEncryption": return c.serve(h.startStreamEncryption, ["kinesis:StartStreamEncryption"])
		case "StopStreamEncryption": return c.serve(h.stopStreamEncryption, ["kinesis:StopStreamEncryption"])
		case "SubscribeToShard": return c.stream[SubscribeToShardInput, SubscribeToShardOutput,
			SubscribeToShardEventStream](h.subscribeToShard, o => o.EventStream, ["kinesis:SubscribeToShard"])
		case "TagResource": return c.serve(h.tagResource, ["kinesis:TagResource"])
		case "UntagResource": return c.serve(h.untagResource, ["kinesis:UntagResource"])
		case "UpdateAccountSettings": return c.serve(h.updateAccountSettings, ["kinesis:UpdateAccountSettings"])
		case "UpdateChannel": return c.serve(h.updateChannel, ["kinesis:UpdateChannel"])
		case "UpdateDeadLetterQueueRecordsVisibility": return c.serve(h.updateDeadLetterQueueRecordsVisibility,
			["kinesis:UpdateDeadLetterQueueRecordsVisibility"])
		case "UpdateMaxRecordSize": return c.serve(h.updateMaxRecordSize, ["kinesis:UpdateMaxRecordSize"])
		case "UpdateQueue": return c.serve(h.updateQueue, ["kinesis:UpdateQueue"])
		case "UpdateQueueRecordsVisibility": return c.serve(h.updateQueueRecordsVisibility,
			["kinesis:UpdateQueueRecordsVisibility"])
		case "UpdateShardCount": return c.serve(h.updateShardCount, ["kinesis:UpdateShardCount"])
		case "UpdateStreamMode": return c.serve(h.updateStreamMode, ["kinesis:UpdateStreamMode"])
		case "UpdateStreamRecordDistributionStrategy": return c.serve(h.updateStreamRecordDistributionStrategy,
			["kinesis:UpdateStreamRecordDistributionStrategy"])
		case "UpdateStreamWarmThroughput": return c.serve(h.updateStreamWarmThroughput,
			["kinesis:UpdateStreamWarmThroughput"])
		default: return c.unknownOperation()
	}
}
