	listTagsForResource(caller: Caller, input: ListTagsForResourceInput): ListTagsForResourceOutput throws Fault
	listTagsForStream(caller: Caller, input: ListTagsForStreamInput): ListTagsForStreamOutput throws Fault
	mergeShards(caller: Caller, input: MergeShardsInput): Unit throws Fault
	putRecord(caller: Caller, input: PutRecordInput): PutRecordOutput throws Fault
	putRecords(caller: Caller, input: PutRecordsInput): PutRecordsOutput throws Fault
	putResourcePolicy(caller: Caller, input: PutResourcePolicyInput): Unit throws Fault

