	listShards(caller: Caller, input: ListShardsInput): ListShardsOutput throws Fault {
		throw notImplemented("ListShards")
	}

	listStreamConsumers(caller: Caller, input: ListStreamConsumersInput): ListStreamConsumersOutput throws Fault {
		throw notImplemented("ListStreamConsumers")
	}

