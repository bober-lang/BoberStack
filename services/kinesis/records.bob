//! Kinesis's state in an account's regional tree: its streams by name, each with its shards; each shard's records by
//! the stream's name, a NUL, the shard's id, a NUL and the record's sequence number, whose fixed width makes byte order
//! the shard's order; and the consumers by the stream's name, a NUL and their own.

import { Fault } from "../../core/fault"
import { Store, Table } from "../../core/state/store"
import * as api from "./api"
import { EncodeError } from "std/encoding/json"
import { Decodable } from "std/types"

export class Stream {
	name = ""
	/// In ns, as are all times here.
	created: i64 = 0
	mode = "PROVISIONED"
	/// In hours.
	retention = 24
	maxRecordKiB = 1024
	shards: Shard[] = []
	/// What the last sequence number given counts: each record put, shard opened and shard closed takes the next.
	counter: i64 = 0
	tags: [string, string][] = []
	encryption = "NONE"
	keyId: string | null = null
	policy: string | null = null
	metrics: api.MetricsName[] = []
}

export class Shard {
	/// Its id's number, in the order the stream opened them.
	index = 0
	parent: string | null = null
	adjacent: string | null = null
	/// Its hash keys, in decimal.
	start = ""
	end = ""
	/// The sequence number it opened at, below its records', and the one it closed at, null while open.
	first = ""
	last: string | null = null
	opened: i64 = 0
	closed: i64 | null = null
}

export class Record {
	/// In base64.
	data = ""
	key = ""
	arrived: i64 = 0
	encrypted = false
}

export class Consumer {
	name = ""
	created: i64 = 0
	tags: [string, string][] = []
	policy: string | null = null
}

export function streams(s: Store): Table[Stream] { return new Table[Stream](s, "kinesis/streams") }
export function records(s: Store): Table[Record] { return new Table[Record](s, "kinesis/records") }
export function consumers(s: Store): Table[Consumer] { return new Table[Consumer](s, "kinesis/consumers") }

/// Puts v in t at key; a record holds no float, so JSON encodes it.
export function save[V extends Decodable](t: Table[V], key: string, v: V) throws Fault {
	try {
		t.put(key, v)
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}
