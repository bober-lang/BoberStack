/// Every operation, not implemented: a service mixes it in and declares those it implements.
export class Unimplemented {
	cancelKeyDeletion(caller: Caller, input: CancelKeyDeletionRequest): CancelKeyDeletionResponse throws Fault {
		throw notImplemented("CancelKeyDeletion")
	}

	connectCustomKeyStore(caller: Caller,
		input: ConnectCustomKeyStoreRequest): ConnectCustomKeyStoreResponse throws Fault {
		throw notImplemented("ConnectCustomKeyStore")
	}

	createAlias(caller: Caller, input: CreateAliasRequest): Unit throws Fault { throw notImplemented("CreateAlias") }

	createCustomKeyStore(caller: Caller,
		input: CreateCustomKeyStoreRequest): CreateCustomKeyStoreResponse throws Fault {
		throw notImplemented("CreateCustomKeyStore")
	}

	createGrant(caller: Caller, input: CreateGrantRequest): CreateGrantResponse throws Fault {
		throw notImplemented("CreateGrant")
	}

	createKey(caller: Caller, input: CreateKeyRequest): CreateKeyResponse throws Fault {
		throw notImplemented("CreateKey")
	}

	decapsulate(caller: Caller, input: DecapsulateRequest): DecapsulateResponse throws Fault {
		throw notImplemented("Decapsulate")
	}

