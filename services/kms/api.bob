export interface KMS {
	cancelKeyDeletion(caller: Caller, input: CancelKeyDeletionRequest): CancelKeyDeletionResponse throws Fault

	connectCustomKeyStore(caller: Caller,
		input: ConnectCustomKeyStoreRequest): ConnectCustomKeyStoreResponse throws Fault

	createAlias(caller: Caller, input: CreateAliasRequest): Unit throws Fault
	createCustomKeyStore(caller: Caller, input: CreateCustomKeyStoreRequest): CreateCustomKeyStoreResponse throws Fault
	createGrant(caller: Caller, input: CreateGrantRequest): CreateGrantResponse throws Fault
	createKey(caller: Caller, input: CreateKeyRequest): CreateKeyResponse throws Fault
	decapsulate(caller: Caller, input: DecapsulateRequest): DecapsulateResponse throws Fault
	decrypt(caller: Caller, input: DecryptRequest): DecryptResponse throws Fault
	deleteAlias(caller: Caller, input: DeleteAliasRequest): Unit throws Fault
	deleteCustomKeyStore(caller: Caller, input: DeleteCustomKeyStoreRequest): DeleteCustomKeyStoreResponse throws Fault

	deleteImportedKeyMaterial(caller: Caller,
		input: DeleteImportedKeyMaterialRequest): DeleteImportedKeyMaterialResponse throws Fault

	deriveSharedSecret(caller: Caller, input: DeriveSharedSecretRequest): DeriveSharedSecretResponse throws Fault

	describeCustomKeyStores(caller: Caller,
		input: DescribeCustomKeyStoresRequest): DescribeCustomKeyStoresResponse throws Fault

	describeKey(caller: Caller, input: DescribeKeyRequest): DescribeKeyResponse throws Fault
	disableKey(caller: Caller, input: DisableKeyRequest): Unit throws Fault
	disableKeyRotation(caller: Caller, input: DisableKeyRotationRequest): Unit throws Fault

	disconnectCustomKeyStore(caller: Caller,
		input: DisconnectCustomKeyStoreRequest): DisconnectCustomKeyStoreResponse throws Fault

	enableKey(caller: Caller, input: EnableKeyRequest): Unit throws Fault
	enableKeyRotation(caller: Caller, input: EnableKeyRotationRequest): Unit throws Fault
	encapsulate(caller: Caller, input: EncapsulateRequest): EncapsulateResponse throws Fault
	encrypt(caller: Caller, input: EncryptRequest): EncryptResponse throws Fault
	generateDataKey(caller: Caller, input: GenerateDataKeyRequest): GenerateDataKeyResponse throws Fault
	generateDataKeyPair(caller: Caller, input: GenerateDataKeyPairRequest): GenerateDataKeyPairResponse throws Fault

	generateDataKeyPairWithoutPlaintext(caller: Caller,
		input: GenerateDataKeyPairWithoutPlaintextRequest): GenerateDataKeyPairWithoutPlaintextResponse throws Fault

	generateDataKeyWithoutPlaintext(caller: Caller,
		input: GenerateDataKeyWithoutPlaintextRequest): GenerateDataKeyWithoutPlaintextResponse throws Fault

	generateMac(caller: Caller, input: GenerateMacRequest): GenerateMacResponse throws Fault
	generateRandom(caller: Caller, input: GenerateRandomRequest): GenerateRandomResponse throws Fault
	getKeyLastUsage(caller: Caller, input: GetKeyLastUsageRequest): GetKeyLastUsageResponse throws Fault
	getKeyPolicy(caller: Caller, input: GetKeyPolicyRequest): GetKeyPolicyResponse throws Fault
	getKeyRotationStatus(caller: Caller, input: GetKeyRotationStatusRequest): GetKeyRotationStatusResponse throws Fault

	getParametersForImport(caller: Caller,
		input: GetParametersForImportRequest): GetParametersForImportResponse throws Fault

	getPublicKey(caller: Caller, input: GetPublicKeyRequest): GetPublicKeyResponse throws Fault
	importKeyMaterial(caller: Caller, input: ImportKeyMaterialRequest): ImportKeyMaterialResponse throws Fault
	listAliases(caller: Caller, input: ListAliasesRequest): ListAliasesResponse throws Fault
	listGrants(caller: Caller, input: ListGrantsRequest): ListGrantsResponse throws Fault
	listKeyPolicies(caller: Caller, input: ListKeyPoliciesRequest): ListKeyPoliciesResponse throws Fault
	listKeyRotations(caller: Caller, input: ListKeyRotationsRequest): ListKeyRotationsResponse throws Fault
	listKeys(caller: Caller, input: ListKeysRequest): ListKeysResponse throws Fault
	listResourceTags(caller: Caller, input: ListResourceTagsRequest): ListResourceTagsResponse throws Fault
	listRetirableGrants(caller: Caller, input: ListRetirableGrantsRequest): ListGrantsResponse throws Fault
	putKeyPolicy(caller: Caller, input: PutKeyPolicyRequest): Unit throws Fault
	reEncrypt(caller: Caller, input: ReEncryptRequest): ReEncryptResponse throws Fault
	replicateKey(caller: Caller, input: ReplicateKeyRequest): ReplicateKeyResponse throws Fault
	retireGrant(caller: Caller, input: RetireGrantRequest): Unit throws Fault
	revokeGrant(caller: Caller, input: RevokeGrantRequest): Unit throws Fault
	rotateKeyOnDemand(caller: Caller, input: RotateKeyOnDemandRequest): RotateKeyOnDemandResponse throws Fault
	scheduleKeyDeletion(caller: Caller, input: ScheduleKeyDeletionRequest): ScheduleKeyDeletionResponse throws Fault
	sign(caller: Caller, input: SignRequest): SignResponse throws Fault
	tagResource(caller: Caller, input: TagResourceRequest): Unit throws Fault
	untagResource(caller: Caller, input: UntagResourceRequest): Unit throws Fault
	updateAlias(caller: Caller, input: UpdateAliasRequest): Unit throws Fault
	updateCustomKeyStore(caller: Caller, input: UpdateCustomKeyStoreRequest): UpdateCustomKeyStoreResponse throws Fault
	updateKeyDescription(caller: Caller, input: UpdateKeyDescriptionRequest): Unit throws Fault
