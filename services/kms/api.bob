/// The answer of h to req.
export function handle(h: KMS, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "linked"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "CancelKeyDeletion": return c.serve(h.cancelKeyDeletion, ["kms:CancelKeyDeletion"])
		case "ConnectCustomKeyStore": return c.serve(h.connectCustomKeyStore, ["kms:ConnectCustomKeyStore"])
		case "CreateAlias": return c.serve(h.createAlias, ["kms:CreateAlias"])
		case "CreateCustomKeyStore": return c.serve(h.createCustomKeyStore, ["kms:CreateCustomKeyStore"])
		case "CreateGrant": return c.serve(h.createGrant, ["kms:CreateGrant"])
		case "CreateKey": return c.serve(h.createKey, ["kms:CreateKey", "kms:PutKeyPolicy", "kms:TagResource"])
		case "Decapsulate": return c.serve(h.decapsulate, ["kms:Decapsulate"])
		case "Decrypt": return c.serve(h.decrypt, ["kms:Decrypt"])
		case "DeleteAlias": return c.serve(h.deleteAlias, ["kms:DeleteAlias"])
		case "DeleteCustomKeyStore": return c.serve(h.deleteCustomKeyStore, ["kms:DeleteCustomKeyStore"])
		case "DeleteImportedKeyMaterial": return c.serve(h.deleteImportedKeyMaterial, ["kms:DeleteImportedKeyMaterial"])
		case "DeriveSharedSecret": return c.serve(h.deriveSharedSecret, ["kms:DeriveSharedSecret"])
		case "DescribeCustomKeyStores": return c.serve(h.describeCustomKeyStores, ["kms:DescribeCustomKeyStores"])
		case "DescribeKey": return c.serve(h.describeKey, ["kms:DescribeKey"])
		case "DisableKey": return c.serve(h.disableKey, ["kms:DisableKey"])
		case "DisableKeyRotation": return c.serve(h.disableKeyRotation, ["kms:DisableKeyRotation"])
		case "DisconnectCustomKeyStore": return c.serve(h.disconnectCustomKeyStore, ["kms:DisconnectCustomKeyStore"])
		case "EnableKey": return c.serve(h.enableKey, ["kms:EnableKey"])
		case "EnableKeyRotation": return c.serve(h.enableKeyRotation, ["kms:EnableKeyRotation"])
		case "Encapsulate": return c.serve(h.encapsulate, ["kms:Encapsulate"])
		case "Encrypt": return c.serve(h.encrypt, ["kms:Encrypt"])
		case "GenerateDataKey": return c.serve(h.generateDataKey, ["kms:GenerateDataKey"])
		case "GenerateDataKeyPair": return c.serve(h.generateDataKeyPair, ["kms:GenerateDataKeyPair"])
		case "GenerateDataKeyPairWithoutPlaintext": return c.serve(h.generateDataKeyPairWithoutPlaintext,
			["kms:GenerateDataKeyPairWithoutPlaintext"])
		case "GenerateDataKeyWithoutPlaintext": return c.serve(h.generateDataKeyWithoutPlaintext,
			["kms:GenerateDataKeyWithoutPlaintext"])
		case "GenerateMac": return c.serve(h.generateMac, ["kms:GenerateMac"])
		case "GenerateRandom": return c.serve(h.generateRandom, ["kms:GenerateRandom"])
		case "GetKeyLastUsage": return c.serve(h.getKeyLastUsage, ["kms:GetKeyLastUsage"])
		case "GetKeyPolicy": return c.serve(h.getKeyPolicy, ["kms:GetKeyPolicy"])
		case "GetKeyRotationStatus": return c.serve(h.getKeyRotationStatus, ["kms:GetKeyRotationStatus"])
		case "GetParametersForImport": return c.serve(h.getParametersForImport, ["kms:GetParametersForImport"])
		case "GetPublicKey": return c.serve(h.getPublicKey, ["kms:GetPublicKey"])
		case "ImportKeyMaterial": return c.serve(h.importKeyMaterial, ["kms:ImportKeyMaterial"])
		case "ListAliases": return c.serve(h.listAliases, ["kms:ListAliases"])
		case "ListGrants": return c.serve(h.listGrants, ["kms:ListGrants"])
		case "ListKeyPolicies": return c.serve(h.listKeyPolicies, ["kms:ListKeyPolicies"])
		case "ListKeyRotations": return c.serve(h.listKeyRotations, ["kms:ListKeyRotations"])
		case "ListKeys": return c.serve(h.listKeys, ["kms:ListKeys"])
		case "ListResourceTags": return c.serve(h.listResourceTags, ["kms:ListResourceTags"])
		case "ListRetirableGrants": return c.serve(h.listRetirableGrants, ["kms:ListRetirableGrants"])
		case "PutKeyPolicy": return c.serve(h.putKeyPolicy, ["kms:PutKeyPolicy"])
		case "ReEncrypt": return c.serve(h.reEncrypt, ["kms:ReEncryptFrom", "kms:ReEncryptTo"])
		case "ReplicateKey": return c.serve(h.replicateKey, ["kms:ReplicateKey"])
		case "RetireGrant": return c.serve(h.retireGrant, ["kms:RetireGrant"])
		case "RevokeGrant": return c.serve(h.revokeGrant, ["kms:RevokeGrant"])
		case "RotateKeyOnDemand": return c.serve(h.rotateKeyOnDemand, ["kms:RotateKeyOnDemand"])
		case "ScheduleKeyDeletion": return c.serve(h.scheduleKeyDeletion, ["kms:ScheduleKeyDeletion"])
		case "Sign": return c.serve(h.sign, ["kms:Sign"])
		case "TagResource": return c.serve(h.tagResource, ["kms:TagResource"])
		case "UntagResource": return c.serve(h.untagResource, ["kms:UntagResource"])
		case "UpdateAlias": return c.serve(h.updateAlias, ["kms:UpdateAlias"])
		case "UpdateCustomKeyStore": return c.serve(h.updateCustomKeyStore, ["kms:UpdateCustomKeyStore"])
		case "UpdateKeyDescription": return c.serve(h.updateKeyDescription, ["kms:UpdateKeyDescription"])
		case "UpdatePrimaryRegion": return c.serve(h.updatePrimaryRegion, ["kms:UpdatePrimaryRegion"])
		case "Verify": return c.serve(h.verify, ["kms:Verify"])
		case "VerifyMac": return c.serve(h.verifyMac, ["kms:VerifyMac"])
		default: return c.unknownOperation()
	}
}
