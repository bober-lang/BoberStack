/// Every operation, not implemented: a service mixes it in and declares those it implements.
export class Unimplemented {
	addLayerVersionPermission(caller: Caller,
		input: AddLayerVersionPermissionRequest): AddLayerVersionPermissionResponse throws Fault {
		throw notImplemented("AddLayerVersionPermission")
	}

	addPermission(caller: Caller, input: AddPermissionRequest): AddPermissionResponse throws Fault {
		throw notImplemented("AddPermission")
	}

	checkpointDurableExecution(caller: Caller,
		input: CheckpointDurableExecutionRequest): CheckpointDurableExecutionResponse throws Fault {
		throw notImplemented("CheckpointDurableExecution")
	}

	createAlias(caller: Caller, input: CreateAliasRequest): AliasConfiguration throws Fault {
		throw notImplemented("CreateAlias")
	}

	createCapacityProvider(caller: Caller,
		input: CreateCapacityProviderRequest): CreateCapacityProviderResponse throws Fault {
		throw notImplemented("CreateCapacityProvider")
	}

	createCodeSigningConfig(caller: Caller,
		input: CreateCodeSigningConfigRequest): CreateCodeSigningConfigResponse throws Fault {
		throw notImplemented("CreateCodeSigningConfig")
	}

	createEventSourceMapping(caller: Caller,
		input: CreateEventSourceMappingRequest): EventSourceMappingConfiguration throws Fault {
		throw notImplemented("CreateEventSourceMapping")
	}

	createFunction(caller: Caller, input: CreateFunctionRequest): FunctionConfiguration throws Fault {
		throw notImplemented("CreateFunction")
	}

	createFunctionUrlConfig(caller: Caller,
		input: CreateFunctionUrlConfigRequest): CreateFunctionUrlConfigResponse throws Fault {
