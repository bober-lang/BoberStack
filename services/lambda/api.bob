/// The answer of h to req.
export function handle(h: Lambda, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDeniedException", "reasoned"]
	const c = restjson.call(caller, req, service, routes)
	switch (c.operation) {
		case "AddLayerVersionPermission": return c.serve(h.addLayerVersionPermission,
			["lambda:AddLayerVersionPermission"], 201)
		case "AddPermission": return c.serve(h.addPermission, ["lambda:AddPermission"], 201)
		case "CheckpointDurableExecution": return c.serve(h.checkpointDurableExecution,
			["lambda:CheckpointDurableExecution"])
		case "CreateAlias": return c.serve(h.createAlias, ["lambda:CreateAlias"], 201)
		case "CreateCapacityProvider": return c.serve(h.createCapacityProvider,
			["lambda:CreateCapacityProvider", "iam:PassRole", "lambda:TagResource"], 202)
		case "CreateCodeSigningConfig": return c.serve(h.createCodeSigningConfig,
			["lambda:CreateCodeSigningConfig", "lambda:TagResource"], 201)
		case "CreateEventSourceMapping": return c.serve(h.createEventSourceMapping,
			["lambda:CreateEventSourceMapping", "lambda:TagResource"], 202)
		case "CreateFunction": return c.serve(h.createFunction,
			["lambda:AssociateRuntimeAlias", "lambda:AssociateRuntimeVersion", "lambda:CreateFunction",
			"lambda:GetLayerVersion", "lambda:PassCapacityProvider", "iam:PassRole", "lambda:TagResource"], 201)
		case "CreateFunctionUrlConfig": return c.serve(h.createFunctionUrlConfig, ["lambda:CreateFunctionUrlConfig"],
			201)
		case "DeleteAlias": return c.serve(h.deleteAlias, ["lambda:DeleteAlias"], 204)
		case "DeleteCapacityProvider": return c.serve(h.deleteCapacityProvider, ["lambda:DeleteCapacityProvider"], 202)
		case "DeleteCodeSigningConfig": return c.serve(h.deleteCodeSigningConfig, ["lambda:DeleteCodeSigningConfig"],
			204)
		case "DeleteDurableExecution": return c.serve(h.deleteDurableExecution, [], 202)
		case "DeleteEventSourceMapping": return c.serve(h.deleteEventSourceMapping, ["lambda:DeleteEventSourceMapping"],
			202)
		case "DeleteFunction": return c.serve(h.deleteFunction, ["lambda:DeleteFunction"])
		case "DeleteFunctionCodeSigningConfig": return c.serve(h.deleteFunctionCodeSigningConfig,
			["lambda:DeleteFunctionCodeSigningConfig"], 204)
		case "DeleteFunctionConcurrency": return c.serve(h.deleteFunctionConcurrency,
			["lambda:DeleteFunctionConcurrency"], 204)
		case "DeleteFunctionEventInvokeConfig": return c.serve(h.deleteFunctionEventInvokeConfig,
			["lambda:DeleteFunctionEventInvokeConfig"], 204)
		case "DeleteFunctionUrlConfig": return c.serve(h.deleteFunctionUrlConfig, ["lambda:DeleteFunctionUrlConfig"],
			204)
		case "DeleteLayerVersion": return c.serve(h.deleteLayerVersion, ["lambda:DeleteLayerVersion"], 204)
		case "DeleteProvisionedConcurrencyConfig": return c.serve(h.deleteProvisionedConcurrencyConfig,
			["lambda:DeleteProvisionedConcurrencyConfig"], 204)
		case "DeleteResourcePolicy": return c.serve(h.deleteResourcePolicy,
			["lambda:DeleteResourcePolicy", "lambda:RemovePermission"], 204)
		case "GetAccountSettings": return c.serve(h.getAccountSettings, ["lambda:GetAccountSettings"])
		case "GetAlias": return c.serve(h.getAlias, ["lambda:GetAlias"])
		case "GetCapacityProvider": return c.serve(h.getCapacityProvider, ["lambda:GetCapacityProvider"])
		case "GetCodeSigningConfig": return c.serve(h.getCodeSigningConfig, ["lambda:GetCodeSigningConfig"])
		case "GetDurableExecution": return c.serve(h.getDurableExecution, ["lambda:GetDurableExecution"])
		case "GetDurableExecutionHistory": return c.serve(h.getDurableExecutionHistory,
			["lambda:GetDurableExecutionHistory"])
		case "GetDurableExecutionState": return c.serve(h.getDurableExecutionState, ["lambda:GetDurableExecutionState"])
		case "GetEventSourceMapping": return c.serve(h.getEventSourceMapping, ["lambda:GetEventSourceMapping"])
		case "GetFunction": return c.serve(h.getFunction, ["lambda:GetFunction", "lambda:ListTags"])
		case "GetFunctionCodeSigningConfig": return c.serve(h.getFunctionCodeSigningConfig,
			["lambda:GetFunctionCodeSigningConfig"])
		case "GetFunctionConcurrency": return c.serve(h.getFunctionConcurrency, ["lambda:GetFunctionConcurrency"])
		case "GetFunctionConfiguration": return c.serve(h.getFunctionConfiguration, ["lambda:GetFunctionConfiguration"])
		case "GetFunctionEventInvokeConfig": return c.serve(h.getFunctionEventInvokeConfig,
			["lambda:GetFunctionEventInvokeConfig"])
		case "GetFunctionRecursionConfig": return c.serve(h.getFunctionRecursionConfig,
			["lambda:GetFunctionRecursionConfig"])
		case "GetFunctionScalingConfig": return c.serve(h.getFunctionScalingConfig, ["lambda:GetFunctionScalingConfig"])
		case "GetFunctionUrlConfig": return c.serve(h.getFunctionUrlConfig, ["lambda:GetFunctionUrlConfig"])
		case "GetLayerVersion": return c.serve(h.getLayerVersion, ["lambda:GetLayerVersion"])
		case "GetLayerVersionByArn": return c.serve(h.getLayerVersionByArn, ["lambda:GetLayerVersion"])
		case "GetLayerVersionPolicy": return c.serve(h.getLayerVersionPolicy, ["lambda:GetLayerVersionPolicy"])
		case "GetPolicy": return c.serve(h.getPolicy, ["lambda:GetPolicy"])
		case "GetProvisionedConcurrencyConfig": return c.serve(h.getProvisionedConcurrencyConfig,
			["lambda:GetProvisionedConcurrencyConfig"])
		case "GetResourcePolicy": return c.serve(h.getResourcePolicy, ["lambda:GetPolicy", "lambda:GetResourcePolicy"])
		case "GetRuntimeManagementConfig": return c.serve(h.getRuntimeManagementConfig,
			["lambda:GetRuntimeManagementConfig"])
		case "Invoke": return c.serve(h.invoke, ["lambda:InvokeFunction"])
		case "InvokeAsync": return c.serve(h.invokeAsync, ["lambda:InvokeAsync"], 202)
		case "InvokeWithResponseStream": return c.fail(notImplemented("InvokeWithResponseStream"))
		case "ListAliases": return c.serve(h.listAliases, ["lambda:ListAliases"])
		case "ListCapacityProviders": return c.serve(h.listCapacityProviders, ["lambda:ListCapacityProviders"])
		case "ListCodeSigningConfigs": return c.serve(h.listCodeSigningConfigs, ["lambda:ListCodeSigningConfigs"])
		case "ListDurableExecutionsByFunction": return c.serve(h.listDurableExecutionsByFunction,
			["lambda:ListDurableExecutionsByFunction"])
		case "ListEventSourceMappings": return c.serve(h.listEventSourceMappings, ["lambda:ListEventSourceMappings"])
		case "ListFunctionEventInvokeConfigs": return c.serve(h.listFunctionEventInvokeConfigs,
			["lambda:ListFunctionEventInvokeConfigs"])
		case "ListFunctionUrlConfigs": return c.serve(h.listFunctionUrlConfigs, ["lambda:ListFunctionUrlConfigs"])
		case "ListFunctionVersionsByCapacityProvider": return c.serve(h.listFunctionVersionsByCapacityProvider,
			["lambda:ListFunctionVersionsByCapacityProvider"])
		case "ListFunctions": return c.serve(h.listFunctions, ["lambda:ListFunctions"])
		case "ListFunctionsByCodeSigningConfig": return c.serve(h.listFunctionsByCodeSigningConfig,
			["lambda:ListFunctionsByCodeSigningConfig"])
		case "ListLayerVersions": return c.serve(h.listLayerVersions, ["lambda:ListLayerVersions"])
		case "ListLayers": return c.serve(h.listLayers, ["lambda:ListLayers"])
		case "ListProvisionedConcurrencyConfigs": return c.serve(h.listProvisionedConcurrencyConfigs,
			["lambda:ListProvisionedConcurrencyConfigs"])
		case "ListTags": return c.serve(h.listTags, ["lambda:ListTags"])
		case "ListVersionsByFunction": return c.serve(h.listVersionsByFunction, ["lambda:ListVersionsByFunction"])
		case "PauseDurableExecution": return c.serve(h.pauseDurableExecution, [], 202)
		case "PublishLayerVersion": return c.serve(h.publishLayerVersion, ["lambda:PublishLayerVersion"], 201)
		case "PublishVersion": return c.serve(h.publishVersion, ["lambda:PublishVersion"], 201)
		case "PutFunctionCodeSigningConfig": return c.serve(h.putFunctionCodeSigningConfig,
			["lambda:PutFunctionCodeSigningConfig"])
		case "PutFunctionConcurrency": return c.serve(h.putFunctionConcurrency, ["lambda:PutFunctionConcurrency"])
		case "PutFunctionEventInvokeConfig": return c.serve(h.putFunctionEventInvokeConfig,
			["lambda:PutFunctionEventInvokeConfig"])
		case "PutFunctionRecursionConfig": return c.serve(h.putFunctionRecursionConfig,
			["lambda:PutFunctionRecursionConfig"])
		case "PutFunctionScalingConfig": return c.serve(h.putFunctionScalingConfig, ["lambda:PutFunctionScalingConfig"],
			202)
		case "PutProvisionedConcurrencyConfig": return c.serve(h.putProvisionedConcurrencyConfig,
			["lambda:PutProvisionedConcurrencyConfig"], 202)
		case "PutResourcePolicy": return c.serve(h.putResourcePolicy,
			["lambda:AddPermission", "lambda:PutResourcePolicy", "lambda:RemovePermission"])
		case "PutRuntimeManagementConfig": return c.serve(h.putRuntimeManagementConfig,
			["lambda:PutRuntimeManagementConfig"])
		case "RemoveLayerVersionPermission": return c.serve(h.removeLayerVersionPermission,
			["lambda:RemoveLayerVersionPermission"], 204)
		case "RemovePermission": return c.serve(h.removePermission, ["lambda:RemovePermission"], 204)
		case "ResumeDurableExecution": return c.serve(h.resumeDurableExecution, [], 202)
		case "SendDurableExecutionCallbackFailure": return c.serve(h.sendDurableExecutionCallbackFailure,
			["lambda:SendDurableExecutionCallbackFailure"])
		case "SendDurableExecutionCallbackHeartbeat": return c.serve(h.sendDurableExecutionCallbackHeartbeat,
			["lambda:SendDurableExecutionCallbackHeartbeat"])
		case "SendDurableExecutionCallbackSuccess": return c.serve(h.sendDurableExecutionCallbackSuccess,
			["lambda:SendDurableExecutionCallbackSuccess"])
		case "StopDurableExecution": return c.serve(h.stopDurableExecution, ["lambda:StopDurableExecution"])
		case "TagResource": return c.serve(h.tagResource, ["lambda:TagResource"], 204)
		case "UntagResource": return c.serve(h.untagResource, ["lambda:UntagResource"], 204)
		case "UpdateAlias": return c.serve(h.updateAlias, ["lambda:UpdateAlias"])
		case "UpdateCapacityProvider": return c.serve(h.updateCapacityProvider, ["lambda:UpdateCapacityProvider"], 202)
		case "UpdateCodeSigningConfig": return c.serve(h.updateCodeSigningConfig, ["lambda:UpdateCodeSigningConfig"])
		case "UpdateEventSourceMapping": return c.serve(h.updateEventSourceMapping, ["lambda:UpdateEventSourceMapping"],
			202)
		case "UpdateFunctionCode": return c.serve(h.updateFunctionCode, ["lambda:UpdateFunctionCode"])
		case "UpdateFunctionConfiguration": return c.serve(h.updateFunctionConfiguration,
			["lambda:AssociateRuntimeAlias", "lambda:AssociateRuntimeVersion", "lambda:GetLayerVersion",
			"lambda:PassCapacityProvider", "iam:PassRole", "lambda:UpdateFunctionConfiguration"])
		case "UpdateFunctionEventInvokeConfig": return c.serve(h.updateFunctionEventInvokeConfig,
			["lambda:UpdateFunctionEventInvokeConfig"])
		case "UpdateFunctionUrlConfig": return c.serve(h.updateFunctionUrlConfig, ["lambda:UpdateFunctionUrlConfig"])
		default: return c.unknownOperation()
	}
