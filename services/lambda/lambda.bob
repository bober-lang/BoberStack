	listProvisionedConcurrencyConfigs(caller: Caller, input: api.ListProvisionedConcurrencyConfigsRequest): api.ListProvisionedConcurrencyConfigsResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const found = db.provisioned.scan(input.Marker, 100000, `${t.name}:`)
		const n = input.MaxItems ?? 50
		const items: api.ProvisionedConcurrencyConfigListItem[] = []
		for (let i = 0; i < found.length && i < n; i++) {
			const [k, p] = found[i]
			items.push(provisionedOf(caller,
				{ ...new Target(), name: t.name, qualifier: k.slice(t.name.length + 1, k.length) }, p))
		}
		return { ...new api.ListProvisionedConcurrencyConfigsResponse(), ProvisionedConcurrencyConfigs: items,
			NextMarker: if (found.length > n) found[n - 1][0] else null }
	}

	putFunctionEventInvokeConfig(caller: Caller,
		input: api.PutFunctionEventInvokeConfigRequest): api.FunctionEventInvokeConfig throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const e = { ...new Invoking(), retries: input.MaximumRetryAttempts, age: input.MaximumEventAgeInSeconds,
			destination: input.DestinationConfig, modified: now() }
		db.invoking.put(`${t.name}:${t.qualifier ?? "$LATEST"}`, e)
		return invokingOf(caller, t.name, t.qualifier ?? "$LATEST", e)
	}

	updateFunctionEventInvokeConfig(caller: Caller,
		input: api.UpdateFunctionEventInvokeConfigRequest): api.FunctionEventInvokeConfig throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const e = invoking(caller, t)
		e.retries = input.MaximumRetryAttempts ?? e.retries
		e.age = input.MaximumEventAgeInSeconds ?? e.age
		e.destination = input.DestinationConfig ?? e.destination
		e.modified = now()
		(new Tables(caller).invoking).put(`${t.name}:${t.qualifier ?? "$LATEST"}`, e)
		return invokingOf(caller, t.name, t.qualifier ?? "$LATEST", e)
	}

