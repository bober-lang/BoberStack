	putProvisionedConcurrencyConfig(caller: Caller,
		input: api.PutProvisionedConcurrencyConfigRequest): api.PutProvisionedConcurrencyConfigResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		if (version(caller, db, t).version == "$LATEST") {
			throw invalid("Provisioned Concurrency Configs cannot be applied to unpublished function versions.")
		}
		const p = { ...new Provisioned(), requested: input.ProvisionedConcurrentExecutions, modified: stamp() }
		save(db.provisioned, `${t.name}:${t.qualifier}`, p)
		const c = provisionedOf(caller, t, p)
		return { ...new api.PutProvisionedConcurrencyConfigResponse(),
			RequestedProvisionedConcurrentExecutions: c.RequestedProvisionedConcurrentExecutions,
			AllocatedProvisionedConcurrentExecutions: c.AllocatedProvisionedConcurrentExecutions,
			AvailableProvisionedConcurrentExecutions: c.AvailableProvisionedConcurrentExecutions, Status: c.Status,
			LastModified: c.LastModified }
	}

	getProvisionedConcurrencyConfig(caller: Caller,
		input: api.GetProvisionedConcurrencyConfigRequest): api.GetProvisionedConcurrencyConfigResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const c = provisionedOf(caller, t, provisioned(caller, t))
		return { ...new api.GetProvisionedConcurrencyConfigResponse(),
			RequestedProvisionedConcurrentExecutions: c.RequestedProvisionedConcurrentExecutions,
			AllocatedProvisionedConcurrentExecutions: c.AllocatedProvisionedConcurrentExecutions,
			AvailableProvisionedConcurrentExecutions: c.AvailableProvisionedConcurrentExecutions, Status: c.Status,
			LastModified: c.LastModified }
	}

