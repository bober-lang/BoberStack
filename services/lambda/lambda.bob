//! AWS Lambda's control plane: functions, their versions, aliases, resource policies, tags, reserved concurrency and
//! event source mappings.
//!
//! Nothing runs a function, and nothing polls an event source mapping's source. Invoke authorizes the call and finds the function and its qualifier as AWS does, then
//! answers status 200 with X-Amz-Function-Error: Unhandled and a payload whose errorType is NotImplemented, as a
//! function that failed: SDKs hand that back to the caller as is, where a 5xx would be retried; a DryRun answers 204
//! as AWS's. There is no background work: a function is Active, and its last update Successful, from the answer that
//! makes it, and a mapping Enabled from the first read after its creation. Where AWS differs further: GetFunction answers no Code.Location, as this server serves no download of a
//! function's code; the role must exist and trust lambda.amazonaws.com, but is never assumed; an image's URI is not
//! checked, and its CodeSha256 is that of the URI. A mapping's source, a queue's or stream's ARN, is not checked to
//! exist. A function URL is shaped as AWS's and serves nothing. A zip in S3 is read as the caller, as AWS reads it.
//! Layers, event invoke configs, provisioned concurrency and code signing are not implemented.

import { Fault } from "../../core/fault"
import { Caller, Context, requestTags, Unit } from "../../core/service"
import { BlobWriter, Table } from "../../core/state/store"
import * as iam from "../iam/records"
import * as s3Api from "../s3/api"
import * as s3 from "../s3/s3"
import * as api from "./api"
import { indexOf, lastIndexOf, startsWith } from "std/algo"
import { CryptoError } from "std/crypto/error"
import { sha256 } from "std/crypto/hash"
import { bytes } from "std/crypto/random"
import * as base64 from "std/encoding/base64"
import * as hex from "std/encoding/hex"
import * as json from "std/encoding/json"
import { EncodeError } from "std/encoding/json"
import { ParseError, replace, split } from "std/string"
import { millisecond, rfc3339 } from "std/time"
import { Decodable } from "std/types"

/// A function: what its versions share.
class Function {
	name = ""
	/// The number of the latest version published, 0 before any.
	published: i32 = 0
	tags: [string, string][] = []
	reserved: i32 | null = null
}

/// A version of a function, $LATEST among them; its code is the blob stored with it.
class Version {
	name = ""
	version = "$LATEST"
	runtime: api.Runtime | null = null
	role = ""
	handler: string | null = null
	description = ""
	timeout: i32 = 3
	memory: i32 = 128
	sha = ""
	size: i64 = 0
	modified = ""
	revision = ""
	packaged: api.PackageType = "Zip"
	image: string | null = null
	environment: [string, string][] | null = null
	layers: string[] = []
	architectures: api.Architecture[] = ["x86_64"]
	ephemeral: i32 = 512
	tracing: api.TracingMode = "PassThrough"
	deadLetter: string | null = null
	vpc: api.VpcConfig | null = null
	logging: api.LoggingConfig | null = null
	kms: string | null = null
}

/// An event source mapping, which nothing polls.
class Mapping {
	uuid = ""
	source = ""
	function = ""
	enabled = true
	batch: i32 = 10
	window: i32 = 0
	position: api.EventSourcePosition | null = null
	positioned: i64 | null = null
	modified: i64 = 0
	filter: api.FilterCriteria | null = null
	destination: api.DestinationConfig | null = null
	age: i32 | null = null
	bisect: bool | null = null
	retries: i32 | null = null
	tumbling: i32 | null = null
	parallelization: i32 | null = null
	responses: api.FunctionResponseType[] | null = null
	tags: [string, string][] = []
}

/// A function URL, which serves nothing.
class Url {
	id = ""
	auth: api.FunctionUrlAuthType = "NONE"
	cors: api.Cors | null = null
	mode: api.InvokeMode = "BUFFERED"
	created = ""
	modified = ""
}

class Alias {
	name = ""
	version = ""
	description = ""
	weights: [string, f64][] | null = null
	revision = ""
}

/// A resource policy's statements, by their ids, as JSON.
class Policy {
	statements: [string, string][] = []
	revision = ""
}

/// Lambda's state in an account's regional tree: functions by name; versions, aliases and policies by the function's
/// name, a colon and the version's key, the alias's name or the qualifier, "" for the unqualified function's.
class Tables {
	functions: Table[Function]
	versions: Table[Version]
	aliases: Table[Alias]
	policies: Table[Policy]
	/// By UUID.
	mappings: Table[Mapping]
	urls: Table[Url]

	constructor(caller: Caller) throws Fault {
		const s = caller.regional()
		this.functions = new Table[Function](s, "lambda.functions")
		this.versions = new Table[Version](s, "lambda.versions")
		this.aliases = new Table[Alias](s, "lambda.aliases")
		this.policies = new Table[Policy](s, "lambda.policies")
		this.mappings = new Table[Mapping](s, "lambda.mappings")
		this.urls = new Table[Url](s, "lambda.urls")
	}
}

/// A function, or a version or alias of it, as a request names it.
class Target {
	name = ""
	qualifier: string | null = null
}

/// The service, of the operations implemented.
export class Handler {
	...api.Unimplemented

	/// S3, which a function's code is read from as the caller.
	s3: s3.Handler | null = null

	createFunction(caller: Caller, input: api.CreateFunctionRequest): api.FunctionConfiguration throws Fault {
		const t = target(caller, input.FunctionName, null)
		caller.allow(arn(caller, t.name, null), null, requestTags(input.Tags ?? []))
		const db = new Tables(caller)
		if (db.functions.get(t.name) != null) {
			throw api.resourceConflictException(`Function already exist: ${t.name}`, conflict())
		}
		assumable(caller, input.Role, arn(caller, t.name, null))
		const v = new Version()
		v.name = t.name
		v.packaged = input.PackageType ?? "Zip"
		if (v.packaged == "Zip") {
			if (input.Runtime == null || input.Handler == null) {
				throw invalid("Runtime and Handler are mandatory parameters for functions created with deployment packages.")
			}
		} else if (input.Code.ImageUri == null) {
			throw invalid("Please provide a source for function code.")
		}
		v.runtime = input.Runtime
		v.handler = input.Handler
		v.role = input.Role
		v.description = input.Description ?? ""
		v.timeout = input.Timeout ?? 3
		v.memory = input.MemorySize ?? 128
		v.environment = input.Environment?.Variables
		v.layers = input.Layers ?? []
		v.architectures = input.Architectures ?? ["x86_64"]
		v.ephemeral = input.EphemeralStorage?.Size ?? 512
		v.tracing = input.TracingConfig?.Mode ?? "PassThrough"
		v.deadLetter = input.DeadLetterConfig?.TargetArn
		v.vpc = input.VpcConfig
		v.logging = input.LoggingConfig
		v.kms = input.KMSKeyArn
		const zip = if (v.packaged == "Zip") source(this.s3, caller, input.Code.ZipFile, input.Code.S3Bucket,
			input.Code.S3Key, input.Code.S3ObjectVersion)
			else null
		const f = new Function()
		f.name = t.name
		f.tags = input.Tags ?? []
		save(db.functions, f.name, f)
		code(db, v, zip, input.Code.ImageUri)
		if (input.Publish) {
			return configuration(caller, publish(caller, db, f, v, ""))
		}
		return configuration(caller, v)
	}

	getFunction(caller: Caller, input: api.GetFunctionRequest): api.GetFunctionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		const f = db.functions.get(t.name)!
		const r = new api.GetFunctionResponse()
		r.Configuration = configuration(caller, v)
		r.Code = new api.FunctionCodeLocation()
		if (v.packaged == "Zip") {
			r.Code.RepositoryType = "S3"
		} else {
			r.Code.RepositoryType = "ECR"
			r.Code.ImageUri = v.image
			r.Code.ResolvedImageUri = v.image
		}
		if (t.qualifier == null) {
			r.Tags = f.tags
		}
		if (f.reserved != null) {
			r.Concurrency = { ...new api.Concurrency(), ReservedConcurrentExecutions: f.reserved }
		}
		return r
	}

	getFunctionConfiguration(caller: Caller,
		input: api.GetFunctionConfigurationRequest): api.FunctionConfiguration throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		return configuration(caller, version(caller, db, t))
	}

	listFunctions(caller: Caller, input: api.ListFunctionsRequest): api.ListFunctionsResponse throws Fault {
		caller.allow("*")
		const all = input.FunctionVersion == "ALL"
		const found = new Tables(caller).versions.scan(input.Marker,
			100000).filter(e => all || e[1].version == "$LATEST")
		const [page, next] = paged(found, input.MaxItems)
		const r = new api.ListFunctionsResponse()
		r.Functions = page.map(v => configuration(caller, v))
		r.NextMarker = next
		return r
	}

	updateFunctionCode(caller: Caller, input: api.UpdateFunctionCodeRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		revised(input.RevisionId, v.revision)
		if (input.Architectures != null) {
			v.architectures = input.Architectures!
		}
		const zip = if (input.ImageUri != null) null
			else source(this.s3, caller, input.ZipFile, input.S3Bucket, input.S3Key, input.S3ObjectVersion)
		if (input.DryRun) {
			return configuration(caller, v)
		}
		code(db, v, zip, input.ImageUri)
		if (input.Publish) {
			return configuration(caller, publish(caller, db, db.functions.get(t.name)!, v, ""))
		}
		return configuration(caller, v)
	}

	updateFunctionConfiguration(caller: Caller,
		input: api.UpdateFunctionConfigurationRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		revised(input.RevisionId, v.revision)
		if (input.Role != null) {
			assumable(caller, input.Role!, arn(caller, t.name, null))
			v.role = input.Role!
		}
		v.handler = input.Handler ?? v.handler
		v.runtime = input.Runtime ?? v.runtime
		v.description = input.Description ?? v.description
		v.timeout = input.Timeout ?? v.timeout
		v.memory = input.MemorySize ?? v.memory
		if (input.Environment != null) {
			v.environment = input.Environment!.Variables
		}
		v.layers = input.Layers ?? v.layers
		v.ephemeral = input.EphemeralStorage?.Size ?? v.ephemeral
		v.tracing = input.TracingConfig?.Mode ?? v.tracing
		if (input.DeadLetterConfig != null) {
			v.deadLetter = input.DeadLetterConfig!.TargetArn
		}
		v.vpc = input.VpcConfig ?? v.vpc
		v.logging = input.LoggingConfig ?? v.logging
		v.kms = input.KMSKeyArn ?? v.kms
		changed(db, v)
		return configuration(caller, v)
	}

	deleteFunction(caller: Caller, input: api.DeleteFunctionRequest): api.DeleteFunctionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const r = { ...new api.DeleteFunctionResponse(), StatusCode: 204 }
		if (t.qualifier != null) {
			if (t.qualifier == "$LATEST") {
				throw invalid("$LATEST version cannot be deleted without deleting the function.")
			}
			const v = version(caller, db, t)
			for (const [_, a] of db.aliases.scan(null, 100000, `${t.name}:`)) {
				if (a.version == v.version) {
					throw api.resourceConflictException(`Unable to delete version because the following aliases reference it: [${a.name}]`,
						conflict())
				}
			}
			db.versions.delete(`${t.name}:${key(v.version)}`)
			db.policies.delete(`${t.name}:${v.version}`)
			return r
		}
		version(caller, db, t)
		db.functions.delete(t.name)
		for (const [k, _] of db.versions.scan(null, 100000, `${t.name}:`)) {
			db.versions.delete(k)
		}
		for (const [k, _] of db.aliases.scan(null, 100000, `${t.name}:`)) {
			db.aliases.delete(k)
		}
		for (const [k, _] of db.policies.scan(null, 100000, `${t.name}:`)) {
			db.policies.delete(k)
		}
		for (const [k, _] of db.urls.scan(null, 100000, `${t.name}:`)) {
			db.urls.delete(k)
		}
		return r
	}

	publishVersion(caller: Caller, input: api.PublishVersionRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		if (input.CodeSha256 != null && input.CodeSha256 != v.sha) {
			throw invalid(`CodeSHA256 (${input.CodeSha256}) is different from current CodeSHA256 in $LATEST (${v.sha}). `
				+ "Please try again with the current CodeSHA256.")
		}
		revised(input.RevisionId, v.revision)
		return configuration(caller,
			publish(caller, db, db.functions.get(t.name)!, v, input.Description ?? v.description))
	}

	listVersionsByFunction(caller: Caller,
		input: api.ListVersionsByFunctionRequest): api.ListVersionsByFunctionResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const [page, next] = paged(db.versions.scan(input.Marker, 100000, `${t.name}:`), input.MaxItems)
		const r = new api.ListVersionsByFunctionResponse()
		r.Versions = page.map(v => configuration(caller, v))
		r.NextMarker = next
		return r
	}

	createAlias(caller: Caller, input: api.CreateAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null))
		version(caller, db, t)
		const k = `${t.name}:${input.Name}`
		if (db.aliases.get(k) != null) {
			throw api.resourceConflictException(`Alias already exists: ${arn(caller, t.name, input.Name)}`, conflict())
		}
		const a = new Alias()
		a.name = input.Name
		a.description = input.Description ?? ""
		pointed(caller, db, t.name, a, input.FunctionVersion, input.RoutingConfig)
		a.revision = uuid()
		save(db.aliases, k, a)
		return aliasOf(caller, t.name, a)
	}

	getAlias(caller: Caller, input: api.GetAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null))
		return aliasOf(caller, t.name, alias(caller, db, t.name, input.Name))
	}

	updateAlias(caller: Caller, input: api.UpdateAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null))
		const a = alias(caller, db, t.name, input.Name)
		revised(input.RevisionId, a.revision)
		a.description = input.Description ?? a.description
		const kept = new api.AliasRoutingConfiguration()
		kept.AdditionalVersionWeights = a.weights
		pointed(caller, db, t.name, a, input.FunctionVersion ?? a.version, input.RoutingConfig ?? kept)
		a.revision = uuid()
		save(db.aliases, `${t.name}:${a.name}`, a)
		return aliasOf(caller, t.name, a)
	}

	deleteAlias(caller: Caller, input: api.DeleteAliasRequest): Unit throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null))
		db.aliases.delete(`${t.name}:${input.Name}`)
		db.policies.delete(`${t.name}:${input.Name}`)
		db.urls.delete(`${t.name}:${input.Name}`)
		return new Unit()
	}

	listAliases(caller: Caller, input: api.ListAliasesRequest): api.ListAliasesResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const found = db.aliases.scan(input.Marker, 100000,
			`${t.name}:`).filter(e => input.FunctionVersion == null || e[1].version == input.FunctionVersion)
		const [page, next] = paged(found, input.MaxItems)
		const r = new api.ListAliasesResponse()
		r.Aliases = page.map(a => aliasOf(caller, t.name, a))
		r.NextMarker = next
		return r
	}

	addPermission(caller: Caller, input: api.AddPermissionRequest): api.AddPermissionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const k = `${t.name}:${t.qualifier ?? ""}`
		const p = db.policies.get(k) ?? new Policy()
		revised(input.RevisionId, p.revision)
		for (const [sid, _] of p.statements) {
			if (sid == input.StatementId) {
				throw api.resourceConflictException(`The statement id (${input.StatementId}) provided already exists. `
					+ "Please provide a new statement id, or remove the existing statement.", conflict())
			}
		}
		const s = statement(caller, input, arn(caller, t.name, t.qualifier))
		p.statements.push([input.StatementId, s])
		p.revision = uuid()
		save(db.policies, k, p)
		return { ...new api.AddPermissionResponse(), Statement: s }
	}

	removePermission(caller: Caller, input: api.RemovePermissionRequest): Unit throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const k = `${t.name}:${t.qualifier ?? ""}`
		const p = db.policies.get(k)
		const kept = (p?.statements ?? []).filter(e => e[0] != input.StatementId)
		if (p == null || kept.length == p!.statements.length) {
			throw api.resourceNotFoundException(`Statement ${input.StatementId} is not found in resource policy.`,
				user())
		}
		revised(input.RevisionId, p!.revision)
		if (kept.length == 0) {
			db.policies.delete(k)
		} else {
			p!.statements = kept
			p!.revision = uuid()
			save(db.policies, k, p!)
		}
		return new Unit()
	}

	getPolicy(caller: Caller, input: api.GetPolicyRequest): api.GetPolicyResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const p = db.policies.get(`${t.name}:${t.qualifier ?? ""}`)
		if (p == null) {
			throw api.resourceNotFoundException("The resource you requested does not exist.", user())
		}
		return { ...new api.GetPolicyResponse(), Policy: document(p!), RevisionId: p!.revision }
	}

	tagResource(caller: Caller, input: api.TagResourceRequest): Unit throws Fault {
		const [db, f] = tagged(caller, input.Resource)
		const kept = f.tags.filter(e => input.Tags.filter(n => n[0] == e[0]).length == 0)
		for (const e of input.Tags) {
			kept.push(e)
		}
		f.tags = kept
		save(db.functions, f.name, f)
		return new Unit()
	}

	untagResource(caller: Caller, input: api.UntagResourceRequest): Unit throws Fault {
		const [db, f] = tagged(caller, input.Resource)
		f.tags = f.tags.filter(e => input.TagKeys.filter(k => k == e[0]).length == 0)
		save(db.functions, f.name, f)
		return new Unit()
	}

	listTags(caller: Caller, input: api.ListTagsRequest): api.ListTagsResponse throws Fault {
		const [_, f] = tagged(caller, input.Resource)
		return { ...new api.ListTagsResponse(), Tags: f.tags }
	}

	putFunctionConcurrency(caller: Caller, input: api.PutFunctionConcurrencyRequest): api.Concurrency throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const f = db.functions.get(t.name)!
		f.reserved = input.ReservedConcurrentExecutions
		save(db.functions, f.name, f)
		return { ...new api.Concurrency(), ReservedConcurrentExecutions: f.reserved }
	}

	getFunctionConcurrency(caller: Caller,
		input: api.GetFunctionConcurrencyRequest): api.GetFunctionConcurrencyResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		return { ...new api.GetFunctionConcurrencyResponse(),
			ReservedConcurrentExecutions: db.functions.get(t.name)!.reserved }
	}

	deleteFunctionConcurrency(caller: Caller, input: api.DeleteFunctionConcurrencyRequest): Unit throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const f = db.functions.get(t.name)!
		f.reserved = null
		save(db.functions, f.name, f)
		return new Unit()
	}

	getAccountSettings(caller: Caller,
		input: api.GetAccountSettingsRequest): api.GetAccountSettingsResponse throws Fault {
		caller.allow("*")
		const db = new Tables(caller)
		const r = new api.GetAccountSettingsResponse()
		const l = { ...new api.AccountLimit(), TotalCodeSize: 80530636800, CodeSizeUnzipped: 262144000,
			CodeSizeZipped: 52428800, ConcurrentExecutions: 1000 }
		r.AccountLimit = l
		let reserved = 0
		let count: i64 = 0
		for (const [_, f] of db.functions.scan(null, 100000)) {
			reserved += f.reserved ?? 0
			count++
		}
		let size: i64 = 0
		for (const [_, v] of db.versions.scan(null, 100000)) {
			size += v.size
		}
		l.UnreservedConcurrentExecutions = 1000 - reserved
		r.AccountUsage = { ...new api.AccountUsage(), TotalCodeSize: size, FunctionCount: count }
		return r
	}

	createFunctionUrlConfig(caller: Caller,
		input: api.CreateFunctionUrlConfigRequest): api.CreateFunctionUrlConfigResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const k = `${t.name}:${t.qualifier ?? ""}`
		if (db.urls.get(k) != null) {
			throw api.resourceConflictException(`Failed to create function url config for [functionArn = `
				+ `${arn(caller, t.name, t.qualifier)}]. Error message:  FunctionUrlConfig exists for this Lambda function`,
				conflict())
		}
		const u = new Url()
		u.id = replace(uuid(), "-", "")
		u.auth = input.AuthType
		u.cors = input.Cors
		u.mode = input.InvokeMode ?? "BUFFERED"
		u.created = stamp()
		u.modified = u.created
		save(db.urls, k, u)
		const c = urlOf(caller, t, u)
		return { ...new api.CreateFunctionUrlConfigResponse(), FunctionUrl: c.FunctionUrl, FunctionArn: c.FunctionArn,
			AuthType: c.AuthType, Cors: c.Cors, CreationTime: c.CreationTime, InvokeMode: c.InvokeMode }
	}

	getFunctionUrlConfig(caller: Caller,
		input: api.GetFunctionUrlConfigRequest): api.GetFunctionUrlConfigResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const c = urlOf(caller, t, url(caller, t))
		return { ...new api.GetFunctionUrlConfigResponse(), FunctionUrl: c.FunctionUrl, FunctionArn: c.FunctionArn,
			AuthType: c.AuthType, Cors: c.Cors, CreationTime: c.CreationTime, LastModifiedTime: c.LastModifiedTime,
			InvokeMode: c.InvokeMode }
	}

	updateFunctionUrlConfig(caller: Caller,
		input: api.UpdateFunctionUrlConfigRequest): api.UpdateFunctionUrlConfigResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const u = url(caller, t)
		u.auth = input.AuthType ?? u.auth
		u.cors = input.Cors ?? u.cors
		u.mode = input.InvokeMode ?? u.mode
		u.modified = stamp()
		save(new Tables(caller).urls, `${t.name}:${t.qualifier ?? ""}`, u)
		const c = urlOf(caller, t, u)
		return { ...new api.UpdateFunctionUrlConfigResponse(), FunctionUrl: c.FunctionUrl, FunctionArn: c.FunctionArn,
			AuthType: c.AuthType, Cors: c.Cors, CreationTime: c.CreationTime, LastModifiedTime: c.LastModifiedTime,
			InvokeMode: c.InvokeMode }
	}

	deleteFunctionUrlConfig(caller: Caller, input: api.DeleteFunctionUrlConfigRequest): Unit throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		url(caller, t)
		new Tables(caller).urls.delete(`${t.name}:${t.qualifier ?? ""}`)
		return new Unit()
	}

	listFunctionUrlConfigs(caller: Caller,
		input: api.ListFunctionUrlConfigsRequest): api.ListFunctionUrlConfigsResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const found = db.urls.scan(input.Marker, 100000, `${t.name}:`)
		const n = input.MaxItems ?? 50
		const r = new api.ListFunctionUrlConfigsResponse()
		for (let i = 0; i < found.length && i < n; i++) {
			const [k, u] = found[i]
			const q = k.slice(t.name.length + 1, k.length)
			r.FunctionUrlConfigs.push(urlOf(caller,
				{ ...new Target(), name: t.name, qualifier: if (q == "") null else q }, u))
		}
		r.NextMarker = if (found.length > n) found[n - 1][0] else null
		return r
	}

	createEventSourceMapping(caller: Caller,
		input: api.CreateEventSourceMappingRequest): api.EventSourceMappingConfiguration throws Fault {
		const t = target(caller, input.FunctionName, null)
		const db = new Tables(caller)
		const fn = arn(caller, t.name, t.qualifier)
		const context = requestTags(input.Tags ?? [])
		context.push(["lambda:FunctionArn", fn])
		caller.allow("*", null, context)
		version(caller, db, t)
		const source = input.EventSourceArn ?? ""
		const kind = split(source, ":")
		if (kind.length < 6 || (kind[2] != "sqs" && kind[2] != "kinesis" && kind[2] != "dynamodb")) {
			throw invalid(`Unrecognized event source, must be kinesis, dynamodb stream or sqs. Unsupported source arn : ${source}`)
		}
		for (const [_, m] of db.mappings.scan(null, 100000)) {
			if (m.source == source && m.function == fn) {
				throw api.resourceConflictException(`The event source arn (" ${source} ") and function (" ${t.name} ") `
					+ `provided mapping already exists. Please update or delete the existing mapping with UUID ${m.uuid}`,
					conflict())
			}
		}
		const m = new Mapping()
		m.uuid = uuid()
		m.source = source
		m.function = fn
		m.enabled = input.Enabled ?? true
		m.batch = input.BatchSize ?? (if (kind[2] == "sqs") 10 else 100)
		m.window = input.MaximumBatchingWindowInSeconds ?? 0
		m.position = input.StartingPosition
		m.positioned = input.StartingPositionTimestamp
		m.filter = input.FilterCriteria
		m.destination = input.DestinationConfig
		if (kind[2] != "sqs") {
			m.age = input.MaximumRecordAgeInSeconds ?? -1
			m.bisect = input.BisectBatchOnFunctionError ?? false
			m.retries = input.MaximumRetryAttempts ?? -1
			m.tumbling = input.TumblingWindowInSeconds ?? 0
			m.parallelization = input.ParallelizationFactor ?? 1
		}
		m.responses = input.FunctionResponseTypes ?? []
		m.tags = input.Tags ?? []
		m.modified = now()
		save(db.mappings, m.uuid, m)
		return mappingOf(caller, m, if (m.enabled) "Creating" else "Disabled")
	}

	getEventSourceMapping(caller: Caller,
		input: api.GetEventSourceMappingRequest): api.EventSourceMappingConfiguration throws Fault {
		const [_, m] = mapping(caller, input.UUID)
		return mappingOf(caller, m, if (m.enabled) "Enabled" else "Disabled")
	}

	updateEventSourceMapping(caller: Caller,
		input: api.UpdateEventSourceMappingRequest): api.EventSourceMappingConfiguration throws Fault {
		const [db, m] = mapping(caller, input.UUID)
		if (input.FunctionName != null) {
			const t = target(caller, input.FunctionName!, null)
			version(caller, db, t)
			m.function = arn(caller, t.name, t.qualifier)
		}
		m.enabled = input.Enabled ?? m.enabled
		m.batch = input.BatchSize ?? m.batch
		m.window = input.MaximumBatchingWindowInSeconds ?? m.window
		m.filter = input.FilterCriteria ?? m.filter
		m.destination = input.DestinationConfig ?? m.destination
		m.age = input.MaximumRecordAgeInSeconds ?? m.age
		m.bisect = input.BisectBatchOnFunctionError ?? m.bisect
		m.retries = input.MaximumRetryAttempts ?? m.retries
		m.tumbling = input.TumblingWindowInSeconds ?? m.tumbling
		m.parallelization = input.ParallelizationFactor ?? m.parallelization
		m.responses = input.FunctionResponseTypes ?? m.responses
		m.modified = now()
		save(db.mappings, m.uuid, m)
		return mappingOf(caller, m, if (m.enabled) "Enabled" else "Disabled")
	}

	deleteEventSourceMapping(caller: Caller,
		input: api.DeleteEventSourceMappingRequest): api.EventSourceMappingConfiguration throws Fault {
		const [db, m] = mapping(caller, input.UUID)
		db.mappings.delete(m.uuid)
		return mappingOf(caller, m, "Deleting")
	}

	listEventSourceMappings(caller: Caller,
		input: api.ListEventSourceMappingsRequest): api.ListEventSourceMappingsResponse throws Fault {
		caller.allow("*")
		let fn: string | null = null
		if (input.FunctionName != null) {
			const t = target(caller, input.FunctionName!, null)
			fn = arn(caller, t.name, t.qualifier)
		}
		const found = new Tables(caller).mappings.scan(input.Marker, 100000).filter(e => (fn == null
			|| e[1].function == fn) && (input.EventSourceArn == null || e[1].source == input.EventSourceArn))
		const [page, next] = paged(found, input.MaxItems)
		const r = new api.ListEventSourceMappingsResponse()
		r.EventSourceMappings = page.map(m => mappingOf(caller, m, if (m.enabled) "Enabled" else "Disabled"))
		r.NextMarker = next
		return r
	}

	invoke(caller: Caller, input: api.InvocationRequest): api.InvocationResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		const r = new api.InvocationResponse()
		if (input.InvocationType == "DryRun") {
			r.StatusCode = 204
			return r
		}
		r.StatusCode = 200
		r.ExecutedVersion = v.version
		r.FunctionError = "Unhandled"
		r.Payload = `{"errorMessage":"This server does not run Lambda functions: ${arn(caller, t.name, t.qualifier)} `
			+ `was not invoked.","errorType":"NotImplemented"}`
		return r
	}
}

/// The function, version or alias that name, a name, a partial ARN or an ARN, and qualifier name, as AWS reads them.
function target(caller: Caller, name: string, qualifier: string | null): Target throws Fault {
	const parts = split(name, ":")
	const t = new Target()
	let q: string | null = null
	if (parts.length == 1) {
		t.name = name
	} else if (parts.length == 2) {
		t.name = parts[0]
		q = parts[1]
	} else if (parts.length >= 3 && parts.length <= 4 && parts[1] == "function") {
		t.name = parts[2]
		q = if (parts.length == 4) parts[3] else null
	} else if (parts.length >= 7 && parts.length <= 8 && parts[0] == "arn" && parts[5] == "function") {
		t.name = parts[6]
		q = if (parts.length == 8) parts[7] else null
	} else {
		throw invalid(`Function name ${name} is invalid.`)
	}
	if (q != null && qualifier != null && q != qualifier) {
		throw invalid("The derived qualifier from the function name does not match the specified qualifier.")
	}
	t.qualifier = q ?? qualifier
	return t
}

/// The function name names, which is not qualified.
function unqualified(caller: Caller, name: string): Target throws Fault {
	const t = target(caller, name, null)
	if (t.qualifier != null) {
		throw invalid(`Unsupported qualified function name: ${name}`)
	}
	return t
}

/// Authorizes the request on t, by its function's or qualifier's policy.
function allowed(caller: Caller, db: Tables, t: Target) throws Fault {
	caller.allow(arn(caller, t.name, t.qualifier), policy(db, t.name, t.qualifier))
}

/// The policy of the function name, or of its version or alias qualifier, as JSON; null if it has none.
function policy(db: Tables, name: string, qualifier: string | null): string | null {
	const p = db.policies.get(`${name}:${qualifier ?? ""}`)
	return if (p == null) null else document(p!)
}

function document(p: Policy): string {
	return `{"Version":"2012-10-17","Id":"default","Statement":[${p.statements.map(s => s[1]).join(",")}]}`
}

/// The version that t names: $LATEST, a number or an alias's; not found as AWS words it.
function version(caller: Caller, db: Tables, t: Target): Version throws Fault {
	let q = t.qualifier ?? "$LATEST"
	if (q != "$LATEST" && !numeric(q)) {
		q = alias(caller, db, t.name, q).version
	}
	const v = db.versions.get(`${t.name}:${key(q)}`)
	if (v == null) {
		throw notFound(caller, t.name, t.qualifier)
	}
	return v!
}

/// Throws unless t's qualifier, if any, names a version or alias that exists.
function qualified(caller: Caller, db: Tables, t: Target) throws Fault { version(caller, db, t) }

function alias(caller: Caller, db: Tables, name: string, a: string): Alias throws Fault {
	const found = db.aliases.get(`${name}:${a}`)
	if (found == null) {
		throw api.resourceNotFoundException(`Cannot find alias arn: ${arn(caller, name, a)}`, user())
	}
	return found!
}

/// Points a at the version given and the routing of r, as AWS validates them.
function pointed(caller: Caller, db: Tables, name: string, a: Alias, given: string,
	r: api.AliasRoutingConfiguration | null) throws Fault {
	if (given != "$LATEST" && !numeric(given)) {
		throw invalid(`Invalid function version ${given}. Function version ${given} is not a number.`)
	}
	if (db.versions.get(`${name}:${key(given)}`) == null) {
		throw notFound(caller, name, given)
	}
	const weights = r?.AdditionalVersionWeights ?? []
	if (weights.length > 1) {
		throw invalid("Number of items in AdditionalVersionWeights cannot be greater than 1")
	}
	for (const [w, weight] of weights) {
		if (given == "$LATEST") {
			throw invalid("$LATEST is not supported for an alias pointing to more than 1 version")
		}
		if (w == given) {
			throw invalid(`Invalid function version ${w}. Function version ${w} is already included in routing configuration.`)
		}
		if (db.versions.get(`${name}:${key(w)}`) == null) {
			throw notFound(caller, name, w)
		}
		if (weight < 0.0 || weight > 1.0) {
			throw invalid(`Invalid weight ${weight}. The weight must be between 0.0 and 1.0`)
		}
	}
	a.version = given
	a.weights = if (weights.length == 0) null else weights
}

function aliasOf(caller: Caller, name: string, a: Alias): api.AliasConfiguration {
	const r = new api.AliasConfiguration()
	r.AliasArn = arn(caller, name, a.name)
	r.Name = a.name
	r.FunctionVersion = a.version
	r.Description = a.description
	if (a.weights != null) {
		r.RoutingConfig = { ...new api.AliasRoutingConfiguration(), AdditionalVersionWeights: a.weights }
	}
	r.RevisionId = a.revision
	return r
}

/// The function that a taggable resource ARN names, authorized.
function tagged(caller: Caller, resource: string): [Tables, Function] throws Fault {
	const t = unqualified(caller, resource)
	const db = new Tables(caller)
	allowed(caller, db, t)
	const f = db.functions.get(t.name)
	if (f == null) {
		throw notFound(caller, t.name, null)
	}
	return [db, f!]
}

/// The URL of t, authorized.
function url(caller: Caller, t: Target): Url throws Fault {
	const db = new Tables(caller)
	allowed(caller, db, t)
	version(caller, db, t)
	const u = db.urls.get(`${t.name}:${t.qualifier ?? ""}`)
	if (u == null) {
		throw api.resourceNotFoundException("The resource you requested does not exist.", user())
	}
	return u!
}

function urlOf(caller: Caller, t: Target, u: Url): api.FunctionUrlConfig {
	const c = new api.FunctionUrlConfig()
	c.FunctionUrl = `https://${u.id}.lambda-url.${caller.region}.on.aws/`
	c.FunctionArn = arn(caller, t.name, t.qualifier)
	c.CreationTime = u.created
	c.LastModifiedTime = u.modified
	c.Cors = u.cors
	c.AuthType = u.auth
	c.InvokeMode = u.mode
	return c
}

/// The event source mapping of id, authorized.
function mapping(caller: Caller, id: string): [Tables, Mapping] throws Fault {
	const db = new Tables(caller)
	const m = db.mappings.get(id)
	const context: Context = []
	if (m != null) {
		context.push(["lambda:FunctionArn", m!.function])
	}
	caller.allow(`arn:aws:lambda:${caller.region}:${caller.account}:event-source-mapping:${id}`, null, context)
	if (m == null) {
		throw api.resourceNotFoundException("The resource you requested does not exist.", user())
	}
	return [db, m!]
}

function mappingOf(caller: Caller, m: Mapping, state: string): api.EventSourceMappingConfiguration {
	const r = new api.EventSourceMappingConfiguration()
	r.UUID = m.uuid
	r.EventSourceArn = m.source
	r.FunctionArn = m.function
	r.BatchSize = m.batch
	r.MaximumBatchingWindowInSeconds = m.window
	r.StartingPosition = m.position
	r.StartingPositionTimestamp = m.positioned
	r.FilterCriteria = m.filter
	r.DestinationConfig = m.destination
	r.MaximumRecordAgeInSeconds = m.age
	r.BisectBatchOnFunctionError = m.bisect
	r.MaximumRetryAttempts = m.retries
	r.TumblingWindowInSeconds = m.tumbling
	r.ParallelizationFactor = m.parallelization
	r.FunctionResponseTypes = m.responses
	r.LastModified = m.modified
	r.LastProcessingResult = "No records processed"
	r.State = state
	r.StateTransitionReason = "USER_INITIATED"
	r.EventSourceMappingArn = `arn:aws:lambda:${caller.region}:${caller.account}:event-source-mapping:${m.uuid}`
	return r
}

/// A function's zip:zip if given, else the object of bucket and key read from S3 by h as the caller.
function source(h: s3.Handler | null, caller: Caller, zip: string | null, bucket: string | null, key: string | null,
	version: string | null): string throws Fault {
	if (zip != null) {
		return zip!
	}
	if (bucket == null || key == null || h == null) {
		throw invalid("Please provide a source for function code.")
	}
	const actions = caller.actions
	const req = new s3Api.GetObjectRequest()
	req.Bucket = bucket!
	req.Key = key!
	req.VersionId = version
	let body = ""
	try {
		body = h!.getObject(caller, req).Body
	} catch (f: Fault) {
		throw invalid(`Error occurred while GetObject. S3 Error Code: ${f.code}. S3 Error Message: ${f.message}`)
	} finally {
		caller.actions = actions
	}
	const streamed = h!.streamed
	h!.streamed = null
	if (streamed == null) {
		return body
	}
	try {
		return streamed!.text(262144000)
	} catch (e: IoError) {
		throw invalid(`Error occurred while GetObject: ${e}`)
	}
}

/// Stores v as $LATEST with code, a zip's bytes, or an image's URI.
function code(db: Tables, v: Version, zip: string | null, image: string | null) throws Fault {
	if (zip == null) {
		v.image = image
		v.sha = digest(image ?? "")
		v.size = 0
		changed(db, v)
		return
	}
	v.sha = digest(zip!)
	v.size = zip!.length as i64
	const w = new BlobWriter()
	w.write(zip!)
	const b = w.finish()
	v.modified = stamp()
	v.revision = uuid()
	try {
		db.versions.put(`${v.name}:${key(v.version)}`, v, b)
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}

/// Stores $LATEST v, changed now.
function changed(db: Tables, v: Version) throws Fault {
	v.modified = stamp()
	v.revision = uuid()
	const k = `${v.name}:${key(v.version)}`
	try {
		db.versions.put(k, v, db.versions.blob(k))
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}

/// A version of $LATEST v, described, or the latest published if nothing changed since it.
function publish(caller: Caller, db: Tables, f: Function, v: Version, description: string): Version throws Fault {
	if (f.published > 0) {
		const last = db.versions.get(`${f.name}:${key(`${f.published}`)}`)
		if (last != null && same(last!, v)) {
			return last!
		}
	}
	f.published++
	save(db.functions, f.name, f)
	const p = copy(v)
	p.version = `${f.published}`
	p.description = description
	p.revision = uuid()
	try {
		db.versions.put(`${f.name}:${key(p.version)}`, p, db.versions.blob(`${f.name}:${key("$LATEST")}`))
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
	return p
}

/// Whether the published version p has the code and configuration of $LATEST v.
function same(p: Version, v: Version): bool throws Fault {
	const a = copy(p)
	const b = copy(v)
	for (const x of [a, b]) {
		x.version = ""
		x.modified = ""
		x.revision = ""
		x.description = ""
	}
	return encoded(a) == encoded(b)
}

function copy(v: Version): Version throws Fault {
	try {
		return json.decode[Version](encoded(v))
	} catch (e: ParseError) {
		throw new Fault(500, "InternalFailure", `A record does not decode: ${e}`)
	}
}

/// The SHA-256 of b in base64, as CodeSha256.
function digest(b: string): string throws Fault {
	try {
		return base64.encode(sha256(b))
	} catch (e: CryptoError) {
		throw new Fault(500, "InternalFailure", `No SHA-256: ${e}`)
	}
}

function encoded(v: Version): string throws Fault {
	try {
		return json.encode(v)
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}

function configuration(caller: Caller, v: Version): api.FunctionConfiguration {
	const c = new api.FunctionConfiguration()
	c.FunctionName = v.name
	c.FunctionArn = arn(caller, v.name, if (v.version == "$LATEST") null else v.version)
	c.Runtime = v.runtime
	c.Role = v.role
	c.Handler = v.handler
	c.CodeSize = v.size
	c.Description = v.description
	c.Timeout = v.timeout
	c.MemorySize = v.memory
	c.LastModified = v.modified
	c.CodeSha256 = v.sha
	c.Version = v.version
	if (v.vpc != null) {
		c.VpcConfig = { ...new api.VpcConfigResponse(), SubnetIds: v.vpc!.SubnetIds ?? [],
			SecurityGroupIds: v.vpc!.SecurityGroupIds ?? [], VpcId: "", Ipv6AllowedForDualStack: false }
	}
	if (v.deadLetter != null) {
		c.DeadLetterConfig = { ...new api.DeadLetterConfig(), TargetArn: v.deadLetter }
	}
	if (v.environment != null) {
		c.Environment = { ...new api.EnvironmentResponse(), Variables: v.environment }
	}
	c.KMSKeyArn = v.kms
	c.TracingConfig = { ...new api.TracingConfigResponse(), Mode: v.tracing }
	c.RevisionId = v.revision
	if (v.layers.length > 0) {
		c.Layers = v.layers.map(l => {
			return { ...new api.Layer(), Arn: l }
		})
	}
	c.State = "Active"
	c.LastUpdateStatus = "Successful"
	c.PackageType = v.packaged
	c.Architectures = v.architectures
	c.EphemeralStorage = { ...new api.EphemeralStorage(), Size: v.ephemeral }
	c.SnapStart = { ...new api.SnapStartResponse(), ApplyOn: "None", OptimizationStatus: "Off" }
	c.LoggingConfig = v.logging ?? { ...new api.LoggingConfig(), LogFormat: "Text", LogGroup: `/aws/lambda/${v.name}` }
	return c
}

/// Throws unless role is a role of the account that lambda.amazonaws.com may assume for the function of ARN fn.
function assumable(caller: Caller, role: string, fn: string) throws Fault {
	const refused = invalid("The role defined for the function cannot be assumed by Lambda.")
	const parts = split(role, ":")
	if (parts.length != 6 || !startsWith(parts[5], "role/")) {
		throw refused
	}
	const r = new iam.Tables(caller.tree(parts[4])).roles.get(iam.key(parts[5].slice(lastIndexOf(parts[5], "/") + 1,
		parts[5].length)))
	if (r == null) {
		throw refused
	}
	try {
		caller.internal("lambda.amazonaws.com", fn, ["sts:AssumeRole"]).allow(role, r!.trust)
	} catch (f: Fault) {
		throw refused
	}
}

/// The statement that AddPermission adds of input to the resource of ARN on, as AWS builds it.
function statement(caller: Caller, input: api.AddPermissionRequest, on: string): string {
	const p = input.Principal
	const principal = if (p == "*") `"*"`
		else if (p.length == 12 && numeric(p)) `{"AWS":${json.quoted(`arn:aws:iam::${p}:root`)}}`
		else if (startsWith(p, "arn:")) `{"AWS":${json.quoted(p)}}`
		else `{"Service":${json.quoted(p)}}`
	const conditions: string[] = []
	const equals: string[] = []
	if (input.SourceAccount != null) {
		equals.push(`"AWS:SourceAccount":${json.quoted(input.SourceAccount!)}`)
	}
	if (input.PrincipalOrgID != null) {
		equals.push(`"aws:PrincipalOrgID":${json.quoted(input.PrincipalOrgID!)}`)
	}
	if (input.FunctionUrlAuthType != null) {
		equals.push(`"lambda:FunctionUrlAuthType":${json.quoted(input.FunctionUrlAuthType!)}`)
	}
	if (equals.length > 0) {
		conditions.push(`"StringEquals":{${equals.join(",")}}`)
	}
	if (input.SourceArn != null) {
		conditions.push(`"ArnLike":{"AWS:SourceArn":${json.quoted(input.SourceArn!)}}`)
	}
	return `{"Sid":${json.quoted(input.StatementId)},"Effect":"Allow","Principal":${principal},`
		+ `"Action":${json.quoted(input.Action)},"Resource":${json.quoted(on)}`
		+ (if (conditions.length == 0) "" else `,"Condition":{${conditions.join(",")}}`) + "}"
}

/// A page of found, of at most max items, 50 if null, and the marker of the next.
function paged[V extends Decodable](found: [string, V][], max: i32 | null): [V[], string | null] {
	const n = max ?? 50
	if (found.length <= n) {
		return [found.map(e => e[1]), null]
	}
	return [found.slice(0, n).map(e => e[1]), found[n - 1][0]]
}

/// Throws unless given, a revision id if any, is current.
function revised(given: string | null, current: string) throws Fault {
	if (given != null && given != current) {
		throw api.preconditionFailedException("The Revision Id provided does not match the latest Revision Id. "
			+ "Call the GetFunction/GetAlias API to retrieve the latest Revision Id",
			{ ...new api.PreconditionFailedException(), Type: "User" })
	}
}

/// The ARN of the function name, qualified by qualifier if not null.
function arn(caller: Caller, name: string, qualifier: string | null): string {
	return `arn:aws:lambda:${caller.region}:${caller.account}:function:${name}`
		+ (if (qualifier == null) "" else `:${qualifier}`)
}

/// A version's key, which sorts $LATEST first and the numbers in order.
function key(version: string): string {
	return if (version == "$LATEST" || version.length >= 10) version
		else "0000000000".slice(version.length, 10) + version
}

function numeric(s: string): bool {
	if (s.length == 0) {
		return false
	}
	for (let i = 0; i < s.length; i++) {
		if (indexOf("0123456789", s.slice(i, i + 1)) < 0) {
			return false
		}
	}
	return true
}

function notFound(caller: Caller, name: string, qualifier: string | null): Fault {
	return api.resourceNotFoundException(`Function not found: ${arn(caller, name, qualifier)}`, user())
}

function invalid(why: string): Fault {
	return api.invalidParameterValueException(why, { ...new api.InvalidParameterValueException(), Type: "User" })
}

function user(): api.ResourceNotFoundException { return { ...new api.ResourceNotFoundException(), Type: "User" } }
function conflict(): api.ResourceConflictException { return { ...new api.ResourceConflictException(), Type: "User" } }

function save[V extends Decodable](t: Table[V], k: string, v: V) throws Fault {
	try {
		t.put(k, v)
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}

/// Now, as Lambda's LastModified: 2024-01-02T03:04:05.678+0000.
function stamp(): string {
	const t = now()
	return replace(rfc3339(t - t % millisecond), "Z", "+0000")
}

function uuid(): string throws Fault {
	try {
		const h = hex.encode(bytes(16))
		return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20, 32)}`
	} catch (e: IoError) {
		throw new Fault(500, "InternalFailure", `No random bytes: ${e}`)
	}
}
