//! AWS Lambda: functions, versions, aliases, policies, concurrency, event source mappings and layers, and invocations
//! of zip functions run by ./runner in containers of Lambda's public images.
//!
//! A synchronous Invoke holds its request until the function answers, the gateway running it again after each change;
//! the run that finds the invocation done answers it. A request to a function URL is invoked so too, its event and
//! response as ./urls maps them. An asynchronous one is queued in the store and run at the tick,
//! retried after one and then two minutes up to MaximumRetryAttempts, and dropped once older than
//! MaximumEventAgeInSeconds; its record then goes to the destination of its outcome, and a failure to the dead-letter
//! queue, as the function's role. An environment gets its role's credentials at the tick, as STS issues them to Lambda.
//!
//! Where AWS differs:
//!
//! - AWS_ENDPOINT_URL is set to this server, so that the SDKs and the CLI in a function call it, not AWS.
//! - A function of a container image answers its error, NotImplemented; so does every invocation when no container
//!   runtime answered at start, with Runtime.Unavailable. An image's URI is not checked and its CodeSha256 is the URI's.
//! - What is in flight is the process's, not the store's: a restart loses running invocations and environments. A
//!   queued invocation that was running is run again.
//! - A synchronous invocation made at the tick, as by a state machine a schedule started, cannot be held, and fails
//!   with ServiceException.
//! - REPORT has no Max Memory Used. A function's logs are put at the tick, as its role, a second or so late.
//! - The init phase may take 10 seconds plus the function's timeout. A throttled asynchronous invocation is tried again
//!   after a second, doubling to five minutes. Only reserved concurrency throttles.
//! - Functions, mappings and provisioned concurrency are ready at once, and a mapping polls nothing. Responses do not
//!   stream, a function URL's of RESPONSE_STREAM neither. The Extensions and Telemetry APIs are not served, and
//!   SnapStart is stored only. Layers are of the function's account and region; code signing is never set.
//! - A function URL is <id>.lambda-url.<region>.localhost on this server's scheme and port, not on.aws; a request is
//!   its URL's by those leading labels of its Host, whatever follows, or by a path under /_aws/lambda-url/<id>/ on any
//!   host. Its event's sourceIp is the first of X-Forwarded-For, else 127.0.0.1, as the server is not told its peer.

import { Fault } from "../../core/fault"
import { random, uuid } from "../../core/random"
import { Caller, Context, requestTags, resourceTags, Unit } from "../../core/service"
import { Blob, Table } from "../../core/state/store"
import * as eventsApi from "../events/api"
import * as logsApi from "../logs/api"
import * as s3Api from "../s3/api"
import * as s3 from "../s3/s3"
import * as kinesisApi from "../kinesis/api"
import * as kinesis from "../kinesis/kinesis"
import * as streamsApi from "../dynamodbstreams/api"
import * as streams from "../dynamodbstreams/dynamodbstreams"
import * as snsApi from "../sns/api"
import * as sqsApi from "../sqs/api"
import * as sqs from "../sqs/sqs"
import { Credentials } from "../sts/api"
import { actAs, passRole, session } from "../sts/sts"
import * as api from "./api"
import * as running from "./runner"
import * as urls from "./urls"
import { indexOf, lastIndexOf, startsWith } from "std/algo"
import { CryptoError } from "std/crypto/error"
import { sha256 } from "std/crypto/hash"
import * as base64 from "std/encoding/base64"
import * as hex from "std/encoding/hex"
import * as json from "std/encoding/json"
import { EncodeError } from "std/encoding/json"
import { Request, Response } from "std/http"
import { formatInt, lower, ParseError, replace, split } from "std/string"
import { millisecond, minute, rfc3339, second } from "std/time"
import { Decodable } from "std/types"

class Function {
	name = ""
	published: i32 = 0
	tags: [string, string][] = []
	reserved: i32 | null = null
	recursion: api.RecursiveLoop = "Terminate"
}

/// A version of a function, $LATEST among them; its code is the blob stored with it.
class Version {
	name = ""
	version = "$LATEST"
	runtime: api.Runtime | null = null
	role = ""
	handler: string | null = null
	description = ""
	timeout: i32 = 3
	memory: i32 = 128
	sha = ""
	size: i64 = 0
	modified = ""
	revision = ""
	packaged: api.PackageType = "Zip"
	image: string | null = null
	environment: [string, string][] | null = null
	layers: [string, i64][] = []
	architectures: api.Architecture[] = ["x86_64"]
	ephemeral: i32 = 512
	tracing: api.TracingMode = "PassThrough"
	deadLetter: string | null = null
	vpc: api.VpcConfig | null = null
	logging: api.LoggingConfig | null = null
	kms: string | null = null
	updateRuntime: api.UpdateRuntimeOn = "Auto"
	runtimeVersion: string | null = null
}

class Mapping {
	uuid = ""
	source = ""
	function = ""
	enabled = true
	batch: i32 = 10
	window: i32 = 0
	position: api.EventSourcePosition | null = null
	positioned: i64 | null = null
	modified: i64 = 0
	filter: api.FilterCriteria | null = null
	destination: api.DestinationConfig | null = null
	age: i32 | null = null
	bisect: bool | null = null
	retries: i32 | null = null
	tumbling: i32 | null = null
	parallelization: i32 | null = null
	responses: api.FunctionResponseType[] | null = null
	tags: [string, string][] = []
}

/// A version of a layer; its zip is the blob stored with it.
class LayerVersion {
	name = ""
	version: i64 = 0
	description: string | null = null
	created = ""
	runtimes: api.Runtime[] | null = null
	architectures: api.Architecture[] | null = null
	license: string | null = null
	sha = ""
	size: i64 = 0
	statements: [string, string][] = []
	revision = ""
}

/// A layer: the number of its latest version, which a version deleted does not give back.
class LayerName {
	published: i64 = 0
}

class Provisioned {
	requested: i32 = 0
	modified = ""
}

class Invoking {
	retries: i32 | null = null
	age: i32 | null = null
	destination: api.DestinationConfig | null = null
	modified: i64 = 0
}

class Url {
	id = ""
	auth: api.FunctionUrlAuthType = "NONE"
	cors: api.Cors | null = null
	mode: api.InvokeMode = "BUFFERED"
	created = ""
	modified = ""
}

/// Where a function URL is, by its id in the global tree, as a request to it names only the id.
class UrlOwner {
	account = ""
	region = ""
	name = ""
	/// "" for the unqualified function's.
	qualifier = ""
}

class Alias {
	name = ""
	version = ""
	description = ""
	weights: [string, f64][] | null = null
	revision = ""
}

/// An asynchronous invocation, until it succeeds or its retries or age run out.
class Queued {
	id = ""
	name = ""
	qualifier: string | null = null
	payload = ""
	context: string | null = null
	enqueued: i64 = 0
	/// The attempts started, and when the next is due.
	attempts: i32 = 0
	due: i64 = 0
	/// The generation of the runner its attempt runs in, "" while none does: one of a server since restarted runs again.
	running = ""
	/// How long its concurrency last held it back, doubled each time.
	backoff: i64 = 0
}

class Policy {
	statements: [string, string][] = []
	revision = ""
}

/// Lambda's state in an account's regional tree: functions by name; versions, aliases and policies by the function's
/// name, a colon and the version's key, the alias's name or the qualifier, "" for the unqualified function's.
class Tables {
	functions: Table[Function]
	versions: Table[Version]
	aliases: Table[Alias]
	policies: Table[Policy]
	mappings: Table[Mapping]
	urls: Table[Url]
	/// By the function's name, a colon and the qualifier, $LATEST for the unqualified function's.
	provisioned: Table[Provisioned]
	invoking: Table[Invoking]
	/// Layers by name; their versions by the layer's name, a colon and the version's key.
	layers: Table[LayerName]
	layerVersions: Table[LayerVersion]
	/// By the instant enqueued and the id.
	queue: Table[Queued]

	constructor(caller: Caller) throws Fault {
		const s = caller.regional()
		this.functions = new Table[Function](s, "lambda.functions")
		this.versions = new Table[Version](s, "lambda.versions")
		this.aliases = new Table[Alias](s, "lambda.aliases")
		this.policies = new Table[Policy](s, "lambda.policies")
		this.mappings = new Table[Mapping](s, "lambda.mappings")
		this.urls = new Table[Url](s, "lambda.urls")
		this.provisioned = new Table[Provisioned](s, "lambda.provisioned")
		this.invoking = new Table[Invoking](s, "lambda.invoking")
		this.layers = new Table[LayerName](s, "lambda.layers")
		this.layerVersions = new Table[LayerVersion](s, "lambda.layerVersions")
		this.queue = new Table[Queued](s, "lambda.queue")
	}
}

class Target {
	name = ""
	qualifier: string | null = null
}

export class Handler {
	...api.Unimplemented

	s3: s3.Handler | null = null
	sqs: sqs.Handler | null = null
	kinesis: kinesis.Handler | null = null
	streams: streams.Handler | null = null
	logs: logsApi.CloudWatchLogs | null = null
	sns: snsApi.SNS | null = null
	events: eventsApi.EventBridge | null = null
	/// What runs functions; null runs none, as each invocation then answers.
	runner: running.Runner | null = null

	createFunction(caller: Caller, input: api.CreateFunctionRequest): api.FunctionConfiguration throws Fault {
		const t = target(caller, input.FunctionName, null)
		caller.allow(arn(caller, t.name, null), null, requestTags(input.Tags ?? []))
		const db = new Tables(caller)
		if (db.functions.get(t.name) != null) {
			throw api.resourceConflictException(`Function already exist: ${t.name}`, conflict())
		}
		assumable(caller, input.Role, arn(caller, t.name, null))
		const v = new Version()
		v.name = t.name
		v.packaged = input.PackageType ?? "Zip"
		if (v.packaged == "Zip") {
			if (input.Runtime == null || input.Handler == null) {
				throw invalid("Runtime and Handler are mandatory parameters for functions created with deployment packages.")
			}
		} else if (input.Code.ImageUri == null) {
			throw invalid("Please provide a source for function code.")
		}
		v.runtime = input.Runtime
		v.handler = input.Handler
		v.role = input.Role
		v.description = input.Description ?? ""
		v.timeout = input.Timeout ?? 3
		v.memory = input.MemorySize ?? 128
		v.environment = input.Environment?.Variables
		v.layers = layered(db, caller, input.Layers ?? [])
		v.architectures = input.Architectures ?? ["x86_64"]
		v.ephemeral = input.EphemeralStorage?.Size ?? 512
		v.tracing = input.TracingConfig?.Mode ?? "PassThrough"
		v.deadLetter = input.DeadLetterConfig?.TargetArn
		v.vpc = input.VpcConfig
		v.logging = input.LoggingConfig
		v.kms = input.KMSKeyArn
		const zip = if (v.packaged == "Zip") source(this.s3, caller, input.Code.ZipFile, input.Code.S3Bucket,
			input.Code.S3Key, input.Code.S3ObjectVersion)
			else null
		const f = new Function()
		f.name = t.name
		f.tags = input.Tags ?? []
		db.functions.put(f.name, f)
		code(db, v, zip, input.Code.ImageUri)
		if (input.Publish) {
			return configuration(caller, publish(caller, db, f, v, ""))
		}
		return configuration(caller, v)
	}

	getFunction(caller: Caller, input: api.GetFunctionRequest): api.GetFunctionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		const f = db.functions.get(t.name)!
		const r = new api.GetFunctionResponse()
		r.Configuration = configuration(caller, v)
		r.Code = new api.FunctionCodeLocation()
		if (v.packaged == "Zip") {
			r.Code.RepositoryType = "S3"
			r.Code.Location = located(caller, "versions", t.name, key(v.version))
		} else {
			r.Code.RepositoryType = "ECR"
			r.Code.ImageUri = v.image
			r.Code.ResolvedImageUri = v.image
		}
		if (t.qualifier == null) {
			r.Tags = f.tags
		}
		if (f.reserved != null) {
			r.Concurrency = { ...new api.Concurrency(), ReservedConcurrentExecutions: f.reserved }
		}
		return r
	}

	getFunctionConfiguration(caller: Caller,
		input: api.GetFunctionConfigurationRequest): api.FunctionConfiguration throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		return configuration(caller, version(caller, db, t))
	}

	listFunctions(caller: Caller, input: api.ListFunctionsRequest): api.ListFunctionsResponse throws Fault {
		caller.allow("*")
		const all = input.FunctionVersion == "ALL"
		const found = new Tables(caller).versions.scan(input.Marker,
			100000).filter(e => all || e[1].version == "$LATEST")
		const [page, next] = paged(found, input.MaxItems)
		const r = new api.ListFunctionsResponse()
		r.Functions = page.map(v => configuration(caller, v))
		r.NextMarker = next
		return r
	}

	updateFunctionCode(caller: Caller, input: api.UpdateFunctionCodeRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		revised(input.RevisionId, v.revision)
		if (input.Architectures != null) {
			v.architectures = input.Architectures!
		}
		const zip = if (input.ImageUri != null) null
			else source(this.s3, caller, input.ZipFile, input.S3Bucket, input.S3Key, input.S3ObjectVersion)
		if (input.DryRun) {
			return configuration(caller, v)
		}
		code(db, v, zip, input.ImageUri)
		this.runner?.retire(caller.account, caller.region, t.name)
		if (input.Publish) {
			return configuration(caller, publish(caller, db, db.functions.get(t.name)!, v, ""))
		}
		return configuration(caller, v)
	}

	updateFunctionConfiguration(caller: Caller,
		input: api.UpdateFunctionConfigurationRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		revised(input.RevisionId, v.revision)
		if (input.Role != null) {
			assumable(caller, input.Role!, arn(caller, t.name, null))
			v.role = input.Role!
		}
		v.handler = input.Handler ?? v.handler
		v.runtime = input.Runtime ?? v.runtime
		v.description = input.Description ?? v.description
		v.timeout = input.Timeout ?? v.timeout
		v.memory = input.MemorySize ?? v.memory
		if (input.Environment != null) {
			v.environment = input.Environment!.Variables
		}
		if (input.Layers != null) {
			v.layers = layered(db, caller, input.Layers!)
		}
		v.ephemeral = input.EphemeralStorage?.Size ?? v.ephemeral
		v.tracing = input.TracingConfig?.Mode ?? v.tracing
		if (input.DeadLetterConfig != null) {
			v.deadLetter = input.DeadLetterConfig!.TargetArn
		}
		v.vpc = input.VpcConfig ?? v.vpc
		v.logging = input.LoggingConfig ?? v.logging
		v.kms = input.KMSKeyArn ?? v.kms
		changed(db, v)
		this.runner?.retire(caller.account, caller.region, t.name)
		return configuration(caller, v)
	}

	deleteFunction(caller: Caller, input: api.DeleteFunctionRequest): api.DeleteFunctionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const r = { ...new api.DeleteFunctionResponse(), StatusCode: 204 }
		this.runner?.retire(caller.account, caller.region, t.name)
		if (t.qualifier != null) {
			if (t.qualifier == "$LATEST") {
				throw invalid("$LATEST version cannot be deleted without deleting the function.")
			}
			const v = version(caller, db, t)
			for (const [_, a] of db.aliases.scan(null, 100000, `${t.name}:`)) {
				if (a.version == v.version) {
					throw api.resourceConflictException(`Unable to delete version because the following aliases reference it: [${a.name}]`,
						conflict())
				}
			}
			db.versions.delete(`${t.name}:${key(v.version)}`)
			db.policies.delete(`${t.name}:${v.version}`)
			db.provisioned.delete(`${t.name}:${v.version}`)
			db.invoking.delete(`${t.name}:${v.version}`)
			return r
		}
		version(caller, db, t)
		db.functions.delete(t.name)
		for (const [k, _] of db.versions.scan(null, 100000, `${t.name}:`)) {
			db.versions.delete(k)
		}
		for (const [k, _] of db.aliases.scan(null, 100000, `${t.name}:`)) {
			db.aliases.delete(k)
		}
		for (const [k, _] of db.policies.scan(null, 100000, `${t.name}:`)) {
			db.policies.delete(k)
		}
		for (const [k, u] of db.urls.scan(null, 100000, `${t.name}:`)) {
			db.urls.delete(k)
			owners(caller).delete(u.id)
		}
		for (const [k, _] of db.provisioned.scan(null, 100000, `${t.name}:`)) {
			db.provisioned.delete(k)
		}
		for (const [k, _] of db.invoking.scan(null, 100000, `${t.name}:`)) {
			db.invoking.delete(k)
		}
		return r
	}

	publishVersion(caller: Caller, input: api.PublishVersionRequest): api.FunctionConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		const v = version(caller, db, t)
		if (input.CodeSha256 != null && input.CodeSha256 != v.sha) {
			throw invalid(`CodeSHA256 (${input.CodeSha256}) is different from current CodeSHA256 in $LATEST (${v.sha}). `
				+ "Please try again with the current CodeSHA256.")
		}
		revised(input.RevisionId, v.revision)
		return configuration(caller,
			publish(caller, db, db.functions.get(t.name)!, v, input.Description ?? v.description))
	}

	listVersionsByFunction(caller: Caller,
		input: api.ListVersionsByFunctionRequest): api.ListVersionsByFunctionResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const [page, next] = paged(db.versions.scan(input.Marker, 100000, `${t.name}:`), input.MaxItems)
		const r = new api.ListVersionsByFunctionResponse()
		r.Versions = page.map(v => configuration(caller, v))
		r.NextMarker = next
		return r
	}

	createAlias(caller: Caller, input: api.CreateAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null),
			resourceTags(db.functions.get(t.name)?.tags ?? []))
		version(caller, db, t)
		const k = `${t.name}:${input.Name}`
		if (db.aliases.get(k) != null) {
			throw api.resourceConflictException(`Alias already exists: ${arn(caller, t.name, input.Name)}`, conflict())
		}
		const a = new Alias()
		a.name = input.Name
		a.description = input.Description ?? ""
		pointed(caller, db, t.name, a, input.FunctionVersion, input.RoutingConfig)
		a.revision = uuid()
		db.aliases.put(k, a)
		return aliasOf(caller, t.name, a)
	}

	getAlias(caller: Caller, input: api.GetAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null),
			resourceTags(db.functions.get(t.name)?.tags ?? []))
		return aliasOf(caller, t.name, alias(caller, db, t.name, input.Name))
	}

	updateAlias(caller: Caller, input: api.UpdateAliasRequest): api.AliasConfiguration throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null),
			resourceTags(db.functions.get(t.name)?.tags ?? []))
		const a = alias(caller, db, t.name, input.Name)
		revised(input.RevisionId, a.revision)
		a.description = input.Description ?? a.description
		const kept = new api.AliasRoutingConfiguration()
		kept.AdditionalVersionWeights = a.weights
		pointed(caller, db, t.name, a, input.FunctionVersion ?? a.version, input.RoutingConfig ?? kept)
		a.revision = uuid()
		db.aliases.put(`${t.name}:${a.name}`, a)
		return aliasOf(caller, t.name, a)
	}

	deleteAlias(caller: Caller, input: api.DeleteAliasRequest): Unit throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		caller.allow(arn(caller, t.name, input.Name), policy(db, t.name, null),
			resourceTags(db.functions.get(t.name)?.tags ?? []))
		db.aliases.delete(`${t.name}:${input.Name}`)
		db.policies.delete(`${t.name}:${input.Name}`)
		const u = db.urls.get(`${t.name}:${input.Name}`)
		if (u != null) {
			db.urls.delete(`${t.name}:${input.Name}`)
			owners(caller).delete(u!.id)
		}
		return new Unit()
	}

	listAliases(caller: Caller, input: api.ListAliasesRequest): api.ListAliasesResponse throws Fault {
		const t = unqualified(caller, input.FunctionName)
		const db = new Tables(caller)
		allowed(caller, db, t)
		version(caller, db, t)
		const found = db.aliases.scan(input.Marker, 100000,
			`${t.name}:`).filter(e => input.FunctionVersion == null || e[1].version == input.FunctionVersion)
		const [page, next] = paged(found, input.MaxItems)
		const r = new api.ListAliasesResponse()
		r.Aliases = page.map(a => aliasOf(caller, t.name, a))
		r.NextMarker = next
		return r
	}

	addPermission(caller: Caller, input: api.AddPermissionRequest): api.AddPermissionResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const k = `${t.name}:${t.qualifier ?? ""}`
		const p = db.policies.get(k) ?? new Policy()
		revised(input.RevisionId, p.revision)
		for (const [sid, _] of p.statements) {
			if (sid == input.StatementId) {
				throw api.resourceConflictException(`The statement id (${input.StatementId}) provided already exists. `
					+ "Please provide a new statement id, or remove the existing statement.", conflict())
			}
		}
		const s = statement(caller, input, arn(caller, t.name, t.qualifier))
		p.statements.push([input.StatementId, s])
		p.revision = uuid()
		db.policies.put(k, p)
		return { ...new api.AddPermissionResponse(), Statement: s }
	}

	removePermission(caller: Caller, input: api.RemovePermissionRequest): Unit throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const k = `${t.name}:${t.qualifier ?? ""}`
		const p = db.policies.get(k)
		const kept = (p?.statements ?? []).filter(e => e[0] != input.StatementId)
		if (p == null || kept.length == p!.statements.length) {
			throw api.resourceNotFoundException(`Statement ${input.StatementId} is not found in resource policy.`,
				user())
		}
		revised(input.RevisionId, p!.revision)
		if (kept.length == 0) {
			db.policies.delete(k)
		} else {
			p!.statements = kept
			p!.revision = uuid()
			db.policies.put(k, p!)
		}
		return new Unit()
	}

	getPolicy(caller: Caller, input: api.GetPolicyRequest): api.GetPolicyResponse throws Fault {
		const t = target(caller, input.FunctionName, input.Qualifier)
		const db = new Tables(caller)
		allowed(caller, db, t)
		qualified(caller, db, t)
		const p = db.policies.get(`${t.name}:${t.qualifier ?? ""}`)
		if (p == null) {
			throw api.resourceNotFoundException("The resource you requested does not exist.", user())
		}
		return { ...new api.GetPolicyResponse(), Policy: document(p!), RevisionId: p!.revision }
	}

	tagResource(caller: Caller, input: api.TagResourceRequest): Unit throws Fault {
		const [tags, save] = tagged(caller, input.Resource)
		const kept = tags.filter(e => input.Tags.filter(n => n[0] == e[0]).length == 0)
		for (const e of input.Tags) {
			kept.push(e)
		}
		save(kept)
		return new Unit()
	}

	untagResource(caller: Caller, input: api.UntagResourceRequest): Unit throws Fault {
		const [tags, save] = tagged(caller, input.Resource)
		save(tags.filter(e => input.TagKeys.filter(k => k == e[0]).length == 0))
		return new Unit()
	}

	listTags(caller: Caller, input: api.ListTagsRequest): api.ListTagsResponse throws Fault {
		return { ...new api.ListTagsResponse(), Tags: tagged(caller, input.Resource)[0] }
	}

