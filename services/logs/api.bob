/// The answer of h to req.
export function handle(h: CloudWatchLogs, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "AssociateKmsKey": return c.serve(h.associateKmsKey, ["logs:AssociateKmsKey"])
		case "AssociateSourceToS3TableIntegration": return c.serve(h.associateSourceToS3TableIntegration,
			["logs:AssociateSourceToS3TableIntegration"])
