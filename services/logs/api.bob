export function accessDeniedException(message: string): Fault {
	return new Fault(400, "AccessDeniedException", message)
}

export function conflictException(message: string): Fault { return new Fault(400, "ConflictException", message) }

/// The members of DataAlreadyAcceptedException besides its message.
export class DataAlreadyAcceptedException {
	expectedSequenceToken: string | null @SequenceToken
}

export function dataAlreadyAcceptedException(message: string,
	members: DataAlreadyAcceptedException = new DataAlreadyAcceptedException()): Fault {
	return new Fault(400, "DataAlreadyAcceptedException", message, true, json.members(members))
}

export function internalServerException(message: string): Fault {
	return new Fault(500, "InternalServerException", message)
}

export function invalidOperationException(message: string): Fault {
	return new Fault(400, "InvalidOperationException", message)
}

export function invalidParameterException(message: string): Fault {
	return new Fault(400, "InvalidParameterException", message)
}

