		case "ListLogGroupsForQuery": return c.serve(h.listLogGroupsForQuery, ["logs:ListLogGroupsForQuery"])
		case "ListScheduledQueries": return c.serve(h.listScheduledQueries, ["logs:ListScheduledQueries"])
		case "ListSourcesForS3TableIntegration": return c.serve(h.listSourcesForS3TableIntegration,
