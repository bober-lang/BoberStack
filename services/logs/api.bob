		case "ListSyslogConfigurations": return c.serve(h.listSyslogConfigurations, ["logs:ListSyslogConfigurations"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["logs:ListTagsForResource"])
		case "ListTagsLogGroup": return c.serve(h.listTagsLogGroup, ["logs:ListTagsLogGroup"])
		case "PutAccountPolicy": return c.serve(h.putAccountPolicy,
			["iam:PassRole", "logs:PutAccountPolicy", "logs:PutDataProtectionPolicy", "logs:PutIndexPolicy",
			"logs:PutRetentionPolicy", "logs:PutSubscriptionFilter", "logs:PutTransformer"])
		case "PutBearerTokenAuthentication": return c.serve(h.putBearerTokenAuthentication,
