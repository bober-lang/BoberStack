/// The answer of h to req.
export function handle(h: Route53, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = restxml.call(caller, req, service, routes)
	switch (c.operation) {
		case "ActivateKeySigningKey": return c.serve(h.activateKeySigningKey, ["route53:ActivateKeySigningKey"])
		case "AssociateVPCWithHostedZone": return c.serve(h.associateVPCWithHostedZone,
			["route53:AssociateVPCWithHostedZone"])
		case "ChangeCidrCollection": return c.serve(h.changeCidrCollection, ["route53:ChangeCidrCollection"])
		case "ChangeResourceRecordSets": return c.serve(h.changeResourceRecordSets,
			["route53:ChangeResourceRecordSets"])
		case "ChangeTagsForResource": return c.serve(h.changeTagsForResource, ["route53:ChangeTagsForResource"])
		case "CreateCidrCollection": return c.serve(h.createCidrCollection, ["route53:CreateCidrCollection"], 201)
		case "CreateHealthCheck": return c.serve(h.createHealthCheck, ["route53:CreateHealthCheck"], 201)
		case "CreateHealthCheckSource": return c.serve(h.createHealthCheckSource,
			["route53:ChangeTagsForResource", "route53:CreateHealthCheckSource"], 201)
		case "CreateHostedZone": return c.serve(h.createHostedZone, ["route53:CreateHostedZone"], 201)
		case "CreateKeySigningKey": return c.serve(h.createKeySigningKey, ["route53:CreateKeySigningKey"], 201)
		case "CreateQueryLoggingConfig": return c.serve(h.createQueryLoggingConfig,
			["route53:CreateQueryLoggingConfig"], 201)
		case "CreateResourceRecordSetProtections": return c.serve(h.createResourceRecordSetProtections,
			["route53:CreateResourceRecordSetProtections"])
		case "CreateReusableDelegationSet": return c.serve(h.createReusableDelegationSet,
			["route53:CreateReusableDelegationSet"], 201)
		case "CreateTrafficPolicy": return c.serve(h.createTrafficPolicy, ["route53:CreateTrafficPolicy"], 201)
		case "CreateTrafficPolicyInstance": return c.serve(h.createTrafficPolicyInstance,
			["route53:CreateTrafficPolicyInstance"], 201)
		case "CreateTrafficPolicyVersion": return c.serve(h.createTrafficPolicyVersion,
			["route53:CreateTrafficPolicyVersion"], 201)
		case "CreateVPCAssociationAuthorization": return c.serve(h.createVPCAssociationAuthorization,
			["route53:CreateVPCAssociationAuthorization"])
		case "DeactivateKeySigningKey": return c.serve(h.deactivateKeySigningKey, ["route53:DeactivateKeySigningKey"])
		case "DeleteCidrCollection": return c.serve(h.deleteCidrCollection, ["route53:DeleteCidrCollection"])
		case "DeleteHealthCheck": return c.serve(h.deleteHealthCheck, ["route53:DeleteHealthCheck"])
		case "DeleteHealthCheckSource": return c.serve(h.deleteHealthCheckSource, ["route53:DeleteHealthCheckSource"])
		case "DeleteHostedZone": return c.serve(h.deleteHostedZone, ["route53:DeleteHostedZone"])
