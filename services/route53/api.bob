		input: CreateHealthCheckSourceRequest): CreateHealthCheckSourceResponse throws Fault

	createHostedZone(caller: Caller, input: CreateHostedZoneRequest): CreateHostedZoneResponse throws Fault
	createKeySigningKey(caller: Caller, input: CreateKeySigningKeyRequest): CreateKeySigningKeyResponse throws Fault

	createQueryLoggingConfig(caller: Caller,
