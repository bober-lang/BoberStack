import { text } from "../../core/client.test"
import { Gateway } from "../../core/gateway"
import { stack } from "../../stack"
import { Catalog } from "../iam/catalog"
import { accounts, Server } from "./dns"
import { labels } from "./rdata"
import { batch, call, create } from "./route53.test"
import * as wire from "./wire"
import { Conn, dial, listenUdp, UdpConn } from "std/net"
import { millisecond, second } from "std/time"

/// A gateway with the zone example.test, and a name server of it on a free port.
class Fixture {
	g: Gateway = stack(new Catalog(""))
	server: Server
	client: UdpConn
	zone = ""

	constructor(records: string[]) {
		this.zone = text(call(this.g, "POST", "/hostedzone", create("example.test", "r1")), "Id")!
		if (records.length > 0) {
			this.change(records)
		}
		const g = this.g
		this.server = new Server(() => accounts(g.trees, g.named))
		this.server.addr = "127.0.0.1:0"
		this.server.idle = 200 * millisecond
		this.server.listen()
		const serving = async this.server.serve()
		this.client = listenUdp("127.0.0.1:0")
		this.client.timeout = second
	}

	change(records: string[]) {
		const res = call(this.g, "POST", `${this.zone}/rrset`, batch(records.map(r => ["CREATE", r])))
		assert res.status == 200
	}

	ask(m: wire.Message): wire.Message {
		this.send(wire.encode(m))
		return wire.decode(this.client.receive()[0])
	}

	send(bytes: string) { this.client.send(bytes, this.server.addr) }

	close() {
		this.client.close()
		this.server.close()
		this.g.close()
	}
}

function query(name: string, kind: string, id: u16 = 7): wire.Message {
	const m = new wire.Message()
	m.id = id
	m.recursionDesired = true
	const q = new wire.Question()
	q.name = labels(name)
	q.type = wire.code(kind)
	m.questions.push(q)
	return m
}

function edns(m: wire.Message, size: u16): wire.Message {
	const e = new wire.Edns()
	e.size = size
	m.edns = e
	return m
}

function rr(name: string, kind: string, values: string[]): string {
	return `<Name>${name}</Name><Type>${kind}</Type><TTL>60</TTL><ResourceRecords>`
		+ values.map(v => `<ResourceRecord><Value>${v}</Value></ResourceRecord>`).join("") + "</ResourceRecords>"
}

function repeat(s: string, n: i32): string {
	let out = ""
	for (let i = 0; i < n; i++) {
		out += s
	}
	return out
}

/// A TXT value of four strings of 255 bytes.
const long = [`"${repeat("a", 255)}" "${repeat("b", 255)}" "${repeat("c", 255)}" "${repeat("d", 255)}"`]

test "queries as datagrams" {
	const f = new Fixture([rr("www.example.test", "A", ["192.0.2.1"]), rr("*.w.example.test", "AAAA", ["2001:db8::1"])])
	const a = f.ask(query("WWW.example.test", "A"))
	assert a.id == 7 && a.response && a.authoritative && a.recursionDesired && !a.recursionAvailable && a.rcode == 0
	assert a.questions[0].name == ["WWW", "example", "test"]
	assert a.answers.length == 1 && a.answers[0].raw == "\xc0\x00\x02\x01" && a.answers[0].ttl == 60
	assert a.answers[0].name == ["WWW", "example", "test"]
	const wild = f.ask(query("x.y.w.example.test", "AAAA"))
	assert wild.answers.length == 1 && wild.answers[0].raw.length == 16
	const nx = f.ask(query("nope.example.test", "A"))
	assert nx.rcode == wire.nxDomain && nx.authority.length == 1 && nx.authority[0].type == 6
	assert f.ask(query("www.other.test", "A")).rcode == wire.refused
	f.change([rr("new.example.test", "A", ["192.0.2.2"])])
	assert f.ask(query("new.example.test", "A")).answers.length == 1
	f.close()
}

test "an answer longer than a datagram is truncated, unless EDNS makes room" {
	const f = new Fixture([rr("big.example.test", "TXT", long)])
	const cut = f.ask(query("big.example.test", "TXT"))
	assert cut.truncated && cut.answers.length == 0 && cut.rcode == 0
	const whole = f.ask(edns(query("big.example.test", "TXT"), 1232))
	assert !whole.truncated && whole.answers.length == 1 && whole.answers[0].raw.length == 1024
	assert whole.edns != null && whole.edns!.size == 4096
	const small = f.ask(edns(query("big.example.test", "TXT"), 100))
	assert small.truncated
	f.close()
}

/// The messages of a TCP connection, each after its length.
class Frames {
	c: Conn
	private got = ""

	constructor(c: Conn) { this.c = c }

	/// The next message, or null if the connection ends first.
	next(): wire.Message | null {
		while (this.got.length < 2 || this.got.length < 2 + (((this.got[0] as i32) << 8) | (this.got[1] as i32))) {
			const more = this.c.read(65536)
			if (more == null) {
				return null
			}
			this.got += more!
		}
		const n = 2 + (((this.got[0] as i32) << 8) | (this.got[1] as i32))
		const m = wire.decode(this.got.slice(2, n))
		this.got = this.got.slice(n, this.got.length)
		return m
	}
}

function framed(m: wire.Message): string {
	const b = wire.encode(m)
	return fromBytes([(b.length >> 8) as u8, (b.length & 0xff) as u8]) + b
}

test "queries over TCP, several on a connection, until it is idle" {
	const f = new Fixture([rr("big.example.test", "TXT", long), rr("www.example.test", "A", ["192.0.2.1"])])
	const c = dial(f.server.addr)
	const frames = new Frames(c)
	c.write(framed(query("big.example.test", "TXT", 1)))
	const big = frames.next()!
	assert big.id == 1 && !big.truncated && big.answers.length == 1
	// two at once, the second's length split from its body
	const both = framed(query("www.example.test", "A", 2)) + framed(query("nope.example.test", "A", 3))
	c.write(both.slice(0, both.length - 20))
	c.write(both.slice(both.length - 20, both.length))
	const second = frames.next()!
	const third = frames.next()!
	assert second.id == 2 && second.answers.length == 1 && third.id == 3 && third.rcode == wire.nxDomain
	assert frames.next() == null
	c.close()
	f.close()
}

test "what is not a query" {
	const f = new Fixture([rr("www.example.test", "A", ["192.0.2.1"])])
	f.send("\x01\x02")
	const response = query("www.example.test", "A", 9)
	response.response = true
	f.send(wire.encode(response))
	f.send("\x00\x05\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x3fwww")
	const formerr = wire.decode(f.client.receive()[0])
	assert formerr.id == 5 && formerr.response && formerr.rcode == wire.formErr && formerr.questions.length == 0
	const status = query("www.example.test", "A", 10)
	status.opcode = 2
	assert f.ask(status).rcode == wire.notImp
	const chaos = query("version.bind", "TXT", 11)
	chaos.questions[0].rrclass = 3
	assert f.ask(chaos).rcode == wire.refused
	assert f.ask(query("example.test", "AXFR", 12)).rcode == wire.refused
	const later = edns(query("www.example.test", "A", 13), 1232)
	later.edns!.version = 1
	const badvers = f.ask(later)
	assert badvers.rcode == 0 && badvers.edns!.upper == 1 && badvers.answers.length == 0
	const two = query("www.example.test", "A", 14)
	two.questions.push(two.questions[0])
	assert f.ask(two).rcode == wire.formErr
	assert f.ask(query("www.example.test", "A", 15)).answers.length == 1
	f.close()
}

test "an EDNS client subnet chooses IP-based answers and is echoed with its scope" {
	const f = new Fixture([])
	const made = call(f.g, "POST", "/cidrcollection",
		"<CreateCidrCollectionRequest xmlns=\"https://route53.amazonaws.com/doc/2013-04-01/\"><Name>c</Name>"
		+ "<CallerReference>c1</CallerReference></CreateCidrCollectionRequest>")
	const collection = text(made, "Id")!
	const changed = call(f.g, "POST", `/cidrcollection/${collection}`,
		"<ChangeCidrCollectionRequest xmlns=\"https://route53.amazonaws.com/doc/2013-04-01/\"><Changes>"
		+ "<member><LocationName>office</LocationName><Action>PUT</Action><CidrList>"
		+ "<Cidr>198.51.100.0/24</Cidr></CidrList></member></Changes></ChangeCidrCollectionRequest>")
	assert changed.status == 200
	const routed = (id: string, location: string, value: string) => `<Name>i.example.test</Name><Type>A</Type>`
		+ `<SetIdentifier>${id}</SetIdentifier><CidrRoutingConfig><CollectionId>${collection}</CollectionId>`
		+ `<LocationName>${location}</LocationName></CidrRoutingConfig><TTL>60</TTL><ResourceRecords>`
		+ `<ResourceRecord><Value>${value}</Value></ResourceRecord></ResourceRecords>`
	f.change([routed("office", "office", "192.0.2.1"), routed("rest", "*", "192.0.2.2")])
	const subnet = (bits: u8, address: string) => {
		const m = edns(query("i.example.test", "A"), 1232)
		m.edns!.options.push([8, "\x00\x01" + fromBytes([bits, 0]) + address])
		return m
	}
	const inside = f.ask(subnet(24, "\xc6\x33\x64"))
	assert inside.answers[0].raw == "\xc0\x00\x02\x01"
	assert inside.edns!.options == [[8 as u16, "\x00\x01\x18\x18\xc6\x33\x64"]]
	const outside = f.ask(subnet(24, "\xc6\x33\x65"))
	assert outside.answers[0].raw == "\xc0\x00\x02\x02" && outside.edns!.options[0][1][3] == 0
	assert f.ask(query("i.example.test", "A")).answers[0].raw == "\xc0\x00\x02\x02"
	assert f.ask(subnet(33, "\xc6\x33\x64\x01\x00")).rcode == wire.formErr
	f.close()
}

test "close ends serve" {
	const g = stack(new Catalog(""))
	const s = new Server(() => accounts(g.trees, g.named))
	s.addr = "127.0.0.1:0"
	s.listen()
	const serving = async s.serve()
	const c = dial(s.addr)
	s.close()
	await serving
	assert c.read(10) == null
	g.close()
}
