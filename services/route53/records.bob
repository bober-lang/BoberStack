//! Route 53's state in an account's tree.

import { Store, Table } from "../../core/state/store"
import * as api from "./api"

export class Zone {
	id = ""
	/// Normalised: lower case, its trailing dot, escaped as AWS escapes it.
	name = ""
	reference = ""
	comment: string | null = null
	isPrivate = false
	/// The VPCs of a private zone: each its region and id.
	vpcs: [string, string][] = []
	nameServers: string[] = []
	delegationSet = ""
	records: Record[] = []
	tags: [string, string][] = []
	created: i64 = 0
}

export class Record {
	name = ""
	type = ""
	setIdentifier: string | null = null
	weight: i64 | null = null
	region: string | null = null
	continent: string | null = null
	country: string | null = null
	subdivision: string | null = null
	failover: string | null = null
	multiValue: bool | null = null
	ttl: i64 | null = null
	values: string[] | null = null
	alias: Alias | null = null
	healthCheck: string | null = null
}

export class Alias {
	zone = ""
	name = ""
	evaluate = false
}

/// A change submitted: when, its comment, and whether a GetChange has read it.
export class Change {
	id = ""
	submitted: i64 = 0
	comment: string | null = null
	read = false
}

export class Reference {
	zone = ""
}

export class Check {
	id = ""
	reference = ""
	config: api.HealthCheckConfig = new api.HealthCheckConfig()
	version: i64 = 1
	tags: [string, string][] = []
}

/// The health check a caller reference made: its id, kept after the check is deleted, as AWS keeps it.
export class CheckReference {
	check = ""
}

export class DelegationSet {
	id = ""
	reference = ""
	nameServers: string[] = []
}

/// A CIDR collection: its blocks, each its location's name and the block.
export class Collection {
	id = ""
	name = ""
	reference = ""
	version: i64 = 1
	blocks: [string, string][] = []
}

export class Tables {
	zones: Table[Zone]
	references: Table[Reference]
	changes: Table[Change]
	checks: Table[Check]
	checkReferences: Table[CheckReference]
	sets: Table[DelegationSet]
	collections: Table[Collection]

	constructor(s: Store) {
		this.zones = new Table[Zone](s, "route53/zones")
		this.references = new Table[Reference](s, "route53/references")
		this.changes = new Table[Change](s, "route53/changes")
		this.checks = new Table[Check](s, "route53/healthchecks")
		this.checkReferences = new Table[CheckReference](s, "route53/healthcheckreferences")
		this.sets = new Table[DelegationSet](s, "route53/delegationsets")
		this.collections = new Table[Collection](s, "route53/cidrcollections")
	}
}
