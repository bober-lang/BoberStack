export function accessDenied(message: string): Fault { return new Fault(403, "AccessDenied", message) }

export function annotationLimitExceeded(message: string): Fault {
	return new Fault(400, "AnnotationLimitExceeded", message)
}

export function annotationNameTooLong(message: string): Fault {
	return new Fault(400, "AnnotationNameTooLong", message)
}

export function bucketAlreadyExists(message: string): Fault { return new Fault(409, "BucketAlreadyExists", message) }

export function bucketAlreadyOwnedByYou(message: string): Fault {
	return new Fault(409, "BucketAlreadyOwnedByYou", message)
}

export function encryptionTypeMismatch(message: string): Fault {
	return new Fault(400, "EncryptionTypeMismatch", message)
}

export function idempotencyParameterMismatch(message: string): Fault {
	return new Fault(400, "IdempotencyParameterMismatch", message)
}

export function invalidAnnotationName(message: string): Fault {
	return new Fault(400, "InvalidAnnotationName", message)
}

/// The members of InvalidObjectState besides its message.
export class InvalidObjectState {
	StorageClass: string | null
	AccessTier: string | null
}

export function invalidObjectState(message: string, members: InvalidObjectState = new InvalidObjectState()): Fault {
	return new Fault(403, "InvalidObjectState", message, true, restxml.members(members))
}

export function invalidPrefix(message: string): Fault { return new Fault(400, "InvalidPrefix", message) }
export function invalidRequest(message: string): Fault { return new Fault(400, "InvalidRequest", message) }
export function invalidWriteOffset(message: string): Fault { return new Fault(400, "InvalidWriteOffset", message) }
export function noSuchAnnotation(message: string): Fault { return new Fault(404, "NoSuchAnnotation", message) }
export function noSuchBucket(message: string): Fault { return new Fault(404, "NoSuchBucket", message) }
export function noSuchKey(message: string): Fault { return new Fault(404, "NoSuchKey", message) }
export function noSuchUpload(message: string): Fault { return new Fault(404, "NoSuchUpload", message) }
export function notFound(message: string): Fault { return new Fault(400, "NotFound", message) }

export function objectAlreadyInActiveTierError(message: string): Fault {
	return new Fault(403, "ObjectAlreadyInActiveTierError", message)
}

export function objectNotInActiveTierError(message: string): Fault {
	return new Fault(403, "ObjectNotInActiveTierError", message)
}

export function tooManyParts(message: string): Fault { return new Fault(400, "TooManyParts", message) }
export function unsupportedMediaType(message: string): Fault { return new Fault(415, "UnsupportedMediaType", message) }

