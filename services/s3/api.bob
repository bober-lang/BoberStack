/// The answer of h to req.
export function handle(h: S3, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = restxml.call(caller, req, service, routes)
	switch (c.operation) {
		case "AbortMultipartUpload": return c.serve(h.abortMultipartUpload,
			["s3:AbortMultipartUpload", "s3-object-lambda:AbortMultipartUpload"], 204)
		case "CompleteMultipartUpload": return c.serve(h.completeMultipartUpload,
			["s3:PutObject", "s3-object-lambda:PutObject"])
		case "CopyObject": return c.serve(h.copyObject,
			["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3-object-lambda:PutObject", "s3:PutObjectAcl",
			"s3:PutObjectLegalHold", "s3:PutObjectRetention", "s3:PutObjectTagging"])
		case "CreateBucket": return c.serve(h.createBucket,
			["s3:CreateBucket", "s3:PutBucketAcl", "s3:PutBucketObjectLockConfiguration",
			"s3:PutBucketOwnershipControls", "s3:PutBucketVersioning"])
		case "CreateBucketMetadataConfiguration": return c.serve(h.createBucketMetadataConfiguration,
			["s3:CreateBucketMetadataTableConfiguration", "s3tables:CreateNamespace", "s3tables:CreateTable",
			"s3tables:CreateTableBucket", "s3tables:GetTable", "s3tables:PutTableEncryption",
			"s3tables:PutTablePolicy"])
		case "CreateBucketMetadataTableConfiguration": return c.serve(h.createBucketMetadataTableConfiguration,
			["s3:CreateBucketMetadataTableConfiguration", "s3tables:CreateNamespace", "s3tables:CreateTable",
			"s3tables:GetTable", "s3tables:PutTablePolicy"])
		case "CreateMultipartUpload": return c.serve(h.createMultipartUpload,
			["s3:PutObject", "s3-object-lambda:PutObject", "s3:PutObjectAcl", "s3:PutObjectLegalHold",
			"s3:PutObjectRetention", "s3:PutObjectTagging"])
		case "CreateSession": return c.serve(h.createSession, [])
		case "DeleteBucket": return c.serve(h.deleteBucket, ["s3:DeleteBucket"], 204)
		case "DeleteBucketAnalyticsConfiguration": return c.serve(h.deleteBucketAnalyticsConfiguration,
			["s3:PutAnalyticsConfiguration"], 204)
		case "DeleteBucketCors": return c.serve(h.deleteBucketCors, ["s3:PutBucketCORS"], 204)
		case "DeleteBucketEncryption": return c.serve(h.deleteBucketEncryption, ["s3:PutEncryptionConfiguration"], 204)
		case "DeleteBucketIntelligentTieringConfiguration": return c.serve(h.deleteBucketIntelligentTieringConfiguration,
			["s3:PutIntelligentTieringConfiguration"], 204)
		case "DeleteBucketInventoryConfiguration": return c.serve(h.deleteBucketInventoryConfiguration,
			["s3:PutInventoryConfiguration"], 204)
		case "DeleteBucketLifecycle": return c.serve(h.deleteBucketLifecycle, ["s3:PutLifecycleConfiguration"], 204)
		case "DeleteBucketMetadataConfiguration": return c.serve(h.deleteBucketMetadataConfiguration,
			["s3:DeleteBucketMetadataTableConfiguration"], 204)
		case "DeleteBucketMetadataTableConfiguration": return c.serve(h.deleteBucketMetadataTableConfiguration,
			["s3:DeleteBucketMetadataTableConfiguration"], 204)
		case "DeleteBucketMetricsConfiguration": return c.serve(h.deleteBucketMetricsConfiguration,
			["s3:PutMetricsConfiguration"], 204)
		case "DeleteBucketOwnershipControls": return c.serve(h.deleteBucketOwnershipControls,
			["s3:PutBucketOwnershipControls"], 204)
		case "DeleteBucketPolicy": return c.serve(h.deleteBucketPolicy, ["s3:DeleteBucketPolicy"], 204)
		case "DeleteBucketReplication": return c.serve(h.deleteBucketReplication, ["s3:PutReplicationConfiguration"],
			204)
		case "DeleteBucketTagging": return c.serve(h.deleteBucketTagging, ["s3:PutBucketTagging"], 204)
		case "DeleteBucketWebsite": return c.serve(h.deleteBucketWebsite, ["s3:DeleteBucketWebsite"], 204)
		case "DeleteObject": return c.serve(h.deleteObject,
			["s3:BypassGovernanceRetention", "s3:DeleteObject", "s3-object-lambda:DeleteObject",
			"s3:DeleteObjectVersion"], 204)
		case "DeleteObjectAnnotation": return c.serve(h.deleteObjectAnnotation, [], 204)
		case "DeleteObjectTagging": return c.serve(h.deleteObjectTagging,
			["s3:DeleteObjectTagging", "s3-object-lambda:DeleteObjectTagging", "s3:DeleteObjectVersionTagging"], 204)
		case "DeleteObjects": return c.serve(h.deleteObjects,
			["s3:BypassGovernanceRetention", "s3:DeleteObject", "s3:DeleteObjectVersion"])
		case "DeletePublicAccessBlock": return c.serve(h.deletePublicAccessBlock, ["s3:PutBucketPublicAccessBlock"],
			204)
		case "GetBucketAbac": return c.serve(h.getBucketAbac, [])
		case "GetBucketAccelerateConfiguration": return c.serve(h.getBucketAccelerateConfiguration,
			["s3:GetAccelerateConfiguration"])
		case "GetBucketAcl": return c.serve(h.getBucketAcl, ["s3:GetBucketAcl"])
		case "GetBucketAnalyticsConfiguration": return c.serve(h.getBucketAnalyticsConfiguration,
			["s3:GetAnalyticsConfiguration"])
		case "GetBucketCors": return c.serve(h.getBucketCors, ["s3:GetBucketCORS"])
		case "GetBucketEncryption": return c.serve(h.getBucketEncryption, ["s3:GetEncryptionConfiguration"])
		case "GetBucketIntelligentTieringConfiguration": return c.serve(h.getBucketIntelligentTieringConfiguration,
			["s3:GetIntelligentTieringConfiguration"])
		case "GetBucketInventoryConfiguration": return c.serve(h.getBucketInventoryConfiguration,
			["s3:GetInventoryConfiguration"])
		case "GetBucketLifecycleConfiguration": return c.serve(h.getBucketLifecycleConfiguration,
			["s3:GetLifecycleConfiguration", "s3express:GetLifecycleConfiguration"])
		case "GetBucketLocation": return c.serve(h.getBucketLocation, ["s3:GetBucketLocation"])
		case "GetBucketLogging": return c.serve(h.getBucketLogging, ["s3:GetBucketLogging"])
		case "GetBucketMetadataConfiguration": return c.serve(h.getBucketMetadataConfiguration,
			["s3:GetBucketMetadataTableConfiguration"])
		case "GetBucketMetadataTableConfiguration": return c.serve(h.getBucketMetadataTableConfiguration,
			["s3:GetBucketMetadataTableConfiguration"])
		case "GetBucketMetricsConfiguration": return c.serve(h.getBucketMetricsConfiguration,
			["s3:GetMetricsConfiguration"])
		case "GetBucketNotificationConfiguration": return c.serve(h.getBucketNotificationConfiguration,
			["s3:GetBucketNotification"])
		case "GetBucketOwnershipControls": return c.serve(h.getBucketOwnershipControls,
			["s3:GetBucketOwnershipControls"])
		case "GetBucketPolicy": return c.serve(h.getBucketPolicy, ["s3:GetBucketPolicy"])
		case "GetBucketPolicyStatus": return c.serve(h.getBucketPolicyStatus, ["s3:GetBucketPolicyStatus"])
		case "GetBucketReplication": return c.serve(h.getBucketReplication, ["s3:GetReplicationConfiguration"])
		case "GetBucketRequestPayment": return c.serve(h.getBucketRequestPayment, ["s3:GetBucketRequestPayment"])
		case "GetBucketTagging": return c.serve(h.getBucketTagging, ["s3:GetBucketTagging"])
		case "GetBucketVersioning": return c.serve(h.getBucketVersioning, ["s3:GetBucketVersioning"])
		case "GetBucketWebsite": return c.serve(h.getBucketWebsite, ["s3:GetBucketWebsite"])
		case "GetObject": return c.serve(h.getObject,
			["s3:GetObject", "s3-object-lambda:GetObject", "s3:GetObjectLegalHold", "s3:GetObjectRetention",
			"s3:GetObjectTagging", "s3:GetObjectVersion"])
		case "GetObjectAcl": return c.serve(h.getObjectAcl,
			["s3:GetObjectAcl", "s3-object-lambda:GetObjectAcl", "s3:GetObjectVersionAcl"])
		case "GetObjectAnnotation": return c.serve(h.getObjectAnnotation, [])
		case "GetObjectAttributes": return c.serve(h.getObjectAttributes, ["s3:GetObject", "s3:GetObjectVersion"])
