//! S3's bucket configuration: public access block, ownership controls and the ACLs they disable, default encryption,
//! CORS and its preflight requests, lifecycle rules (kept, never run), website, logging, request payment, Object
//! Lock, and notifications, which deliver to SQS queues and SNS topics, and with EventBridge on to the bucket owner's
//! default event bus, within the request that makes the event. The operations of the Handler of ./s3 that it mixes in.
//! Where AWS differs: an EventBridge event's key is as given, not URL-encoded, and of a removal of an object never
//! versioned it has no etag; the events of tags, ACLs, restores and lifecycle are never made.

import { Fault } from "../../core/fault"
import { Policy } from "../../core/auth/policy"
import { Caller, Unit } from "../../core/service"
import { Table } from "../../core/state/store"
import * as events from "../events/events"
import * as snsApi from "../sns/api"
import * as sqsApi from "../sqs/api"
import * as api from "./api"
import { arn, found, Found, member, noSuchBucket, noSuchKey, owner } from "./common"
import { path, places, put, Tables, Version } from "./records"
import { endsWith, startsWith } from "std/algo"
import * as json from "std/encoding/json"
import { Request, Response } from "std/http"
import { lower, replace, split, trim } from "std/string"
import { rfc3339 } from "std/time"
import { escape } from "std/url"

/// A bucket's configuration, which a bucket that has none has the defaults of.
export class Settings {
	publicAccessBlock: api.PublicAccessBlockConfiguration | null = { ...new api.PublicAccessBlockConfiguration(),
		BlockPublicAcls: true, IgnorePublicAcls: true, BlockPublicPolicy: true, RestrictPublicBuckets: true }

	ownership: string | null = "BucketOwnerEnforced"
	/// The default rule if null.
	encryption: api.ServerSideEncryptionRule[] | null = null
	cors: api.CORSRule[] | null = null
	lifecycle: api.LifecycleRule[] | null = null
	website: api.WebsiteConfiguration | null = null
	logging: api.LoggingEnabled | null = null
	payer = "BucketOwner"
	lock: api.ObjectLockConfiguration | null = null
	mfaDelete: api.MFADeleteStatus | null = null
	notification = new api.NotificationConfiguration()
}

/// The configuration of the bucket of f.
export function settings(f: Found): Settings throws Fault { return table(f).get(f.bucket.name) ?? new Settings() }
/// Drops the configuration of the bucket of f, deleted.
export function forget(f: Found) throws Fault { table(f).delete(f.bucket.name) }

/// Throws S3's refusal of a public bucket policy p unless the bucket of f lets one be put.
export function publicPolicy(caller: Caller, f: Found, p: Policy) throws Fault {
	if (settings(f).publicAccessBlock?.BlockPublicPolicy == true && isPublic(p)) {
		throw new Fault(403, "AccessDenied",
			`User: ${caller.arn} is not authorized to perform: s3:PutBucketPolicy on resource: "${arn(f.bucket.name)}" `
			+ "because public policies are prevented by the BlockPublicPolicy setting in S3 Block Public Access.")
	}
}

/// Whether p grants anyone access, unconditionally.
export function isPublic(p: Policy): bool {
	return p.statements.some(s => s.allow && s.conditions.length == 0
		&& s.principals.some(n => n[0] == "*" || n[1] == "*"))
}

/// Throws S3's refusal of an ACL, acl, unless the bucket of f has ACLs enabled.
export function acl(f: Found, acl: string | null) throws Fault {
	if (acl != null && settings(f).ownership == "BucketOwnerEnforced") {
		throw aclsDisabled()
	}
}

/// The MFA delete status of the bucket of f, as GetBucketVersioning answers it.
export function mfaDelete(f: Found): api.MFADeleteStatus | null throws Fault { return settings(f).mfaDelete }

/// Keeps the MFA delete status that a PutBucketVersioning of the bucket of f sets, which S3 refuses to enable without
/// an MFA device.
export function versioned(f: Found, input: api.PutBucketVersioningRequest) throws Fault {
	const m = input.VersioningConfiguration.MFADelete
	if (m == null) {
		return
	}
	if (m! == "Enabled" && input.MFA == null) {
		throw new Fault(403, "AccessDenied", "Mfa Authentication must be used for this request")
	}
	const s = settings(f)
	s.mfaDelete = if (m! == "Enabled") "Enabled" else "Disabled"
	save(f, s)
}

/// The operations on a bucket's configuration, and what delivers its notifications.
export class Config {
	/// What notifications are delivered to, which the stack sets.
	sqs: sqsApi.SQS | null = null
	sns: snsApi.SNS | null = null
	events: events.Handler | null = null

	putPublicAccessBlock(caller: Caller, input: api.PutPublicAccessBlockRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketPublicAccessBlock"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const c = input.PublicAccessBlockConfiguration
		const s = settings(f)
		s.publicAccessBlock = { ...new api.PublicAccessBlockConfiguration(),
			BlockPublicAcls: c.BlockPublicAcls ?? false, IgnorePublicAcls: c.IgnorePublicAcls ?? false,
			BlockPublicPolicy: c.BlockPublicPolicy ?? false, RestrictPublicBuckets: c.RestrictPublicBuckets ?? false }
		save(f, s)
		return new Unit()
	}

	getPublicAccessBlock(caller: Caller,
		input: api.GetPublicAccessBlockRequest): api.GetPublicAccessBlockOutput throws Fault {
		caller.actions = ["s3:GetBucketPublicAccessBlock"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const c = settings(f).publicAccessBlock
		if (c == null) {
			throw missing("NoSuchPublicAccessBlockConfiguration", "The public access block configuration was not found",
				input.Bucket)
		}
		return { ...new api.GetPublicAccessBlockOutput(), PublicAccessBlockConfiguration: c }
	}

	deletePublicAccessBlock(caller: Caller, input: api.DeletePublicAccessBlockRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketPublicAccessBlock"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.publicAccessBlock = null
		save(f, s)
		return new Unit()
	}

	putBucketOwnershipControls(caller: Caller, input: api.PutBucketOwnershipControlsRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketOwnershipControls"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = input.OwnershipControls.Rules
		if (rules.length != 1) {
			throw malformed()
		}
		const s = settings(f)
		s.ownership = rules[0].ObjectOwnership
		save(f, s)
		return new Unit()
	}

	getBucketOwnershipControls(caller: Caller,
		input: api.GetBucketOwnershipControlsRequest): api.GetBucketOwnershipControlsOutput throws Fault {
		caller.actions = ["s3:GetBucketOwnershipControls"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const o = settings(f).ownership
		if (o == null) {
			throw missing("OwnershipControlsNotFoundError", "The bucket ownership controls were not found",
				input.Bucket)
		}
		const rule = { ...new api.OwnershipControlsRule(), ObjectOwnership: o! }
		return { ...new api.GetBucketOwnershipControlsOutput(),
			OwnershipControls: { ...new api.OwnershipControls(), Rules: [rule] } }
	}

	deleteBucketOwnershipControls(caller: Caller, input: api.DeleteBucketOwnershipControlsRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketOwnershipControls"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.ownership = null
		save(f, s)
		return new Unit()
	}

	/// The owner's full control, the one grant of a bucket whose ACLs are disabled.
	getBucketAcl(caller: Caller, input: api.GetBucketAclRequest): api.GetBucketAclOutput throws Fault {
		caller.actions = ["s3:GetBucketAcl"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const o = owner(f.bucket.owner)
		return { ...new api.GetBucketAclOutput(), Owner: o, Grants: [fullControl(o)] }
	}

	putBucketAcl(caller: Caller, input: api.PutBucketAclRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketAcl"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		if (settings(f).ownership == "BucketOwnerEnforced") {
			throw aclsDisabled()
		}
		throw new Fault(501, "NotImplemented", "ACLs are not implemented")
	}

	getObjectAcl(caller: Caller, input: api.GetObjectAclRequest): api.GetObjectAclOutput throws Fault {
		caller.actions = [if (input.VersionId == null) "s3:GetObjectAcl" else "s3:GetObjectVersionAcl"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner, arn(input.Bucket, input.Key))
		if (f.db.objects.get(path(input.Bucket, input.Key)) == null) {
			throw noSuchKey(input.Key)
		}
		const o = owner(f.bucket.owner)
		return { ...new api.GetObjectAclOutput(), Owner: o, Grants: [fullControl(o)] }
	}

	putObjectAcl(caller: Caller, input: api.PutObjectAclRequest): api.PutObjectAclOutput throws Fault {
		caller.actions = [if (input.VersionId == null) "s3:PutObjectAcl" else "s3:PutObjectVersionAcl"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner, arn(input.Bucket, input.Key))
		if (settings(f).ownership == "BucketOwnerEnforced") {
			throw aclsDisabled()
		}
		throw new Fault(501, "NotImplemented", "ACLs are not implemented")
	}

	putBucketEncryption(caller: Caller, input: api.PutBucketEncryptionRequest): Unit throws Fault {
		caller.actions = ["s3:PutEncryptionConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = input.ServerSideEncryptionConfiguration.Rules
		if (rules.length != 1) {
			throw malformed()
		}
		for (const r of rules) {
			r.BucketKeyEnabled = r.BucketKeyEnabled ?? false
			r.BlockedEncryptionTypes = r.BlockedEncryptionTypes ?? sseC()
		}
		const s = settings(f)
		s.encryption = rules
		save(f, s)
		return new Unit()
	}

	/// The bucket's rule, or the SSE-S3 that every bucket has by default.
	getBucketEncryption(caller: Caller,
		input: api.GetBucketEncryptionRequest): api.GetBucketEncryptionOutput throws Fault {
		caller.actions = ["s3:GetEncryptionConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = settings(f).encryption
			?? [{ ...new api.ServerSideEncryptionRule(),
			ApplyServerSideEncryptionByDefault: { ...new api.ServerSideEncryptionByDefault(), SSEAlgorithm: "AES256" },
			BucketKeyEnabled: false, BlockedEncryptionTypes: sseC() }]
		return { ...new api.GetBucketEncryptionOutput(),
			ServerSideEncryptionConfiguration: { ...new api.ServerSideEncryptionConfiguration(), Rules: rules } }
	}

	deleteBucketEncryption(caller: Caller, input: api.DeleteBucketEncryptionRequest): Unit throws Fault {
		caller.actions = ["s3:PutEncryptionConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.encryption = null
		save(f, s)
		return new Unit()
	}

	putBucketCors(caller: Caller, input: api.PutBucketCorsRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketCORS"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.cors = input.CORSConfiguration.CORSRules
		save(f, s)
		return new Unit()
	}

	getBucketCors(caller: Caller, input: api.GetBucketCorsRequest): api.GetBucketCorsOutput throws Fault {
		caller.actions = ["s3:GetBucketCORS"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = settings(f).cors
		if (rules == null) {
			throw noCors(input.Bucket)
		}
		return { ...new api.GetBucketCorsOutput(), CORSRules: rules }
	}

	deleteBucketCors(caller: Caller, input: api.DeleteBucketCorsRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketCORS"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.cors = null
		save(f, s)
		return new Unit()
	}

	/// Kept as given once valid; nothing expires.
	putBucketLifecycleConfiguration(caller: Caller,
		input: api.PutBucketLifecycleConfigurationRequest): api.PutBucketLifecycleConfigurationOutput throws Fault {
		caller.actions = ["s3:PutLifecycleConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = input.LifecycleConfiguration?.Rules ?? []
		const ids: string[] = []
		for (const r of rules) {
			const days = r.Expiration?.Days
			if (days != null && days! <= 0) {
				throw argument("'Days' for Expiration action must be a positive integer", "Days", `${days!}`)
			}
			if (r.ID != null && ids.includes(r.ID!)) {
				throw argument("Rule ID must be unique. Found same ID for more than one rule", "ID", r.ID!)
			}
			if (r.ID != null) {
				ids.push(r.ID!)
			}
		}
		const s = settings(f)
		s.lifecycle = rules
		save(f, s)
		return new api.PutBucketLifecycleConfigurationOutput()
	}

	getBucketLifecycleConfiguration(caller: Caller,
		input: api.GetBucketLifecycleConfigurationRequest): api.GetBucketLifecycleConfigurationOutput throws Fault {
		caller.actions = ["s3:GetLifecycleConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const rules = settings(f).lifecycle
		if (rules == null) {
			throw missing("NoSuchLifecycleConfiguration", "The lifecycle configuration does not exist", input.Bucket)
		}
		return { ...new api.GetBucketLifecycleConfigurationOutput(), Rules: rules }
	}

	deleteBucketLifecycle(caller: Caller, input: api.DeleteBucketLifecycleRequest): Unit throws Fault {
		caller.actions = ["s3:PutLifecycleConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.lifecycle = null
		save(f, s)
		return new Unit()
	}

	putBucketWebsite(caller: Caller, input: api.PutBucketWebsiteRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketWebsite"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.website = input.WebsiteConfiguration
		save(f, s)
		return new Unit()
	}

	getBucketWebsite(caller: Caller, input: api.GetBucketWebsiteRequest): api.GetBucketWebsiteOutput throws Fault {
		caller.actions = ["s3:GetBucketWebsite"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const w = settings(f).website
		if (w == null) {
			throw missing("NoSuchWebsiteConfiguration", "The specified bucket does not have a website configuration",
				input.Bucket)
		}
		return { ...new api.GetBucketWebsiteOutput(), RedirectAllRequestsTo: w!.RedirectAllRequestsTo,
			IndexDocument: w!.IndexDocument, ErrorDocument: w!.ErrorDocument, RoutingRules: w!.RoutingRules }
	}

	deleteBucketWebsite(caller: Caller, input: api.DeleteBucketWebsiteRequest): Unit throws Fault {
		caller.actions = ["s3:DeleteBucketWebsite"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.website = null
		save(f, s)
		return new Unit()
	}

	putBucketLogging(caller: Caller, input: api.PutBucketLoggingRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketLogging"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.logging = input.BucketLoggingStatus.LoggingEnabled
		save(f, s)
		return new Unit()
	}

	getBucketLogging(caller: Caller, input: api.GetBucketLoggingRequest): api.GetBucketLoggingOutput throws Fault {
		caller.actions = ["s3:GetBucketLogging"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		return { ...new api.GetBucketLoggingOutput(), LoggingEnabled: settings(f).logging }
	}

	putBucketRequestPayment(caller: Caller, input: api.PutBucketRequestPaymentRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketRequestPayment"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const s = settings(f)
		s.payer = input.RequestPaymentConfiguration.Payer
		save(f, s)
		return new Unit()
	}

	getBucketRequestPayment(caller: Caller,
		input: api.GetBucketRequestPaymentRequest): api.GetBucketRequestPaymentOutput throws Fault {
		caller.actions = ["s3:GetBucketRequestPayment"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		return { ...new api.GetBucketRequestPaymentOutput(), Payer: settings(f).payer }
	}

	/// Refused as in eu-north-1, where S3 has no Transfer Acceleration.
	putBucketAccelerateConfiguration(caller: Caller,
		input: api.PutBucketAccelerateConfigurationRequest): Unit throws Fault {
		caller.actions = ["s3:PutAccelerateConfiguration"]
		found(caller, input.Bucket, input.ExpectedBucketOwner)
		throw notAllowed("PUT")
	}

	getBucketAccelerateConfiguration(caller: Caller,
		input: api.GetBucketAccelerateConfigurationRequest): api.GetBucketAccelerateConfigurationOutput throws Fault {
		caller.actions = ["s3:GetAccelerateConfiguration"]
		found(caller, input.Bucket, input.ExpectedBucketOwner)
		throw notAllowed("GET")
	}

	putObjectLockConfiguration(caller: Caller,
		input: api.PutObjectLockConfigurationRequest): api.PutObjectLockConfigurationOutput throws Fault {
		caller.actions = ["s3:PutBucketObjectLockConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		if (f.bucket.versioning != "Enabled") {
			throw new Fault(409, "InvalidBucketState",
				"Versioning must be 'Enabled' on the bucket to apply a Object Lock configuration")
		}
		const s = settings(f)
		s.lock = input.ObjectLockConfiguration
		save(f, s)
		return new api.PutObjectLockConfigurationOutput()
	}

	getObjectLockConfiguration(caller: Caller,
		input: api.GetObjectLockConfigurationRequest): api.GetObjectLockConfigurationOutput throws Fault {
		caller.actions = ["s3:GetBucketObjectLockConfiguration"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const l = settings(f).lock
		if (l == null) {
			throw missing("ObjectLockConfigurationNotFoundError",
				"Object Lock configuration does not exist for this bucket", input.Bucket)
		}
		return { ...new api.GetObjectLockConfigurationOutput(), ObjectLockConfiguration: l }
	}

	/// Kept once its events are S3's and each queue and topic, sent S3's test event, takes it; refused naming each
	/// that does not.
	putBucketNotificationConfiguration(caller: Caller,
		input: api.PutBucketNotificationConfigurationRequest): Unit throws Fault {
		caller.actions = ["s3:PutBucketNotification"]
		const f = found(caller, input.Bucket, input.ExpectedBucketOwner)
		const c = input.NotificationConfiguration
		const events: string[] = []
		for (const q of c.QueueConfigurations ?? []) {
			events.append(q.Events.map(e => `${e}`))
		}
		for (const t of c.TopicConfigurations ?? []) {
			events.append(t.Events.map(e => `${e}`))
		}
		for (const e of events) {
			if (!among[api.Event](e)) {
				throw argument("The event is not supported for notifications", "Event", e)
			}
		}
		if (input.SkipDestinationValidation != true) {
			const test = `{"Service":"Amazon S3","Event":"s3:TestEvent","Time":${json.quoted(time())},`
				+ `"Bucket":${json.quoted(input.Bucket)},"RequestId":${json.quoted(caller.requestId)},`
				+ `"HostId":${json.quoted(caller.requestId)}}`
			const failed: [string, string][] = []
			for (const q of c.QueueConfigurations ?? []) {
				const why = this.toQueue(caller, f, q.QueueArn, test)
				if (why != null) {
					failed.push([q.QueueArn, why!])
				}
			}
			for (const t of c.TopicConfigurations ?? []) {
				if (!this.toTopic(caller, f, t.TopicArn, test)) {
					failed.push([t.TopicArn,
						"Permissions on the destination topic do not allow S3 to publish notifications from this bucket"])
				}
			}
			if (failed.length > 0) {
				let members = ""
				for (let i = 0; i < failed.length; i++) {
					members += member(`ArgumentName${i + 1}`, failed[i][0])
						+ member(`ArgumentValue${i + 1}`, failed[i][1])
				}
				throw new Fault(400, "InvalidArgument", "Unable to validate the following destination configurations",
					true, members)
			}
		}
		const s = settings(f)
		s.notification = c
		save(f, s)
		return new Unit()
	}

	getBucketNotificationConfiguration(caller: Caller,
		input: api.GetBucketNotificationConfigurationRequest): api.NotificationConfiguration throws Fault {
		caller.actions = ["s3:GetBucketNotification"]
		return settings(found(caller, input.Bucket, input.ExpectedBucketOwner)).notification
	}

	/// Delivers to the queues and topics of the bucket of f that take the event named event, as
	/// ObjectCreated:Put, of the version v: S3's event record, sent as the service on behalf of the bucket, so that
	/// their policies decide; one refused is dropped.
	notify(caller: Caller, f: Found, event: string, v: Version) throws Fault {
		const c = settings(f).notification
		const queues = (c.QueueConfigurations
			?? []).filter(q => takes(q.Events.map(e => `${e}`), q.Filter, event, v.key))
		const topics = (c.TopicConfigurations
			?? []).filter(t => takes(t.Events.map(e => `${e}`), t.Filter, event, v.key))
		for (const q of queues) {
			this.toQueue(caller, f, q.QueueArn, record(caller, f, event, v, q.Id ?? ""))
		}
		for (const t of topics) {
			this.toTopic(caller, f, t.TopicArn, record(caller, f, event, v, t.Id ?? ""))
		}
		if (c.EventBridgeConfiguration != null && this.events != null) {
			// S3 puts it on the bucket owner's default bus of the bucket's region.
			const s = caller.internal("s3.amazonaws.com", arn(f.bucket.name), [])
			s.account = f.bucket.owner
			s.region = f.bucket.region
			const created = startsWith(event, "ObjectCreated:")
			this.events!.emit(s, "aws.s3", if (created) "Object Created" else "Object Deleted", [arn(f.bucket.name)],
				detail(caller, f, event, v))
		}
	}

	/// Sends body to the queue of the ARN a, as S3 for the bucket of f: null if it takes it, else why not.
	private toQueue(caller: Caller, f: Found, a: string, body: string): string | null {
		const parts = split(a, ":")
		if (this.sqs == null || parts.length != 6) {
			return "The destination queue does not exist"
		}
		const m = new sqsApi.SendMessageRequest()
		m.QueueUrl = `${caller.endpoint}/${parts[4]}/${parts[5]}`
		m.MessageBody = body
		try {
			this.sqs!.sendMessage(caller.internal("s3.amazonaws.com", arn(f.bucket.name), ["sqs:SendMessage"]), m)
		} catch (e: Fault) {
			return if (endsWith(e.code, "NonExistentQueue")
				|| e.code == "QueueDoesNotExist") "The destination queue does not exist"
				else "Permissions on the destination queue do not allow S3 to publish notifications from this bucket"
		}
		return null
	}

	/// Publishes body to the topic of the ARN a, as S3 for the bucket of f: whether it takes it.
	private toTopic(caller: Caller, f: Found, a: string, body: string): bool {
		if (this.sns == null) {
			return false
		}
		const m = new snsApi.PublishInput()
		m.TopicArn = a
		m.Subject = "Amazon S3 Notification"
		m.Message = body
		try {
			this.sns!.publish(caller.internal("s3.amazonaws.com", arn(f.bucket.name), ["sns:Publish"]), m)
		} catch (e: Fault) {
			return false
		}
		return true
	}
}

/// The answer to a CORS preflight request, an OPTIONS of req, to the bucket it names, by the bucket's CORS rules.
export function preflight(caller: Caller, req: Request): Response throws Fault {
	const segments = split(req.url.path.slice(1, req.url.path.length), "/")
	const name = segments[0]
	const resource = if (segments.length > 1 && segments[1] != "") "OBJECT" else "BUCKET"
	const origin = req.headers.get("origin")
	const method = req.headers.get("access-control-request-method") ?? ""
	if (origin == null) {
		throw new Fault(400, "BadRequest", "Insufficient information. Origin request header needed.")
	}
	const f = bucket(caller, name)
	const rules = settings(f).cors
	if (rules == null) {
		throw forbidden("CORSResponse: CORS is not enabled for this bucket.", method, "BUCKET")
	}
	const asked = split(lower(req.headers.get("access-control-request-headers") ?? ""),
		",").map(h => trim(h)).filter(h => h != "")
	for (const r of rules!) {
		if (allows(r, origin!, method) && asked.every(h => (r.AllowedHeaders ?? []).some(p => like(lower(p), h)))) {
			const res = new Response(200, "")
			res.headers.set("content-length", "0")
			cors(res, r, origin!)
			if (asked.length > 0) {
				res.headers.set("access-control-allow-headers", asked.join(", "))
			}
			return res
		}
	}
	throw forbidden("CORSResponse: This CORS request is not allowed. This is usually because the evalution of Origin, "
		+ "request method / Access-Control-Request-Method or Access-Control-Request-Headers are not whitelisted by the "
		+ "resource's CORS spec.", method, resource)
}

/// Sets on res, the answer to req of an Origin, the CORS headers of the first rule of its bucket that allows the
/// origin its method.
export function exposed(caller: Caller, req: Request, res: Response) throws Fault {
	const origin = req.headers.get("origin")
	const name = split(req.url.path.slice(1, req.url.path.length), "/")[0]
	if (origin == null || name == "") {
		return
	}
	const g = caller.existing("")
	const p = if (g == null) null else places(g!).get(name)
	if (p == null) {
		return
	}
	const db = new Tables(caller.tree(`${p.account}/${p.region}`))
	const b = db.buckets.get(name)
	if (b == null) {
		return
	}
	for (const r of settings(new Found(db, b!)).cors ?? []) {
		if (allows(r, origin!, req.method)) {
			cors(res, r, origin!)
			return
		}
	}
}

/// The bucket named name, unauthorized, as a preflight request reaches it.
function bucket(caller: Caller, name: string): Found throws Fault {
	const g = caller.existing("")
	const p = if (g == null) null else places(g!).get(name)
	if (p == null) {
		throw noSuchBucket(name)
	}
	const db = new Tables(caller.tree(`${p.account}/${p.region}`))
	return new Found(db, db.buckets.get(name)!)
}

/// Whether the rule r allows origin the method.
function allows(r: api.CORSRule, origin: string, method: string): bool {
	return r.AllowedOrigins.some(o => like(o, origin)) && r.AllowedMethods.includes(method)
}

/// Sets on res the headers of the rule r that allows origin.
function cors(res: Response, r: api.CORSRule, origin: string) {
	const any = r.AllowedOrigins.includes("*")
	res.headers.set("access-control-allow-origin", if (any) "*" else origin)
	res.headers.set("access-control-allow-methods", r.AllowedMethods.join(", "))
	if (r.ExposeHeaders != null) {
		res.headers.set("access-control-expose-headers", r.ExposeHeaders!.join(", "))
	}
	if (r.MaxAgeSeconds != null) {
		res.headers.set("access-control-max-age", `${r.MaxAgeSeconds!}`)
	}
	if (!any) {
		res.headers.set("access-control-allow-credentials", "true")
	}
	res.headers.set("vary", "Origin, Access-Control-Request-Headers, Access-Control-Request-Method")
}

/// Whether s matches the pattern p, of at most one *.
function like(p: string, s: string): bool {
	const parts = split(p, "*")
	if (parts.length == 1) {
		return p == s
	}
	return s.length >= parts[0].length + parts[1].length && startsWith(s, parts[0]) && endsWith(s, parts[1])
}

/// Whether a configuration of events, filtered by filter, takes the event named event of the key given.
function takes(events: string[], filter: api.NotificationConfigurationFilter | null, event: string, key: string): bool {
	const family = event.slice(0, event.length - split(event, ":")[1].length)
	if (!events.some(e => e == `s3:${event}` || e == `s3:${family}*`)) {
		return false
	}
	for (const r of filter?.Key?.FilterRules ?? []) {
		const v = r.Value ?? ""
		if (r.Name == "prefix" && !startsWith(key, v) || r.Name == "suffix" && !endsWith(key, v)) {
			return false
		}
	}
	return true
}

/// S3's event record of the event named event of the version v, of the bucket of f, for the configuration id.
function record(caller: Caller, f: Found, event: string, v: Version, id: string): string throws Fault {
	const created = startsWith(event, "ObjectCreated:")
	// as a form encodes it, though its slashes kept
	let object = `"key":${json.quoted(replace(escape(v.key, "form"), "%2F", "/"))}`
	if (created) {
		object += `,"size":${v.size},"eTag":${json.quoted(v.etag.slice(1, v.etag.length - 1))}`
	}
	if (f.bucket.versioning != "") {
		object += `,"versionId":${json.quoted(v.id)}`
	}
	object += `,"sequencer":${json.quoted(sequencer(v))}`
	const principal = json.quoted(`AWS:${caller.userId}`)
	return `{"Records":[{"eventVersion":"2.1","eventSource":"aws:s3","awsRegion":${json.quoted(f.bucket.region)},`
		+ `"eventTime":${json.quoted(time())},"eventName":${json.quoted(event)},`
		+ `"userIdentity":{"principalId":${principal}},"requestParameters":{"sourceIPAddress":"127.0.0.1"},`
		+ `"responseElements":{"x-amz-request-id":${json.quoted(caller.requestId)},`
		+ `"x-amz-id-2":${json.quoted(caller.requestId)}},"s3":{"s3SchemaVersion":"1.0",`
		+ `"configurationId":${json.quoted(id)},"bucket":{"name":${json.quoted(f.bucket.name)},`
		+ `"ownerIdentity":{"principalId":${json.quoted(owner(f.bucket.owner).ID ?? "")}},`
		+ `"arn":${json.quoted(arn(f.bucket.name))}},"object":{${object}}}}]}`
}

/// The detail of the EventBridge event of the event named event, as ObjectCreated:Put, of the version v of the bucket
/// of f: its reason the operation, and of a removal what it removed.
function detail(caller: Caller, f: Found, event: string, v: Version): string {
	const kind = split(event, ":")[1]
	const created = startsWith(event, "ObjectCreated:")
	let object = `"key":${json.quoted(v.key)}`
	if (created) {
		object += `,"size":${v.size}`
	}
	if (v.etag != "") {
		object += `,"etag":${json.quoted(v.etag.slice(1, v.etag.length - 1))}`
	} else if (kind == "DeleteMarkerCreated") {
		object += `,"etag":"d41d8cd98f00b204e9800998ecf8427e"`
	}
	if (f.bucket.versioning != "") {
		object += `,"version-id":${json.quoted(v.id)}`
	}
	object += `,"sequencer":${json.quoted(sequencer(v))}`
	const reason = if (!created) "DeleteObject"
		else if (kind == "Put") "PutObject"
		else if (kind == "Post") "POST Object"
		else if (kind == "Copy") "CopyObject"
		else kind
	const removed = if (created) ""
		else `,"deletion-type":${if (kind == "Delete") `"Permanently Deleted"` else `"Delete Marker Created"`}`
	return `{"version":"0","bucket":{"name":${json.quoted(f.bucket.name)}},"object":{${object}},`
		+ `"request-id":${json.quoted(caller.requestId)},"requester":${json.quoted(caller.account)},`
		+ `"source-ip-address":"127.0.0.1","reason":${json.quoted(reason)}${removed}}`
}

/// The sequencer of the version v, which orders the events of a key: its order in hex, 16 digits.
function sequencer(v: Version): string {
	let h = ""
	for (let n = v.order; h.length < 16; n = n >> 4) {
		const d = (n & 15) as i32
		h = "0123456789ABCDEF".slice(d, d + 1) + h
	}
	return h
}

/// Now, as S3's event records name a time.
function time(): string {
	const t = now()
	const s = rfc3339(t - t % 1000000)
	return if (endsWith(s, "Z")) `${s.slice(0, s.length - 1)}.${`${1000 + t / 1000000 % 1000}`.slice(1, 4)}Z` else s
}

function table(f: Found): Table[Settings] { return new Table[Settings](f.db.store, "s3/settings") }
function save(f: Found, s: Settings) throws Fault { put(table(f), f.bucket.name, s) }

function fullControl(o: api.Owner): api.Grant {
	return { ...new api.Grant(), Grantee: { ...new api.Grantee(), ID: o.ID, Type: "CanonicalUser" },
		Permission: "FULL_CONTROL" }
}

/// Whether s is one of the enum T, a union of literals.
function among[T](s: string): bool {
	for (const M of T.members) {
		if (M.kind == "literal" && `${M.value}` == s) {
			return true
		}
	}
	return false
}

function sseC(): api.BlockedEncryptionTypes {
	return { ...new api.BlockedEncryptionTypes(), EncryptionType: ["SSE-C"] }
}

function missing(code: string, message: string, bucket: string): Fault {
	return new Fault(404, code, message, true, member("BucketName", bucket))
}

function aclsDisabled(): Fault {
	return new Fault(400, "AccessControlListNotSupported", "The bucket does not allow ACLs")
}

function noCors(bucket: string): Fault {
	return missing("NoSuchCORSConfiguration", "The CORS configuration does not exist", bucket)
}

function argument(message: string, name: string, value: string): Fault {
	return new Fault(400, "InvalidArgument", message, true,
		member("ArgumentName", name) + member("ArgumentValue", value))
}

function forbidden(message: string, method: string, resource: string): Fault {
	return new Fault(403, "AccessForbidden", message, true, member("Method", method) + member("ResourceType", resource))
}

function notAllowed(method: string): Fault {
	return new Fault(405, "MethodNotAllowed", "The specified method is not allowed against this resource.", true,
		member("Method", method) + member("ResourceType", "accelerate"))
}

function malformed(): Fault {
	return new Fault(400, "MalformedXML",
		"The XML you provided was not well-formed or did not validate against our published schema")
}
