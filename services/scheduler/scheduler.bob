//! Amazon EventBridge Scheduler: schedules, schedule groups and their tags. A schedule fires at the gateway's tick by
//! calling its target's handler directly, as a session of its execution role; an invocation that fails goes to its
//! dead-letter queue, with AWS's message attributes, or is dropped. Where AWS differs:
//!
//! - A schedule fires up to a second late, and a tick that comes late fires it once, not once for each instant missed.
//!   A flexible time window is not used: the schedule fires at the window's start.
//! - An invocation is never retried; the retry policy is stored only.
//! - Its targets are SQS, SNS, Lambda, Step Functions, EventBridge, Kinesis and Firehose. A universal target (aws-sdk)
//!   fails, as there is no generic way to call an operation by its name here.
//! - A group is ACTIVE at once, and DeleteScheduleGroup deletes it and its schedules at once, where AWS answers
//!   DELETING. The default group is made on first use and never deleted.
//! - Error wording is this server's where AWS documents none.
//! - A customer's KMS key is stored unused; the target's ARN, dead-letter queue and parameters are checked only when
//!   the schedule fires.
//! - The request's tags are not checked against IAM policies.

import { Fault } from "../../core/fault"
import { pick } from "../../core/random"
import { Caller } from "../../core/service"
import * as schedule from "../events/schedule"
import * as eventsApi from "../events/api"
import * as firehoseApi from "../firehose/api"
import * as kinesisApi from "../kinesis/api"
import * as lambdaApi from "../lambda/api"
import * as snsApi from "../sns/api"
import * as sqsApi from "../sqs/api"
import * as sfnApi from "../stepfunctions/api"
import { actAs, passRole } from "../sts/sts"
import * as api from "./api"
import { Group, key, Schedule, Tables } from "./records"
import { endsWith, indexOf, sortBy, startsWith } from "std/algo"
import * as hex from "std/encoding/hex"
import { ParseError, split } from "std/string"
import { load, minute, rfc3339, second, utc, Zone } from "std/time"

const principal = "scheduler.amazonaws.com"
const untrusted = "The execution role you provide must allow AWS EventBridge Scheduler to assume the role."

export class Handler {
	...api.Unimplemented

	sqs: sqsApi.SQS | null = null
	sns: snsApi.SNS | null = null
	lambda: lambdaApi.Lambda | null = null
	states: sfnApi.SFN | null = null
	events: eventsApi.EventBridge | null = null
	kinesis: kinesisApi.Kinesis | null = null
	firehose: firehoseApi.Firehose | null = null

	createScheduleGroup(caller: Caller,
		input: api.CreateScheduleGroupInput): api.CreateScheduleGroupOutput throws Fault {
		const arn = groupArn(caller, input.Name)
		caller.allow(arn)
		const t = new Tables(caller.regional())
		const token = input.ClientToken ?? ""
		const was = group(t, input.Name)
		if (was != null) {
			if (token != "" && was!.token == token) {
				return { ...new api.CreateScheduleGroupOutput(), ScheduleGroupArn: arn }
			}
			throw api.conflictException(`Schedule group ${input.Name} already exists.`)
		}
		const g = new Group()
		g.name = input.Name
		g.token = token
		g.created = now()
		g.modified = g.created
		g.tags = (input.Tags ?? []).map(x => [x.Key, x.Value] as [string, string])
		t.groups.put(g.name, g)
		return { ...new api.CreateScheduleGroupOutput(), ScheduleGroupArn: arn }
	}

	getScheduleGroup(caller: Caller, input: api.GetScheduleGroupInput): api.GetScheduleGroupOutput throws Fault {
		caller.allow(groupArn(caller, input.Name))
		const g = existing(new Tables(caller.regional()), input.Name)
		const s = summary(caller, g)
		const out = new api.GetScheduleGroupOutput()
		out.Arn = s.Arn
		out.Name = s.Name
		out.State = s.State
		out.CreationDate = s.CreationDate
		out.LastModificationDate = s.LastModificationDate
		return out
	}

	listScheduleGroups(caller: Caller, input: api.ListScheduleGroupsInput): api.ListScheduleGroupsOutput throws Fault {
		caller.allow("*")
		const t = new Tables(caller.regional())
		group(t, "default")
		const gs = t.groups.scan(null,
			1000000).map(e => e[1]).filter(g => input.NamePrefix == null || startsWith(g.name, input.NamePrefix!))
		const [from, to, next] = page(gs.map(g => g.name), input.NextToken, input.MaxResults)
		const out = new api.ListScheduleGroupsOutput()
		out.ScheduleGroups = gs.slice(from, to).map(g => summary(caller, g))
		out.NextToken = next
		return out
	}

	deleteScheduleGroup(caller: Caller,
		input: api.DeleteScheduleGroupInput): api.DeleteScheduleGroupOutput throws Fault {
		caller.allow(groupArn(caller, input.Name))
		const t = new Tables(caller.regional())
		if (input.Name == "default") {
			throw api.validationException("The default schedule group cannot be deleted.")
		}
		existing(t, input.Name)
		for (const s of schedules(t).filter(s => s.group == input.Name)) {
			t.due.delete(s.next, key(s.group, s.name))
			t.schedules.delete(key(s.group, s.name))
		}
		t.groups.delete(input.Name)
		return new api.DeleteScheduleGroupOutput()
	}

	createSchedule(caller: Caller, input: api.CreateScheduleInput): api.CreateScheduleOutput throws Fault {
		const g = input.GroupName ?? "default"
		const arn = scheduleArn(caller, g, input.Name)
		caller.allow(arn)
		const t = new Tables(caller.regional())
		existing(t, g)
		const was = t.schedules.get(key(g, input.Name))
		if (was != null) {
			if (input.ClientToken != null && was!.token == input.ClientToken!) {
				return { ...new api.CreateScheduleOutput(), ScheduleArn: arn }
			}
			throw api.conflictException(`Schedule ${input.Name} already exists.`)
		}
		const s = new Schedule()
		s.group = g
		s.name = input.Name
		s.token = input.ClientToken ?? ""
		s.created = now()
		fill(caller, s, arn, input.ScheduleExpression, input.ScheduleExpressionTimezone, input.StartDate, input.EndDate,
			input.Description, input.State, input.KmsKeyArn, input.Target, input.FlexibleTimeWindow,
			input.ActionAfterCompletion)
		timed(t, s)
		t.schedules.put(key(g, s.name), s)
		return { ...new api.CreateScheduleOutput(), ScheduleArn: arn }
	}

	updateSchedule(caller: Caller, input: api.UpdateScheduleInput): api.UpdateScheduleOutput throws Fault {
		const g = input.GroupName ?? "default"
		const arn = scheduleArn(caller, g, input.Name)
		caller.allow(arn)
		const t = new Tables(caller.regional())
		const s = found(t, g, input.Name)
		fill(caller, s, arn, input.ScheduleExpression, input.ScheduleExpressionTimezone, input.StartDate, input.EndDate,
			input.Description, input.State, input.KmsKeyArn, input.Target, input.FlexibleTimeWindow,
			input.ActionAfterCompletion)
		timed(t, s)
		t.schedules.put(key(g, s.name), s)
		return { ...new api.UpdateScheduleOutput(), ScheduleArn: arn }
	}

	getSchedule(caller: Caller, input: api.GetScheduleInput): api.GetScheduleOutput throws Fault {
		const g = input.GroupName ?? "default"
		caller.allow(scheduleArn(caller, g, input.Name))
		const s = found(new Tables(caller.regional()), g, input.Name)
		const out = new api.GetScheduleOutput()
		out.Arn = scheduleArn(caller, g, s.name)
		out.GroupName = g
		out.Name = s.name
		out.ScheduleExpression = s.expression
		out.StartDate = s.start
		out.EndDate = s.end
		out.Description = s.description
		out.ScheduleExpressionTimezone = s.timezone
		out.State = s.state
		out.CreationDate = s.created
		out.LastModificationDate = s.modified
		out.KmsKeyArn = s.key
		out.Target = s.target
		out.FlexibleTimeWindow = s.window
		out.ActionAfterCompletion = s.after
		return out
	}

	listSchedules(caller: Caller, input: api.ListSchedulesInput): api.ListSchedulesOutput throws Fault {
		caller.allow("*")
		const t = new Tables(caller.regional())
		const ss = schedules(t).filter(s => (input.GroupName == null || s.group == input.GroupName!)
			&& (input.NamePrefix == null || startsWith(s.name, input.NamePrefix!))
			&& (input.State == null || s.state == input.State!))
		const [from, to, next] = page(ss.map(s => key(s.group, s.name)), input.NextToken, input.MaxResults)
		const out = new api.ListSchedulesOutput()
		out.Schedules = ss.slice(from, to).map(s => {
			const o = new api.ScheduleSummary()
			o.Arn = scheduleArn(caller, s.group, s.name)
			o.Name = s.name
			o.GroupName = s.group
			o.State = s.state
			o.CreationDate = s.created
			o.LastModificationDate = s.modified
			o.Target = { ...new api.TargetSummary(), Arn: s.target.Arn }
			return o
		})
		out.NextToken = next
		return out
	}

	deleteSchedule(caller: Caller, input: api.DeleteScheduleInput): api.DeleteScheduleOutput throws Fault {
		const g = input.GroupName ?? "default"
		caller.allow(scheduleArn(caller, g, input.Name))
		const t = new Tables(caller.regional())
		t.due.delete(found(t, g, input.Name).next, key(g, input.Name))
		t.schedules.delete(key(g, input.Name))
		return new api.DeleteScheduleOutput()
	}

	tagResource(caller: Caller, input: api.TagResourceInput): api.TagResourceOutput throws Fault {
		caller.allow(input.ResourceArn)
		const t = new Tables(caller.regional())
		const g = tagged(caller, t, input.ResourceArn)
		for (const x of input.Tags) {
			g.tags = g.tags.filter(k => k[0] != x.Key)
			g.tags.push([x.Key, x.Value])
		}
		t.groups.put(g.name, g)
		return new api.TagResourceOutput()
	}

	untagResource(caller: Caller, input: api.UntagResourceInput): api.UntagResourceOutput throws Fault {
		caller.allow(input.ResourceArn)
		const t = new Tables(caller.regional())
		const g = tagged(caller, t, input.ResourceArn)
		g.tags = g.tags.filter(k => !input.TagKeys.includes(k[0]))
		t.groups.put(g.name, g)
		return new api.UntagResourceOutput()
	}

	listTagsForResource(caller: Caller,
		input: api.ListTagsForResourceInput): api.ListTagsForResourceOutput throws Fault {
		caller.allow(input.ResourceArn)
		const g = tagged(caller, new Tables(caller.regional()), input.ResourceArn)
		const out = new api.ListTagsForResourceOutput()
		out.Tags = g.tags.map(k => ({ ...new api.Tag(), Key: k[0], Value: k[1] }))
		return out
	}

	/// Fires the schedules due by t in the caller's region, each once however many of its instants t is past.
	tick(caller: Caller, t: i64) throws Fault {
		const db = new Tables(caller.regional())
		for (const [at, k] of db.due.until(t)) {
			const s = db.schedules.get(k)!
			db.due.delete(at, k)
			s.next = following(s, t)
			if (s.next != null) {
				db.due.put(s.next!, k)
			}
			if (s.next == null && s.after == "DELETE") {
				db.schedules.delete(k)
			} else {
				db.schedules.put(k, s)
			}
			this.fire(caller, s, at)
		}
	}

	/// Invokes s's target with its input as of instant at; one that fails sends the input to its dead-letter queue.
	private fire(caller: Caller, s: Schedule, at: i64) throws Fault {
		const arn = scheduleArn(caller, s.group, s.name)
		const id = pick(16, "abcdefghijklmnopqrstuvwxyz0123456789")
		const time = rfc3339(at - at % second)
		// AWS documents no input when none is given; an empty JSON object is sent.
		let input = s.target.Input ?? "{}"
		for (const [k,
			v] of [["schedule-arn", arn], ["scheduled-time", time], ["execution-id", id], ["attempt-number", "1"]]) {
			input = split(input, `<aws.scheduler.${k}>`).join(v)
		}
		const x = s.target
		try {
			this.invoke(caller, arn, x, input, id)
		} catch (f: Fault) {
			const dlq = x.DeadLetterConfig?.Arn ?? null
			const [service, _, account, queue] = parts(dlq ?? "")
			if (service != "sqs" || this.sqs == null) {
				return
			}
			const m = new sqsApi.SendMessageRequest()
			m.QueueUrl = `${caller.endpoint}/${account}/${queue}`
			m.MessageBody = input
			m.MessageAttributes = [["ERROR_CODE", f.code], ["ERROR_MESSAGE", f.message], ["EXECUTION_ID", id],
				["IS_PAYLOAD_TRUNCATED", "false"], ["RETRY_ATTEMPTS", "0"], ["SCHEDULED_TIME", time],
				["SCHEDULE_ARN", arn], ["TARGET_ARN", x.Arn]].map(a => {
				const v = new sqsApi.MessageAttributeValue()
				v.DataType = "String"
				v.StringValue = a[1]
				return [a[0], v]
			})
			try {
				this.sqs!.sendMessage(assumed(caller, x.RoleArn, arn, ["sqs:SendMessage"], id), m)
			} catch (g: Fault) {} // dropped, as by AWS when its dead-letter queue refuses it too
		}
	}

	private invoke(caller: Caller, arn: string, x: api.Target, input: string, id: string) throws Fault {
		const [service, _, account, resource] = parts(x.Arn)
		if (service == "sqs" && this.sqs != null) {
			const m = new sqsApi.SendMessageRequest()
			m.QueueUrl = `${caller.endpoint}/${account}/${resource}`
			m.MessageBody = input
			if (endsWith(resource, ".fifo")) {
				m.MessageGroupId = x.SqsParameters?.MessageGroupId ?? null
				m.MessageDeduplicationId = id
			}
			this.sqs!.sendMessage(assumed(caller, x.RoleArn, arn, ["sqs:SendMessage"], id), m)
		} else if (service == "sns" && this.sns != null) {
			const m = new snsApi.PublishInput()
			m.TopicArn = x.Arn
			m.Message = input
			this.sns!.publish(assumed(caller, x.RoleArn, arn, ["sns:Publish"], id), m)
		} else if (service == "lambda" && this.lambda != null) {
			const m = new lambdaApi.InvocationRequest()
			m.FunctionName = x.Arn
			m.InvocationType = "Event"
			m.Payload = input
			this.lambda!.invoke(assumed(caller, x.RoleArn, arn, ["lambda:InvokeFunction"], id), m)
		} else if (service == "states" && this.states != null) {
			const m = new sfnApi.StartExecutionInput()
			m.stateMachineArn = x.Arn
			m.input = input
			this.states!.startExecution(assumed(caller, x.RoleArn, arn, ["states:StartExecution"], id), m)
		} else if (service == "events" && this.events != null && x.EventBridgeParameters != null) {
			const e = new eventsApi.PutEventsRequestEntry()
			e.EventBusName = x.Arn
			e.Source = x.EventBridgeParameters!.Source
			e.DetailType = x.EventBridgeParameters!.DetailType
			e.Detail = input
			const m = new eventsApi.PutEventsRequest()
			m.Entries = [e]
			const out = this.events!.putEvents(assumed(caller, x.RoleArn, arn, ["events:PutEvents"], id), m)
			const failed = out.Entries?.[0]
			if (out.FailedEntryCount > 0 && failed != null) {
				throw new Fault(400, failed!.ErrorCode ?? "InternalFailure", failed!.ErrorMessage ?? "")
			}
		} else if (service == "kinesis" && this.kinesis != null) {
			const m = new kinesisApi.PutRecordInput()
			m.StreamARN = x.Arn
			m.Data = input
			m.PartitionKey = x.KinesisParameters?.PartitionKey ?? id
			this.kinesis!.putRecord(assumed(caller, x.RoleArn, arn, ["kinesis:PutRecord"], id), m)
		} else if (service == "firehose" && this.firehose != null) {
			const m = new firehoseApi.PutRecordInput()
			m.DeliveryStreamName = resource.slice(indexOf(resource, "/") + 1, resource.length)
			m.Record.Data = input
			this.firehose!.putRecord(assumed(caller, x.RoleArn, arn, ["firehose:PutRecord"], id), m)
		} else {
			throw new Fault(400, "NotImplemented", `This server does not invoke target ${x.Arn}.`)
		}
	}
}

/// A session of role for schedule arn; a fault if the role does not let Scheduler assume it.
function assumed(caller: Caller, role: string, arn: string, actions: string[], session: string): Caller throws Fault {
	const c = actAs(caller, principal, role, arn, actions, session)
	if (c == null) {
		throw new Fault(403, "AccessDenied", untrusted)
	}
	return c!
}

function parts(a: string): [string, string, string, string] {
	const p = split(a, ":")
	if (p.length < 6) {
		return ["", "", "", ""]
	}
	return [p[2], p[3], p[4], p.slice(5, p.length).join(":")]
}

/// Files s by when it next fires after it was written, unfiled from when it was to.
function timed(t: Tables, s: Schedule) throws Fault {
	t.due.delete(s.next, key(s.group, s.name))
	s.next = if (s.state == "DISABLED") null else following(s, s.modified - 1)
	if (s.next != null) {
		t.due.put(s.next!, key(s.group, s.name))
	}
}

/// The first instant after t that s fires at: an at() whenever its reading comes, a rate every period from its start
/// or else from when it was written, a cron's within its start and end.
function following(s: Schedule, t: i64): i64 | null {
	const e = schedule.parse(s.expression, true)!
	const z = zone(s.timezone)
	if (e.at != null) {
		return schedule.next(e!, t, z, 0)
	}
	const from = s.start ?? s.modified
	const n = schedule.next(e!, if (from - 1 > t) from - 1 else t, z, from)
	return if (n == null || s.end != null && n! >= s.end!) null else n
}

function zone(name: string | null): Zone {
	if (name == null || name! == "UTC") {
		return utc
	}
	try {
		return load(name!)
	} catch (e: IoError | ParseError) {
		return utc // checked when written
	}
}

function groupArn(caller: Caller, name: string): string {
	return `arn:aws:scheduler:${caller.region}:${caller.account}:schedule-group/${name}`
}

function scheduleArn(caller: Caller, group: string, name: string): string {
	return `arn:aws:scheduler:${caller.region}:${caller.account}:schedule/${group}/${name}`
}

/// The group named name in t, null if there is none; the default group, made if it is not yet.
function group(t: Tables, name: string): Group | null throws Fault {
	const g = t.groups.get(name)
	if (g != null || name != "default") {
		return g
	}
	const made = new Group()
	made.name = name
	made.created = now()
	made.modified = made.created
	t.groups.put(name, made)
	return made
}

function existing(t: Tables, name: string): Group throws Fault {
	const g = group(t, name)
	if (g == null) {
		throw api.resourceNotFoundException(`Schedule group ${name} does not exist.`)
	}
	return g!
}

function tagged(caller: Caller, t: Tables, arn: string): Group throws Fault {
	const prefix = groupArn(caller, "")
	if (!startsWith(arn, prefix)) {
		throw api.resourceNotFoundException(`Schedule group ${arn} does not exist.`)
	}
	return existing(t, arn.slice(prefix.length, arn.length))
}

function summary(caller: Caller, g: Group): api.ScheduleGroupSummary {
	const out = new api.ScheduleGroupSummary()
	out.Arn = groupArn(caller, g.name)
	out.Name = g.name
	out.State = "ACTIVE"
	out.CreationDate = g.created
	out.LastModificationDate = g.modified
	return out
}

function schedules(t: Tables): Schedule[] { return t.schedules.scan(null, 1000000).map(e => e[1]) }

function found(t: Tables, group: string, name: string): Schedule throws Fault {
	const s = t.schedules.get(key(group, name))
	if (s == null) {
		throw api.resourceNotFoundException(`Schedule ${name} does not exist.`)
	}
	return s!
}

function page(keys: string[], token: string | null, max: i32 | null): [i32, i32, string | null] throws Fault {
	let from = 0
	if (token != null) {
		from = keys.indexOf(fromToken(token!))
		if (from < 0) {
			throw api.validationException("Invalid NextToken.")
		}
	}
	const n = max ?? 100
	const to = if (from + n < keys.length) from + n else keys.length
	return [from, to, if (to < keys.length) hex.encode(keys[to]) else null]
}

function fromToken(token: string): string throws Fault {
	try {
		return hex.decode(token)
	} catch (e: ParseError) {
		throw api.validationException("Invalid NextToken.")
	}
}

function fill(caller: Caller, s: Schedule, arn: string, expression: string, timezone: string | null, start: i64 | null,
	end: i64 | null, description: string | null, state: api.ScheduleState | null, key: string | null,
	target: api.Target, window: api.FlexibleTimeWindow, after: api.ActionAfterCompletion | null) throws Fault {
	if (schedule.parse(expression, true) == null) {
		throw api.validationException(`Invalid Schedule Expression ${expression}.`)
	}
	if (timezone != null && timezone! != "UTC") {
		try {
			load(timezone!)
		} catch (e: IoError | ParseError) {
			throw api.validationException(`Invalid ScheduleExpressionTimezone ${timezone!}.`)
		}
	}
	const t = now()
	if (start != null && start! < t - 5 * minute) {
		throw api.validationException("The StartDate you specify cannot be earlier than 5 minutes ago.")
	}
	if (end != null && end! <= t) {
		throw api.validationException("The EndDate you specify cannot be earlier than the current time.")
	}
	if (start != null && end != null && end! <= start!) {
		throw api.validationException("The EndDate you specify must be later than the StartDate.")
	}
	if (window.Mode == "FLEXIBLE" && window.MaximumWindowInMinutes == null) {
		throw api.validationException("MaximumWindowInMinutes must be provided when Mode is FLEXIBLE.")
	}
	if (window.Mode == "OFF" && window.MaximumWindowInMinutes != null) {
		throw api.validationException("MaximumWindowInMinutes must not be provided when Mode is OFF.")
	}
	passRole(caller, target.RoleArn, principal)
	if (actAs(caller, principal, target.RoleArn, arn, [], "") == null) {
		throw api.validationException(untrusted)
	}
	s.expression = expression
	s.timezone = timezone
	s.start = start
	s.end = end
	s.description = description
	s.state = state ?? "ENABLED"
	s.key = key
	s.target = target
	s.window = window
	s.after = after ?? "NONE"
	s.modified = t
}
