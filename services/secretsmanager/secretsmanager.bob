//! AWS Secrets Manager: secrets, their versions and staging labels, tags, resource policies, scheduled deletion,
//! BatchGetSecretValue and GetRandomPassword. Where AWS differs:
//!
//! - A secret scheduled for deletion is never purged.
//! - A value is encrypted by KMS directly, not under a data key, though as AWS the caller needs kms:GenerateDataKey to
//!   write it and kms:Decrypt to read it.
//! - Rotation (it needs Lambda), replication and resource policies but the default one are not implemented.
//! - A request breaking the model's constraints is checked only where noted; AWS checks the rest after authorizing it.
//! - ValidateResourcePolicy checks the policy's syntax and whether it allows every principal, not what Zelkova does.

import * as auth from "../../core/auth/policy"
import { Fault } from "../../core/fault"
import { pick, random, uuid } from "../../core/random"
import { Caller, Unit } from "../../core/service"
import { Table } from "../../core/state/store"
import * as api from "./api"
import { decryptAs, encryptAs } from "../kms/kms"
import { save, Secret, secrets, Version } from "./records"
import { sortBy, startsWith } from "std/algo"
import { isAlphanumeric } from "std/ascii"
import * as base64 from "std/encoding/base64"
import { lower, ParseError, parseInt, split } from "std/string"
import { day } from "std/time"

/// The versions a secret keeps at most, but for those of the last day and those with a staging label.
const kept = 100
const current = "AWSCURRENT"
const previous = "AWSPREVIOUS"
const pending = "AWSPENDING"
const punctuation = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"

export class Handler {
	...api.Unimplemented

	createSecret(caller: Caller, input: api.CreateSecretRequest): api.CreateSecretResponse throws Fault {
		named(input.Name)
		caller.actions = caller.actions.filter(a => a == "secretsmanager:CreateSecret"
			|| a == "secretsmanager:TagResource" && (input.Tags ?? []).length > 0)
		const db = secrets(caller.regional())
		const old = db.get(input.Name)
		caller.allow(old?.arn ?? arnOf(caller, input.Name), old?.policy, [], input.Name)
		const value = valueOf(input.SecretString, input.SecretBinary)
		const token = input.ClientRequestToken ?? uuid()
		const r = new api.CreateSecretResponse()
		if (old != null) {
			if (old.deleting != null) {
				const why = "You can't create this secret because a secret with this name is already scheduled for deletion."
				throw api.invalidRequestException(why)
			}
			const v = old.versions.find(v => v.id == token)
			if (v == null || value == null || !same(caller, old, v!, value!)) {
				throw api.resourceExistsException(`The operation failed because the secret ${input.Name} already exists.`)
			}
			r.ARN = old.arn
			r.Name = old.name
			r.VersionId = v.id
			return r
		}
		const t = now()
		const s = { ...new Secret(), name: input.Name, arn: `${arnOf(caller, input.Name)}-${suffix()}`,
			description: input.Description, kmsKey: input.KmsKeyId, type: input.Type, created: t, changed: t }
		s.tags = tagged([], input.Tags ?? [])
		if (value != null) {
			stage(s, version(caller, s, token, value!, t), [current], t)
			r.VersionId = token
		}
		save(db, s)
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	getSecretValue(caller: Caller, input: api.GetSecretValueRequest): api.GetSecretValueResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		const v = chosen(s, input.VersionId, input.VersionStage)
		const plain = opened(caller, s, v)
		const t = now()
		v.accessed = t - t % day
		s.accessed = v.accessed
		save(db, s)
		const r = new api.GetSecretValueResponse()
		r.ARN = s.arn
		r.Name = s.name
		r.VersionId = v.id
		r.SecretString = if (v.binary) null else plain
		r.SecretBinary = if (v.binary) plain else null
		r.VersionStages = v.stages
		r.CreatedDate = v.created
		return r
	}

	batchGetSecretValue(caller: Caller,
		input: api.BatchGetSecretValueRequest): api.BatchGetSecretValueResponse throws Fault {
		const ids = input.SecretIdList
		const filters = input.Filters
		if ((ids == null) == (filters == null)) {
			throw api.invalidParameterException("You must include Filters or SecretIdList, but not both.")
		}
		if (ids != null && input.MaxResults != null) {
			throw api.invalidParameterException("You can use MaxResults only with Filters.")
		}
		caller.actions = caller.actions.filter(a => a == "secretsmanager:BatchGetSecretValue"
			|| a == "secretsmanager:ListSecrets" && filters != null)
		caller.allow("*")
		caller.actions = ["secretsmanager:GetSecretValue"]
		const db = secrets(caller.regional())
		const r = new api.BatchGetSecretValueResponse()
		r.SecretValues = []
		r.Errors = []
		let wanted: string[] = []
		if (filters != null) {
			const all = listed(db, filters, false)
			sortBy(all, (a, b) => a.created < b.created)
			const [from, to, next] = paged(all.length, input.NextToken, input.MaxResults, 20)
			wanted = all.slice(from, to).map(s => s.arn)
			r.NextToken = next
		} else {
			if (ids!.length > 20) {
				throw api.invalidParameterException("You can retrieve at most 20 secrets at a time.")
			}
			wanted = ids!
		}
		const t = now()
		for (const id of wanted) {
			try {
				const s = lookup(caller, db, id)
				caller.allow(s?.arn ?? arnOf(caller, id), s?.policy, [], id)
				if (s == null) {
					throw missing()
				}
				live(s)
				const v = chosen(s, null, null)
				const plain = opened(caller, s, v)
				v.accessed = t - t % day
				s.accessed = v.accessed
				save(db, s)
				r.SecretValues!.push({ ...new api.SecretValueEntry(), ARN: s.arn, Name: s.name, VersionId: v.id,
					SecretString: if (v.binary) null else plain, SecretBinary: if (v.binary) plain else null,
					VersionStages: v.stages, CreatedDate: v.created })
			} catch (f: Fault) {
				if (f.status >= 500) {
					throw f
				}
				r.Errors!.push({ ...new api.APIErrorType(), SecretId: id, ErrorCode: f.code, Message: f.message })
			}
		}
		return r
	}

	putSecretValue(caller: Caller, input: api.PutSecretValueRequest): api.PutSecretValueResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		const value = valueOf(input.SecretString, input.SecretBinary)
		if (value == null) {
			throw api.invalidRequestException("You must provide either SecretString or SecretBinary.")
		}
		const token = input.ClientRequestToken ?? uuid()
		const r = new api.PutSecretValueResponse()
		r.ARN = s.arn
		r.Name = s.name
		r.VersionId = token
		const old = s.versions.find(v => v.id == token)
		if (old != null) {
			if (!same(caller, s, old, value!)) {
				throw api.resourceExistsException("You can't modify an existing version, you can only create a new version.")
			}
			r.VersionStages = old.stages
			return r
		}
		const t = now()
		const stages = input.VersionStages ?? [current]
		const v = version(caller, s, token, value!, t)
		stage(s, v, if (s.versions.length == 1) [current, ...stages.filter(x => x != current)] else stages, t)
		s.changed = t
		save(db, s)
		r.VersionStages = v.stages
		return r
	}

	updateSecret(caller: Caller, input: api.UpdateSecretRequest): api.UpdateSecretResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		const value = valueOf(input.SecretString, input.SecretBinary)
		const t = now()
		const r = new api.UpdateSecretResponse()
		const token = input.ClientRequestToken ?? uuid()
		if (value != null && s.versions.some(v => v.id == token)) {
			throw api.resourceExistsException("You can't modify an existing version, you can only create a new version.")
		}
		if (input.KmsKeyId != null) {
			s.kmsKey = if (input.KmsKeyId == "") null else input.KmsKeyId
			rekeyed(caller, s)
		}
		if (value != null) {
			stage(s, version(caller, s, token, value!, t), [current], t)
			r.VersionId = token
		}
		if (input.Description != null) {
			s.description = input.Description
		}
		if (input.Type != null) {
			s.type = input.Type
		}
		s.changed = t
		save(db, s)
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	describeSecret(caller: Caller, input: api.DescribeSecretRequest): api.DescribeSecretResponse throws Fault {
		const s = found(caller, input.SecretId)[1]
		const r = new api.DescribeSecretResponse()
		r.ARN = s.arn
		r.Name = s.name
		r.Type = s.type
		r.Description = s.description
		r.KmsKeyId = s.kmsKey
		r.LastChangedDate = s.changed
		r.LastAccessedDate = s.accessed
		r.DeletedDate = s.deleting
		r.Tags = tags(s)
		r.VersionIdsToStages = stages(s)
		r.CreatedDate = s.created
		return r
	}

	listSecrets(caller: Caller, input: api.ListSecretsRequest): api.ListSecretsResponse throws Fault {
		caller.allow("*")
		const all = listed(secrets(caller.regional()), input.Filters ?? [], input.IncludePlannedDeletion ?? false)
		const by = input.SortBy ?? "created-date"
		const desc = (input.SortOrder ?? "desc") == "desc"
		sortBy(all, (a, b) => if (desc) before(b, a, by) else before(a, b, by))
		const [from, to, next] = paged(all.length, input.NextToken, input.MaxResults, 100)
		const r = new api.ListSecretsResponse()
		r.SecretList = all.slice(from, to).map(s => ({ ...new api.SecretListEntry(), ARN: s.arn, Name: s.name,
			Type: s.type, Description: s.description, KmsKeyId: s.kmsKey, LastChangedDate: s.changed,
			LastAccessedDate: s.accessed, DeletedDate: s.deleting, Tags: tags(s), SecretVersionsToStages: stages(s),
			CreatedDate: s.created }))
		r.NextToken = next
		return r
	}

	listSecretVersionIds(caller: Caller,
		input: api.ListSecretVersionIdsRequest): api.ListSecretVersionIdsResponse throws Fault {
		const s = found(caller, input.SecretId)[1]
		const all = s.versions.filter(v => v.stages.length > 0 || (input.IncludeDeprecated ?? false))
		const [from, to, next] = paged(all.length, input.NextToken, input.MaxResults, 100)
		const r = new api.ListSecretVersionIdsResponse()
		r.Versions = all.slice(from, to).map(v => ({ ...new api.SecretVersionsListEntry(), VersionId: v.id,
			VersionStages: v.stages, LastAccessedDate: v.accessed, CreatedDate: v.created,
			KmsKeyIds: [v.kmsKey ?? "DefaultEncryptionKey"] }))
		r.NextToken = next
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	updateSecretVersionStage(caller: Caller,
		input: api.UpdateSecretVersionStageRequest): api.UpdateSecretVersionStageResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		const label = input.VersionStage
		const holder = s.versions.find(v => v.stages.includes(label))
		const from = input.RemoveFromVersionId
		const to = input.MoveToVersionId
		if (from != null && (holder == null || holder.id != from)) {
			throw api.invalidParameterException(`The staging label ${label} is not attached to version ${from}.`)
		}
		if (to != null) {
			const target = s.versions.find(v => v.id == to)
			if (target == null) {
				throw api.resourceNotFoundException(`Secrets Manager can't find the specified secret value for VersionId: ${to}`)
			}
			if (holder != null && holder.id != to && from == null) {
				throw api.invalidParameterException(`The parameter RemoveFromVersionId can't be empty. Staging label ${label} `
					+ `is currently attached to version ${holder.id}, so you must explicitly reference that version in `
					+ "RemoveFromVersionId.")
			}
			stage(s, target, [label], now())
		} else if (holder != null) {
			holder.stages = holder.stages.filter(x => x != label)
		}
		s.changed = now()
		save(db, s)
		const r = new api.UpdateSecretVersionStageResponse()
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	deleteSecret(caller: Caller, input: api.DeleteSecretRequest): api.DeleteSecretResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		const force = input.ForceDeleteWithoutRecovery ?? false
		const window = input.RecoveryWindowInDays
		if (force && window != null) {
			throw api.invalidParameterException("You can't use ForceDeleteWithoutRecovery in conjunction with RecoveryWindowInDays.")
		}
		if (window != null && (window < 7 || window > 30)) {
			throw api.invalidParameterException("The RecoveryWindowInDays value must be between 7 and 30 days (inclusive).")
		}
		const t = now()
		const r = new api.DeleteSecretResponse()
		r.ARN = s.arn
		r.Name = s.name
		if (force) {
			db.delete(s.name)
			r.DeletionDate = t
			return r
		}
		live(s)
		s.deleting = t + (window ?? 30) * day
		save(db, s)
		r.DeletionDate = s.deleting
		return r
	}

	restoreSecret(caller: Caller, input: api.RestoreSecretRequest): api.RestoreSecretResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		s.deleting = null
		save(db, s)
		const r = new api.RestoreSecretResponse()
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	tagResource(caller: Caller, input: api.TagResourceRequest): Unit throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		s.tags = tagged(s.tags, input.Tags)
		save(db, s)
		return new Unit()
	}

	untagResource(caller: Caller, input: api.UntagResourceRequest): Unit throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		s.tags = s.tags.filter(t => !input.TagKeys.includes(t[0]))
		save(db, s)
		return new Unit()
	}

	getResourcePolicy(caller: Caller, input: api.GetResourcePolicyRequest): api.GetResourcePolicyResponse throws Fault {
		const s = found(caller, input.SecretId)[1]
		const r = new api.GetResourcePolicyResponse()
		r.ARN = s.arn
		r.Name = s.name
		r.ResourcePolicy = s.policy
		return r
	}

	putResourcePolicy(caller: Caller, input: api.PutResourcePolicyRequest): api.PutResourcePolicyResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		live(s)
		defaultPolicy(input.PolicyName)
		const p = parsed(input.ResourcePolicy)
		if ((input.BlockPublicPolicy ?? false) && broad(p)) {
			throw api.publicPolicyException("The BlockPublicPolicy parameter is set to true, and the resource policy did not prevent broad access to the secret.")
		}
		s.policy = input.ResourcePolicy
		save(db, s)
		const r = new api.PutResourcePolicyResponse()
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	deleteResourcePolicy(caller: Caller,
		input: api.DeleteResourcePolicyRequest): api.DeleteResourcePolicyResponse throws Fault {
		const [db, s] = found(caller, input.SecretId)
		defaultPolicy(input.PolicyName)
		s.policy = null
		save(db, s)
		const r = new api.DeleteResourcePolicyResponse()
		r.ARN = s.arn
		r.Name = s.name
		return r
	}

	validateResourcePolicy(caller: Caller,
		input: api.ValidateResourcePolicyRequest): api.ValidateResourcePolicyResponse throws Fault {
		caller.actions = ["secretsmanager:ValidateResourcePolicy"]
		if (input.SecretId != null) {
			found(caller, input.SecretId!)
		} else {
			caller.allow("*")
		}
		const p = parsed(input.ResourcePolicy)
		const r = new api.ValidateResourcePolicyResponse()
		r.PolicyValidationPassed = !broad(p)
		if (!r.PolicyValidationPassed) {
			r.ValidationErrors = [{ ...new api.ValidationErrorsEntry(), CheckName: "BLOCK_PUBLIC_POLICY",
				ErrorMessage: "The resource policy grants broad access to the secret." }]
		}
		return r
	}

	getRandomPassword(caller: Caller, input: api.GetRandomPasswordRequest): api.GetRandomPasswordResponse throws Fault {
		caller.allow("*")
		const r = new api.GetRandomPasswordResponse()
		r.RandomPassword = password(input)
		return r
	}
}

function found(caller: Caller, id: string): [Table[Secret], Secret] throws Fault {
	const db = secrets(caller.regional())
	const s = lookup(caller, db, id)
	caller.allow(s?.arn ?? arnOf(caller, id), s?.policy, [], id)
	if (s == null) {
		throw missing()
	}
	return [db, s!]
}

/// The secret that id names in db by its name, ARN or partial ARN, the ARN without its random suffix.
function lookup(caller: Caller, db: Table[Secret], id: string): Secret | null throws Fault {
	if (id.length > 2048) {
		throw api.invalidParameterException("SecretId exceeds size limit.")
	}
	if (!startsWith(id, "arn:")) {
		named(id)
		return db.get(id)
	}
	const prefix = arnOf(caller, "")
	if (!startsWith(id, prefix)) {
		return null
	}
	const rest = id.slice(prefix.length, id.length)
	const partial = db.get(rest)
	if (partial != null) {
		return partial
	}
	const full = if (rest.length > 7) db.get(rest.slice(0, rest.length - 7)) else null
	return if (full != null && full.arn == id) full else null
}

function named(n: string) throws Fault {
	const ok = n.length >= 1 && n.length <= 512 && n.every(c => isAlphanumeric(c) || has("-/_+=.@!", c))
	if (!ok) {
		const why = "Invalid name. Must be a valid name containing alphanumeric characters, or any of the following: -/_+=.@!"
		throw new Fault(400, "ValidationException", why)
	}
}

function live(s: Secret) throws Fault {
	if (s.deleting != null) {
		const why = "You can't perform this operation on the secret because it was marked for deletion."
		throw api.invalidRequestException(why)
	}
}

function chosen(s: Secret, id: string | null, label: string | null): Version throws Fault {
	const stage = if (id == null) label ?? current else label
	const v = s.versions.find(v => (id == null || v.id == id) && (stage == null || v.stages.includes(stage!)))
	if (v == null) {
		const why = if (id == null) `staging label: ${stage}`
			else if (stage == null) `VersionId: ${id}`
			else `VersionId: ${id} and staging label: ${stage}`
		throw api.resourceNotFoundException(`Secrets Manager can't find the specified secret value for ${why}`)
	}
	return v!
}

function valueOf(str: string | null, bin: string | null): [string, bool] | null throws Fault {
	if (str != null && bin != null) {
		const why = "You can't specify both a binary secret value and a string secret value in the same secret."
		throw api.invalidParameterException(why)
	}
	if (str == null && bin == null) {
		return null
	}
	return [str ?? bin!, bin != null]
}

function version(caller: Caller, s: Secret, id: string, value: [string, bool], t: i64): Version throws Fault {
	const v = { ...new Version(), id: id, binary: value[1], created: t, kmsKey: s.kmsKey }
	v.sealed = sealed(caller, s, id, value[0], "kms:GenerateDataKey")
	s.versions.push(v)
	return v
}

function same(caller: Caller, s: Secret, v: Version, value: [string, bool]): bool throws Fault {
	return v.binary == value[1] && opened(caller, s, v) == value[0]
}

function sealed(caller: Caller, s: Secret, id: string, plain: string, action: string): string throws Fault {
	try {
		return base64.encode(encryptAs(caller, "secretsmanager", s.kmsKey ?? "alias/aws/secretsmanager", plain,
			[["SecretARN", s.arn], ["SecretVersionId", id]], action))
	} catch (f: Fault) {
		throw failure(f, true)
	}
}

function opened(caller: Caller, s: Secret, v: Version): string throws Fault {
	let blob = ""
	try {
		blob = base64.decode(v.sealed)
	} catch (e: ParseError) {
		throw new Fault(500, "InternalFailure", "A version's value does not decode")
	}
	try {
		return decryptAs(caller, "secretsmanager", blob, [["SecretARN", s.arn], ["SecretVersionId", v.id]])[0]
	} catch (f: Fault) {
		throw failure(f, false)
	}
}

/// Re-encrypts the versions of s that have a staging label of Secrets Manager's under its key, as the caller may: as
/// AWS, not if the caller may not encrypt under the key.
function rekeyed(caller: Caller, s: Secret) throws Fault {
	for (const v of s.versions) {
		if (v.kmsKey != s.kmsKey && v.stages.some(x => x == current || x == previous || x == pending)) {
			const plain = opened(caller, s, v)
			try {
				v.sealed = sealed(caller, s, v.id, plain, "kms:Encrypt")
			} catch (f: Fault) {
				if (f.code == "AccessDeniedException") {
					return
				}
				throw f
			}
			v.kmsKey = s.kmsKey
		}
	}
}

function failure(f: Fault, encrypting: bool): Fault {
	if (f.status >= 500) {
		return f
	}
	if (f.code == "AccessDeniedException") {
		return new Fault(400, "AccessDeniedException", "Access to KMS is not allowed")
	}
	return if (encrypting) api.encryptionFailure("Secrets Manager can't encrypt the protected secret text using the "
		+ "provided KMS key. Check that the KMS key is available, enabled, and not in an invalid state. For more "
		+ "information, see Key state: Effect on your KMS key.")
		else api.decryptionFailure("Secrets Manager can't decrypt the protected secret text using the provided KMS key.")
}

/// Attaches the staging labels to v, a version of s, taking each from the version that has it: AWSPREVIOUS goes to
/// the one AWSCURRENT is taken from. Then drops the oldest deprecated versions over the most kept, but those made in
/// the day before t.
function stage(s: Secret, v: Version, labels: string[], t: i64) {
	const was = s.versions.find(o => o.id != v.id && o.stages.includes(current))
	for (const o of s.versions) {
		if (o.id != v.id) {
			o.stages = o.stages.filter(x => !labels.includes(x))
		}
	}
	for (const x of labels) {
		if (!v.stages.includes(x)) {
			v.stages.push(x)
		}
	}
	if (labels.includes(current) && was != null) {
		for (const o of s.versions) {
			o.stages = o.stages.filter(x => x != previous)
		}
		was.stages.push(previous)
	}
	let over = s.versions.length - kept
	s.versions = s.versions.filter(o => {
		const drop = over > 0 && o.stages.length == 0 && o.created < t - day
		if (drop) {
			over--
		}
		return !drop
	})
}

function stages(s: Secret): [string, string[]][] | null {
	const all: [string, string[]][] = []
	for (const v of s.versions) {
		if (v.stages.length > 0) {
			all.push([v.id, v.stages])
		}
	}
	return if (all.length == 0) null else all
}

function tags(s: Secret): api.Tag[] | null {
	return if (s.tags.length == 0) null else s.tags.map(t => ({ ...new api.Tag(), Key: t[0], Value: t[1] }))
}

function tagged(tags: [string, string][], given: api.Tag[]): [string, string][] {
	const out = tags.filter(t => !given.some(g => g.Key == t[0]))
	for (const g of given) {
		out.push([g.Key ?? "", g.Value ?? ""])
	}
	return out
}

function listed(db: Table[Secret], filters: api.Filter[], planned: bool): Secret[] throws Fault {
	const out: Secret[] = []
	let after: string | null = null
	while (true) {
		const chunk = db.scan(after, 100)
		for (const [_, s] of chunk) {
			if ((planned || s.deleting == null) && filters.every(f => matches(s, f))) {
				out.push(s)
			}
		}
		if (chunk.length < 100) {
			return out
		}
		after = chunk[chunk.length - 1][0]
	}
}

/// Whether s passes the filter f: one of its values matches, or none is given but those negated by a !, and no
/// negated one does.
function matches(s: Secret, f: api.Filter): bool {
	const values = f.Values ?? []
	const plain = values.filter(v => !startsWith(v, "!"))
	const negated = values.filter(v => startsWith(v, "!")).map(v => v.slice(1, v.length))
	const key = f.Key ?? "all"
	return (plain.length == 0 || plain.some(v => match(s, key, v))) && !negated.some(v => match(s, key, v))
}

/// Whether the attribute of s that key names starts with v: as Secrets Manager compares them, the description and
/// all of them not case-sensitive, all each word of v.
function match(s: Secret, key: api.FilterNameStringType, v: string): bool {
	switch (key) {
		case "name": return startsWith(s.name, v)
		case "description": return startsWith(lower(s.description ?? ""), lower(v))
		case "tag-key": return s.tags.some(t => startsWith(t[0], v))
		case "tag-value": return s.tags.some(t => startsWith(t[1], v))
		case "primary-region", "owning-service": return false
		default:
			const words = [s.name, s.description ?? "", ...s.tags.map(t => t[0]), ...s.tags.map(t => t[1])]
			return split(lower(v), " ").filter(w => w != "").every(w => words.some(x => startsWith(lower(x), w)))
	}
}

function before(a: Secret, b: Secret, by: api.SortByType): bool {
	switch (by) {
		case "name": return a.name < b.name
		case "last-changed-date": return a.changed < b.changed
		case "last-accessed-date": return (a.accessed ?? 0) < (b.accessed ?? 0)
		default: return a.created < b.created || a.created == b.created && a.name < b.name
	}
}

function paged(n: i32, token: string | null, max: i32 | null, most: i32): [i32, i32, string | null] throws Fault {
	if (max != null && (max < 1 || max > most)) {
		throw api.invalidParameterException(`MaxResults must be between 1 and ${most}.`)
	}
	let from = 0
	if (token != null) {
		try {
			from = parseInt(base64.decode(token!))
		} catch (e: ParseError) {
			throw api.invalidNextTokenException("The NextToken value is invalid.")
		}
	}
	const to = if (from + (max ?? most) < n) from + (max ?? most) else n
	return [from, to, if (to < n) base64.encode(`${to}`) else null]
}

function defaultPolicy(name: string | null) throws Fault {
	if (name != null && name != "default") {
		throw api.invalidParameterException("You can only attach the default policy.")
	}
}

function parsed(document: string): auth.Policy throws Fault {
	try {
		return auth.parse(document, "resource")
	} catch (f: Fault) {
		throw api.malformedPolicyDocumentException(f.message)
	}
}

function broad(p: auth.Policy): bool {
	return p.statements.some(s => s.allow && !s.notPrincipal && s.conditions.length == 0
		&& s.principals.some(x => x[0] == "*" || x[1] == "*"))
}

function password(input: api.GetRandomPasswordRequest): string throws Fault {
	const n = input.PasswordLength ?? 32
	if (n < 1 || n > 4096) {
		const why = `Value '${n}' at 'passwordLength' failed to satisfy constraint: Member must have value `
			+ (if (n < 1) "greater than or equal to 1" else "less than or equal to 4096")
		throw new Fault(400, "ValidationException", `1 validation error detected: ${why}`)
	}
	const excluded = input.ExcludeCharacters ?? ""
	const kinds: [string, bool][] = [["abcdefghijklmnopqrstuvwxyz", input.ExcludeLowercase ?? false],
		["ABCDEFGHIJKLMNOPQRSTUVWXYZ", input.ExcludeUppercase ?? false], ["0123456789", input.ExcludeNumbers ?? false],
		[punctuation, input.ExcludePunctuation ?? false], [" ", !(input.IncludeSpace ?? false)]]
	const sets: string[] = []
	for (const [chars, exclude] of kinds) {
		const left: u8[] = []
		for (const c of chars) {
			if (!has(excluded, c)) {
				left.push(c)
			}
		}
		if (!exclude && left.length > 0) {
			sets.push(fromBytes(left))
		}
	}
	const every = input.RequireEachIncludedType ?? true
	if (sets.length == 0 || every && n < sets.length) {
		throw api.invalidParameterException("The password length is too short to include every character type.")
	}
	const all = sets.join("")
	const out: u8[] = []
	if (every) {
		for (const s of sets) {
			out.push(s[below(s.length)])
		}
	}
	while (out.length < n) {
		out.push(all[below(all.length)])
	}
	for (let i = out.length - 1; i > 0; i--) {
		const j = below(i + 1)
		const c = out[i]
		out[i] = out[j]
		out[j] = c
	}
	return fromBytes(out)
}

function below(n: i32): i32 throws Fault {
	const b = random(4)
	let x: u32 = 0
	for (const c of b) {
		x = x * 256 + (c as u32)
	}
	return (x % (n as u32)) as i32
}

function has(s: string, c: u8): bool {
	for (const x of s) {
		if (x == c) {
			return true
		}
	}
	return false
}

function arnOf(caller: Caller, name: string): string {
	return `arn:aws:secretsmanager:${caller.region}:${caller.account}:secret:${name}`
}

/// The six random letters and digits that end a secret's ARN.
function suffix(): string throws Fault {
	return pick(6, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
}

function missing(): Fault { return api.resourceNotFoundException("Secrets Manager can't find the specified secret.") }
