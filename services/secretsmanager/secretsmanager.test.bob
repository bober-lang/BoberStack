import { sign } from "../../core/client"
import { Fault } from "../../core/fault"
import { Gateway } from "../../core/gateway"
import * as protocol from "../../core/protocol/json"
import * as api from "./api"
import { Handler } from "./secretsmanager"
import { indexOf, startsWith } from "std/algo"
import { Request, Response } from "std/http"
import { Decodable } from "std/types"

const arn = "arn:aws:secretsmanager:us-east-1:000000000000:secret:"

function gateway(): Gateway {
	const g = new Gateway()
	const h = new Handler()
	g.services.set(api.signingName, (caller, req) => api.handle(h, caller, req))
	return g
}

/// The answer of g to the operation op with the JSON input body, from the root of 000000000000.
function call(g: Gateway, op: string, body: string): Response {
	const req = new Request("POST", "http://localhost:4566/", body)
	req.headers.set("content-type", "application/x-amz-json-1.1")
	req.headers.set("x-amz-target", `secretsmanager.${op}`)
	sign(req, body, "secretsmanager", "us-east-1", "test", "test", "", "20150626T140000Z")
	return g.handle(req)
}

/// The T that res holds.
function out[T extends Decodable](res: Response): T {
	assert res.status == 200
	let r: T | null = null
	try {
		r = protocol.decode[T](res.body.whole ?? "")
	} catch (f: Fault) {}
	return r!
}

/// Whether res is the error code, of the message why if given.
function fails(res: Response, code: string, why = ""): bool {
	const body = res.body.whole ?? ""
	return res.status == 400 && indexOf(body, `"__type":"${code}"`) >= 0 && indexOf(body, why) >= 0
}

/// The value of the secret id at the stage given, or its AWSCURRENT.
function value(g: Gateway, id: string, stage = "AWSCURRENT"): string | null {
	const res = call(g, "GetSecretValue", `{"SecretId":"${id}","VersionStage":"${stage}"}`)
	return if (res.status == 200) out[api.GetSecretValueResponse](res).SecretString else null
}

test "secrets: create, read by name, ARN and partial ARN, versions and their labels" {
	const g = gateway()
	const token = "00000000-0000-0000-0000-000000000001"
	const made = out[api.CreateSecretResponse](call(g, "CreateSecret",
		`{"Name":"db/pass","SecretString":"one","ClientRequestToken":"${token}","Tags":[{"Key":"env","Value":"dev"}]}`))
	const a = made.ARN!
	assert startsWith(a, `${arn}db/pass-`) && a.length == `${arn}db/pass-`.length + 6 && made.VersionId == token
	// The same token and value again is the same secret; another value or token is not.
	assert out[api.CreateSecretResponse](call(g, "CreateSecret",
		`{"Name":"db/pass","SecretString":"one","ClientRequestToken":"${token}"}`)).ARN == a
	assert fails(call(g, "CreateSecret", `{"Name":"db/pass","SecretString":"two"}`), "ResourceExistsException",
		"The operation failed because the secret db/pass already exists.")
	assert fails(call(g, "CreateSecret", `{"Name":"bad name"}`), "ValidationException", "Invalid name.")
	assert fails(call(g, "CreateSecret", `{"Name":"x","SecretString":"a","SecretBinary":"YQ=="}`),
		"InvalidParameterException")
	assert value(g, "db/pass") == "one" && value(g, a) == "one" && value(g, `${arn}db/pass`) == "one"
	assert fails(call(g, "GetSecretValue", `{"SecretId":"none"}`), "ResourceNotFoundException",
		"Secrets Manager can't find the specified secret.")
	const put = out[api.PutSecretValueResponse](call(g, "PutSecretValue",
		`{"SecretId":"db/pass","SecretString":"two"}`))
	assert put.VersionStages! == ["AWSCURRENT"]
	assert value(g, "db/pass") == "two" && value(g, "db/pass", "AWSPREVIOUS") == "one"
	assert fails(call(g, "PutSecretValue",
		`{"SecretId":"db/pass","SecretString":"other","ClientRequestToken":"${token}"}`), "ResourceExistsException")
	const v1 = out[api.GetSecretValueResponse](call(g, "GetSecretValue",
		`{"SecretId":"db/pass","VersionId":"${token}"}`))
	assert v1.SecretString == "one" && v1.VersionStages! == ["AWSPREVIOUS"]
	// Moving AWSCURRENT back takes AWSPREVIOUS to the version it left.
	assert fails(call(g, "UpdateSecretVersionStage",
		`{"SecretId":"db/pass","VersionStage":"AWSCURRENT","MoveToVersionId":"${token}"}`), "InvalidParameterException",
		"RemoveFromVersionId")
	assert call(g, "UpdateSecretVersionStage",
		`{"SecretId":"db/pass","VersionStage":"AWSCURRENT","MoveToVersionId":`
		+ `"${token}","RemoveFromVersionId":"${put.VersionId!}"}`).status == 200
	assert value(g, "db/pass") == "one" && value(g, "db/pass", "AWSPREVIOUS") == "two"
	const versions = out[api.ListSecretVersionIdsResponse](call(g, "ListSecretVersionIds", `{"SecretId":"db/pass"}`))
	assert versions.Versions!.length == 2 && versions.ARN == a
	const d = out[api.DescribeSecretResponse](call(g, "DescribeSecret", `{"SecretId":"db/pass"}`))
	assert d.Tags!.length == 1 && d.VersionIdsToStages!.length == 2 && d.DeletedDate == null
	// A secret without a value has no version.
	assert out[api.CreateSecretResponse](call(g, "CreateSecret", `{"Name":"empty"}`)).VersionId == null
	assert fails(call(g, "GetSecretValue", `{"SecretId":"empty"}`), "ResourceNotFoundException",
		"Secrets Manager can't find the specified secret value for staging label: AWSCURRENT")
	const bin = out[api.GetSecretValueResponse](call(g, "GetSecretValue", `{"SecretId":"${a}"}`))
	assert bin.SecretBinary == null
	assert call(g, "UpdateSecret", `{"SecretId":"empty","SecretBinary":"AAEC","Description":"d"}`).status == 200
	assert out[api.GetSecretValueResponse](call(g, "GetSecretValue", `{"SecretId":"empty"}`)).SecretBinary
		== "\x00\x01\x02"
	g.close()
}

test "deletion is scheduled, refused while scheduled, restored, or forced" {
	const g = gateway()
	assert call(g, "CreateSecret", `{"Name":"s","SecretString":"v"}`).status == 200
	assert fails(call(g, "DeleteSecret", `{"SecretId":"s","RecoveryWindowInDays":3}`), "InvalidParameterException")
	assert fails(call(g, "DeleteSecret", `{"SecretId":"s","RecoveryWindowInDays":7,"ForceDeleteWithoutRecovery":true}`),
		"InvalidParameterException")
	const del = out[api.DeleteSecretResponse](call(g, "DeleteSecret", `{"SecretId":"s"}`))
	assert del.DeletionDate != null
	assert fails(call(g, "GetSecretValue", `{"SecretId":"s"}`), "InvalidRequestException",
		"You can't perform this operation on the secret because it was marked for deletion.")
	assert fails(call(g, "CreateSecret", `{"Name":"s"}`), "InvalidRequestException")
	assert out[api.DescribeSecretResponse](call(g, "DescribeSecret", `{"SecretId":"s"}`)).DeletedDate != null
	assert out[api.ListSecretsResponse](call(g, "ListSecrets", "{}")).SecretList!.length == 0
	assert out[api.ListSecretsResponse](call(g, "ListSecrets", `{"IncludePlannedDeletion":true}`)).SecretList!.length
		== 1
	assert call(g, "RestoreSecret", `{"SecretId":"s"}`).status == 200
	assert value(g, "s") == "v"
	assert call(g, "DeleteSecret", `{"SecretId":"s","ForceDeleteWithoutRecovery":true}`).status == 200
	assert fails(call(g, "DescribeSecret", `{"SecretId":"s"}`), "ResourceNotFoundException")
	g.close()
}

test "lists filter, sort and page; a batch reads several" {
	const g = gateway()
	for (const n of ["b", "a", "c"]) {
		assert call(g, "CreateSecret", `{"Name":"app-${n}","SecretString":"${n}","Description":"Of ${n}"}`).status
			== 200
	}
	assert call(g, "CreateSecret", `{"Name":"other","Tags":[{"Key":"team","Value":"x"}]}`).status == 200
	const named = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"Filters":[{"Key":"name","Values":["app-"]}],"SortBy":"name","SortOrder":"asc"}`))
	assert named.SecretList!.map(s => s.Name!) == ["app-a", "app-b", "app-c"]
	const negated = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"Filters":[{"Key":"name","Values":["!app"]}]}`))
	assert negated.SecretList!.map(s => s.Name!) == ["other"]
	const described = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"Filters":[{"Key":"description","Values":["of b"]}]}`))
	assert described.SecretList!.map(s => s.Name!) == ["app-b"]
	const tagged = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"Filters":[{"Key":"tag-key","Values":["te"]}]}`))
	assert tagged.SecretList!.map(s => s.Name!) == ["other"]
	const first = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"MaxResults":3,"SortBy":"name","SortOrder":"asc"}`))
	assert first.SecretList!.length == 3 && first.NextToken != null
	const rest = out[api.ListSecretsResponse](call(g, "ListSecrets",
		`{"MaxResults":3,"SortBy":"name","SortOrder":"asc","NextToken":"${first.NextToken!}"}`))
	assert rest.SecretList!.map(s => s.Name!) == ["other"] && rest.NextToken == null
	const batch = out[api.BatchGetSecretValueResponse](call(g, "BatchGetSecretValue",
		`{"SecretIdList":["app-a","app-c","none"]}`))
	assert batch.SecretValues!.map(v => v.SecretString!) == ["a", "c"]
	assert batch.Errors!.length == 1 && batch.Errors![0].ErrorCode == "ResourceNotFoundException"
	const filtered = out[api.BatchGetSecretValueResponse](call(g, "BatchGetSecretValue",
		`{"Filters":[{"Key":"name","Values":["app-"]}]}`))
	assert filtered.SecretValues!.length == 3
	assert fails(call(g, "BatchGetSecretValue", "{}"), "InvalidParameterException")
	g.close()
}

test "tags and resource policies" {
	const g = gateway()
	assert call(g, "CreateSecret", `{"Name":"s","SecretString":"v"}`).status == 200
	assert call(g, "TagResource", `{"SecretId":"s","Tags":[{"Key":"a","Value":"1"},{"Key":"b","Value":"2"}]}`).status
		== 200
	assert call(g, "UntagResource", `{"SecretId":"s","TagKeys":["a"]}`).status == 200
	const tags = out[api.DescribeSecretResponse](call(g, "DescribeSecret", `{"SecretId":"s"}`)).Tags!
	assert tags.length == 1 && tags[0].Key == "b"
	const open = `{\\"Version\\":\\"2012-10-17\\",\\"Statement\\":[{\\"Effect\\":\\"Allow\\",\\"Principal\\":\\"*\\",`
		+ `\\"Action\\":\\"secretsmanager:GetSecretValue\\",\\"Resource\\":\\"*\\"}]}`
	assert fails(call(g, "PutResourcePolicy", `{"SecretId":"s","ResourcePolicy":"${open}","BlockPublicPolicy":true}`),
		"PublicPolicyException")
	assert fails(call(g, "PutResourcePolicy", `{"SecretId":"s","ResourcePolicy":"nope"}`),
		"MalformedPolicyDocumentException")
	assert call(g, "PutResourcePolicy", `{"SecretId":"s","ResourcePolicy":"${open}"}`).status == 200
	assert out[api.GetResourcePolicyResponse](call(g, "GetResourcePolicy", `{"SecretId":"s"}`)).ResourcePolicy != null
	const checked = out[api.ValidateResourcePolicyResponse](call(g, "ValidateResourcePolicy",
		`{"ResourcePolicy":"${open}"}`))
	assert !checked.PolicyValidationPassed
	assert call(g, "DeleteResourcePolicy", `{"SecretId":"s"}`).status == 200
	assert out[api.GetResourcePolicyResponse](call(g, "GetResourcePolicy", `{"SecretId":"s"}`)).ResourcePolicy == null
	g.close()
}

test "random passwords" {
	const g = gateway()
	const p = out[api.GetRandomPasswordResponse](call(g, "GetRandomPassword", "{}")).RandomPassword!
	assert p.length == 32
	const digits = out[api.GetRandomPasswordResponse](call(g, "GetRandomPassword",
		`{"PasswordLength":50,"ExcludeLowercase":true,"ExcludeUppercase":true,"ExcludePunctuation":true,`
		+ `"ExcludeCharacters":"0123"}`)).RandomPassword!
	assert digits.length == 50 && digits.every(c => c >= "4"[0] && c <= "9"[0])
	const spaced = out[api.GetRandomPasswordResponse](call(g, "GetRandomPassword",
		`{"PasswordLength":5,"ExcludeLowercase":true,"ExcludeUppercase":true,"ExcludePunctuation":true,`
		+ `"ExcludeNumbers":true,"IncludeSpace":true}`)).RandomPassword!
	assert spaced == "     "
	assert fails(call(g, "GetRandomPassword", `{"PasswordLength":0}`), "ValidationException")
	assert fails(call(g, "GetRandomPassword", `{"PasswordLength":3}`), "InvalidParameterException")
	g.close()
}
