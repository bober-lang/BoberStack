/// The answer of h to req.
export function handle(h: SES, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = query.call(caller, req, version, ns)
	switch (c.action) {
		case "CloneReceiptRuleSet": return c.serve(h.cloneReceiptRuleSet, ["ses:CloneReceiptRuleSet"])
		case "CreateConfigurationSet": return c.serve(h.createConfigurationSet,
			["ses:CreateConfigurationSet", "ses:TagResource"])
		case "CreateConfigurationSetEventDestination": return c.serve(h.createConfigurationSetEventDestination,
			["ses:CreateConfigurationSetEventDestination", "iam:PassRole"])
		case "CreateConfigurationSetTrackingOptions": return c.serve(h.createConfigurationSetTrackingOptions,
			["ses:CreateConfigurationSetTrackingOptions"])
		case "CreateCustomVerificationEmailTemplate": return c.serve(h.createCustomVerificationEmailTemplate,
			["ses:CreateCustomVerificationEmailTemplate", "ses:TagResource"])
		case "CreateReceiptFilter": return c.serve(h.createReceiptFilter, ["ses:CreateReceiptFilter"])
		case "CreateReceiptRule": return c.serve(h.createReceiptRule, ["ses:CreateReceiptRule", "iam:PassRole"])
		case "CreateReceiptRuleSet": return c.serve(h.createReceiptRuleSet, ["ses:CreateReceiptRuleSet"])
		case "CreateTemplate": return c.serve(h.createTemplate, ["ses:CreateTemplate"])
		case "DeleteConfigurationSet": return c.serve(h.deleteConfigurationSet, ["ses:DeleteConfigurationSet"])
		case "DeleteConfigurationSetEventDestination": return c.serve(h.deleteConfigurationSetEventDestination,
			["ses:DeleteConfigurationSetEventDestination"])
		case "DeleteConfigurationSetTrackingOptions": return c.serve(h.deleteConfigurationSetTrackingOptions,
			["ses:DeleteConfigurationSetTrackingOptions"])
		case "DeleteCustomVerificationEmailTemplate": return c.serve(h.deleteCustomVerificationEmailTemplate,
			["ses:DeleteCustomVerificationEmailTemplate"])
		case "DeleteIdentity": return c.serve(h.deleteIdentity, ["ses:DeleteIdentity"])
		case "DeleteIdentityPolicy": return c.serve(h.deleteIdentityPolicy, ["ses:DeleteIdentityPolicy"])
		case "DeleteReceiptFilter": return c.serve(h.deleteReceiptFilter, ["ses:DeleteReceiptFilter"])
		case "DeleteReceiptRule": return c.serve(h.deleteReceiptRule, ["ses:DeleteReceiptRule"])
		case "DeleteReceiptRuleSet": return c.serve(h.deleteReceiptRuleSet, ["ses:DeleteReceiptRuleSet"])
		case "DeleteTemplate": return c.serve(h.deleteTemplate, ["ses:DeleteTemplate"])
		case "DeleteVerifiedEmailAddress": return c.serve(h.deleteVerifiedEmailAddress,
			["ses:DeleteVerifiedEmailAddress"])
		case "DescribeActiveReceiptRuleSet": return c.serve(h.describeActiveReceiptRuleSet,
			["ses:DescribeActiveReceiptRuleSet"])
		case "DescribeConfigurationSet": return c.serve(h.describeConfigurationSet, ["ses:DescribeConfigurationSet"])
		case "DescribeReceiptRule": return c.serve(h.describeReceiptRule, ["ses:DescribeReceiptRule"])
		case "DescribeReceiptRuleSet": return c.serve(h.describeReceiptRuleSet, ["ses:DescribeReceiptRuleSet"])
		case "GetAccountSendingEnabled": return c.serve(h.getAccountSendingEnabled, ["ses:GetAccountSendingEnabled"])
		case "GetCustomVerificationEmailTemplate": return c.serve(h.getCustomVerificationEmailTemplate,
			["ses:GetCustomVerificationEmailTemplate"])
		case "GetIdentityDkimAttributes": return c.serve(h.getIdentityDkimAttributes, ["ses:GetIdentityDkimAttributes"])
		case "GetIdentityMailFromDomainAttributes": return c.serve(h.getIdentityMailFromDomainAttributes,
			["ses:GetIdentityMailFromDomainAttributes"])
