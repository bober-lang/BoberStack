export function accountSuspendedException(message: string): Fault {
	return new Fault(400, "AccountSuspendedException", message)
}

export function alreadyExistsException(message: string): Fault {
	return new Fault(400, "AlreadyExistsException", message)
}

export function badRequestException(message: string): Fault { return new Fault(400, "BadRequestException", message) }

export function concurrentModificationException(message: string): Fault {
	return new Fault(500, "ConcurrentModificationException", message)
}

export function conflictException(message: string): Fault { return new Fault(409, "ConflictException", message) }

export function internalServiceErrorException(message: string): Fault {
	return new Fault(500, "InternalServiceErrorException", message)
}

export function invalidNextTokenException(message: string): Fault {
	return new Fault(400, "InvalidNextTokenException", message)
}

export function limitExceededException(message: string): Fault {
	return new Fault(400, "LimitExceededException", message)
}

export function mailFromDomainNotVerifiedException(message: string): Fault {
	return new Fault(400, "MailFromDomainNotVerifiedException", message)
}

export function messageRejected(message: string): Fault { return new Fault(400, "MessageRejected", message) }
export function notFoundException(message: string): Fault { return new Fault(404, "NotFoundException", message) }

export function sendingPausedException(message: string): Fault {
	return new Fault(400, "SendingPausedException", message)
}

export function tooManyRequestsException(message: string): Fault {
	return new Fault(429, "TooManyRequestsException", message)
}

