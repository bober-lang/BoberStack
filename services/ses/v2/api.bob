/// The answer of h to req.
export function handle(h: SESv2, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [403, "AccessDenied", "reasoned"]
	const c = restjson.call(caller, req, service, routes)
	switch (c.operation) {
		case "AssociateEmailIdentityCertificate": return c.serve(h.associateEmailIdentityCertificate,
			["ses:AssociateEmailIdentityCertificate"])
		case "BatchGetMetricData": return c.serve(h.batchGetMetricData, ["ses:BatchGetMetricData"])
		case "CancelExportJob": return c.serve(h.cancelExportJob, ["ses:CancelExportJob"])
		case "CreateConfigurationSet": return c.serve(h.createConfigurationSet,
			["ses:CreateConfigurationSet", "ses:TagResource"])
		case "CreateConfigurationSetEventDestination": return c.serve(h.createConfigurationSetEventDestination,
			["ses:CreateConfigurationSetEventDestination", "iam:PassRole"])
		case "CreateContact": return c.serve(h.createContact, ["ses:CreateContact"])
		case "CreateContactList": return c.serve(h.createContactList, ["ses:CreateContactList", "ses:TagResource"])
		case "CreateCustomVerificationEmailTemplate": return c.serve(h.createCustomVerificationEmailTemplate,
			["ses:CreateCustomVerificationEmailTemplate", "ses:TagResource"])
		case "CreateDedicatedIpPool": return c.serve(h.createDedicatedIpPool,
			["ses:CreateDedicatedIpPool", "ses:TagResource"])
		case "CreateDeliverabilityTestReport": return c.serve(h.createDeliverabilityTestReport,
			["ses:CreateDeliverabilityTestReport", "ses:TagResource"])
		case "CreateEmailIdentity": return c.serve(h.createEmailIdentity,
			["ses:CreateEmailIdentity", "ses:TagResource"])
		case "CreateEmailIdentityPolicy": return c.serve(h.createEmailIdentityPolicy, ["ses:CreateEmailIdentityPolicy"])
		case "CreateEmailTemplate": return c.serve(h.createEmailTemplate,
			["ses:CreateEmailTemplate", "ses:TagResource"])
		case "CreateExportJob": return c.serve(h.createExportJob, ["ses:CreateExportJob"])
		case "CreateImportJob": return c.serve(h.createImportJob, ["ses:CreateImportJob"])
		case "CreateMultiRegionEndpoint": return c.serve(h.createMultiRegionEndpoint,
			["ses:CreateMultiRegionEndpoint", "ses:TagResource"])
		case "CreateTenant": return c.serve(h.createTenant, ["ses:CreateTenant", "ses:TagResource"])
