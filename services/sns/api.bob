		case "AddPermission": return c.serve(h.addPermission, ["sns:AddPermission"])
		case "CheckIfPhoneNumberIsOptedOut": return c.serve(h.checkIfPhoneNumberIsOptedOut,
			["sns:CheckIfPhoneNumberIsOptedOut"])
		case "ConfirmSubscription": return c.serve(h.confirmSubscription, ["sns:ConfirmSubscription"])
		case "CreatePlatformApplication": return c.serve(h.createPlatformApplication,
			["sns:CreatePlatformApplication", "iam:PassRole"])
		case "CreatePlatformEndpoint": return c.serve(h.createPlatformEndpoint, ["sns:CreatePlatformEndpoint"])
		case "CreateSMSSandboxPhoneNumber": return c.serve(h.createSMSSandboxPhoneNumber,
			["sns:CreateSMSSandboxPhoneNumber"])
		case "CreateTopic": return c.serve(h.createTopic,
			["sns:CreateTopic", "iam:PassRole", "sns:PutDataProtectionPolicy", "sns:TagResource"])
		case "DeleteEndpoint": return c.serve(h.deleteEndpoint, ["sns:DeleteEndpoint"])
		case "DeletePlatformApplication": return c.serve(h.deletePlatformApplication, ["sns:DeletePlatformApplication"])
		case "DeleteSMSSandboxPhoneNumber": return c.serve(h.deleteSMSSandboxPhoneNumber,
			["sns:DeleteSMSSandboxPhoneNumber"])
		case "DeleteTopic": return c.serve(h.deleteTopic, ["sns:DeleteTopic"])
		case "GetDataProtectionPolicy": return c.serve(h.getDataProtectionPolicy, ["sns:GetDataProtectionPolicy"])
		case "GetEndpointAttributes": return c.serve(h.getEndpointAttributes, ["sns:GetEndpointAttributes"])
		case "GetPlatformApplicationAttributes": return c.serve(h.getPlatformApplicationAttributes,
			["sns:GetPlatformApplicationAttributes"])
		case "GetSMSAttributes": return c.serve(h.getSMSAttributes, ["sns:GetSMSAttributes"])
		case "GetSMSSandboxAccountStatus": return c.serve(h.getSMSSandboxAccountStatus,
			["sns:GetSMSSandboxAccountStatus"])
		case "GetSubscriptionAttributes": return c.serve(h.getSubscriptionAttributes, ["sns:GetSubscriptionAttributes"])
		case "GetTopicAttributes": return c.serve(h.getTopicAttributes, ["sns:GetTopicAttributes"])
		case "ListEndpointsByPlatformApplication": return c.serve(h.listEndpointsByPlatformApplication,
			["sns:ListEndpointsByPlatformApplication"])
		case "ListOriginationNumbers": return c.serve(h.listOriginationNumbers, ["sns:ListOriginationNumbers"])
		case "ListPhoneNumbersOptedOut": return c.serve(h.listPhoneNumbersOptedOut, ["sns:ListPhoneNumbersOptedOut"])
		case "ListPlatformApplications": return c.serve(h.listPlatformApplications, ["sns:ListPlatformApplications"])
		case "ListSMSSandboxPhoneNumbers": return c.serve(h.listSMSSandboxPhoneNumbers,
			["sns:ListSMSSandboxPhoneNumbers"])
		case "ListSubscriptions": return c.serve(h.listSubscriptions, ["sns:ListSubscriptions"])
		case "ListSubscriptionsByTopic": return c.serve(h.listSubscriptionsByTopic, ["sns:ListSubscriptionsByTopic"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["sns:ListTagsForResource"])
		case "ListTopics": return c.serve(h.listTopics, ["sns:ListTopics"])
		case "OptInPhoneNumber": return c.serve(h.optInPhoneNumber, ["sns:OptInPhoneNumber"])
		case "Publish": return c.serve(h.publish, ["sns:Publish"])
		case "PublishBatch": return c.serve(h.publishBatch, ["sns:Publish"])
		case "PutDataProtectionPolicy": return c.serve(h.putDataProtectionPolicy, ["sns:PutDataProtectionPolicy"])
		case "RemovePermission": return c.serve(h.removePermission, ["sns:RemovePermission"])
		case "SetEndpointAttributes": return c.serve(h.setEndpointAttributes, ["sns:SetEndpointAttributes"])
		case "SetPlatformApplicationAttributes": return c.serve(h.setPlatformApplicationAttributes,
			["iam:PassRole", "sns:SetPlatformApplicationAttributes"])
		case "SetSMSAttributes": return c.serve(h.setSMSAttributes, ["iam:PassRole", "sns:SetSMSAttributes"])
		case "SetSubscriptionAttributes": return c.serve(h.setSubscriptionAttributes,
			["iam:PassRole", "sns:SetSubscriptionAttributes"])
		case "SetTopicAttributes": return c.serve(h.setTopicAttributes, ["iam:PassRole", "sns:SetTopicAttributes"])
		case "Subscribe": return c.serve(h.subscribe, ["iam:PassRole", "sns:Subscribe"])
		case "TagResource": return c.serve(h.tagResource, ["sns:TagResource"])
		case "Unsubscribe": return c.serve(h.unsubscribe, ["sns:Unsubscribe"])
		case "UntagResource": return c.serve(h.untagResource, ["sns:UntagResource"])
		case "VerifySMSSandboxPhoneNumber": return c.serve(h.verifySMSSandboxPhoneNumber,
			["sns:VerifySMSSandboxPhoneNumber"])
		default: return c.invalidAction()
	}
}
