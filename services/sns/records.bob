//! SNS's state in an account's tree of a region: its topics by name, and their subscriptions by the topic's name, a NUL
//! and the subscription's id, so that a topic's are together.

import { Fault } from "../../core/fault"
import { Store, Table } from "../../core/state/store"
import { EncodeError } from "std/encoding/json"
import { Decodable } from "std/types"

export class Topic {
	name = ""
	/// The attributes set, as given, in the order first set: DisplayName, Policy, FifoTopic and the others SNS keeps.
	attributes: [string, string][] = []
	tags: [string, string][] = []
	/// The messages published to it, the last of which a FIFO topic's sequence numbers count.
	published: i64 = 0
}

export class Subscription {
	/// The last part of its ARN, after the topic's.
	id = ""
	topic = ""
	protocol = ""
	endpoint = ""
	/// The account that subscribed, and the identity.
	owner = ""
	principal = ""
	confirmed = false
	/// What ConfirmSubscription takes while it is pending.
	token = ""
	/// The attributes set, as given: RawMessageDelivery, FilterPolicy and the others.
	attributes: [string, string][] = []
}

/// A message published to a FIFO topic, by its deduplication id, which another of the id is within five minutes.
export class Published {
	id = ""
	sequence = ""
	at: i64 = 0
}

/// The tables of an account's tree in a region.
export class Tables {
	topics: Table[Topic]
	subscriptions: Table[Subscription]
	/// By the topic's name and the deduplication id, after the message group's where the topic deduplicates by group.
	published: Table[Published]

	constructor(s: Store) {
		this.topics = new Table[Topic](s, "sns/topics")
		this.subscriptions = new Table[Subscription](s, "sns/subscriptions")
		this.published = new Table[Published](s, "sns/published")
	}
}

/// The key of the record of name, the key of what it belongs to, within it.
export function within(owner: string, name: string): string { return `${owner}\x00${name}` }

/// The value of the attribute name of attributes, null if not set.
export function attribute(attributes: [string, string][], name: string): string | null {
	for (const [k, v] of attributes) {
		if (k == name) {
			return v
		}
	}
	return null
}

/// attributes with name set to value, in place if it was set, or without it if value is null.
export function set(attributes: [string, string][], name: string, value: string | null): [string, string][] {
	const out: [string, string][] = []
	let found = false
	for (const [k, v] of attributes) {
		if (k != name) {
			out.push([k, v])
		} else if (value != null) {
			out.push([k, value!])
			found = true
		}
	}
	if (!found && value != null) {
		out.push([name, value!])
	}
	return out
}

/// Puts v at k in t; a record holds no float, the one thing JSON cannot encode.
export function save[V extends Decodable](t: Table[V], k: string, v: V) throws Fault {
	try {
		t.put(k, v)
	} catch (e: EncodeError) {
		throw new Fault(500, "InternalFailure", `A record of ${e.value} cannot be stored`)
	}
}
