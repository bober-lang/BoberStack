export type ReviewStatus = "APPROVED" | "NOT_REVIEWED" | "PENDING" | "REJECTED"

export type SessionFilterKey = "InvokedAfter" | "InvokedBefore" | "Target" | "Owner" | "Status" | "SessionId"
	| "AccessType"

export type SessionState = "Active" | "History"
export type SessionStatus = "Connected" | "Connecting" | "Disconnected" | "Terminated" | "Terminating" | "Failed"
export type SignalType = "Approve" | "Reject" | "StartStep" | "StopStep" | "Resume" | "Revoke"

export type SourceType = "AWS::EC2::Instance" | "AWS::IoT::Thing" | "AWS::SSM::ManagedInstance"
	| "Microsoft.Compute/virtualMachines" | "compute.googleapis.com/Instance"

export type StepExecutionFilterKey = "StartTimeBefore" | "StartTimeAfter" | "StepExecutionStatus" | "StepExecutionId"
	| "StepName" | "Action" | "ParentStepExecutionId" | "ParentStepIteration" | "ParentStepIteratorValue"

export type StopType = "Complete" | "Cancel"

export type ValidationFindingCode = "TargetInaccessible" | "TargetUnusable" | "TargetMissingPermissions"
	| "TargetApiDisabled" | "TargetStateWarning" | "AwsRoleAssumptionFailed" | "WebIdentityTokenFailed"
	| "OutboundWebIdentityFederationDisabled" | "ProviderCredentialCreationFailed" | "TenantSummary"
	| "SubscriptionAccessible"

export type ValidationFindingScopeType = "azure:tenant" | "azure:subscription" | "gcp:organization" | "gcp:project"
export type ValidationFindingType = "INFO" | "WARN" | "ERROR"

