/// The answer of h to req.
export function handle(h: SSM, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "reasoned"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "AddTagsToResource": return c.serve(h.addTagsToResource, ["ssm:AddTagsToResource"])
		case "AssociateOpsItemRelatedItem": return c.serve(h.associateOpsItemRelatedItem,
			["ssm:AssociateOpsItemRelatedItem"])
		case "CancelCommand": return c.serve(h.cancelCommand, ["ssm:CancelCommand"])
		case "CancelMaintenanceWindowExecution": return c.serve(h.cancelMaintenanceWindowExecution,
			["ssm:CancelMaintenanceWindowExecution"])
		case "CreateActivation": return c.serve(h.createActivation,
			["ssm:AddTagsToResource", "ssm:CreateActivation", "iam:PassRole"])
		case "CreateAssociation": return c.serve(h.createAssociation,
			["ssm:AddTagsToResource", "ssm:CreateAssociation", "iam:PassRole"])
		case "CreateAssociationBatch": return c.serve(h.createAssociationBatch,
			["ssm:CreateAssociation", "ssm:CreateAssociationBatch", "iam:PassRole"])
		case "CreateCloudConnector": return c.serve(h.createCloudConnector,
			["ssm:AddTagsToResource", "ssm:CreateCloudConnector", "iam:PassRole"])
		case "CreateDocument": return c.serve(h.createDocument,
			["ssm:AddTagsToResource", "ssm:CreateDocument", "ssm:GetDocument", "iam:PassRole"])
		case "CreateMaintenanceWindow": return c.serve(h.createMaintenanceWindow,
			["ssm:AddTagsToResource", "ssm:CreateMaintenanceWindow"])
		case "CreateOpsItem": return c.serve(h.createOpsItem, ["ssm:AddTagsToResource", "ssm:CreateOpsItem"])
		case "CreateOpsMetadata": return c.serve(h.createOpsMetadata,
			["ssm:AddTagsToResource", "ssm:CreateOpsMetadata"])
		case "CreatePatchBaseline": return c.serve(h.createPatchBaseline,
			["ssm:AddTagsToResource", "ssm:CreatePatchBaseline"])
		case "CreateResourceDataSync": return c.serve(h.createResourceDataSync, ["ssm:CreateResourceDataSync"])
		case "DeleteActivation": return c.serve(h.deleteActivation, ["ssm:DeleteActivation"])
		case "DeleteAssociation": return c.serve(h.deleteAssociation, ["ssm:DeleteAssociation"])
		case "DeleteCloudConnector": return c.serve(h.deleteCloudConnector, ["ssm:DeleteCloudConnector"])
		case "DeleteDocument": return c.serve(h.deleteDocument, ["ssm:DeleteDocument"])
