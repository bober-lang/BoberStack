/// The answer of h to req.
export function handle(h: SFN, caller: Caller, req: Request): Response throws IoError {
	caller.denied = [400, "AccessDeniedException", "linked"]
	const c = json.call(caller, req, service)
	switch (c.operation) {
		case "CreateActivity": return c.serve(h.createActivity, ["states:CreateActivity", "states:TagResource"])
		case "CreateStateMachine": return c.serve(h.createStateMachine,
			["states:CreateStateMachine", "iam:PassRole", "states:PublishStateMachineVersion", "states:TagResource"])
		case "CreateStateMachineAlias": return c.serve(h.createStateMachineAlias, ["states:CreateStateMachineAlias"])
		case "DeleteActivity": return c.serve(h.deleteActivity, ["states:DeleteActivity"])
		case "DeleteStateMachine": return c.serve(h.deleteStateMachine, ["states:DeleteStateMachine"])
		case "DeleteStateMachineAlias": return c.serve(h.deleteStateMachineAlias, ["states:DeleteStateMachineAlias"])
		case "DeleteStateMachineVersion": return c.serve(h.deleteStateMachineVersion,
			["states:DeleteStateMachineVersion"])
		case "DescribeActivity": return c.serve(h.describeActivity, ["states:DescribeActivity"])
		case "DescribeExecution": return c.serve(h.describeExecution, ["states:DescribeExecution"])
		case "DescribeMapRun": return c.serve(h.describeMapRun, ["states:DescribeMapRun"])
		case "DescribeStateMachine": return c.serve(h.describeStateMachine, ["states:DescribeStateMachine"])
		case "DescribeStateMachineAlias": return c.serve(h.describeStateMachineAlias,
			["states:DescribeStateMachineAlias"])
		case "DescribeStateMachineForExecution": return c.serve(h.describeStateMachineForExecution,
			["states:DescribeStateMachineForExecution"])
		case "GetActivityTask": return c.serve(h.getActivityTask, ["states:GetActivityTask"])
		case "GetExecutionHistory": return c.serve(h.getExecutionHistory, ["states:GetExecutionHistory"])
		case "ListActivities": return c.serve(h.listActivities, ["states:ListActivities"])
		case "ListExecutions": return c.serve(h.listExecutions, ["states:ListExecutions"])
		case "ListMapRuns": return c.serve(h.listMapRuns, ["states:ListMapRuns"])
		case "ListStateMachineAliases": return c.serve(h.listStateMachineAliases, ["states:ListStateMachineAliases"])
		case "ListStateMachineVersions": return c.serve(h.listStateMachineVersions, ["states:ListStateMachineVersions"])
		case "ListStateMachines": return c.serve(h.listStateMachines, ["states:ListStateMachines"])
		case "ListTagsForResource": return c.serve(h.listTagsForResource, ["states:ListTagsForResource"])
		case "PublishStateMachineVersion": return c.serve(h.publishStateMachineVersion,
			["states:PublishStateMachineVersion"])
		case "RedriveExecution": return c.serve(h.redriveExecution, ["states:RedriveExecution"])
		case "SendTaskFailure": return c.serve(h.sendTaskFailure, ["states:SendTaskFailure"])
		case "SendTaskHeartbeat": return c.serve(h.sendTaskHeartbeat, ["states:SendTaskHeartbeat"])
		case "SendTaskSuccess": return c.serve(h.sendTaskSuccess, ["states:SendTaskSuccess"])
		case "StartExecution": return c.serve(h.startExecution, ["states:DescribeExecution", "states:StartExecution"])
		case "StartSyncExecution": return c.serve(h.startSyncExecution, ["states:StartSyncExecution"])
		case "StopExecution": return c.serve(h.stopExecution, ["states:StopExecution"])
		case "TagResource": return c.serve(h.tagResource, ["states:TagResource"])
		case "TestState": return c.serve(h.testState, ["iam:PassRole", "states:RevealSecrets", "states:TestState"])
		case "UntagResource": return c.serve(h.untagResource, ["states:UntagResource"])
		case "UpdateMapRun": return c.serve(h.updateMapRun, ["states:UpdateMapRun"])
		case "UpdateStateMachine": return c.serve(h.updateStateMachine,
			["iam:PassRole", "states:PublishStateMachineVersion", "states:UpdateStateMachine"])
		case "UpdateStateMachineAlias": return c.serve(h.updateStateMachineAlias, ["states:UpdateStateMachineAlias"])
		case "ValidateStateMachineDefinition": return c.serve(h.validateStateMachineDefinition,
			["states:ValidateStateMachineDefinition"])
		default: return c.unknownOperation()
	}
}
