export interface SFN {
	createActivity(caller: Caller, input: CreateActivityInput): CreateActivityOutput throws Fault
	createStateMachine(caller: Caller, input: CreateStateMachineInput): CreateStateMachineOutput throws Fault

	createStateMachineAlias(caller: Caller,
		input: CreateStateMachineAliasInput): CreateStateMachineAliasOutput throws Fault

	deleteActivity(caller: Caller, input: DeleteActivityInput): DeleteActivityOutput throws Fault
	deleteStateMachine(caller: Caller, input: DeleteStateMachineInput): DeleteStateMachineOutput throws Fault

	deleteStateMachineAlias(caller: Caller,
		input: DeleteStateMachineAliasInput): DeleteStateMachineAliasOutput throws Fault

	deleteStateMachineVersion(caller: Caller,
		input: DeleteStateMachineVersionInput): DeleteStateMachineVersionOutput throws Fault

	describeActivity(caller: Caller, input: DescribeActivityInput): DescribeActivityOutput throws Fault
	describeExecution(caller: Caller, input: DescribeExecutionInput): DescribeExecutionOutput throws Fault
	describeMapRun(caller: Caller, input: DescribeMapRunInput): DescribeMapRunOutput throws Fault
	describeStateMachine(caller: Caller, input: DescribeStateMachineInput): DescribeStateMachineOutput throws Fault

	describeStateMachineAlias(caller: Caller,
		input: DescribeStateMachineAliasInput): DescribeStateMachineAliasOutput throws Fault

	describeStateMachineForExecution(caller: Caller,
		input: DescribeStateMachineForExecutionInput): DescribeStateMachineForExecutionOutput throws Fault

	getActivityTask(caller: Caller, input: GetActivityTaskInput): GetActivityTaskOutput throws Fault
	getExecutionHistory(caller: Caller, input: GetExecutionHistoryInput): GetExecutionHistoryOutput throws Fault
	listActivities(caller: Caller, input: ListActivitiesInput): ListActivitiesOutput throws Fault
	listExecutions(caller: Caller, input: ListExecutionsInput): ListExecutionsOutput throws Fault
	listMapRuns(caller: Caller, input: ListMapRunsInput): ListMapRunsOutput throws Fault

	listStateMachineAliases(caller: Caller,
		input: ListStateMachineAliasesInput): ListStateMachineAliasesOutput throws Fault

	listStateMachineVersions(caller: Caller,
		input: ListStateMachineVersionsInput): ListStateMachineVersionsOutput throws Fault

	listStateMachines(caller: Caller, input: ListStateMachinesInput): ListStateMachinesOutput throws Fault
	listTagsForResource(caller: Caller, input: ListTagsForResourceInput): ListTagsForResourceOutput throws Fault

	publishStateMachineVersion(caller: Caller,
		input: PublishStateMachineVersionInput): PublishStateMachineVersionOutput throws Fault

	redriveExecution(caller: Caller, input: RedriveExecutionInput): RedriveExecutionOutput throws Fault
	sendTaskFailure(caller: Caller, input: SendTaskFailureInput): SendTaskFailureOutput throws Fault
	sendTaskHeartbeat(caller: Caller, input: SendTaskHeartbeatInput): SendTaskHeartbeatOutput throws Fault
	sendTaskSuccess(caller: Caller, input: SendTaskSuccessInput): SendTaskSuccessOutput throws Fault
	startExecution(caller: Caller, input: StartExecutionInput): StartExecutionOutput throws Fault
	startSyncExecution(caller: Caller, input: StartSyncExecutionInput): StartSyncExecutionOutput throws Fault
	stopExecution(caller: Caller, input: StopExecutionInput): StopExecutionOutput throws Fault
	tagResource(caller: Caller, input: TagResourceInput): TagResourceOutput throws Fault
	testState(caller: Caller, input: TestStateInput): TestStateOutput throws Fault
	untagResource(caller: Caller, input: UntagResourceInput): UntagResourceOutput throws Fault
	updateMapRun(caller: Caller, input: UpdateMapRunInput): UpdateMapRunOutput throws Fault
	updateStateMachine(caller: Caller, input: UpdateStateMachineInput): UpdateStateMachineOutput throws Fault

	updateStateMachineAlias(caller: Caller,
		input: UpdateStateMachineAliasInput): UpdateStateMachineAliasOutput throws Fault

	validateStateMachineDefinition(caller: Caller,
		input: ValidateStateMachineDefinitionInput): ValidateStateMachineDefinitionOutput throws Fault
}

