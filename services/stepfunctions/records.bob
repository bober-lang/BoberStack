//! Step Functions' state in an account's regional tree: its state machines by name, their executions by the machine's
//! name, a NUL and the execution's, their versions and aliases, and its activities by name.

import { Store, Table } from "../../core/state/store"

export class Machine {
	name = ""
	kind = "STANDARD"
	definition = ""
	role = ""
	created: i64 = 0
	/// A UUID, renewed by each update.
	revision = ""
	tags: [string, string][] = []
	/// The number of its last version, 0 if none.
	versions = 0
}

export class Execution {
	name = ""
	machine = ""
	express = false
	/// RUNNING, SUCCEEDED, FAILED, TIMED_OUT or ABORTED.
	status = "RUNNING"
	input = ""
	output: string | null = null
	error: string | null = null
	cause: string | null = null
	started: i64 = 0
	stopped: i64 | null = null
	/// The definition and role it ran with.
	definition = ""
	role = ""
	/// Its history, each event the JSON of the wire's HistoryEvent.
	events: string[] = []
	/// The outcome of each call its runs made of their host, in order, as JSON: a task's {"Output"} or {"Error",
	/// "Cause"}, a UUID's string or a random number; what a continuation replays.
	steps: string[] = []
	/// The number of events its run had made before each step; and the events its redrives left behind, which runs do
	/// not make again: those after the step a redrive takes again, and those of the end it redrove.
	marks: i32[] = []
	shift = 0
	/// The number of times it was redriven, and when last.
	redrives = 0
	redriven: i64 | null = null
	/// The number of the task, counted from 0 in the run's order, a RUNNING execution waits on for its token.
	waiting: i32 = -1
	/// The ARN of the activity that task is of, "" if it is a callback; its input, whether a worker has it, and when it
	/// was scheduled.
	activity = ""
	work = ""
	handed = false
	scheduled: i64 = 0
	/// Random hex its task tokens carry.
	secret = ""
	/// The task token of the .sync task of the execution that started it and waits for its end, "" if none does; and
	/// whether that task is of .sync:2.
	parent = ""
	sync2 = false
	/// The ARNs of the version and alias it was started by, if it was.
	version: string | null = null
	alias: string | null = null
	/// The ARN of the map run it is a child execution of, if it is one, its machine the run's machine's name, a slash
	/// and the Map state's label; and the number of items it processed.
	mapRun: string | null = null
	items = 0
}

/// A version of a state machine, its number counted from 1.
export class Version {
	number = 0
	definition = ""
	role = ""
	revision = ""
	description: string | null = null
	created: i64 = 0
}

/// An alias of a state machine: the versions it routes to, by number, and their weights.
export class Alias {
	name = ""
	description: string | null = null
	routes: [i32, i32][] = []
	/// The executions started by it, which pick between its versions.
	starts = 0
	created: i64 = 0
	updated: i64 = 0
}

/// A map run of a DISTRIBUTED Map state, its items processed within its execution's run: the execution's ARN, its
/// limits, and the counts of its items, those run as child executions.
export class MapRun {
	execution = ""
	machine = ""
	status = "RUNNING"
	started: i64 = 0
	stopped: i64 | null = null
	concurrency = 0
	percentage: f32 = 0.0
	count: i64 = 0
	total: i64 = 0
	succeeded: i64 = 0
	failed: i64 = 0
	written: i64 = 0
	executions: i64 = 0
}

export class Activity {
	name = ""
	created: i64 = 0
	tags: [string, string][] = []
}

/// The tables of a regional tree.
export class Tables {
	machines: Table[Machine]
	executions: Table[Execution]
	activities: Table[Activity]
	/// Versions and aliases by the machine's name, a NUL and the version's number or the alias's name.
	versions: Table[Version]
	aliases: Table[Alias]
	/// Map runs by their ARN's resource: the machine's name, a slash, the label, a colon and the run's id.
	mapRuns: Table[MapRun]

	constructor(s: Store) {
		this.mapRuns = new Table[MapRun](s, "states/mapruns")
		this.machines = new Table[Machine](s, "states/machines")
		this.executions = new Table[Execution](s, "states/executions")
		this.activities = new Table[Activity](s, "states/activities")
		this.versions = new Table[Version](s, "states/versions")
		this.aliases = new Table[Alias](s, "states/aliases")
	}
}
