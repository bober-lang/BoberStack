import { sign } from "../../core/auth/sigv4"
import { ticks } from "../../core/client.test"
import { Gateway } from "../../core/gateway"
import { Catalog } from "../iam/catalog"
import { stack } from "../../stack"
import { indexOf } from "std/algo"
import * as json from "std/encoding/json"
import { Request, Response } from "std/http"
import { escape } from "std/url"
import { second } from "std/time"

const machine = "arn:aws:states:us-east-1:000000000000:stateMachine:m"
const role = "arn:aws:iam::000000000000:role/r"

function call(g: Gateway, service: string, op: string, body: string): Response {
	const [target, version] = switch (service) {
		case "states": ["AWSStepFunctions", "1.0"]
		case "sqs": ["AmazonSQS", "1.0"]
		default: ["DynamoDB_20120810", "1.0"]
	}
	const req = new Request("POST", "http://localhost:4566/", body)
	req.headers.set("content-type", `application/x-amz-json-${version}`)
	req.headers.set("x-amz-target", `${target}.${op}`)
	sign(req, body, service, "us-east-1", "test", "test", "", "20150626T140000Z")
	return g.handle(req)
}

function sfn(g: Gateway, op: string, body: string): Response { return call(g, "states", op, body) }

function iam(g: Gateway, params: [string, string][]): Response {
	const body = "Version=2010-05-08"
		+ params.map(p => `&${escape(p[0], "component")}=${escape(p[1], "component")}`).join("")
	const req = new Request("POST", "http://localhost:4566/", body)
	req.headers.set("content-type", "application/x-www-form-urlencoded; charset=utf-8")
	sign(req, body, "iam", "us-east-1", "test", "test", "", "20150626T140000Z")
	return g.handle(req)
}

function ok(res: Response, ...parts: string[]): bool {
	const b = res.body.whole ?? ""
	const fine = res.status == 200 && parts.every(p => indexOf(b, p) >= 0)
	if (!fine) {
		print(b)
	}
	return fine
}

function fails(res: Response, code: string, message: string): bool {
	const b = res.body.whole ?? ""
	const fine = res.status == 400 && indexOf(b, `${code}"`) >= 0 && indexOf(b, message) >= 0
	if (!fine) {
		print(b)
	}
	return fine
}

function world(): Gateway {
	const g = stack(new Catalog(""))
	const trust = `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"states.amazonaws.com"},`
		+ `"Action":"sts:AssumeRole"}]}`
	assert iam(g, [["Action", "CreateRole"], ["RoleName", "r"], ["AssumeRolePolicyDocument", trust]]).status == 200
	const allowed = `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["sqs:SendMessage",`
		+ `"dynamodb:PutItem"],"Resource":"*"}]}`
	assert iam(g,
		[["Action", "PutRolePolicy"], ["RoleName", "r"], ["PolicyName", "p"], ["PolicyDocument", allowed]]).status
		== 200
	assert ok(call(g, "sqs", "CreateQueue", `{"QueueName":"q"}`))
	assert ok(call(g, "dynamodb", "CreateTable",
		`{"TableName":"tab","AttributeDefinitions":[{"AttributeName":"id",`
		+ `"AttributeType":"S"}],"KeySchema":[{"AttributeName":"id","KeyType":"HASH"}],"BillingMode":"PAY_PER_REQUEST"}`))
	return g
}

function create(d: string): string { return `{"name":"m","roleArn":"${role}","definition":${json.quoted(d)}}` }

const definition = `{"StartAt":"Each","States":{
	"Each":{"Type":"Map","ItemsPath":"$.items","ItemProcessor":{"StartAt":"Send","States":{"Send":{"Type":"Task",
		"Resource":"arn:aws:states:::sqs:sendMessage","Parameters":{"QueueUrl":"http://localhost:4566/000000000000/q",
		"MessageBody.$":"States.Format('item {}', $)"},"ResultSelector":{"id.$":"$.MessageId"},"End":true}}},
		"ResultPath":"$.sent","Next":"Both"},
	"Both":{"Type":"Parallel","Branches":[{"StartAt":"Put","States":{"Put":{"Type":"Task",
		"Resource":"arn:aws:states:::dynamodb:putItem","Parameters":{"TableName":"tab","Item":{"id":{"S.$":"$.id"}}},
		"End":true}}},{"StartAt":"Lambda","States":{"Lambda":{"Type":"Task","Resource":"arn:aws:states:::lambda:invoke",
		"Parameters":{"FunctionName":"f"},"Retry":[{"ErrorEquals":["States.ALL"],"MaxAttempts":1}],
		"Catch":[{"ErrorEquals":["States.TaskFailed"],"Next":"Caught"}],"End":true},
		"Caught":{"Type":"Pass","Result":"caught","End":true}}}],"ResultPath":"$.both","Next":"Which"},
	"Which":{"Type":"Choice","Choices":[{"Variable":"$.both[1]","StringEquals":"caught","Next":"Done"}],
		"Default":"Bad"},
	"Bad":{"Type":"Fail","Error":"Bad"},
	"Done":{"Type":"Succeed","OutputPath":"$.both[1]"}}}`

test "a machine runs to its end within StartExecution" {
	const g = world()
	assert ok(sfn(g, "CreateStateMachine", create(definition)), machine)
	// The same again is the same machine; another definition of its name a conflict.
	assert ok(sfn(g, "CreateStateMachine", create(definition)), machine)
	const other = `{"StartAt":"A","States":{"A":{"Type":"Succeed"}}}`
	assert fails(sfn(g, "CreateStateMachine", create(other)), "StateMachineAlreadyExists", machine)
	assert ok(sfn(g, "StartExecution",
		`{"stateMachineArn":"${machine}","name":"e","input":"{\\"items\\":[1,2],\\"id\\":\\"k\\"}"}`),
		`"executionArn":"arn:aws:states:us-east-1:000000000000:execution:m:e"`)
	const e = "arn:aws:states:us-east-1:000000000000:execution:m:e"
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"${e}"}`), `"status":"SUCCEEDED"`, `"output":"\\"caught\\""`)
	assert ok(call(g, "sqs", "ReceiveMessage",
		`{"QueueUrl":"http://localhost:4566/000000000000/q","MaxNumberOfMessages":10}`), "item 1", "item 2")
	assert ok(call(g, "dynamodb", "GetItem", `{"TableName":"tab","Key":{"id":{"S":"k"}}}`), `"Item":{"id":{"S":"k"}}`)
	assert ok(sfn(g, "GetExecutionHistory", `{"executionArn":"${e}","reverseOrder":true,"maxResults":1}`),
		`"type":"ExecutionSucceeded"`, `"nextToken":"1"`)
	assert ok(sfn(g, "GetExecutionHistory", `{"executionArn":"${e}"}`), `"type":"ExecutionStarted"`,
		`"type":"MapIterationStarted"`, `"resourceType":"sqs","resource":"sendMessage"`, `"type":"TaskFailed"`,
		`"error":"Lambda.AWSLambdaException"`, `Error Code: AccessDeniedException;`, `"type":"SucceedStateEntered"`)
	assert fails(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"e"}`), "ExecutionAlreadyExists", e)
	assert ok(sfn(g, "ListExecutions", `{"stateMachineArn":"${machine}","statusFilter":"SUCCEEDED"}`), `"name":"e"`)
	assert ok(sfn(g, "DescribeStateMachineForExecution", `{"executionArn":"${e}"}`), `"roleArn":"${role}"`)
}

test "a task its role may not perform fails the execution" {
	const g = world()
	const d = `{"StartAt":"A","States":{"A":{"Type":"Task","Resource":"arn:aws:states:::dynamodb:getItem",`
		+ `"Parameters":{"TableName":"tab","Key":{"id":{"S":"k"}}},"End":true}}}`
	assert ok(sfn(g, "CreateStateMachine", create(d)))
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"x"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"arn:aws:states:us-east-1:000000000000:execution:m:x"}`),
		`"status":"FAILED"`, `"error":"DynamoDB.AccessDeniedException"`,
		"assumed-role/r/x is not authorized to perform: dynamodb:GetItem")
}

test "a role that does not trust Step Functions is refused when a machine is made, and fails a task run as it" {
	const g = world()
	const untrusted = "Neither the global service principal states.amazonaws.com, nor the regional one is authorized to "
		+ "assume the provided role."
	const elsewhere = `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"events.amazonaws.com"},`
		+ `"Action":"sts:AssumeRole"}]}`
	assert iam(g, [["Action", "CreateRole"], ["RoleName", "u"], ["AssumeRolePolicyDocument", elsewhere]]).status == 200
	const d = `{"StartAt":"A","States":{"A":{"Type":"Task","Resource":"arn:aws:states:::sqs:sendMessage",`
		+ `"Parameters":{"QueueUrl":"http://localhost:4566/000000000000/q","MessageBody":"m"},"End":true}}}`
	assert fails(sfn(g, "CreateStateMachine",
		`{"name":"m","roleArn":"arn:aws:iam::000000000000:role/u","definition":${json.quoted(d)}}`),
		"AccessDeniedException", untrusted)
	assert ok(sfn(g, "CreateStateMachine", create(d)))
	assert fails(sfn(g, "UpdateStateMachine",
		`{"stateMachineArn":"${machine}","roleArn":"arn:aws:iam::000000000000:role/u"}`), "AccessDeniedException",
		untrusted)
	assert iam(g, [["Action", "UpdateAssumeRolePolicy"], ["RoleName", "r"], ["PolicyDocument", elsewhere]]).status
		== 200
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"x"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"arn:aws:states:us-east-1:000000000000:execution:m:x"}`),
		`"status":"FAILED"`, `"error":"States.TaskFailed"`, "nor the regional one")
}

test "state machines" {
	const g = world()
	assert fails(sfn(g, "CreateStateMachine", `{"name":"m","roleArn":"x","definition":"{}"}`), "InvalidArn",
		"Invalid Role Arn: 'x'")
	assert fails(sfn(g, "CreateStateMachine", create(`{"StartAt":"A","States":{"A":{"Type":"Pass","Next":"B"}}}`)),
		"InvalidDefinition", "MISSING_TRANSITION_TARGET: Missing 'Next' target: B at /States/A/Next")
	assert fails(sfn(g, "DescribeStateMachine", `{"stateMachineArn":"x"}`), "InvalidArn",
		"Invalid Arn: 'Invalid ARN prefix: x'")
	assert fails(sfn(g, "DescribeStateMachine", `{"stateMachineArn":"${machine}"}`), "StateMachineDoesNotExist",
		`State Machine Does Not Exist: '${machine}'`)
	assert ok(sfn(g, "ValidateStateMachineDefinition", `{"definition":"{}"}`), `"result":"FAIL"`)
	const d = `{"StartAt":"A","States":{"A":{"Type":"Pass","End":true}}}`
	assert ok(sfn(g, "CreateStateMachine",
		`{"name":"m","roleArn":"${role}","definition":${json.quoted(d)},`
		+ `"type":"EXPRESS","tags":[{"key":"k","value":"v"}]}`))
	assert ok(sfn(g, "ListStateMachines", "{}"), `"type":"EXPRESS"`)
	assert ok(sfn(g, "ListTagsForResource", `{"resourceArn":"${machine}"}`), `{"key":"k","value":"v"}`)
	assert ok(sfn(g, "StartSyncExecution", `{"stateMachineArn":"${machine}","input":"{\\"a\\":1}"}`),
		`"status":"SUCCEEDED"`, `"output":"{\\"a\\":1}"`)
	assert ok(sfn(g, "UpdateStateMachine", `{"stateMachineArn":"${machine}","definition":${json.quoted(d)}}`),
		`"revisionId"`)
	assert ok(sfn(g, "DeleteStateMachine", `{"stateMachineArn":"${machine}"}`))
	assert ok(sfn(g, "ListStateMachines", "{}"), `"stateMachines":[]`)
}

test "an execution waits at an activity's task until a worker answers it" {
	const g = world()
	const activity = "arn:aws:states:us-east-1:000000000000:activity:a"
	assert ok(sfn(g, "CreateActivity", `{"name":"a"}`), `"activityArn":"${activity}"`)
	const d = `{"StartAt":"A","States":{"A":{"Type":"Task","Resource":"${activity}","ResultPath":"$.r","Next":"B"},`
		+ `"B":{"Type":"Pass","Parameters":{"id.$":"States.UUID()","r.$":"$.r"},"Next":"C"},`
		+ `"C":{"Type":"Task","Resource":"${activity}","End":true}}}`
	assert ok(sfn(g, "CreateStateMachine", create(d)))
	const e = "arn:aws:states:us-east-1:000000000000:execution:m:x"
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"x","input":"{\\"n\\":1}"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"${e}"}`), `"status":"RUNNING"`)
	const first = token(sfn(g, "GetActivityTask", `{"activityArn":"${activity}"}`))
	// A poll with no task waits 60 seconds, then answers none.
	const t = now()
	const ticking = async ticks(g, 61)
	assert ok(sfn(g, "GetActivityTask", `{"activityArn":"${activity}"}`), "{}")
	assert now() - t >= 60 * second && now() - t < 61 * second
	await ticking
	assert fails(sfn(g, "SendTaskSuccess", `{"taskToken":"x","output":"{}"}`), "InvalidToken", "Invalid Token")
	assert ok(sfn(g, "SendTaskHeartbeat", `{"taskToken":"${first}"}`))
	assert ok(sfn(g, "SendTaskSuccess", `{"taskToken":"${first}","output":"7"}`))
	assert fails(sfn(g, "SendTaskSuccess", `{"taskToken":"${first}","output":"7"}`), "TaskDoesNotExist", "Task")
	const res = sfn(g, "GetActivityTask", `{"activityArn":"${activity}"}`)
	assert ok(res, `\\"r\\":7`)
	const b = res.body.whole ?? ""
	const at = indexOf(b, `\\"id\\":\\"`) + 9
	const id = b.slice(at, at + 36)
	assert ok(sfn(g, "SendTaskFailure", `{"taskToken":"${token(res)}","error":"E","cause":"C"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"${e}"}`), `"status":"FAILED"`, `"error":"E"`)
	// The continuation replayed the first answer and the UUID as they were, and kept the history it had.
	assert ok(sfn(g, "GetExecutionHistory", `{"executionArn":"${e}"}`), id, `"id":1,`, `"type":"ExecutionFailed"`)
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"y"}`))
	const y = "arn:aws:states:us-east-1:000000000000:execution:m:y"
	assert ok(sfn(g, "StopExecution", `{"executionArn":"${y}","error":"Stop"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"${y}"}`), `"status":"ABORTED"`, `"error":"Stop"`)
	assert ok(sfn(g, "GetExecutionHistory", `{"executionArn":"${y}","reverseOrder":true}`), `"type":"ExecutionAborted"`)
	// A poll held is answered by the execution that reaches the activity.
	const polled = async sfn(g, "GetActivityTask", `{"activityArn":"${activity}"}`)
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}","name":"z","input":"{\\"n\\":2}"}`))
	assert ok(await polled, `\\"n\\":2`)
}

test "versions, aliases and TestState" {
	const g = world()
	const d = `{"StartAt":"A","States":{"A":{"Type":"Pass","Result":1,"End":true}}}`
	assert ok(sfn(g, "CreateStateMachine",
		`{"name":"m","roleArn":"${role}","definition":${json.quoted(d)},"publish":true}`),
		`"stateMachineVersionArn":"${machine}:1"`)
	assert fails(sfn(g, "CreateStateMachineAlias",
		`{"name":"a","routingConfiguration":[{"stateMachineVersionArn":"${machine}:1","weight":90}]}`),
		"ValidationException", "Sum of routing configuration weights must be equal to 100")
	assert ok(sfn(g, "CreateStateMachineAlias",
		`{"name":"a","routingConfiguration":[{"stateMachineVersionArn":"${machine}:1","weight":100}]}`),
		`"stateMachineAliasArn":"${machine}:a"`)
	const conflict = sfn(g, "DeleteStateMachineVersion", `{"stateMachineVersionArn":"${machine}:1"}`)
	assert conflict.status == 409
		&& indexOf(conflict.body.whole ?? "", `Current list of aliases referencing this version: [${machine}:a]`) >= 0
	assert ok(sfn(g, "StartExecution", `{"stateMachineArn":"${machine}:a","name":"x"}`))
	assert ok(sfn(g, "DescribeExecution", `{"executionArn":"arn:aws:states:us-east-1:000000000000:execution:m:x"}`),
		`"stateMachineVersionArn":"${machine}:1"`, `"stateMachineAliasArn":"${machine}:a"`)
	const full = `{"StartAt":"A","States":{"A":{"Type":"Pass","Next":"B"},"B":{"Type":"Task",`
		+ `"Resource":"arn:aws:states:::lambda:invoke","Retry":[{"ErrorEquals":["X"]}],`
		+ `"Catch":[{"ErrorEquals":["X"],"Next":"A"},{"ErrorEquals":["States.ALL"],"Next":"A","ResultPath":"$.e"}],`
		+ `"End":true}}}`
	assert ok(sfn(g, "TestState",
		`{"definition":${json.quoted(full)},"stateName":"B","roleArn":"${role}","input":"{}","inspectionLevel":"DEBUG"}`),
		`"status":"CAUGHT_ERROR"`, `"nextState":"A"`, `"errorDetails":{"catchIndex":1}`,
		`"error":"Lambda.AWSLambdaException"`)
}

function token(res: Response): string {
	const b = res.body.whole ?? ""
	const from = indexOf(b, `"taskToken":"`) + 13
	const rest = b.slice(from, b.length)
	return rest.slice(0, indexOf(rest, `"`))
}
