//! AWS Security Token Service: who a caller is, and temporary credentials for a role or for the caller itself.

import { Credential, credentials, id, secret } from "../../core/auth/credentials"
import { Fault } from "../../core/fault"
import { invalid } from "../../core/protocol/query"
import { Caller } from "../../core/service"
import { arn, key, save, Tables } from "../iam/records"

import { AssumedRoleUser, AssumeRoleRequest, AssumeRoleResponse, Credentials, GetCallerIdentityRequest,
	GetCallerIdentityResponse, GetSessionTokenRequest, GetSessionTokenResponse, Unimplemented } from "./api"

import { indexOf, lastIndexOf, startsWith } from "std/algo"
import { isAlphanumeric } from "std/ascii"
import { second } from "std/time"

/// The service, of the operations implemented.
export class Handler {
	...Unimplemented

	getCallerIdentity(caller: Caller, input: GetCallerIdentityRequest): GetCallerIdentityResponse throws Fault {
		const r = new GetCallerIdentityResponse()
		r.UserId = caller.userId
		r.Account = caller.account
		r.Arn = caller.arn
		return r
	}

	assumeRole(caller: Caller, input: AssumeRoleRequest): AssumeRoleResponse throws Fault {
		const a = input.RoleArn
		const session = input.RoleSessionName
		if (session.length < 2 || session.length > 64) {
			const why = if (session.length < 2) "greater than or equal to 2" else "less than or equal to 64"
			throw invalid(session, "roleSessionName", `Member must have length ${why}`)
		}
		if (!session.every(c => isAlphanumeric(c) || indexOf("_+=,.@-", chr(c)) >= 0)) {
			throw invalid(session, "roleSessionName", "Member must satisfy regular expression pattern: [\\w+=,.@-]*")
		}
		if (!startsWith(a, "arn:aws:iam::") || indexOf(a, ":role/") != 25) {
			throw new Fault(400, "ValidationError", `${a} is not a valid role ARN`)
		}
		const account = a.slice(13, 25)
		// The trust policy is not evaluated: any caller may assume a role that exists.
		const role = new Tables(caller.tree(account)).roles.get(key(a.slice(lastIndexOf(a, "/") + 1, a.length)))
		if (role == null || arn(account, "role", role.path, role.name) != a) {
			const why = `User: ${caller.arn} is not authorized to perform: sts:AssumeRole on resource: ${a}`
			throw new Fault(403, "AccessDenied", why)
		}
		const seconds = input.DurationSeconds ?? 3600
		if (seconds < 900) {
			throw invalid(`${seconds}`, "durationSeconds", "Member must have value greater than or equal to 900")
		}
		if (seconds > role.maxSession) {
			const why = "The requested DurationSeconds exceeds the MaxSessionDuration set for this role."
			throw new Fault(400, "ValidationError", why)
		}
		const r = new AssumeRoleResponse()
		const u = new AssumedRoleUser()
		u.AssumedRoleId = `${role.id}:${session}`
		u.Arn = `arn:aws:sts::${account}:assumed-role/${role.name}/${session}`
		r.AssumedRoleUser = u
		r.Credentials = issue(caller, account, u.Arn, u.AssumedRoleId, seconds)
		return r
	}

	getSessionToken(caller: Caller, input: GetSessionTokenRequest): GetSessionTokenResponse throws Fault {
		if (indexOf(caller.arn, ":assumed-role/") >= 0) {
			throw new Fault(403, "AccessDenied", "Cannot call GetSessionToken with session credentials")
		}
		// A root's session lasts an hour at most, whatever it asks for.
		const root = caller.arn == `arn:aws:iam::${caller.account}:root`
		let seconds = input.DurationSeconds ?? 43200
		if (seconds < 900 || seconds > 129600) {
			const why = if (seconds < 900) "greater than or equal to 900" else "less than or equal to 129600"
			throw invalid(`${seconds}`, "durationSeconds", `Member must have value ${why}`)
		}
		if (root && seconds > 3600) {
			seconds = 3600
		}
		const r = new GetSessionTokenResponse()
		r.Credentials = issue(caller, caller.account, caller.arn, caller.userId, seconds)
		return r
	}
}

/// Temporary credentials of account, acting as identity, of the unique id userId, for seconds from now, issued for caller.
function issue(caller: Caller, account: string, identity: string, userId: string,
	seconds: i32): Credentials throws Fault {
	const c = new Credential()
	c.secret = secret()
	c.account = account
	c.arn = identity
	c.userId = userId
	c.token = secret(356)
	c.expiry = now() + (seconds as i64) * second
	const r = new Credentials()
	r.AccessKeyId = id("ASIA", 16)
	r.SecretAccessKey = c.secret
	r.SessionToken = c.token
	r.Expiration = c.expiry
	save(credentials(caller.global()), r.AccessKeyId, c)
	return r
}
