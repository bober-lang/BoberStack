//! AWS Security Token Service: who a caller is, and temporary credentials for a role, a federated user or itself.

import { Credential, credentials, id, secret } from "../../core/auth/credentials"
import * as auth from "../../core/auth/policy"
import { Fault } from "../../core/fault"
import { Caller, Context } from "../../core/service"
import { arn, key, stamp, Tables } from "../iam/records"

import { AssumedRoleUser, AssumeRoleRequest, AssumeRoleResponse, Credentials, FederatedUser, GetCallerIdentityRequest,
	GetCallerIdentityResponse, GetFederationTokenRequest, GetFederationTokenResponse, GetSessionTokenRequest,
	GetSessionTokenResponse, PolicyDescriptorType, Tag, Unimplemented } from "./api"

import { indexOf, lastIndexOf, startsWith } from "std/algo"
import { second } from "std/time"

export class Handler {
	...Unimplemented

	/// Needs no permission.
	getCallerIdentity(caller: Caller, input: GetCallerIdentityRequest): GetCallerIdentityResponse throws Fault {
		const r = new GetCallerIdentityResponse()
		r.UserId = caller.userId
		r.Account = caller.account
		r.Arn = caller.arn
		return r
	}

	/// As the role's trust policy and the caller's policies allow, plus sts:TagSession and sts:SetSourceIdentity if used.
	assumeRole(caller: Caller, input: AssumeRoleRequest): AssumeRoleResponse throws Fault {
		const a = input.RoleArn
		const session = input.RoleSessionName
		if (!startsWith(a, "arn:aws:iam::") || indexOf(a, ":role/") != 25) {
			throw new Fault(400, "ValidationError", `${a} is not a valid role ARN`)
		}
		const account = a.slice(13, 25)
		const tags = input.Tags ?? []
		caller.actions = caller.actions.filter(x => x == "sts:AssumeRole" || x == "sts:TagSession" && tags.length > 0
			|| x == "sts:SetSourceIdentity" && input.SourceIdentity != null
			|| x == "sts:SetContext" && input.ProvidedContexts != null)
		const role = new Tables(caller.tree(account)).roles.get(key(a.slice(lastIndexOf(a, "/") + 1, a.length)))
		if (role == null || arn(account, "role", role.path, role.name) != a) {
			const why = `User: ${caller.arn} is not authorized to perform: sts:AssumeRole on resource: ${a}`
			throw new Fault(403, "AccessDenied", why)
		}
		const context: Context = [["sts:RoleSessionName", session]]
		if (input.ExternalId != null) {
			context.push(["sts:ExternalId", input.ExternalId!])
		}
		if (input.SourceIdentity != null) {
			context.push(["sts:SourceIdentity", input.SourceIdentity!])
		}
		requested(context, tags)
		if (input.TransitiveTagKeys != null) {
			context.push(["sts:TransitiveTagKeys", input.TransitiveTagKeys!])
		}
		caller.allow(a, role.trust, context)
		const seconds = input.DurationSeconds ?? 3600
		if (seconds > role.maxSession) {
			const why = "The requested DurationSeconds exceeds the MaxSessionDuration set for this role."
			throw new Fault(400, "ValidationError", why)
		}
		const r = new AssumeRoleResponse()
		const u = new AssumedRoleUser()
		u.AssumedRoleId = `${role.id}:${session}`
		u.Arn = `arn:aws:sts::${account}:assumed-role/${role.name}/${session}`
		r.AssumedRoleUser = u
		const c = issued(account, u.Arn, u.AssumedRoleId, seconds, "role", input.Policy, input.PolicyArns, tags)
		r.Credentials = issue(caller, c)
		const [size, used] = sized(c)
		r.SessionTokenSize = size
		r.SessionTokenUtilization = used
		r.PackedPolicySize = used
		return r
	}

	/// For a federated user whose permissions are those of both the caller's and the session policies.
	getFederationToken(caller: Caller, input: GetFederationTokenRequest): GetFederationTokenResponse throws Fault {
		const tags = input.Tags ?? []
		if (tags.length == 0) {
			caller.actions = caller.actions.filter(x => x != "sts:TagSession")
		}
		const context: Context = []
		requested(context, tags)
		const a = `arn:aws:sts::${caller.account}:federated-user/${input.Name}`
		caller.allow(a, null, context)
		const r = new GetFederationTokenResponse()
		const u = new FederatedUser()
		u.FederatedUserId = `${caller.account}:${input.Name}`
		u.Arn = a
		r.FederatedUser = u
		const c = issued(caller.account, a, u.FederatedUserId, input.DurationSeconds ?? 43200, "federated-user",
			input.Policy, input.PolicyArns, tags)
		c.issuer = caller.arn
		r.Credentials = issue(caller, c)
		const [size, used] = sized(c)
		r.SessionTokenSize = size
		r.SessionTokenUtilization = used
		r.PackedPolicySize = used
		return r
	}

	getSessionToken(caller: Caller, input: GetSessionTokenRequest): GetSessionTokenResponse throws Fault {
		if (caller.credential != null && caller.credential!.token != "") {
			throw new Fault(403, "AccessDenied", "Cannot call GetSessionToken with session credentials")
		}
		// A root's session lasts an hour at most, whatever it asks for.
		const root = caller.arn == `arn:aws:iam::${caller.account}:root`
		let seconds = input.DurationSeconds ?? 43200
		if (root && seconds > 3600) {
			seconds = 3600
		}
		const r = new GetSessionTokenResponse()
		const c = issued(caller.account, caller.arn, caller.userId, seconds, if (root) "" else "user", null, null, [])
		r.Credentials = issue(caller, c)
		const [size, used] = sized(c)
		r.SessionTokenSize = size
		r.SessionTokenUtilization = used
		return r
	}
}

/// The session a service principal acts as in role on behalf of its resource source, as AssumeRole gives one; null if
/// the role's trust policy, with aws:SourceArn and aws:SourceAccount, does not let the service assume it.
export function actAs(caller: Caller, principal: string, role: string, source: string, actions: string[],
	session: string): Caller | null throws Fault {
	if (!startsWith(role, "arn:aws:iam::") || indexOf(role, ":role/") != 25) {
		return null
	}
	const account = role.slice(13, 25)
	const r = new Tables(caller.tree(account)).roles.get(key(role.slice(lastIndexOf(role, "/") + 1, role.length)))
	if (r == null || arn(account, "role", r.path, r.name) != role) {
		return null
	}
	try {
		caller.internal(principal, source, ["sts:AssumeRole"]).allow(role, r.trust)
	} catch (f: Fault) {
		return null
	}
	const c = caller.internal(principal, source, actions)
	c.account = account
	c.arn = `arn:aws:sts::${account}:assumed-role/${r.name}/${session}`
	c.userId = `${r.id}:${session}`
	c.source = ""
	return c
}

/// Throws access denied unless caller may pass role to the service: iam:PassRole with iam:PassedToService.
export function passRole(caller: Caller, role: string, principal: string) throws Fault {
	const actions = caller.actions
	caller.actions = ["iam:PassRole"]
	let denied: Fault | null = null
	try {
		caller.allow(role, null, [["iam:PassedToService", principal]])
	} catch (f: Fault) {
		denied = f
	}
	caller.actions = actions
	if (denied != null) {
		throw denied!
	}
}

function requested(context: Context, tags: Tag[]) {
	for (const t of tags) {
		context.push([`aws:RequestTag/${t.Key}`, t.Value])
	}
	if (tags.length > 0) {
		context.push(["aws:TagKeys", tags.map(t => t.Key)])
	}
}

function issued(account: string, identity: string, userId: string, seconds: i32, session: string, policy: string | null,
	policyArns: PolicyDescriptorType[] | null, tags: Tag[]): Credential throws Fault {
	if (policy != null) {
		auth.parse(policy!, "identity")
	}
	const c = new Credential()
	c.secret = secret()
	c.account = account
	c.arn = identity
	c.userId = userId
	c.token = secret(356)
	c.expiry = stamp() + (seconds as i64) * second
	c.session = session
	c.policy = policy ?? ""
	c.policyArns = (policyArns ?? []).map(p => p.arn ?? "")
	c.tags = tags.map(t => [t.Key, t.Value])
	return c
}

/// The session token's size and its percentage of the 4096-byte maximum, which AWS also answers as PackedPolicySize.
function sized(c: Credential): [i32, i32] {
	const n = c.token.length as i32
	return [n, n * 100 / 4096]
}

function issue(caller: Caller, c: Credential): Credentials throws Fault {
	const r = new Credentials()
	r.AccessKeyId = id("ASIA", 16)
	r.SecretAccessKey = c.secret
	r.SessionToken = c.token
	r.Expiration = c.expiry
	(credentials(caller.global())).put(r.AccessKeyId, c)
	return r
}
