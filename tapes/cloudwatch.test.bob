import { Catalog } from "../services/iam/catalog"
import { stack } from "../stack"
import { replay } from "../tools/tape/tape"

test "CloudWatch tapes replay" {
	for (const tape of ["tapes/cloudwatch/alarms.json", "tapes/cloudwatch/composite.json",
		"tapes/cloudwatch/dashboards.json", "tapes/cloudwatch/metrics.json"]) {
		test `${tape}` {
			const differences = replay(tape, stack(new Catalog(0, 0)))
			assert differences == []
		}
	}
}
