import { Gateway } from "../core/gateway"
import * as query from "../core/protocol/query"
import * as api from "../services/iam/api"
import { Catalog } from "../services/iam/catalog"
import * as iam from "../services/iam/iam"
import { identify } from "../services/iam/identities"
import * as stsApi from "../services/sts/api"
import * as sts from "../services/sts/sts"
import { replay } from "../tools/tape/tape"
import managed from "../models/iam-managed-policies.jsonl" @Embed["deflate"]

/// A gateway of IAM, of every AWS managed policy, which the catalog's text costs this test's build; and of STS, which
/// a tape's users call to learn that their keys work.
function gateway(catalog: Catalog): Gateway {
	const g = new Gateway()
	const h = new iam.Handler(catalog)
	const s = new sts.Handler()
	g.identify = identify(catalog)
	g.services.set(api.signingName, (caller, req) => api.handle(h, caller, req))
	g.faults.set(api.signingName, (f, id, _) => query.error(f, id, api.ns))
	g.services.set(stsApi.signingName, (caller, req) => stsApi.handle(s, caller, req))
	g.faults.set(stsApi.signingName, (f, id, _) => query.error(f, id, stsApi.ns))
	return g
}

const catalog = new Catalog(managed)

test "IAM tapes replay" {
	for (const tape of ["tapes/iam/users.json", "tapes/iam/roles.json", "tapes/iam/policies.json",
		"tapes/iam/managed.json", "tapes/iam/enforcement.json", "tapes/iam/boundaries.json", "tapes/iam/dependent.json",
		"tapes/iam/groups.json", "tapes/iam/profiles.json", "tapes/iam/oidc.json", "tapes/iam/password.json",
		"tapes/iam/keys.json", "tapes/iam/simulation.json", "tapes/iam/summary.json"]) {
		test `${tape}` {
			const differences = replay(tape, gateway(catalog))
			assert differences == []
		}
	}
}
