{
	"volatile": [
		"RequestId",
		"CreateDate",
		"UserId"
	],
	"steps": [
		{
			"name": "create a group of a bad name",
			"service": "iam",
			"query": {
				"Action": "CreateGroup",
				"Version": "2010-05-08",
				"GroupName": "bad name"
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<ErrorResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <Error>\n    <Type>Sender</Type>\n    <Code>ValidationError</Code>\n    <Message>The specified value for groupName is invalid. It must contain only alphanumeric characters and/or the following: +=,.@_-</Message>\n  </Error>\n  <RequestId>x-x-x-x-x</RequestId>\n</ErrorResponse>\n"
			}
		},
		{
			"name": "create a group of a bad path",
			"service": "iam",
			"query": {
				"Action": "CreateGroup",
				"Version": "2010-05-08",
				"GroupName": "${prefix}-x",
				"Path": "nope"
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<ErrorResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <Error>\n    <Type>Sender</Type>\n    <Code>ValidationError</Code>\n    <Message>The specified value for path is invalid. It must begin and end with / and contain only alphanumeric characters and/or / characters.</Message>\n  </Error>\n  <RequestId>x-x-x-x-x</RequestId>\n</ErrorResponse>\n"
			}
		},
		{
			"name": "get a missing group",
			"service": "iam",
			"query": {
				"Action": "GetGroup",
				"Version": "2010-05-08",
				"GroupName": "${prefix}-none"
			},
			"response": {
				"status": 404,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<ErrorResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <Error>\n    <Type>Sender</Type>\n    <Code>NoSuchEntity</Code>\n    <Message>The group with name boberstack-ab-00000000-none cannot be found.</Message>\n  </Error>\n  <RequestId>x-x-x-x-x</RequestId>\n</ErrorResponse>\n"
			}
		},
		{
			"name": "list the groups of the path",
			"service": "iam",
			"query": {
				"Action": "ListGroups",
