			}
		},
		{
			"name": "remove from a missing group",
			"service": "iam",
			"query": {
				"Action": "RemoveUserFromGroup",
				"Version": "2010-05-08",
				"GroupName": "${prefix}-none",
				"UserName": "${prefix}-alice"
			},
			"response": {
				"status": 404,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<ErrorResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <Error>\n    <Type>Sender</Type>\n    <Code>NoSuchEntity</Code>\n    <Message>The user with name boberstack-ab-00000000-alice cannot be found.</Message>\n  </Error>\n  <RequestId>x-x-x-x-x</RequestId>\n</ErrorResponse>\n"
			}
		},
		{
