				"headers": {
					"content-type": "text/xml"
				},
				"body": "<GetAccountPasswordPolicyResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <GetAccountPasswordPolicyResult>\n    <PasswordPolicy>\n      <ExpirePasswords>false</ExpirePasswords>\n      <MinimumPasswordLength>6</MinimumPasswordLength>\n      <RequireSymbols>false</RequireSymbols>\n      <AllowUsersToChangePassword>false</AllowUsersToChangePassword>\n      <RequireLowercaseCharacters>false</RequireLowercaseCharacters>\n      <RequireNumbers>false</RequireNumbers>\n      <RequireUppercaseCharacters>false</RequireUppercaseCharacters>\n    </PasswordPolicy>\n  </GetAccountPasswordPolicyResult>\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</GetAccountPasswordPolicyResponse>\n"
			}
		},
