{
  "volatile": [
    "RequestId",
    "CreateDate",
    "ValidUntil",
    "SAMLProviderUUID"
  ],
  "steps": [
    {
      "name": "create of a bad document",
      "service": "iam",
      "query": {
        "Action": "CreateSAMLProvider",
        "Version": "2010-05-08",
        "Name": "${prefix}-s",
        "SAMLMetadataDocument": "nope nope nope nope nope nope nope nope nope nope"
      }
    },
    {
      "name": "create of a short document",
      "service": "iam",
      "query": {
        "Action": "CreateSAMLProvider",
        "Version": "2010-05-08",
        "Name": "${prefix}-s",
        "SAMLMetadataDocument": "nope"
      }
    },
    {
      "name": "create of a bad name",
      "service": "iam",
      "query": {
        "Action": "CreateSAMLProvider",
        "Version": "2010-05-08",
        "Name": "bad name",
        "SAMLMetadataDocument": "<?xml version=\"1.0\"?><EntityDescriptor xmlns=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://idp.example.com/saml\"><IDPSSODescriptor protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:protocol\"><KeyDescriptor use=\"signing\"><KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><X509Data><X509Certificate></X509Certificate></X509Data></KeyInfo></KeyDescriptor><SingleSignOnService Binding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect\" Location=\"https://idp.example.com/sso\"/></IDPSSODescriptor></EntityDescriptor>"
      }
    },
    {
      "name": "get a missing provider",
      "service": "iam",
      "query": {
        "Action": "GetSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:saml-provider/${prefix}-none"
      }
    },
    {
      "name": "get of an ARN not one",
      "service": "iam",
      "query": {
        "Action": "GetSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:role/${prefix}-none"
      }
    },
    {
      "name": "delete a missing provider",
      "service": "iam",
      "query": {
        "Action": "DeleteSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:saml-provider/${prefix}-none"
      }
    },
    {
      "name": "create",
      "service": "iam",
      "query": {
        "Action": "CreateSAMLProvider",
        "Version": "2010-05-08",
        "Name": "${prefix}-s",
        "SAMLMetadataDocument": "<?xml version=\"1.0\"?><EntityDescriptor xmlns=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://idp.example.com/saml\"><IDPSSODescriptor protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:protocol\"><KeyDescriptor use=\"signing\"><KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><X509Data><X509Certificate></X509Certificate></X509Data></KeyInfo></KeyDescriptor><SingleSignOnService Binding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect\" Location=\"https://idp.example.com/sso\"/></IDPSSODescriptor></EntityDescriptor>",
        "Tags.member.1.Key": "k0",
        "Tags.member.1.Value": "v0"
      },
      "capture": {
        "arn": "SAMLProviderArn"
      }
    },
    {
      "name": "create it again",
      "service": "iam",
      "query": {
        "Action": "CreateSAMLProvider",
        "Version": "2010-05-08",
        "Name": "${prefix}-S",
        "SAMLMetadataDocument": "<?xml version=\"1.0\"?><EntityDescriptor xmlns=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://idp.example.com/saml\"><IDPSSODescriptor protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:protocol\"><KeyDescriptor use=\"signing\"><KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><X509Data><X509Certificate></X509Certificate></X509Data></KeyInfo></KeyDescriptor><SingleSignOnService Binding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect\" Location=\"https://idp.example.com/sso\"/></IDPSSODescriptor></EntityDescriptor>"
      }
    },
    {
      "name": "get",
      "service": "iam",
      "query": {
        "Action": "GetSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}"
      }
    },
    {
      "name": "update",
      "service": "iam",
      "query": {
        "Action": "UpdateSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}",
        "SAMLMetadataDocument": "<?xml version=\"1.0\"?><EntityDescriptor xmlns=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://idp.example.com/saml\"><IDPSSODescriptor protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:protocol\"><KeyDescriptor use=\"signing\"><KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><X509Data><X509Certificate></X509Certificate></X509Data></KeyInfo></KeyDescriptor><SingleSignOnService Binding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect\" Location=\"https://idp.example.com/sso\"/></IDPSSODescriptor></EntityDescriptor>"
      }
    },
    {
      "name": "update with a bad document",
      "service": "iam",
      "query": {
        "Action": "UpdateSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}",
        "SAMLMetadataDocument": "nope nope nope nope nope nope nope nope nope nope"
      }
    },
    {
      "name": "update a missing provider",
      "service": "iam",
      "query": {
        "Action": "UpdateSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:saml-provider/${prefix}-none",
        "SAMLMetadataDocument": "<?xml version=\"1.0\"?><EntityDescriptor xmlns=\"urn:oasis:names:tc:SAML:2.0:metadata\" entityID=\"https://idp.example.com/saml\"><IDPSSODescriptor protocolSupportEnumeration=\"urn:oasis:names:tc:SAML:2.0:protocol\"><KeyDescriptor use=\"signing\"><KeyInfo xmlns=\"http://www.w3.org/2000/09/xmldsig#\"><X509Data><X509Certificate></X509Certificate></X509Data></KeyInfo></KeyDescriptor><SingleSignOnService Binding=\"urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect\" Location=\"https://idp.example.com/sso\"/></IDPSSODescriptor></EntityDescriptor>"
      }
    },
    {
      "name": "tag",
      "service": "iam",
      "query": {
        "Action": "TagSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}",
        "Tags.member.1.Key": "k1",
        "Tags.member.1.Value": "v1",
        "Tags.member.2.Key": "K0",
        "Tags.member.2.Value": "v2"
      }
    },
    {
      "name": "list the tags",
      "service": "iam",
      "query": {
        "Action": "ListSAMLProviderTags",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}"
      }
    },
    {
      "name": "untag",
      "service": "iam",
      "query": {
        "Action": "UntagSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}",
        "TagKeys.member.1": "k1"
      }
    },
    {
      "name": "list the tags left",
      "service": "iam",
      "query": {
        "Action": "ListSAMLProviderTags",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}"
      }
    },
    {
      "name": "list a missing provider's tags",
      "service": "iam",
      "query": {
        "Action": "ListSAMLProviderTags",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:saml-provider/${prefix}-none"
      }
    },
    {
      "name": "delete",
      "service": "iam",
      "query": {
        "Action": "DeleteSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}"
      }
    },
    {
      "name": "get the deleted",
      "service": "iam",
      "query": {
        "Action": "GetSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "${arn}"
      }
    }
  ],
  "cleanup": [
    {
      "name": "clean up the provider",
      "service": "iam",
      "query": {
        "Action": "DeleteSAMLProvider",
        "Version": "2010-05-08",
        "SAMLProviderArn": "arn:aws:iam::${account}:saml-provider/${prefix}-s"
      }
    }
  ]
}
