import { Catalog } from "../services/iam/catalog"
import { stack } from "../stack"
import { replay } from "../tools/tape/tape"

test "CloudWatch Logs tapes replay" {
	// The tapes' users have no policies, AWS managed or not.
	for (const tape of ["tapes/logs/groups.json", "tapes/logs/events.json", "tapes/logs/filters.json",
		"tapes/logs/denials.json", "tapes/logs/insights.json"]) {
		test `${tape}` {
			const differences = replay(tape, stack(new Catalog(0, 0)))
			assert differences == []
		}
	}
}
