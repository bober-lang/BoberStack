{
	"volatile": [
		"creationTime",
		"firstEventTimestamp",
		"lastEventTimestamp",
		"lastIngestionTime",
		"uploadSequenceToken",
		"nextSequenceToken",
		"timestamp",
		"ingestionTime",
		"eventId",
		"nextForwardToken",
		"nextBackwardToken",
		"lastUpdatedTime",
		"revisionId",
		"UserId",
		"CreateDate",
		"RequestId"
	],
	"steps": [
		{
			"name": "create a group",
			"service": "logs",
			"target": "Logs_20140328.CreateLogGroup",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "a metric filter",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "errors",
				"filterPattern": "ERROR",
				"metricTransformations": [
					{
						"metricName": "errors",
						"metricNamespace": "${prefix}",
						"metricValue": "1"
					}
				]
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "another, of a value extracted",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "bytes",
				"filterPattern": "[ip, user, size]",
				"metricTransformations": [
					{
						"metricName": "bytes",
						"metricNamespace": "${prefix}",
						"metricValue": "$size",
						"unit": "Bytes",
						"dimensions": {
							"user": "$user"
						}
					}
				]
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "dimensions and a default value",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "bad",
				"filterPattern": "",
				"metricTransformations": [
					{
						"metricName": "bytes",
						"metricNamespace": "${prefix}",
						"metricValue": "1",
						"defaultValue": 0,
						"dimensions": {
							"user": "$user"
						}
					}
				]
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"__type": "InvalidParameterException",
					"message": "Invalid metric transformation: dimensions and default value are mutually exclusive properties"
				}
			}
		},
		{
			"name": "replace the first",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "errors",
				"filterPattern": "?ERROR ?FATAL",
				"metricTransformations": [
					{
						"metricName": "errors",
						"metricNamespace": "${prefix}",
						"metricValue": "1"
					}
				]
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "a pattern not valid",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "bad",
				"filterPattern": "{ $.a = ",
				"metricTransformations": [
					{
						"metricName": "errors",
						"metricNamespace": "${prefix}",
						"metricValue": "1"
					}
				]
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"__type": "InvalidParameterException",
					"message": "If a filter pattern starts with '{' it must end with '}'"
				}
			}
		},
		{
			"name": "in a group not there",
			"service": "logs",
			"target": "Logs_20140328.PutMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g9",
				"filterName": "x",
				"filterPattern": "",
				"metricTransformations": [
					{
						"metricName": "errors",
						"metricNamespace": "${prefix}",
						"metricValue": "1"
					}
				]
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"__type": "ResourceNotFoundException",
					"message": "The specified log group does not exist."
				}
			}
		},
		{
			"name": "describe the group's",
			"service": "logs",
			"target": "Logs_20140328.DescribeMetricFilters",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"metricFilters": [
						{
							"applyOnTransformedLogs": false,
							"creationTime": "x",
							"filterName": "bytes",
							"filterPattern": "[ip, user, size]",
							"logGroupName": "/boberstack-ab-00000000/g",
							"metricTransformations": [
								{
									"dimensions": {
										"user": "$user"
									},
									"metricName": "bytes",
									"metricNamespace": "boberstack-ab-00000000",
									"metricValue": "$size",
									"unit": "Bytes"
								}
							]
						},
						{
							"applyOnTransformedLogs": false,
							"creationTime": "x",
							"filterName": "errors",
							"filterPattern": "?ERROR ?FATAL",
							"logGroupName": "/boberstack-ab-00000000/g",
							"metricTransformations": [
								{
									"metricName": "errors",
									"metricNamespace": "boberstack-ab-00000000",
									"metricValue": "1"
								}
							]
						}
					]
				}
			}
		},
		{
			"name": "by prefix",
			"service": "logs",
			"target": "Logs_20140328.DescribeMetricFilters",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterNamePrefix": "err"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"metricFilters": [
						{
							"applyOnTransformedLogs": false,
							"creationTime": "x",
							"filterName": "errors",
							"filterPattern": "?ERROR ?FATAL",
							"logGroupName": "/boberstack-ab-00000000/g",
							"metricTransformations": [
								{
									"metricName": "errors",
									"metricNamespace": "boberstack-ab-00000000",
									"metricValue": "1"
								}
							]
						}
					]
				}
			}
		},
		{
			"name": "by metric",
			"service": "logs",
			"target": "Logs_20140328.DescribeMetricFilters",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"metricName": "bytes",
				"metricNamespace": "${prefix}"
