			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"logGroups": [
						{
							"arn": "arn:aws:logs:us-east-1:000000000000:log-group:/boberstack-ab-00000000/g:*",
							"bearerTokenAuthenticationEnabled": false,
							"creationTime": "x",
							"deletionProtectionEnabled": false,
							"logGroupArn": "arn:aws:logs:us-east-1:000000000000:log-group:/boberstack-ab-00000000/g",
							"logGroupClass": "STANDARD",
							"logGroupName": "/boberstack-ab-00000000/g",
							"metricFilterCount": 2,
							"storedBytes": 0
						}
					]
				}
			}
		},
		{
			"name": "delete one",
			"service": "logs",
			"target": "Logs_20140328.DeleteMetricFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "bytes"
