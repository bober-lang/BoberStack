					"metricFilters": [
						{
							"applyOnTransformedLogs": false,
							"creationTime": "x",
							"filterName": "bytes",
							"filterPattern": "[ip, user, size]",
							"logGroupName": "/boberstack-ab-00000000/g",
							"metricTransformations": [
								{
									"dimensions": {
										"user": "$user"
									},
									"metricName": "bytes",
									"metricNamespace": "boberstack-ab-00000000",
									"metricValue": "$size",
									"unit": "Bytes"
								}
							]
						}
					]
				}
			}
		},
		{
			"name": "by metric name alone",
			"service": "logs",
			"target": "Logs_20140328.DescribeMetricFilters",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"metricName": "bytes"
			},
			"response": {
				"status": 400,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"__type": "InvalidParameterException",
					"message": "Describe Metric Filters request must contain both MetricName and MetricNamespace"
				}
			}
		},
		{
			"name": "the group's count",
			"service": "logs",
			"target": "Logs_20140328.DescribeLogGroups",
			"contentType": "application/x-amz-json-1.1",
			"json": {
