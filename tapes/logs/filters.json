		{
			"name": "an account's resource policy",
			"service": "logs",
			"target": "Logs_20140328.PutResourcePolicy",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"policyName": "${prefix}",
				"policyDocument": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"Service\":\"route53.amazonaws.com\"},\"Action\":\"logs:PutLogEvents\",\"Resource\":\"arn:aws:logs:us-east-1:${account}:log-group:/${prefix}/*\"}]}"
