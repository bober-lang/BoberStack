				}
			}
		},
		{
			"name": "a subscription to a function not there",
			"service": "logs",
			"target": "Logs_20140328.PutSubscriptionFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "s",
				"filterPattern": "",
				"destinationArn": "arn:aws:lambda:us-east-1:${account}:function:${prefix}"
			},
			"differs": "BoberStack cannot try a destination: it stores the filter",
			"response": {
				"status": 400,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"__type": "InvalidParameterException",
					"message": "Could not execute the lambda function. Make sure you have given CloudWatch Logs permission to execute your function."
				}
			}
		},
		{
			"name": "a subscription of a pattern not valid",
			"service": "logs",
			"target": "Logs_20140328.PutSubscriptionFilter",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/g",
				"filterName": "s",
				"filterPattern": "[a",
				"destinationArn": "arn:aws:lambda:us-east-1:${account}:function:${prefix}"
