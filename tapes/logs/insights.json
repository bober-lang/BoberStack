{
	"region": "eu-north-1",
	"volatile": [
		"RequestId",
		"bytesScanned",
		"queryId",
		"creationTime",
		"nextSequenceToken"
	],
	"steps": [
		{
			"name": "create the group",
			"service": "logs",
			"target": "Logs_20140328.CreateLogGroup",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "a stream",
			"service": "logs",
			"target": "Logs_20140328.CreateLogStream",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights",
				"logStreamName": "s"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				}
			}
		},
		{
			"name": "a dozen events",
			"service": "logs",
			"target": "Logs_20140328.PutLogEvents",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights",
				"logStreamName": "s",
				"logEvents": [
					{
						"timestamp": "${now-12000}",
						"message": "GET /a 200 10"
					},
					{
						"timestamp": "${now-11000}",
						"message": "GET /a 200 11"
					},
					{
						"timestamp": "${now-10000}",
						"message": "GET /a 200 12"
					},
					{
						"timestamp": "${now-9000}",
						"message": "GET /a 200 13"
					},
					{
						"timestamp": "${now-8000}",
						"message": "GET /a 200 14"
					},
					{
						"timestamp": "${now-7000}",
						"message": "GET /a 200 15"
					},
					{
						"timestamp": "${now-6000}",
						"message": "GET /a 200 16"
					},
					{
						"timestamp": "${now-5000}",
						"message": "GET /a 200 17"
					},
					{
						"timestamp": "${now-4000}",
						"message": "POST /b 500 40"
					},
					{
						"timestamp": "${now-3000}",
						"message": "POST /b 500 60"
					},
					{
						"timestamp": "${now-2000}",
						"message": "{\"level\":\"error\",\"req\":{\"ms\":7}}"
					},
					{
						"timestamp": "${now-1000}",
						"message": "{\"level\":\"info\",\"req\":{\"ms\":3}}"
					}
				]
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"nextSequenceToken": "x"
				}
			}
		},
		{
			"name": "the group's fields, once queryable",
			"service": "logs",
			"target": "Logs_20140328.GetLogGroupFields",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights"
			},
			"unordered": [
				"logGroupFields"
			],
			"untilBody": "\"req.ms\"",
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"logGroupFields": []
				}
			},
			"differs": "AWS lists a new log group's fields only minutes after its events can be queried"
		},
		{
			"name": "start: parse and stats by a field",
			"service": "logs",
			"target": "Logs_20140328.StartQuery",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights",
				"startTime": 1400000000,
				"endTime": 4000000000,
				"queryString": "parse @message \"* * * *\" as verb, path, status, ms | filter ispresent(verb) | stats count(*) as n, sum(ms) as total, avg(ms), max(ms) by status | sort n desc"
			},
			"capture": {
				"q1": "queryId"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "application/x-amz-json-1.1"
				},
				"json": {
					"queryId": "${q1}"
				}
			}
		},
