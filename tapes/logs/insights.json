								"field": "total",
								"value": "108"
							},
							{
								"field": "avg(ms)",
								"value": "13.5"
							},
							{
								"field": "max(ms)",
								"value": "17"
							}
						],
						[
							{
								"field": "status",
								"value": "500"
							},
							{
								"field": "n",
								"value": "2"
							},
							{
								"field": "total",
								"value": "100"
							},
							{
								"field": "avg(ms)",
								"value": "50"
							},
							{
								"field": "max(ms)",
								"value": "60"
							}
						]
					],
					"statistics": {
						"bytesScanned": "x.x",
						"estimatedBytesSkipped": 0.0,
						"estimatedRecordsSkipped": 0.0,
						"logGroupsScanned": 1.0,
						"recordsMatched": 12.0,
						"recordsScanned": 12.0,
						"resultCount": 2.0
					},
					"status": "Complete"
				}
			}
		},
		{
			"name": "start: JSON fields and functions",
			"service": "logs",
			"target": "Logs_20140328.StartQuery",
			"contentType": "application/x-amz-json-1.1",
			"json": {
				"logGroupName": "/${prefix}/insights",
				"startTime": 1400000000,
				"endTime": 4000000000,
				"queryString": "filter level = 'error' or level = 'info' | fields level, req.ms * 2 as d, toupper(level), strlen(level) | sort d desc"
			},
