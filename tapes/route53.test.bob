import { Catalog } from "../services/iam/catalog"
import { stack } from "../stack"
import { replay } from "../tools/tape/tape"

test "Route 53 tapes replay" {
	for (const name of ["zones", "records", "denied", "health", "answers", "sets", "cidr"]) {
		test `tapes/route53/${name}.json` {
			const differences = replay(`tapes/route53/${name}.json`, stack(new Catalog(0, 0)))
			assert differences == []
		}
	}
}
