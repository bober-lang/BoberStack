{
	"volatile": [
		"RequestId",
		"CreateDate",
		"UserId",
		"AccessKeyId",
		"SecretAccessKey"
	],
	"steps": [
		{
			"name": "create a user of no policies",
			"service": "iam",
			"query": {
				"Action": "CreateUser",
				"Version": "2010-05-08",
				"UserName": "${prefix}-denied"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<CreateUserResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <CreateUserResult>\n    <User>\n      <Path>/</Path>\n      <UserName>boberstack-ab-00000000-denied</UserName>\n      <Arn>arn:aws:iam::000000000000:user/boberstack-ab-00000000-denied</Arn>\n      <UserId>x</UserId>\n      <CreateDate>x-x-x:x:x</CreateDate>\n    </User>\n  </CreateUserResult>\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</CreateUserResponse>\n"
			}
		},
		{
			"name": "a key of it",
			"service": "iam",
			"query": {
				"Action": "CreateAccessKey",
				"Version": "2010-05-08",
				"UserName": "${prefix}-denied"
			},
			"capture": {
				"denied.key": "AccessKey/AccessKeyId",
				"denied.secret": "AccessKey/SecretAccessKey"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<CreateAccessKeyResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <CreateAccessKeyResult>\n    <AccessKey>\n      <AccessKeyId>${denied.key}</AccessKeyId>\n      <SecretAccessKey>${denied.secret}</SecretAccessKey>\n      <UserName>boberstack-ab-00000000-denied</UserName>\n      <Status>Active</Status>\n      <CreateDate>x-x-x:x:x</CreateDate>\n    </AccessKey>\n  </CreateAccessKeyResult>\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</CreateAccessKeyResponse>\n"
			}
		},
		{
			"name": "the user, once its key works",
			"service": "sts",
			"query": {
				"Action": "GetCallerIdentity",
				"Version": "2011-06-15"
			},
			"as": "denied",
			"until": 200,
			"response": {
				"status": 200,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<GetCallerIdentityResponse xmlns=\"https://sts.amazonaws.com/doc/2011-06-15/\">\n  <GetCallerIdentityResult>\n    <Arn>arn:aws:iam::000000000000:user/boberstack-ab-00000000-denied</Arn>\n    <UserId>x</UserId>\n    <Account>000000000000</Account>\n  </GetCallerIdentityResult>\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</GetCallerIdentityResponse>\n"
			}
		},
		{
			"name": "it lists hosted zones",
			"service": "route53",
			"method": "GET",
			"path": "/2013-04-01/hostedzone",
			"as": "denied",
			"until": 403,
			"response": {
				"status": 403,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<?xml version=\"1.0\"?>\n<ErrorResponse xmlns=\"https://route53.amazonaws.com/doc/2013-04-01/\"><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>User: arn:aws:iam::000000000000:user/boberstack-ab-00000000-denied is not authorized to perform: route53:ListHostedZones because no identity-based policy allows the route53:ListHostedZones action</Message></Error><RequestId>x-x-x-x-x</RequestId></ErrorResponse>"
			}
		},
		{
			"name": "it gets a hosted zone",
			"service": "route53",
			"method": "GET",
			"path": "/2013-04-01/hostedzone/ZNOPE123",
			"as": "denied",
			"response": {
				"status": 403,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<?xml version=\"1.0\"?>\n<ErrorResponse xmlns=\"https://route53.amazonaws.com/doc/2013-04-01/\"><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>User: arn:aws:iam::000000000000:user/boberstack-ab-00000000-denied is not authorized to perform: route53:GetHostedZone on resource: arn:aws:route53:::hostedzone/ZNOPE123 because no identity-based policy allows the route53:GetHostedZone action</Message></Error><RequestId>x-x-x-x-x</RequestId></ErrorResponse>"
			}
		}
	],
	"cleanup": [
		{
			"name": "clean up the key",
			"service": "iam",
			"query": {
				"Action": "DeleteAccessKey",
				"Version": "2010-05-08",
				"UserName": "${prefix}-denied",
				"AccessKeyId": "${denied.key}"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<DeleteAccessKeyResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</DeleteAccessKeyResponse>\n"
			}
		},
		{
			"name": "clean up the user",
			"service": "iam",
			"query": {
				"Action": "DeleteUser",
				"Version": "2010-05-08",
				"UserName": "${prefix}-denied"
			},
			"response": {
				"status": 200,
				"headers": {
					"content-type": "text/xml"
				},
				"body": "<DeleteUserResponse xmlns=\"https://iam.amazonaws.com/doc/2010-05-08/\">\n  <ResponseMetadata>\n    <RequestId>x-x-x-x-x</RequestId>\n  </ResponseMetadata>\n</DeleteUserResponse>\n"
			}
		}
	]
}
