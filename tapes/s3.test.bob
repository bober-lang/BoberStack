import { Catalog } from "../services/iam/catalog"
import { stack } from "../stack"
import { replay } from "../tools/tape/tape"

test "S3 tapes replay" {
	for (const name of ["buckets", "objects", "reads", "listing", "copy", "multipart", "versioning", "conditions",
		"retention"]) {
		test `tapes/s3/${name}.json` {
			const differences = replay(`tapes/s3/${name}.json`, stack(new Catalog(0, 0)))
			assert differences == []
		}
	}
}
