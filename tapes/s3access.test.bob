import { Catalog } from "../services/iam/catalog"
import { stack } from "../stack"
import { replay } from "../tools/tape/tape"

test "S3's access and configuration tapes replay" {
	// The tapes' users and roles have only the inline policies they are given.
	for (const tape of ["tapes/s3/access.json", "tapes/s3/configuration.json", "tapes/s3/refusals.json",
		"tapes/s3/more.json", "tapes/s3/lock.json"]) {
		test `${tape}` {
			const differences = replay(tape, stack(new Catalog(0, 0)))
			assert differences == []
		}
	}
}
