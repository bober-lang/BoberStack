//! Generates the API of an awsQuery or awsJson service from its Smithy model, in the JSON AST: a class for each
//! structure its operations take or give, a type for each enum, for each union a class U$M of one field M for each
//! member M and their union U, a function making each error's Fault, an interface of the operations' handlers, a class
//! Unimplemented answering each NotImplemented, for a service to mix in, and a function handle serving the service's
//! requests by a handler with the codec of ../../core/protocol/query or json. It fails on what that cannot express.
//! Given a list of the model's protocol test vectors to skip, it generates a test of each of the others beside the API,
//! as OUT.test.bob: of a request by a class Got noting the input, of a response by a class, named by the vector's id,
//! answering as the vector does.
//!
//! Usage: smithygen MODEL OUT [SKIPS], as `bober run tools/smithygen/main.bob -- models/sts.json services/sts/api.bob`,
//! or `-- models/awsquery-tests.json protocoltests/query/api.bob protocoltests/query/skips.txt`.

import { indexOf, lastIndexOf, sortBy, startsWith, unique } from "std/algo"
import * as json from "std/encoding/json"
import { min, round } from "std/math"
import { lower, ParseError, replace, split } from "std/string"

class Model {
	shapes: [string, Shape][] @json.Mapping = []
	rest: json.Unknown[] @json.Rest = []
}

class Shape {
	type = ""
	version = ""
	members: [string, Ref][] @json.Mapping = []
	member: Ref | null
	key: Ref | null
	value: Ref | null
	input: Ref | null
	output: Ref | null
	operations: Ref[] = []
	resources: Ref[] = []
	errors: Ref[] = []
	traits = new Traits()
	rest: json.Unknown[] @json.Rest = []
}

class Ref {
	target = ""
	traits = new Traits()
}

/// The traits this reads; the others it ignores.
class Traits {
	required: Mark | null @json.Name["smithy.api#required"]
	xmlName: string | null @json.Name["smithy.api#xmlName"]
	xmlFlattened: Mark | null @json.Name["smithy.api#xmlFlattened"]
	xmlAttribute: Mark | null @json.Name["smithy.api#xmlAttribute"]
	xmlNamespace: Namespace | null @json.Name["smithy.api#xmlNamespace"]
	timestampFormat: string | null @json.Name["smithy.api#timestampFormat"]
	enumValue: string | i32 | null @json.Name["smithy.api#enumValue"]
	enum: EnumValue[] | null @json.Name["smithy.api#enum"]
	streaming: Mark | null @json.Name["smithy.api#streaming"]
	sparse: Mark | null @json.Name["smithy.api#sparse"]
	error: string | null @json.Name["smithy.api#error"]
	httpError: i32 | null @json.Name["smithy.api#httpError"]
	queryError: QueryError | null @json.Name["aws.protocols#awsQueryError"]
	awsQuery: Mark | null @json.Name["aws.protocols#awsQuery"]
	awsJson10: Mark | null @json.Name["aws.protocols#awsJson1_0"]
	awsJson11: Mark | null @json.Name["aws.protocols#awsJson1_1"]
	queryCompatible: Mark | null @json.Name["aws.protocols#awsQueryCompatible"]
	sigv4: Sigv4 | null @json.Name["aws.auth#sigv4"]
	service: Service | null @json.Name["aws.api#service"]
	requestTests: Vector[] @json.Name["smithy.test#httpRequestTests"] = []
	responseTests: Vector[] @json.Name["smithy.test#httpResponseTests"] = []
	rest: json.Unknown[] @json.Rest = []
}

/// A protocol test vector: a request and what it holds, or a response and what makes it.
class Vector {
	id = ""
	protocol = ""
	appliesTo = ""
	method = ""
	uri = ""
	headers: [string, string][] @json.Mapping = []
	body: string | null
	params = new json.Keys()
	code: i32 = 0
	rest: json.Unknown[] @json.Rest = []
}

class Mark {}

class Namespace {
	uri = ""
	rest: json.Unknown[] @json.Rest = []
}

class EnumValue {
	value = ""
	rest: json.Unknown[] @json.Rest = []
}

class QueryError {
	code = ""
	httpResponseCode: i32 = 0
}

class Sigv4 {
	name = ""
	rest: json.Unknown[] @json.Rest = []
}

class Service {
	sdkId = ""
	rest: json.Unknown[] @json.Rest = []
}

/// What makes a model one this cannot generate from.
export class ModelError {
	what: string

	constructor(what: string) { this.what = what }
}

/// A declaration's lines, of a kind: import, const, type, interface, class, function, test, spread, field or method.
class Decl {
	kind: string
	lines: string[]

	constructor(kind: string, lines: string[]) {
		this.kind = kind
		this.lines = lines
	}
}

const width = 120

class Generator {
	model: Model
	/// The structures, unions and enums the operations reach.
	structures: string[] = []
	enums: string[] = []

	/// The names declared, the imported ones too, to fail on a second of one.
	taken = ["query", "json", "Caller", "Fault", "notImplemented", "Unit", "Request", "Response", "signingName",
		"version", "ns", "service", "Unimplemented", "handle"]

	/// The service's protocol, awsQuery, awsJson1_0 or awsJson1_1, once api has begun; and its shape id, operations and
	/// version, once api has run.
	protocol = ""
	id = ""
	ops: string[] = []
	version = ""

	constructor(model: Model) { this.model = model }

	api(from: string, out: string): string throws ModelError {
		const services = this.model.shapes.filter(s => s[1].type == "service")
		if (services.length != 1) {
			throw new ModelError(`${services.length} services, not one`)
		}
		const s = services[0][1]
		const t = s.traits
		this.protocol = if (t.awsQuery != null) "awsQuery"
			else if (t.awsJson10 != null) "awsJson1_0"
			else if (t.awsJson11 != null) "awsJson1_1"
			else ""
		const query = this.protocol == "awsQuery"
		if (this.protocol == "" || query && t.xmlNamespace == null || t.sigv4 == null || s.resources.length > 0) {
			const why = "not an awsQuery service of an XML namespace or an awsJson one, of sigv4, or has resources"
			throw new ModelError(`${services[0][0]}: ${why}`)
		}
		const ops = s.operations.map(r => r.target)
		sortNames(ops)
		const errors = s.errors.map(r => r.target)
		const signatures: Decl[] = []
		const unimplemented: Decl[] = []
		const cases: string[] = []
		let unit = false
		for (const id of ops) {
			const op = this.shape(id)
			errors.push(...op.errors.map(r => r.target))
			const input = this.structure(op.input)
			const output = this.structure(op.output)
			if (input == "Unit" || output == "Unit") {
				unit = true
			}
			const head = `\t${lowerCamel(name(id))}(caller: Caller, input: ${input}): ${output} throws Fault`
			signatures.push(new Decl("method", signature(head)))
			unimplemented.push(new Decl("method", method(head, [`\t\tthrow notImplemented(${json.quoted(name(id))})`])))
			cases.push(`\t\tcase ${json.quoted(name(id))}: return c.serve(h.${lowerCamel(name(id))})`)
		}
		sortNames(errors)
		sortNames(this.structures)
		sortNames(this.enums)
		const decls = imports(out, query, unit)
		decls.push(new Decl("const", [`export const signingName = ${json.quoted(t.sigv4!.name)}`]))
		if (query) {
			decls.push(new Decl("const", [`export const version = ${json.quoted(s.version)}`]))
			decls.push(new Decl("const", [`export const ns = ${json.quoted(t.xmlNamespace!.uri)}`]))
		} else {
			const shapes = unique(errors).map(id => `new json.ErrorShape(${this.errorShape(id)})`)
			const version = json.quoted(if (this.protocol == "awsJson1_0") "1.0" else "1.1")
			const head = `export const service = new json.Service(${json.quoted(services[0][0])}, ${version}`
			decls.push(new Decl("const", wrap(`${head}, ${t.queryCompatible != null}, [${shapes.join(", ")}])`)))
		}
		for (const id of this.enums) {
			decls.push(new Decl("type", fill(`export type ${this.declare(name(id))} = `, this.values(id))))
		}
		for (const id of this.structures) {
			decls.push(...this.classOf(id))
		}
		for (const id of unique(errors)) {
			decls.push(new Decl("function", this.maker(id)))
		}
		const handlers = this.declare(replace(t.service?.sdkId ?? name(services[0][0]), " ", ""))
		this.id = services[0][0]
		this.version = s.version
		this.ops = ops
		decls.push(new Decl("interface", [`export interface ${handlers} {`, ...layout(signatures), "}"]))
		const doc = "/// Every operation, not implemented: a service mixes it in and declares those it implements."
		decls.push(new Decl("class", [doc, "export class Unimplemented {", ...layout(unimplemented), "}"]))
		decls.push(new Decl("function", handle(handlers, cases, query)))
		return [`// Code generated by tools/smithygen from ${from}. DO NOT EDIT.`, ...layout(decls)].join("\n") + "\n"
	}

	/// n, declared at the top level.
	declare(n: string): string throws ModelError {
		if (this.taken.includes(n)) {
			throw new ModelError(`${n} names two declarations`)
		}
		this.taken.push(n)
		return n
	}

	/// The shape id, of the model or Smithy's prelude.
	shape(id: string): Shape throws ModelError {
		for (const s of this.model.shapes) {
			if (s[0] == id) {
				return s[1]
			}
		}
		if (!startsWith(id, "smithy.api#")) {
			throw new ModelError(`${id}: no such shape`)
		}
		const s = new Shape()
		s.type = lower(replace(name(id), "Primitive", ""))
		return s
	}

	/// The class of an operation's input or output r, Unit if none, each structure it reaches to be generated.
	structure(r: Ref | null): string throws ModelError {
		if (r == null || r.target == "smithy.api#Unit") {
			return "Unit"
		}
		const s = this.shape(r.target)
		if (s.type != "structure") {
			throw new ModelError(`${r.target}: an operation's input or output that is a ${s.type}`)
		}
		this.reach(r.target)
		return name(r.target)
	}

	/// Notes the structures, unions and enums that the shape id is or holds, to be generated.
	reach(id: string): void throws ModelError {
		const s = this.shape(id)
		if (enumerates(s)) {
			if (!this.enums.includes(id)) {
				this.enums.push(id)
			}
		} else if ((s.type == "structure" || s.type == "union") && !this.structures.includes(id)) {
			this.structures.push(id)
			for (const m of s.members) {
				this.reach(m[1].target)
			}
		}
		for (const r of [s.member, s.key, s.value]) {
			if (r != null) {
				this.reach(r.target)
			}
		}
	}

	/// The literals of the enum id.
	values(id: string): string[] throws ModelError {
		const s = this.shape(id)
		const values: string[] = []
		for (const m of s.members) {
			const v = m[1].traits.enumValue
			values.push(json.quoted(if (v == null) m[0] else `${v}`))
		}
		for (const v of s.traits.enum ?? []) {
			values.push(json.quoted(v.value))
		}
		return values
	}

	/// The class of the structure id, a field for each member, null where it is not required; or the classes of the
	/// union id's members and their union.
	classOf(id: string): Decl[] throws ModelError {
		const s = this.shape(id)
		const decls: Decl[] = []
		if (s.type == "union") {
			const variants: string[] = []
			for (const m of s.members) {
				const v = this.declare(`${name(id)}$${m[0]}`)
				variants.push(v)
				decls.push(new Decl("class", [`export class ${v} {`, this.field(id, m, true), "}"]))
			}
			decls.push(new Decl("type", fill(`export type ${this.declare(name(id))} = `, variants)))
			return decls
		}
		const n = this.declare(name(id))
		if (s.members.length == 0) {
			return [new Decl("class", [`export class ${n} {}`])]
		}
		const lines = [`export class ${n} {`]
		for (const m of s.members) {
			lines.push(this.field(id, m, m[1].traits.required != null))
		}
		lines.push("}")
		return [new Decl("class", lines)]
	}

	/// The field of the member m of the shape id, null unless required.
	field(id: string, m: [string, Ref], required: bool): string throws ModelError {
		const t = m[1].traits
		const query = this.protocol == "awsQuery"
		if (query && t.xmlAttribute != null) {
			throw new ModelError(`${id}$${m[0]}: an XML attribute`)
		}
		const tags: string[] = []
		if (query && t.xmlName != null) {
			tags.push(`@query.Name[${json.quoted(t.xmlName!)}]`)
		}
		if (query && t.xmlFlattened != null) {
			tags.push("@query.Flat")
		}
		const ty = this.typeOf(m[1], tags, false)
		const tagged = tags.map(x => ` ${x}`).join("")
		const field = if (required) `\t${m[0]}: ${ty}${tagged}${this.initial(m[1].target, ty)}`
			else `\t${m[0]}: ${ty} | null${tagged}`
		if (wide(field)) {
			throw new ModelError(`${id}$${m[0]}: a field wider than a line`) // bober format would wrap it
		}
		return field
	}

	/// The initializer of a required field of the shape id, of type ty: none where ty has a zero value.
	initial(id: string, ty: string): string throws ModelError {
		const s = this.shape(id)
		if (enumerates(s)) {
			return ` = ${this.values(id)[0]}`
		}
		switch (s.type) {
			case "list", "map": return " = []"
			case "structure": return ` = new ${ty}()`
			case "union": return ` = new ${ty}$${s.members[0][0]}()`
			default: return ""
		}
	}

	/// The type of a member, or item, r, with the tags into tags that its target takes; within a list or map if inner.
	typeOf(r: Ref, tags: string[], inner: bool): string throws ModelError {
		const s = this.shape(r.target)
		if (enumerates(s)) {
			return name(r.target)
		}
		const query = this.protocol == "awsQuery"
		if (!query && ["timestamp", "document", "list", "map"].includes(s.type)) {
			return this.jsonType(r, s, tags)
		}
		switch (s.type) {
			case "string": return "string"
			case "boolean": return "bool"
			case "byte": return "i8"
			case "short": return "i16"
			case "integer", "intEnum": return "i32"
			case "long": return "i64"
			case "float": return "f32"
			case "double": return "f64"
			case "timestamp":
				const format = r.traits.timestampFormat ?? s.traits.timestampFormat ?? "date-time"
				tags.push(if (format == "date-time") "@query.Timestamp" else `@query.Timestamp[${json.quoted(format)}]`)
				return "i64"
			case "blob":
				if (s.traits.streaming != null) {
					throw new ModelError(`${r.target}: a stream`)
				}
				tags.push(if (query) "@query.Blob" else "@json.Blob")
				return "string"
			case "list":
				const m = s.member!
				if (s.traits.sparse != null || inner && m.traits.xmlName != null) {
					throw new ModelError(`${r.target}: a sparse list, or one within a list or map whose items are named`)
				}
				if (m.traits.xmlName != null) {
					tags.push(`@query.Member[${json.quoted(m.traits.xmlName!)}]`)
				}
				return `${this.typeOf(m, tags, true)}[]`
			case "map":
				const k = s.key!
				const v = s.value!
				if (s.traits.sparse != null || inner && (k.traits.xmlName != null || v.traits.xmlName != null)) {
					throw new ModelError(`${r.target}: a sparse map, or one within a list or map whose keys or values are named`)
				}
				if (k.traits.xmlName != null) {
					tags.push(`@query.Key[${json.quoted(k.traits.xmlName!)}]`)
				}
				if (v.traits.xmlName != null) {
					tags.push(`@query.Value[${json.quoted(v.traits.xmlName!)}]`)
				}
				return `[${this.typeOf(k, tags, true)}, ${this.typeOf(v, tags, true)}][]`
			case "structure", "union": return name(r.target)
			default: throw new ModelError(`${r.target}: a ${s.type}`)
		}
	}

	/// The type of a member, or item, r of an awsJson service, of the timestamp, document, list or map s, with the tags
	/// into tags that it takes.
	jsonType(r: Ref, s: Shape, tags: string[]): string throws ModelError {
		switch (s.type) {
			case "timestamp":
				const format = r.traits.timestampFormat ?? s.traits.timestampFormat ?? "epoch-seconds"
				tags.push(if (format == "epoch-seconds") "@json.Timestamp"
					else `@json.Timestamp[${json.quoted(format)}]`)
				return "i64"
			case "document":
				tags.push("@json.Document")
				return "string"
			case "list":
				const item = this.typeOf(s.member!, tags, true)
				return if (s.traits.sparse != null) `(${item} | null)[]` else `${item}[]`
			default:
				// a map
				const k = this.typeOf(s.key!, tags, true)
				const v = this.typeOf(s.value!, tags, true)
				return `[${k}, ${v}${if (s.traits.sparse != null) " | null" else ""}][]`
		}
	}

	/// The arguments making the ErrorShape of the error id: its id, the member that holds its message and its code
	/// under awsQuery.
	errorShape(id: string): string throws ModelError {
		const message = this.shape(id).members.find(m => lower(m[0]) == "message")
		const code = this.shape(id).traits.queryError?.code ?? ""
		return `${json.quoted(id)}, ${json.quoted(if (message == null) "" else message[0])}, ${json.quoted(code)}`
	}

	/// The function making the Fault of the error id, as the protocol answers it, of a message if it has one.
	maker(id: string): string[] throws ModelError {
		const t = this.shape(id).traits
		if (t.error == null) {
			throw new ModelError(`${id}: an error without the error trait`)
		}
		const client = t.error == "client"
		const query = this.protocol == "awsQuery"
		const status = (if (query) t.queryError?.httpResponseCode else t.httpError) ?? (if (client) 400 else 500)
		const code = (if (query) t.queryError?.code else null) ?? name(id)
		const message = query || this.shape(id).members.some(m => lower(m[0]) == "message")
		const param = if (message) "message: string" else ""
		const sender = if (client == (status < 500)) "" else `, ${client}`
		const head = `export function ${this.declare(lowerCamel(name(id)))}(${param}): Fault {`
		const body = `return new Fault(${status}, ${json.quoted(code)}, ${if (message) "message" else "\"\""}${sender})`
		const line = `${head} ${body} }` // as bober format puts a body of one statement where it fits
		return if (wide(line)) [head, `\t${body}`, "}"] else [line]
	}

	/// The tests of the vectors of the operations and their errors, of the API in the file out, after api has run;
	/// those that skips, of a line "id: reason" or "id request: reason" or "id response: reason" each, gives a reason
	/// for, and those for clients only, listed instead.
	/// And how many there are.
	suite(from: string, out: string, skips: string): [string, string] throws ModelError | ParseError {
		const reasons = split(skips, "\n").filter(l => l != "").map(l => split(l, ": "))
		const tests: Decl[] = []
		const skipped: string[] = []
		const ids: string[] = []
		const names: string[] = []
		const errors: string[] = []
		const got: Decl[] = [] // the methods of Got
		const spread = new Decl("spread", ["\t...api.Unimplemented"])
		const classes = ["Got", "Caller", "Fault", "Unit", "Request", "caller", "same", "sameJson", "api"]
		for (const op of this.ops) {
			let requested = false
			const vectors: [Vector, string | null][] = [] // a response's error, "" if none; null for a request
			for (const v of this.shape(op).traits.requestTests) {
				vectors.push([v, null])
			}
			for (const v of this.shape(op).traits.responseTests) {
				vectors.push([v, ""])
			}
			for (const e of this.shape(op).errors.filter(e => !errors.includes(e.target))) {
				errors.push(e.target)
				for (const v of this.shape(e.target).traits.responseTests) {
					vectors.push([v, e.target])
				}
			}
			for (const [v, error] of vectors) {
				ids.push(v.id)
				const test = `${v.id} ${if (error == null) "request" else "response"}` // an id can name one of each
				names.push(test)
				const reason = reasons.find(r => r[0] == v.id || r[0] == test)
				if (v.protocol != `aws.protocols#${this.protocol}`) {
					throw new ModelError(`${v.id}: a vector of ${v.protocol}`)
				} else if (v.appliesTo == "client" || reason != null) {
					const why = if (reason == null) "for clients only" else reason.slice(1, reason.length).join(": ")
					skipped.push(`// ${test}: ${why}`)
				} else if (error == null) {
					if (!requested) {
						const output = this.className(this.shape(op).output)
						const body = ["\t\tthis.input = `${input}`", `\t\treturn new ${output}()`]
						got.push(new Decl("method", method(this.head(op), body)))
						requested = true
					}
					tests.push(new Decl("test", [`test ${json.quoted(test)} {`, ...this.request(op, v), "}"]))
				} else {
					// its own handler, a class named by its id
					if (classes.includes(v.id)) {
						throw new ModelError(`${v.id}: names two declarations`)
					}
					classes.push(v.id)
					const handler = [`class ${v.id} {`, ...layout([spread, this.answer(op, v, error)]), "}"]
					tests.push(new Decl("class", handler))
					tests.push(new Decl("test", [`test ${json.quoted(test)} {`, ...this.response(op, v), "}"]))
				}
			}
		}
		for (const r of reasons.filter(r => !ids.includes(r[0]) && !names.includes(r[0]))) {
			throw new ModelError(`${r[0]}: skipped, but no such vector`)
		}
		const count = tests.filter(d => d.kind == "test").length
		const tally = `${ids.length} vectors: ${count} tests, ${skipped.length} skipped`
		const up = root(out)
		const decls = [new Decl("import", [`import { Fault } from "${up}core/fault"`])]
		decls.push(new Decl("import", [`import { Caller, Unit } from "${up}core/service"`]))
		const same = if (this.protocol == "awsQuery") "same" else "sameJson"
		decls.push(new Decl("import", [`import { caller, ${same} } from "${up}tools/smithygen/vectors"`]))
		decls.push(new Decl("import", [`import * as api from "./${replace(split(out, "/").pop()!, ".bob", "")}"`]))
		decls.push(new Decl("import", [`import { Request } from "std/http"`]))
		if (got.length > 0) {
			const members = layout([spread, new Decl("field", ["\tinput = \"\""]), ...got])
			const doc = "/// The input of the operation it served last, as text."
			decls.push(new Decl("class", [doc, "class Got {", ...members, "}"]))
		}
		const head = [`// Code generated by tools/smithygen from ${from}. DO NOT EDIT.`, `// ${tally}:`, ...skipped]
		return [[...head, ...layout([...decls, ...tests])].join("\n") + "\n", tally]
	}

	/// The signature of the method of a test's handler for operation op.
	head(op: string): string throws ModelError {
		const o = this.shape(op)
		const input = this.className(o.input)
		return `\t${lowerCamel(name(op))}(c: Caller, input: ${input}): ${this.className(o.output)} throws Fault`
	}

	/// The test that the request of vector v, of operation op, decodes to its params.
	request(op: string, v: Vector): string[] throws ModelError | ParseError {
		const o = this.shape(op)
		const input = this.className(o.input)
		if (v.body == null) {
			throw new ModelError(`${v.id}: a request without a body`)
		}
		const lines = ["\tconst h = new Got()"]
		const req = `new Request(${json.quoted(v.method)}, ${json.quoted(v.uri)}, ${json.quoted(v.body!)})`
		lines.append(wrap(`\tconst req = ${req}`))
		for (const h of v.headers) {
			lines.push(`\treq.headers.set(${json.quoted(h[0])}, ${json.quoted(h[1])})`)
		}
		if (this.protocol != "awsQuery" && !v.headers.some(h => lower(h[0]) == "x-amz-target")) {
			lines.push(this.target(op))
		}
		lines.append([`\tapi.handle(h, caller(""), req)`, `\tconst want = new ${input}()`])
		lines.append(this.assignments("\twant", o.input, v.params))
		lines.push("\tassert h.input == `${want}`")
		return lines
	}

	/// The method of the handler of vector v of operation op: making the params of v, or throwing the error of them if
	/// error is not "".
	answer(op: string, v: Vector, error: string): Decl throws ModelError | ParseError {
		const o = this.shape(op)
		const output = this.className(o.output)
		const body: string[] = []
		if (error != "") {
			const message = this.shape(error).members.find(m => lower(m[0]) == "message")
			const given = v.params.all.find(p => message != null && p[0] == message[0])
			if (v.params.all.length > (if (given == null) 0 else 1) || this.protocol == "awsQuery" && given == null) {
				throw new ModelError(`${v.id}: an error of members besides a Message`)
			}
			const text = if (message == null) "" else if (given == null) "\"\"" else this.literal(message[1], given[1])
			body.append(wrap(`\t\tthrow api.${lowerCamel(name(error))}(${text})`))
		} else if (v.params.all.length == 0) {
			body.push(`\t\treturn new ${output}()`)
		} else {
			body.push(`\t\tconst out = new ${output}()`)
			body.append(this.assignments("\t\tout", o.output, v.params))
			body.push("\t\treturn out")
		}
		return new Decl("method", method(this.head(op), body))
	}

	/// The test that operation op, by the handler of vector v, answers as v does.
	response(op: string, v: Vector): string[] throws ModelError {
		const lines: string[] = []
		const body = v.body ?? ""
		const query = this.protocol == "awsQuery"
		if (query) {
			const id = if (has(body, "<RequestId>")) split(split(body, "<RequestId>")[1], "</RequestId>")[0] else ""
			const req = `new Request("POST", "/", ${json.quoted(`Action=${name(op)}&Version=${this.version}`)})`
			lines.append(wrap(`\tconst res = api.handle(new ${v.id}(), caller(${json.quoted(id)}), ${req})`))
		} else {
			const header = v.headers.find(h => lower(h[0]) == "x-amzn-requestid")
			const id = if (header == null) "" else header[1]
			lines.append([`\tconst req = new Request("POST", "/", "{}")`, this.target(op)])
			lines.append(wrap(`\tconst res = api.handle(new ${v.id}(), caller(${json.quoted(id)}), req)`))
		}
		lines.push(`\tassert res.status == ${v.code}`)
		for (const h of v.headers) {
			lines.push(`\tassert res.headers.get(${json.quoted(h[0])}) == ${json.quoted(h[1])}`)
		}
		if (v.body != null) {
			const verbatim = !has(body, "`") && !has(body, "${") && !has(body, "\\")
			if (query && !verbatim) {
				throw new ModelError(`${v.id}: a body that a template literal cannot hold as it is`)
			}
			const want = (if (verbatim) `\`${body}\`` else json.quoted(body)) + ")"
			const same = if (query) "same" else "sameJson"
			const line = `\tassert ${same}(res, ${want}`
			// as bober format breaks it, a body of several lines measured as if of one
			lines.append(if (wide(line)) [`\tassert ${same}(res,`, `\t\t${want}`] else [line])
		}
		return lines
	}

	/// The statement setting the X-Amz-Target of req to name the operation op.
	target(op: string): string {
		return `\treq.headers.set("X-Amz-Target", ${json.quoted(`${name(this.id)}.${name(op)}`)})`
	}

	/// The class of an operation's input or output r, as a test names it.
	className(r: Ref | null): string throws ModelError {
		const c = this.structure(r)
		return if (c == "Unit") c else `api.${c}`
	}

	/// The statements setting the members of x, of the structure r, to the values that params gives them.
	assignments(x: string, r: Ref | null, params: json.Keys): string[] throws ModelError | ParseError {
		const lines: string[] = []
		for (const p of params.all) {
			lines.append(wrap(`${x}.${p[0]} = ${this.literal(this.member(r!.target, p[0]), p[1])}`))
		}
		return lines
	}

	/// The member m of the structure id.
	member(id: string, m: string): Ref throws ModelError {
		const found = this.shape(id).members.find(x => x[0] == m)
		if (found == null) {
			throw new ModelError(`${id}: no member ${m}`)
		}
		return found[1]
	}

	/// The value, of the member or item r, that a vector's params give as the JSON v: a document as its JSON.
	literal(r: Ref, v: string): string throws ModelError | ParseError {
		const s = this.shape(r.target)
		if (v == "null") {
			return "null"
		}
		switch (if (enumerates(s)) "string" else s.type) {
			case "string", "blob": return json.quoted(json.decode[string](v))
			case "boolean", "byte", "short", "integer", "long", "intEnum": return v
			case "float", "double":
				switch (v) {
					case "\"NaN\"": return "0.0 / 0.0"
					case "\"Infinity\"": return "1.0 / 0.0"
					case "\"-Infinity\"": return "-1.0 / 0.0"
				}
				return if (has(v, ".")) v else `${v}.0`
			case "timestamp":
				// ns from epoch seconds
				return `${(round(json.decode[f64](v) * 1000.0) as i64) * 1000000}`
			case "list":
				const items: string[] = []
				for (const x of json.decode[Item[]](v)) {
					items.push(this.literal(s.member!, encode(x)))
				}
				return `[${items.join(", ")}]`
			case "map":
				const entries: string[] = []
				for (const e of json.decode[json.Keys](v).all) {
					entries.push(`[${json.quoted(e[0])}, ${this.literal(s.value!, e[1])}]`)
				}
				return `[${entries.join(", ")}]`
			case "structure":
				const members: string[] = []
				for (const p of json.decode[json.Keys](v).all) {
					members.push(`, ${p[0]}: ${this.literal(this.member(r.target, p[0]), p[1])}`)
				}
				return `{ ...new api.${name(r.target)}()${members.join("")} }`
			case "union":
				const m = json.decode[json.Keys](v).all[0]
				const variant = `${name(r.target)}$${m[0]}`
				return `{ ...new api.${variant}(), ${m[0]}: ${this.literal(this.member(r.target, m[0]), m[1])} }`
			case "document": return json.quoted(v)
			default: throw new ModelError(`${r.target}: a ${s.type} in a vector`)
		}
	}
}

/// An item of a list in a vector's params, a list of items of no lists if one.
type Item = string | f64 | bool | json.Keys | null | (string | f64 | bool | json.Keys | null)[]

/// The JSON of x, which it can hold.
function encode(x: Item): string {
	try {
		return json.encode(x)
	} catch (e: json.EncodeError) {
		return "" // a float of JSON is finite
	}
}

/// The API of the service that the Smithy JSON AST model, read from the file from, describes, as the file out.
export function generate(model: string, from: string, out: string): string throws ModelError {
	try {
		return new Generator(json.decode[Model](model)).api(from, out)
	} catch (e: ParseError) {
		throw new ModelError(`${from}: ${e}`)
	}
}

/// The tests of the vectors of the model, read from the file from, of the API that generate makes as the file out,
/// but for those that skips, of a line "id: reason" each, gives a reason for; and how many there are.
export function vectors(model: string, from: string, out: string, skips: string): [string, string] throws ModelError {
	try {
		const g = new Generator(json.decode[Model](model))
		g.api(from, out)
		return g.suite(from, out, skips)
	} catch (e: ParseError) {
		throw new ModelError(`${from}: ${e}`)
	}
}

/// The path from the file out up to the root.
function root(out: string): string {
	let up = ""
	for (let i = 1; i < split(out, "/").length; i++) {
		up += "../"
	}
	return up
}

/// The imports of the file out, of the awsQuery codec if query, else of the awsJson one, and of Unit if unit.
function imports(out: string, query: bool, unit: bool): Decl[] {
	const up = root(out)
	const decls: Decl[] = []
	const codec = if (query) "query" else "json"
	decls.push(new Decl("import", [`import * as ${codec} from "${up}core/protocol/${codec}"`]))
	decls.push(new Decl("import", [`import { Fault } from "${up}core/fault"`]))
	const names = if (unit) "Caller, notImplemented, Unit" else "Caller, notImplemented"
	decls.push(new Decl("import", [`import { ${names} } from "${up}core/service"`]))
	decls.push(new Decl("import", [`import { Request, Response } from "std/http"`]))
	return decls
}

/// The function serving a request by a handler of the interface handlers, by the cases of its operations, of awsQuery
/// if query, else of awsJson.
function handle(handlers: string, cases: string[], query: bool): string[] {
	const lines = ["/// The answer of h to req."]
	const head = `export function handle(h: ${handlers}, caller: Caller, req: Request)`
	lines.append(signature(`${head}: Response throws IoError {`))
	if (query) {
		lines.append(["\tconst c = query.call(caller, req, version, ns)", "\tswitch (c.action) {", ...cases])
		lines.push("\t\tdefault: return c.invalidAction()")
	} else {
		lines.append(["\tconst c = json.call(caller, req, service)", "\tswitch (c.operation) {", ...cases])
		lines.push("\t\tdefault: return c.unknownOperation()")
	}
	lines.append(["\t}", "}"])
	return lines
}

/// The method of the signature head and the statements body, on one line where it fits and body is one line.
function method(head: string, body: string[]): string[] {
	const line = `${head} { ${body[0].slice(tabs(body[0]), body[0].length)} }`
	return if (body.length == 1 && !wide(line)) [line] else [...signature(`${head} {`), ...body, "\t}"]
}

/// The signature line, its parameters wrapped as bober format wraps them: one that does not fit on the line goes on a
/// line of its own, a tab in, unless it would not fit there either and does not overflow where it is.
function signature(line: string): string[] {
	const open = indexOf(line, "(")
	const close = lastIndexOf(line, ")")
	const params = split(line.slice(open + 1, close), ", ")
	const tail = line.slice(close, line.length)
	const indent = line.slice(0, tabs(line)) + "\t"
	const lines = [line.slice(0, open + 1) + params[0]]
	for (let i = 1; i < params.length; i++) {
		lines[lines.length - 1] += ","
		const last = lines[lines.length - 1]
		const w = params[i].length + (if (i < params.length - 1) 1 else 0) // with its comma
		const after = if (i == params.length - 1) tail.length else 0
		const col = last.length + 3 * tabs(last)
		if (col + 1 + w + after > width && (col + 1 + w > width || 4 * indent.length + w + after <= width)) {
			lines.push(indent + params[i])
		} else {
			lines[lines.length - 1] = `${last} ${params[i]}`
		}
	}
	lines[lines.length - 1] += tail
	return lines
}

/// The decls' lines, a blank line between two of different kinds or of more than a line, as bober format puts them.
function layout(decls: Decl[]): string[] {
	const lines: string[] = []
	for (let i = 0; i < decls.length; i++) {
		const d = decls[i]
		if (i > 0) {
			const prev = decls[i - 1]
			if (prev.kind != d.kind || prev.lines.length > 1 || d.lines.length > 1) {
				lines.push("")
			}
		}
		lines.push(...d.lines)
	}
	return lines
}

/// head followed by the union of values, wrapped as bober format wraps it.
function fill(head: string, values: string[]): string[] {
	const lines = [head + values[0]]
	for (const v of values.slice(1, values.length)) {
		const last = lines[lines.length - 1]
		if (wide(`${last} | ${v}`)) {
			lines.push(`\t| ${v}`)
		} else {
			lines[lines.length - 1] = `${last} | ${v}`
		}
	}
	return lines
}

/// line, wrapped as bober format wraps one too wide, the lines after the first indented a tab more.
function wrap(line: string): string[] {
	const lines = [""]
	put(lines, line, line.slice(0, tabs(line)) + "\t")
	return lines
}

/// Puts s on lines: on the last where it fits, else on a line of its own at indent, else each of its pieces so, from
/// a line of their own.
function put(lines: string[], s: string, indent: string): void {
	const last = lines[lines.length - 1]
	const blank = tabs(last) == last.length
	const cut = pieces(s)
	if (!wide(last + s) || blank && cut.length == 1) {
		lines[lines.length - 1] = last + s
	} else if (!blank) {
		lines.push(indent)
		put(lines, s.slice(1, s.length), indent)
	} else {
		for (const p of cut) {
			put(lines, p, indent)
		}
	}
}

/// s cut after each of its commas, not in a string or at its end, that the fewest brackets enclose.
function pieces(s: string): string[] {
	const commas: [i32, i32][] = [] // where, and in how many brackets
	let depth = 0
	let quoted = false
	for (let i = 0; i < s.length; i++) {
		const c = s.slice(i, i + 1)
		if (c == "\\") {
			i++
		} else if (c == "\"") {
			quoted = !quoted
		} else if (!quoted) {
			depth += if (c == "(" || c == "[" || c == "{") 1 else if (c == ")" || c == "]" || c == "}") -1 else 0
			if (c == "," && i < s.length - 1) {
				commas.push([i, depth])
			}
		}
	}
	let least = s.length
	for (const c of commas) {
		least = min(least, c[1])
	}
	const out: string[] = []
	let at = 0
	for (const c of commas.filter(c => c[1] == least)) {
		out.push(s.slice(at, c[0] + 1))
		at = c[0] + 1
	}
	out.push(s.slice(at, s.length))
	return out
}

/// Whether line is wider than bober format allows, a tab as 4 columns.
function wide(line: string): bool { return line.length + 3 * tabs(line) > width }

/// How many tabs line starts with.
function tabs(line: string): i32 {
	let n = 0
	while (n < line.length && line.slice(n, n + 1) == "\t") {
		n++
	}
	return n
}

/// Whether s has sub in it.
function has(s: string, sub: string): bool { return indexOf(s, sub) >= 0 }
/// Whether s is an enum, or a string of Smithy 1's enum trait.
function enumerates(s: Shape): bool { return s.type == "enum" || s.traits.enum != null }
/// Sorts the shape ids by their names.
function sortNames(ids: string[]) { sortBy(ids, (a, b) => name(a) < name(b)) }
/// The name of the shape id, without its namespace.
function name(id: string): string { return split(id, "#")[1] }

/// s with its leading capitals lowered, but for the last of several that starts a word: IDPError as idpError.
function lowerCamel(s: string): string {
	let n = 0
	while (n < s.length && s.slice(n, n + 1) != lower(s.slice(n, n + 1))) {
		n++
	}
	if (n > 1 && n < s.length) {
		n--
	}
	return lower(s.slice(0, n)) + s.slice(n, s.length)
}

function main(): i32 {
	const a = args()
	if (a.length != 2 && a.length != 3) {
		print("usage: smithygen MODEL OUT [SKIPS]")
		return 2
	}
	const model = readFile(a[0])
	const skips = if (a.length == 3) readFile(a[2]) else ""
	if (model == null || skips == null) {
		print(`smithygen: cannot read ${a.filter(f => f != a[1]).join(" or ")}`)
		return 1
	}
	try {
		const tests = replace(a[1], ".bob", ".test.bob")
		const suite = if (a.length == 3) vectors(model, a[0], a[1], skips) else null
		if (!writeFile(a[1], generate(model, a[0], a[1])) || suite != null && !writeFile(tests, suite[0])) {
			print(`smithygen: cannot write ${a[1]} or ${tests}`)
			return 1
		}
		if (suite != null) {
			print(suite[1])
		}
	} catch (e: ModelError) {
		print(`smithygen: ${e.what}`)
		return 1
	}
	return 0
}
