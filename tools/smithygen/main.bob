//! Generates the API of an awsQuery or awsJson service from its Smithy model, in the JSON AST: a class for each
//! structure its operations take or give, a type for each enum, for each union a class U$M of one field M for each
//! member M and their union U, a function making each error's Fault, an interface of the operations' handlers, a class
//! Unimplemented answering each NotImplemented, for a service to mix in, and a function handle serving the service's
//! requests by a handler with the codec of ../../core/protocol/query or json. It fails on what that cannot express.
//! Given a list of the model's protocol test vectors to skip, it generates a test of each of the others beside the API,
//! as OUT.test.bob: of a request by a class Got noting the input, of a response by a class, named by the vector's id,
//! answering as the vector does.
//!
//! Usage: smithygen MODEL OUT [SKIPS], as `bober run tools/smithygen/main.bob -- models/sts.json services/sts/api.bob`,
//! or `-- models/awsquery-tests.json protocoltests/query/api.bob protocoltests/query/skips.txt`.

import { indexOf, lastIndexOf, sortBy, startsWith, unique } from "std/algo"
import * as base64 from "std/encoding/base64"
import * as json from "std/encoding/json"
import { min, round } from "std/math"
import { compile } from "std/regex"
import { lower, ParseError, replace, split } from "std/string"

class Model {
	shapes: [string, Shape][] @json.Mapping = []
	rest: json.Unknown[] @json.Rest = []
}

class Shape {
	type = ""
	version = ""
	members: [string, Ref][] @json.Mapping = []
	member: Ref | null
	key: Ref | null
	value: Ref | null
	input: Ref | null
	output: Ref | null
	operations: Ref[] = []
	resources: Ref[] = []
	errors: Ref[] = []
	traits = new Traits()
	rest: json.Unknown[] @json.Rest = []
}

class Ref {
	target = ""
	traits = new Traits()
}

/// The traits this reads; the others it ignores.
class Traits {
	required: Mark | null @json.Name["smithy.api#required"]
	xmlName: string | null @json.Name["smithy.api#xmlName"]
	xmlFlattened: Mark | null @json.Name["smithy.api#xmlFlattened"]
	xmlAttribute: Mark | null @json.Name["smithy.api#xmlAttribute"]
	xmlNamespace: Namespace | null @json.Name["smithy.api#xmlNamespace"]
	timestampFormat: string | null @json.Name["smithy.api#timestampFormat"]
	enumValue: string | i32 | null @json.Name["smithy.api#enumValue"]
	enum: EnumValue[] | null @json.Name["smithy.api#enum"]
	length: Bounds | null @json.Name["smithy.api#length"]
	range: Bounds | null @json.Name["smithy.api#range"]
	pattern: string | null @json.Name["smithy.api#pattern"]
	sensitive: Mark | null @json.Name["smithy.api#sensitive"]
	streaming: Mark | null @json.Name["smithy.api#streaming"]
	sparse: Mark | null @json.Name["smithy.api#sparse"]
	unwrapped: Mark | null @json.Name["aws.customizations#s3UnwrappedXmlOutput"]
	error: string | null @json.Name["smithy.api#error"]
	httpError: i32 | null @json.Name["smithy.api#httpError"]
	queryError: QueryError | null @json.Name["aws.protocols#awsQueryError"]
	awsQuery: Mark | null @json.Name["aws.protocols#awsQuery"]
	awsJson10: Mark | null @json.Name["aws.protocols#awsJson1_0"]
	awsJson11: Mark | null @json.Name["aws.protocols#awsJson1_1"]
	queryCompatible: Mark | null @json.Name["aws.protocols#awsQueryCompatible"]
	restXml: RestXml | null @json.Name["aws.protocols#restXml"]
	http: Http | null @json.Name["smithy.api#http"]
	httpLabel: Mark | null @json.Name["smithy.api#httpLabel"]
	httpQuery: string | null @json.Name["smithy.api#httpQuery"]
	httpQueryParams: Mark | null @json.Name["smithy.api#httpQueryParams"]
	httpHeader: string | null @json.Name["smithy.api#httpHeader"]
	httpPrefixHeaders: string | null @json.Name["smithy.api#httpPrefixHeaders"]
	httpPayload: Mark | null @json.Name["smithy.api#httpPayload"]
	httpResponseCode: Mark | null @json.Name["smithy.api#httpResponseCode"]
	sigv4: Sigv4 | null @json.Name["aws.auth#sigv4"]
	service: Service | null @json.Name["aws.api#service"]
	requestTests: Vector[] @json.Name["smithy.test#httpRequestTests"] = []
	responseTests: Vector[] @json.Name["smithy.test#httpResponseTests"] = []
	rest: json.Unknown[] @json.Rest = []
}

/// A protocol test vector: a request and what it holds, or a response and what makes it.
class Vector {
	id = ""
	protocol = ""
	appliesTo = ""
	method = ""
	uri = ""
	queryParams: string[] = []
	headers: [string, string][] @json.Mapping = []
	body: string | null
	params = new json.Keys()
	code: i32 = 0
	rest: json.Unknown[] @json.Rest = []
}

class Mark {}

class Namespace {
	uri = ""
	prefix = ""
	rest: json.Unknown[] @json.Rest = []
}

class RestXml {
	noErrorWrapping = false
	rest: json.Unknown[] @json.Rest = []
}

class Http {
	method = ""
	uri = ""
	code: i32 = 200
}

class EnumValue {
	value = ""
	rest: json.Unknown[] @json.Rest = []
}

class Bounds {
	min: f64 | null
	max: f64 | null
}

class QueryError {
	code = ""
	httpResponseCode: i32 = 0
}

class Sigv4 {
	name = ""
	rest: json.Unknown[] @json.Rest = []
}

class Service {
	sdkId = ""
	rest: json.Unknown[] @json.Rest = []
}

/// A service's authorization reference, of the operations' actions.
class Reference {
	Operations: Operation[] = []
	rest: json.Unknown[] @json.Rest = []
}

class Operation {
	Name = ""
	AuthorizedActions: Action[] = []
	rest: json.Unknown[] @json.Rest = []
}

class Action {
	Name = ""
	Service = ""
	rest: json.Unknown[] @json.Rest = []
}

/// What makes a model one this cannot generate from.
export class ModelError {
	what: string

	constructor(what: string) { this.what = what }
}

/// A declaration's lines, of a kind: import, const, type, interface, class, function, test, spread, field or method.
class Decl {
	kind: string
	lines: string[]

	constructor(kind: string, lines: string[]) {
		this.kind = kind
		this.lines = lines
	}
}

const width = 120

/// How the services below answer a request breaking their models' constraints, as AWS did on 2026-11-23: by their
/// shape ids, the code of the fault, whether its messages quote the values, and whether a pattern is checked as the
/// others are; if not, a member of a pattern is left to the service's handlers, as are all of a service not listed.
const validations: [string, string, bool, bool][] = [["com.amazonaws.iam#AWSIdentityManagementV20100508",
	"ValidationError", false, false],
	["com.amazonaws.sts#AWSSecurityTokenServiceV20110615", "ValidationError", true, true],
	["com.amazonaws.eventbridge#AWSEvents", "ValidationException", true, true],
	["com.amazonaws.cloudwatchlogs#Logs_20140328", "InvalidParameterException", false, true],
	["com.amazonaws.kms#TrentService", "ValidationException", true, true]]

/// How the services below answer a request IAM denies, as AWS did on 2026-11-23: by their shape ids, the status and
/// code of the fault, and its wording, of core/service's Wording; any other by AccessDenied, of 403, reasoned.
const denials: [string, i32, string, string][] = [["com.amazonaws.iam#AWSIdentityManagementV20100508", 403,
	"AccessDenied", "linked"], ["com.amazonaws.sts#AWSSecurityTokenServiceV20110615", 403, "AccessDenied", "plain"],
	["com.amazonaws.sqs#AmazonSQS", 403, "AccessDenied", "linked"],
	["com.amazonaws.dynamodb#DynamoDB_20120810", 400, "AccessDeniedException", "reasoned"],
	["com.amazonaws.sns#AmazonSimpleNotificationService", 403, "AuthorizationError", "reasoned"],
	["com.amazonaws.eventbridge#AWSEvents", 400, "AccessDeniedException", "reasoned"],
	["com.amazonaws.secretsmanager#secretsmanager", 400, "AccessDeniedException", "reasoned"],
	["com.amazonaws.ssm#AmazonSSM", 400, "AccessDeniedException", "reasoned"],
	["com.amazonaws.cloudwatchlogs#Logs_20140328", 400, "AccessDeniedException", "reasoned"],
	["com.amazonaws.kms#TrentService", 400, "AccessDeniedException", "linked"]]

/// The members of the services below whose enums are strings, by their shape ids: AWS answers a name outside the enum
/// with an error of the service's own.
const strings: [string,
	string[]][] = [["com.amazonaws.sqs#AmazonSQS", ["com.amazonaws.sqs#ReceiveMessageRequest$AttributeNames"]]]

/// The services whose enums are all strings: AWS takes a value outside an enum, or answers it with an error of its own.
const opened = ["com.amazonaws.s3#AmazonS3"]

/// The statuses that operations of the services below answer with where their models say otherwise, as AWS did on
/// 2026-11-23: by their shape ids, each operation's name and status.
const statuses: [string,
	[string, i32][]][] = [["com.amazonaws.s3#AmazonS3", [["PutBucketPolicy", 204], ["PutBucketTagging", 204]]]]

/// The restXml services that write a date-time to the millisecond, .000 too, as S3 does.
const milliseconds = ["com.amazonaws.s3#AmazonS3"]

/// The flattened lists that the services below write as one, in the order that a field `order` of their structure
/// gives: by their shape ids, each structure's and the names of the two lists' items.
const interleaved: [string, [string, string, string][]][] = [["com.amazonaws.s3#AmazonS3",
	[["com.amazonaws.s3#ListObjectVersionsOutput", "Version", "DeleteMarker"]]]]

/// The codes the services below answer with besides the errors their models declare, as AWS did on 2026-11-23: by
/// their shape ids, each code and its __type.
const undeclared: [string, [string, string][]][] = [["com.amazonaws.sqs#AmazonSQS",
	[["InvalidParameterValue", "com.amazon.coral.service#InvalidParameterValueException"]]]]

/// The unions the services below word on their own where none of a union's members is set or more than one, as AWS
/// did on 2026-11-23: by their shape ids, each union's and its two messages.
const unions: [string, [string, string, string][]][] = [["com.amazonaws.dynamodb#DynamoDB_20120810",
	[["com.amazonaws.dynamodb#AttributeValue",
	"Supplied AttributeValue is empty, must contain exactly one of the supported datatypes",
	"Supplied AttributeValue has more than one datatypes set, must contain exactly one of the supported datatypes"]]]]

/// What the services below answer that their models lack, as AWS did on 2026-11-23: by their shape ids, shapes of
/// Smithy's JSON AST, whose members are added to the model's shape of an id, or which are added to it if it has none.
const amendments: [string, string][] = [["com.amazonaws.cloudwatchlogs#Logs_20140328",
	`{"shapes": {
	"com.amazonaws.cloudwatchlogs#OutputLogEvent": {"type": "structure", "members": {
		"eventId": {"target": "com.amazonaws.cloudwatchlogs#EventId"}}},
	"com.amazonaws.cloudwatchlogs#FilterLogEventsResponse": {"type": "structure", "members": {
		"searchStatistics": {"target": "com.amazonaws.cloudwatchlogs#SearchStatistics"}}},
	"com.amazonaws.cloudwatchlogs#SearchStatistics": {"type": "structure", "members": {
		"approximateTotalLogStreamCount": {"target": "smithy.api#Integer", "traits": {"smithy.api#required": {}}},
		"completedLogStreamCount": {"target": "smithy.api#Integer", "traits": {"smithy.api#required": {}}}}}}}`],
	["com.amazonaws.iam#AWSIdentityManagementV20100508",
	`{"shapes": {
	"com.amazonaws.iam#PermissionsBoundaryAttachmentType": {"type": "enum", "members": {
		"Answered": {"target": "smithy.api#Unit", "traits": {"smithy.api#enumValue": "Policy"}}}}}}`]]

/// The members of the services below whose models' constraints AWS does not check, by their shape ids: their
/// handlers answer as AWS does.
const unconstrained: [string, string[]][] = [["com.amazonaws.cloudwatchlogs#Logs_20140328",
	["com.amazonaws.cloudwatchlogs#ListLogGroupsRequest$logGroupNamePattern",
	"com.amazonaws.cloudwatchlogs#TagResourceRequest$resourceArn"]]]

/// The member holding the message of an access denied of the services below, where AWS names it otherwise than their
/// models, as on 2026-11-23: by their shape ids.
const deniedMessages: [string, string][] = [["com.amazonaws.cloudwatchlogs#Logs_20140328", "Message"]]

class Generator {
	model: Model
	/// The structures, unions and enums the operations reach.
	structures: string[] = []
	enums: string[] = []
	/// The outputs of the operations whose output is unwrapped, as S3's GetBucketLocation's.
	unwrapped: string[] = []
	/// How the service answers a request breaking its model's constraints, null if they are not checked.
	validation: [string, string, bool, bool] | null = null
	/// The aliases of the constraints of shapes, by their ids; whether a tag of core/protocol/model is used; and the
	/// patterns std/regex cannot run, by their shapes' ids, which go unchecked.
	aliases: [string, string][] = []
	modeled = false
	unchecked: string[] = []
	/// The members whose constraints go unchecked.
	unconstrained: string[] = []
	/// The members whose enums are strings, or whether all are, and whether the member being typed is one.
	strings: string[] = []
	opened = false
	open = false
	/// The flattened lists written as one, by their structures' ids.
	interleaved: [string, string, string][] = []
	/// Whether the member being typed is a restXml payload, which may be a stream; and the operations the API cannot
	/// express.
	payload = false
	unexpressible: string[] = []

	/// The names declared, the imported ones too, to fail on a second of one.
	taken = ["query", "json", "model", "Caller", "Fault", "notImplemented", "Unit", "Request", "Response",
		"signingName", "version", "ns", "service", "validation", "Unimplemented", "handle", "restxml", "routes"]

	/// The service's protocol, awsQuery, awsJson1_0 or awsJson1_1, once api has begun; and its shape id, operations and
	/// version, once api has run.
	protocol = ""
	id = ""
	ops: string[] = []
	version = ""

	constructor(model: Model) { this.model = model }

	api(from: string, out: string): string throws ModelError {
		const services = this.model.shapes.filter(s => s[1].type == "service")
		if (services.length != 1) {
			throw new ModelError(`${services.length} services, not one`)
		}
		const s = services[0][1]
		const t = s.traits
		this.protocol = if (t.awsQuery != null) "awsQuery"
			else if (t.awsJson10 != null) "awsJson1_0"
			else if (t.awsJson11 != null) "awsJson1_1"
			else if (t.restXml != null) "restXml"
			else ""
		const query = this.protocol == "awsQuery"
		const rest = this.protocol == "restXml"
		if (this.protocol == "" || query && t.xmlNamespace == null || t.sigv4 == null || s.resources.length > 0) {
			const why = "not an awsQuery service of an XML namespace, an awsJson or restXml one, of sigv4, or has resources"
			throw new ModelError(`${services[0][0]}: ${why}`)
		}
		this.amend(services[0][0])
		this.validation = validations.find(v => v[0] == services[0][0])
		const exempt = unconstrained.find(u => u[0] == services[0][0])
		this.unconstrained = if (exempt == null) [] else exempt[1]
		const open = strings.find(s => s[0] == services[0][0])
		this.strings = if (open == null) [] else open[1]
		this.opened = opened.includes(services[0][0])
		const merged = interleaved.find(i => i[0] == services[0][0])
		this.interleaved = if (merged == null) [] else merged[1]
		const fixed = statuses.find(c => c[0] == services[0][0])
		const answered = if (fixed == null) [] else fixed[1]
		const ops = s.operations.map(r => r.target)
		sortNames(ops)
		const errors = s.errors.map(r => r.target)
		const signatures: Decl[] = []
		const unimplemented: Decl[] = []
		const cases: string[] = []
		const actions = this.actions(from, t.sigv4!.name)
		let unit = false
		const routes: [i32, string][] = [] // by how specific
		const unserved: string[] = []
		for (const id of ops) {
			const op = this.shape(id)
			if (rest) {
				routes.push(this.route(id))
				const why = this.unexpressed(id)
				if (why != "") {
					this.unexpressible.push(id)
					unserved.push(`// ${name(id)}: ${why}`)
					cases.append(wrap(`\t\tcase ${json.quoted(name(id))}: return c.fail(notImplemented(${json.quoted(name(id))}))`))
					continue
				}
			}
			errors.push(...op.errors.map(r => r.target))
			const input = this.structure(op.input)
			const output = this.structure(op.output)
			if (op.traits.unwrapped != null && op.output != null) {
				this.unwrapped.push(op.output!.target)
			}
			if (input == "Unit" || output == "Unit") {
				unit = true
			}
			const head = `\t${lowerCamel(name(id))}(caller: Caller, input: ${input}): ${output} throws Fault`
			signatures.push(new Decl("method", signature(head)))
			unimplemented.push(new Decl("method", method(head, [`\t\tthrow notImplemented(${json.quoted(name(id))})`])))
			const authorized = actions.find(a => a[0] == name(id))
			let by = if (authorized == null) "" else `, [${authorized[1].map(a => json.quoted(a)).join(", ")}]`
			const given = answered.find(c => c[0] == name(id))
			const code = if (given != null) given[1] else op.traits.http?.code ?? 200
			if (rest && code != 200) {
				by = `${if (by == "") ", []" else by}, ${code}`
			}
			cases.append(wrap(`\t\tcase ${json.quoted(name(id))}: return c.serve(h.${lowerCamel(name(id))}${by})`))
		}
		sortNames(errors)
		for (const id of unique(errors)) {
			for (const m of this.shape(id).members.filter(m => lower(m[0]) != "message")) {
				this.reach(m[1].target)
			}
		}
		sortNames(this.structures)
		sortNames(this.enums)
		const body: Decl[] = []
		for (const id of this.enums) {
			body.push(new Decl("type", fill(`export type ${this.declare(enumName(id))} = `, this.values(id))))
		}
		const classes: Decl[] = []
		for (const id of this.structures) {
			classes.push(...this.classOf(id))
		}
		for (const id of unique(errors)) {
			classes.append(this.maker(id))
		}
		sortBy(this.aliases, (a, b) => a[0] < b[0])
		body.append(this.aliases.map(a => new Decl("type", wrap(a[1]))))
		body.append(classes)
		const v = this.validation
		const worded = unions.find(u => u[0] == services[0][0])
		const validated = v != null || worded != null
		const codec = this.codec()
		const head: Decl[] = imports(out, codec, unit, this.modeled || validated)
		const unchecked = if (this.unchecked.length == 0) []
			else ["// Patterns that std/regex cannot run, so unchecked:", ...this.unchecked.map(u => `// ${u}`)]
		if (unserved.length > 0) {
			unchecked.append(["// Operations this cannot express, so not implemented:", ...unserved])
		}
		head.push(new Decl("const", [...unchecked, `export const signingName = ${json.quoted(t.sigv4!.name)}`]))
		if (validated) {
			const args = [json.quoted(if (v != null) v[1] else if (query) "ValidationError" else "ValidationException")]
			if (v != null && !v[2] || worded != null) {
				args.push(`${v == null || v[2]}`)
			}
			if (worded != null) {
				const listed = worded[1].map(u => `[${[name(u[0]), u[1], u[2]].map(x => json.quoted(x)).join(", ")}]`)
				args.push(`[${listed.join(", ")}]`)
			}
			head.push(new Decl("const", wrap(`export const validation = new model.Validation(${args.join(", ")})`)))
		}
		const denial = denials.find(d => d[0] == services[0][0])
		if (query) {
			head.push(new Decl("const", [`export const version = ${json.quoted(s.version)}`]))
			head.push(new Decl("const", [`export const ns = ${json.quoted(t.xmlNamespace!.uri)}`]))
		} else if (rest) {
			const ns = json.quoted(t.xmlNamespace?.uri ?? "")
			const start = `export const service = new restxml.Service(${json.quoted(services[0][0])}, ${ns}`
			const ms = milliseconds.includes(services[0][0])
			const end = if (validated) `, ${ms}, validation` else if (ms) ", true" else ""
			head.push(new Decl("const", wrap(`${start}, ${!t.restXml!.noErrorWrapping}${end})`)))
			sortBy(routes, (a, b) => a[0] > b[0] || a[0] == b[0] && a[1] < b[1])
			const doc = "/// The operations' routes, the most specific first."
			head.push(new Decl("const", [doc, ...wrap(`export const routes = [${routes.map(r => r[1]).join(", ")}]`)]))
		} else {
			const renamed = deniedMessages.find(d => d[0] == services[0][0])
			const denier = if (denial == null || renamed == null) "" else denial[2]
			const held = if (renamed == null) "" else renamed[1]
			const shapes = unique(errors).map(id => `new json.ErrorShape(${this.errorShape(id, denier, held)})`)
			const besides = undeclared.find(u => u[0] == services[0][0])
			for (const [code, typed] of if (besides == null) [] else besides[1]) {
				shapes.push(`new json.ErrorShape(${json.quoted(typed)}, "message", ${json.quoted(code)})`)
			}
			const version = json.quoted(if (this.protocol == "awsJson1_0") "1.0" else "1.1")
			const start = `export const service = new json.Service(${json.quoted(services[0][0])}, ${version}`
			const end = if (validated) ", validation" else ""
			head.push(new Decl("const", wrap(`${start}, ${t.queryCompatible != null}, [${shapes.join(", ")}]${end})`)))
		}
		const decls = [...head, ...body]
		const handlers = this.declare(replace(t.service?.sdkId ?? name(services[0][0]), " ", ""))
		this.id = services[0][0]
		this.version = s.version
		this.ops = ops
		decls.push(new Decl("interface", [`export interface ${handlers} {`, ...layout(signatures), "}"]))
		const doc = "/// Every operation, not implemented: a service mixes it in and declares those it implements."
		decls.push(new Decl("class", [doc, "export class Unimplemented {", ...layout(unimplemented), "}"]))
		const denied = if (denial == null) `403, "AccessDenied", "reasoned"`
			else `${denial[1]}, ${json.quoted(denial[2])}, ${json.quoted(denial[3])}`
		decls.push(new Decl("function", handle(handlers, cases, codec, validated, denied)))
		return [`// Code generated by tools/smithygen from ${from}. DO NOT EDIT.`, ...layout(decls)].join("\n") + "\n"
	}

	/// Adds to the model what the service id answers that it lacks, as amendments gives it.
	amend(id: string): void throws ModelError {
		const a = amendments.find(a => a[0] == id)
		if (a == null) {
			return
		}
		try {
			for (const [sid, added] of json.decode[Model](a[1]).shapes) {
				const s = this.model.shapes.find(s => s[0] == sid)
				if (s == null) {
					this.model.shapes.push([sid, added])
				} else {
					s[1].members.append(added.members)
				}
			}
		} catch (e: ParseError) {
			throw new ModelError(`${id}'s amendments: ${e}`)
		}
	}

	/// The Route of the operation id, of restXml, and how specific it is: by the literals and required members of the
	/// query and headers it requires, then by its path's literal segments.
	route(id: string): [i32, string] throws ModelError {
		const op = this.shape(id)
		const http = op.traits.http
		if (http == null) {
			throw new ModelError(`${id}: an operation without the http trait`)
		}
		const parts = split(http!.uri, "?")
		const literals = if (parts.length < 2) [] else split(parts[1], "&").filter(l => l != "")
		const queries: string[] = []
		const headers: string[] = []
		for (const m of this.required(id)) {
			if (m.traits.httpQuery != null) {
				queries.push(m.traits.httpQuery!)
			} else if (m.traits.httpHeader != null) {
				headers.push(lower(m.traits.httpHeader!))
			}
		}
		const args = [json.quoted(name(id)), json.quoted(http!.method), json.quoted(parts[0])]
		for (const xs of [literals, queries, headers]) {
			args.push(`[${xs.map(x => json.quoted(x)).join(", ")}]`)
		}
		while (args[args.length - 1] == "[]") {
			args.pop()
		}
		const required = literals.filter(l => !startsWith(l, "x-id=")).length + queries.length + headers.length
		const fixed = split(parts[0], "/").filter(s => s != "" && !startsWith(s, "{")).length
		return [100 * required + fixed, `new restxml.Route(${args.join(", ")})`]
	}

	/// Why the API cannot express the restXml operation id, "" if it can: of an event stream, or of the shapes its
	/// input and output reach.
	unexpressed(id: string): string throws ModelError {
		const op = this.shape(id)
		if (this.streams(op.input) || this.streams(op.output)) {
			return "an event stream"
		}
		const g = new Generator(this.model)
		g.protocol = this.protocol
		try {
			g.structure(op.input)
			g.structure(op.output)
			for (const s of g.structures) {
				g.classOf(s)
			}
		} catch (e: ModelError) {
			return e.what
		}
		return ""
	}

	/// Whether the operation's input or output r holds an event stream.
	streams(r: Ref | null): bool throws ModelError {
		if (r == null || r.target == "smithy.api#Unit") {
			return false
		}
		return this.shape(r.target).members.some(m => this.shape(m[1].target).traits.streaming != null
			&& this.shape(m[1].target).type == "union")
	}

	/// n, declared at the top level.
	declare(n: string): string throws ModelError {
		if (this.taken.includes(n)) {
			throw new ModelError(`${n} names two declarations`)
		}
		this.taken.push(n)
		return n
	}

	/// The shape id, of the model or Smithy's prelude.
	shape(id: string): Shape throws ModelError {
		for (const s of this.model.shapes) {
			if (s[0] == id) {
				return s[1]
			}
		}
		if (!startsWith(id, "smithy.api#")) {
			throw new ModelError(`${id}: no such shape`)
		}
		const s = new Shape()
		s.type = lower(replace(name(id), "Primitive", ""))
		return s
	}

	/// The class of an operation's input or output r, Unit if none, each structure it reaches to be generated.
	structure(r: Ref | null): string throws ModelError {
		if (r == null || r.target == "smithy.api#Unit") {
			return "Unit"
		}
		const s = this.shape(r.target)
		if (s.type != "structure") {
			throw new ModelError(`${r.target}: an operation's input or output that is a ${s.type}`)
		}
		this.reach(r.target)
		return name(r.target)
	}

	/// Notes the structures, unions and enums that the shape id is or holds, to be generated.
	reach(id: string): void throws ModelError {
		const s = this.shape(id)
		if (enumerates(s)) {
			if (!this.enums.includes(id)) {
				this.enums.push(id)
			}
		} else if ((s.type == "structure" || s.type == "union") && !this.structures.includes(id)) {
			this.structures.push(id)
			for (const m of s.members) {
				this.reach(m[1].target)
			}
		}
		for (const r of [s.member, s.key, s.value]) {
			if (r != null) {
				this.reach(r.target)
			}
		}
	}

	/// The literals of the enum id.
	values(id: string): string[] throws ModelError {
		const s = this.shape(id)
		const values: string[] = []
		for (const m of s.members) {
			const v = m[1].traits.enumValue
			values.push(json.quoted(if (v == null) m[0] else `${v}`))
		}
		for (const v of s.traits.enum ?? []) {
			values.push(json.quoted(v.value))
		}
		return values
	}

	/// The class of the structure id, a field for each member, null where it is not required; or the classes of the
	/// union id's members and their union.
	classOf(id: string): Decl[] throws ModelError {
		const s = this.shape(id)
		const decls: Decl[] = []
		if (s.type == "union") {
			const variants: string[] = []
			for (const m of s.members) {
				const v = this.declare(`${name(id)}$${m[0]}`)
				variants.push(v)
				decls.push(new Decl("class", [`export class ${v} {`, ...this.field(id, m, true).lines, "}"]))
			}
			decls.push(new Decl("type", fill(`export type ${this.declare(name(id))} = `, variants)))
			return decls
		}
		const n = this.declare(name(id))
		let tags = ""
		if (this.protocol == "restXml" && s.traits.xmlName != null) {
			tags += ` @restxml.Name[${json.quoted(s.traits.xmlName!)}]`
		}
		if (this.protocol == "restXml" && s.traits.xmlNamespace != null) {
			tags += ` ${namespace(s.traits.xmlNamespace!)}`
		}
		if (this.unwrapped.includes(id)) {
			tags += " @restxml.Unwrapped"
		}
		if (s.members.length == 0) {
			return [new Decl("class", [`export class ${n}${tags} {}`])]
		}
		const fields: Decl[] = []
		for (const m of s.members) {
			fields.push(this.field(id, m, m[1].traits.required != null))
		}
		const merged = this.interleaved.find(i => i[0] == id)
		if (merged != null) {
			const [_, a, b] = merged
			fields.push(new Decl("field",
				[`\t/// The order of the ${a} and ${b} items, written as one list: whether each is a ${b}.`,
				`\torder: bool[] | null @restxml.Interleave[${json.quoted(a)}, ${json.quoted(b)}]`]))
		}
		const lines = [`export class ${n}${tags} {`, ...layout(fields), "}"]
		return [new Decl("class", lines)]
	}

	/// The module of the service's codec, of core/protocol.
	codec(): string {
		return if (this.protocol == "awsQuery") "query" else if (this.protocol == "restXml") "restxml" else "json"
	}

	/// The tag n of the service's codec.
	tag(n: string): string { return `@${this.codec()}.${n}` }

	/// The tags of restXml that bind the member r to where it is on the wire and shape its XML: of a payload, its
	/// element's name too.
	bindings(r: Ref): string[] throws ModelError {
		const t = r.traits
		const tags: string[] = []
		if (t.httpLabel != null) {
			tags.push("@restxml.Label")
		}
		if (t.httpQuery != null) {
			tags.push(`@restxml.Query[${json.quoted(t.httpQuery!)}]`)
		}
		if (t.httpQueryParams != null) {
			tags.push("@restxml.Params")
		}
		if (t.httpHeader != null) {
			tags.push(`@restxml.Header[${json.quoted(t.httpHeader!)}]`)
		}
		if (t.httpPrefixHeaders != null) {
			tags.push(`@restxml.Prefix[${json.quoted(t.httpPrefixHeaders!)}]`)
		}
		if (t.httpResponseCode != null) {
			tags.push("@restxml.Status")
		}
		if (t.httpPayload != null) {
			tags.push("@restxml.Payload")
			if (t.xmlName == null) {
				const s = this.shape(r.target)
				tags.push(`@restxml.Name[${json.quoted(s.traits.xmlName ?? name(r.target))}]`)
			}
		}
		if (t.xmlAttribute != null) {
			tags.push("@restxml.Attr")
		}
		if (t.xmlNamespace != null) {
			tags.push(namespace(t.xmlNamespace!))
		}
		return tags
	}

	/// The field of the member m of the shape id, null unless required or of a default.
	field(id: string, m: [string, Ref], required: bool): Decl throws ModelError {
		const t = m[1].traits
		const query = this.protocol == "awsQuery"
		const rest = this.protocol == "restXml"
		if (query && t.xmlAttribute != null) {
			throw new ModelError(`${id}$${m[0]}: an XML attribute`)
		}
		const tags = if (rest) this.bindings(m[1]) else []
		if ((query || rest) && t.xmlName != null) {
			tags.push(this.tag(`Name[${json.quoted(t.xmlName!)}]`))
		}
		if ((query || rest) && t.xmlFlattened != null) {
			tags.push(this.tag("Flat"))
		}
		const d = m[1].traits.rest.find(x => x[0] == "smithy.api#default")
		const initial = if (d == null || d[1] == "null") null else this.defaultOf(m[1], d[1])
		if (initial != null) {
			tags.push("@model.Default")
			this.modeled = true
		}
		const valid = if (this.unconstrained.includes(`${id}$${m[0]}`)) "" else this.valid(m[1])
		this.open = this.opened || this.strings.includes(`${id}$${m[0]}`)
		this.payload = t.httpPayload != null
		const ty = this.typeOf(m[1], tags, false)
		this.open = false
		this.payload = false
		if (valid != "") {
			tags.push(valid)
		}
		const tagged = tags.map(x => ` ${x}`).join("")
		const field = if (initial != null) `\t${m[0]}: ${ty}${tagged} = ${initial}`
			else if (required) `\t${m[0]}: ${ty}${tagged}${this.initial(m[1].target, ty)}`
			else `\t${m[0]}: ${ty} | null${tagged}`
		if (!wide(field) || initial != null || required) {
			return new Decl("field", [field]) // which bober format leaves as it is
		}
		// as bober format breaks a type too wide before its last member, unless that does not make it fit
		const last = `\t\t| null${tagged}`
		return new Decl("field", if (wide(last)) [field] else [`\t${m[0]}: ${ty}`, last])
	}

	/// The value of the member r of the default d, as Smithy's JSON gives it.
	defaultOf(r: Ref, d: string): string throws ModelError {
		const s = this.shape(r.target)
		try {
			switch (s.type) {
				case "blob": return json.quoted(base64.decode(json.decode[string](d)))
				case "map": return "[]"
				case "timestamp": return `${(round(json.decode[f64](d) * 1000.0) as i64) * 1000000}`
				default: return this.literal(r, d)
			}
		} catch (e: ParseError) {
			throw new ModelError(`${r.target}: a default of ${d}`)
		}
	}

	/// The tag of the constraints of the member or item r, "" if it has none or the service's handlers check them; an
	/// alias of its target's where the member adds none of its own; and Sensitive if it is and values are quoted.
	valid(r: Ref): string throws ModelError {
		const v = this.validation
		const s = this.shape(r.target)
		const own = r.traits.length != null || r.traits.range != null || r.traits.pattern != null
		const length = r.traits.length ?? s.traits.length
		const pattern = r.traits.pattern ?? s.traits.pattern
		if (v == null || pattern != null && !v[3] || enumerates(s)) {
			return ""
		}
		let tag = ""
		if (s.type == "list" || s.type == "map") {
			if (length == null) {
				return ""
			}
			tag = `model.Size[${bound(length!.min)}, ${bound(length!.max)}]`
		} else {
			const b = length ?? r.traits.range ?? s.traits.range
			let p = pattern ?? ""
			try {
				compile(p)
			} catch (e: ParseError) {
				const unrun = `${r.target}: ${p}`
				if (!this.unchecked.includes(unrun)) {
					this.unchecked.push(unrun)
				}
				p = ""
			}
			if (b == null && p == "") {
				return ""
			}
			tag = `model.Valid[${bound(b?.min)}, ${bound(b?.max)}, ${json.quoted(p)}]`
		}
		// of a string or number, as a blob's value is hidden anyway, and a list's or map's items take the tag
		const sensitive = r.traits.sensitive != null || s.traits.sensitive != null
		const hidden = if (v[2] && sensitive && !["blob", "list", "map"].includes(s.type)) " @model.Sensitive" else ""
		if (own) {
			return `@${tag}${hidden}`
		}
		const alias = this.aliases.find(a => a[0] == r.target)
		if (alias == null) {
			this.aliases.push([r.target, `type ${this.declare(name(r.target))} = ${tag}`])
		}
		return `@${name(r.target)}${hidden}`
	}

	/// The actions that authorize each operation, by its name, as the authorization reference of the service of the
	/// signing name signing, beside the model from, gives them; none if there is no reference.
	actions(from: string, signing: string): [string, string[]][] throws ModelError {
		const at = lastIndexOf(from, "/")
		const file = readFile(`${from.slice(0, at + 1)}${signing}-auth.json`)
		if (file == null) {
			return []
		}
		try {
			return json.decode[Reference](file!).Operations.map(o => [o.Name,
				o.AuthorizedActions.map(a => `${a.Service}:${a.Name}`)])
		} catch (e: ParseError) {
			throw new ModelError(`${signing}-auth.json: ${e}`)
		}
	}

	/// The initializer of a required field of the shape id, of type ty: none where ty has a zero value.
	initial(id: string, ty: string): string throws ModelError {
		const s = this.shape(id)
		if (enumerates(s)) {
			return if (ty == "string") "" else ` = ${this.values(id)[0]}`
		}
		switch (s.type) {
			case "list", "map": return " = []"
			case "structure": return ` = new ${ty}()`
			case "union": return ` = new ${ty}$${s.members[0][0]}()`
			default: return ""
		}
	}

	/// The type of a member, or item, r, with the tags into tags that its target takes; within a list or map if inner.
	typeOf(r: Ref, tags: string[], inner: bool): string throws ModelError {
		const s = this.shape(r.target)
		if (enumerates(s)) {
			if (this.open) {
				this.reach(r.target)
				return "string"
			}
			return enumName(r.target)
		}
		const xml = this.protocol == "awsQuery" || this.protocol == "restXml"
		if (!xml && ["timestamp", "document", "list", "map"].includes(s.type)) {
			return this.jsonType(r, s, tags)
		}
		switch (s.type) {
			case "string": return "string"
			case "boolean": return "bool"
			case "byte": return "i8"
			case "short": return "i16"
			case "integer", "intEnum": return "i32"
			case "long": return "i64"
			case "float": return "f32"
			case "double": return "f64"
			case "timestamp":
				// restXml's default is of where the member is bound
				const otherwise = if (this.protocol == "restXml") "" else "date-time"
				const format = r.traits.timestampFormat ?? s.traits.timestampFormat ?? otherwise
				tags.push(if (format == otherwise) this.tag("Timestamp")
					else this.tag(`Timestamp[${json.quoted(format)}]`))
				return "i64"
			case "blob":
				if (s.traits.streaming != null && !this.payload) {
					throw new ModelError(`${r.target}: a stream`)
				}
				tags.push(this.tag("Blob"))
				return "string"
			case "list":
				const m = s.member!
				if (s.traits.sparse != null || inner && m.traits.xmlName != null) {
					throw new ModelError(`${r.target}: a sparse list, or one within a list or map whose items are named`)
				}
				if (m.traits.xmlName != null) {
					tags.push(this.tag(`Member[${json.quoted(m.traits.xmlName!)}]`))
				}
				return `${this.item(m, tags)}[]`
			case "map":
				const k = s.key!
				const v = s.value!
				if (s.traits.sparse != null || inner && (k.traits.xmlName != null || v.traits.xmlName != null)) {
					throw new ModelError(`${r.target}: a sparse map, or one within a list or map whose keys or values are named`)
				}
				if (k.traits.xmlName != null) {
					tags.push(this.tag(`Key[${json.quoted(k.traits.xmlName!)}]`))
				}
				if (v.traits.xmlName != null) {
					tags.push(this.tag(`Value[${json.quoted(v.traits.xmlName!)}]`))
				}
				return `[${this.typeOf(k, tags, true)}, ${this.item(v, tags)}][]`
			case "structure", "union": return name(r.target)
			default: throw new ModelError(`${r.target}: a ${s.type}`)
		}
	}

	/// The type of the item r of a list or map, with the tags into tags that it takes: its constraints, unless it is a
	/// list or map itself, whose number of items they would bound.
	item(r: Ref, tags: string[]): string throws ModelError {
		const ty = this.typeOf(r, tags, true)
		const valid = if (["list", "map"].includes(this.shape(r.target).type)) "" else this.valid(r)
		if (valid != "") {
			tags.push(valid)
		}
		return ty
	}

	/// The type of a member, or item, r of an awsJson service, of the timestamp, document, list or map s, with the tags
	/// into tags that it takes.
	jsonType(r: Ref, s: Shape, tags: string[]): string throws ModelError {
		switch (s.type) {
			case "timestamp":
				const format = r.traits.timestampFormat ?? s.traits.timestampFormat ?? "epoch-seconds"
				tags.push(if (format == "epoch-seconds") "@json.Timestamp"
					else `@json.Timestamp[${json.quoted(format)}]`)
				return "i64"
			case "document":
				tags.push("@json.Document")
				return "string"
			case "list":
				const item = this.item(s.member!, tags)
				return if (s.traits.sparse != null) `(${item} | null)[]` else `${item}[]`
			default:
				// a map
				const k = this.typeOf(s.key!, tags, true)
				const v = this.item(s.value!, tags)
				return `[${k}, ${v}${if (s.traits.sparse != null) " | null" else ""}][]`
		}
	}

	/// The arguments making the ErrorShape of the error id: its id, the member that holds its message and its code
	/// under awsQuery; held where it is the access denied of the code denier.
	errorShape(id: string, denier: string, held: string): string throws ModelError {
		const message = this.shape(id).members.find(m => lower(m[0]) == "message")
		const code = this.shape(id).traits.queryError?.code ?? ""
		const m = if (name(id) == denier) held else if (message == null) "" else message[0]
		return `${json.quoted(id)}, ${json.quoted(m)}, ${json.quoted(code)}`
	}

	/// The function making the Fault of the error id, as the protocol answers it, of a message if it has one; and if
	/// the error has other members, the class of them, which the function takes too.
	maker(id: string): Decl[] throws ModelError {
		const s = this.shape(id)
		const t = s.traits
		if (t.error == null) {
			throw new ModelError(`${id}: an error without the error trait`)
		}
		const client = t.error == "client"
		const query = this.protocol == "awsQuery"
		const status = (if (query) t.queryError?.httpResponseCode else t.httpError) ?? (if (client) 400 else 500)
		const code = (if (query) t.queryError?.code else null) ?? name(id)
		const message = query || this.protocol == "restXml" || s.members.some(m => lower(m[0]) == "message")
		const others = s.members.filter(m => lower(m[0]) != "message")
		const decls: Decl[] = []
		const params: string[] = if (message) ["message: string"] else []
		let members = ""
		if (others.length > 0) {
			const c = this.declare(name(id))
			const doc = `/// The members of ${name(id)} besides its message.`
			const fields = layout(others.map(m => this.field(id, m, m[1].traits.required != null)))
			decls.push(new Decl("class", [doc, `export class ${c} {`, ...fields, "}"]))
			params.push(`members: ${c} = new ${c}()`)
			members = `, ${client}, ${this.codec()}.members(members)`
		}
		const sender = if (members != "" || client == (status < 500)) "" else `, ${client}`
		const head = `export function ${this.declare(lowerCamel(name(id)))}(${params.join(", ")}): Fault {`
		const text = if (message) "message" else "\"\""
		const body = `return new Fault(${status}, ${json.quoted(code)}, ${text}${sender}${members})`
		const line = `${head} ${body} }` // as bober format puts a body of one statement where it fits
		decls.push(new Decl("function", if (wide(line)) [...signature(head), ...wrap(`\t${body}`), "}"] else [line]))
		return decls
	}

	/// The tests of the vectors of the operations and their errors, of the API in the file out, after api has run;
	/// those that skips, of a line "id: reason" or "id request: reason" or "id response: reason" each, gives a reason
	/// for, and those for clients only, listed instead.
	/// And how many there are.
	suite(from: string, out: string, skips: string): [string, string] throws ModelError | ParseError {
		const reasons = split(skips, "\n").filter(l => l != "").map(l => split(l, ": "))
		const tests: Decl[] = []
		const skipped: string[] = []
		const ids: string[] = []
		const names: string[] = []
		const errors: string[] = []
		const got: Decl[] = [] // the methods of Got
		const spread = new Decl("spread", ["\t...api.Unimplemented"])
		const classes = ["Got", "Caller", "Fault", "Unit", "Request", "caller", "same", "sameJson", "api"]
		for (const op of this.ops) {
			let requested = false
			const vectors: [Vector, string | null][] = [] // a response's error, "" if none; null for a request
			for (const v of this.shape(op).traits.requestTests) {
				vectors.push([v, null])
			}
			for (const v of this.shape(op).traits.responseTests) {
				vectors.push([v, ""])
			}
			for (const e of this.shape(op).errors.filter(e => !errors.includes(e.target))) {
				errors.push(e.target)
				for (const v of this.shape(e.target).traits.responseTests) {
					vectors.push([v, e.target])
				}
			}
			for (const [v, error] of vectors) {
				ids.push(v.id)
				const test = `${v.id} ${if (error == null) "request" else "response"}` // an id can name one of each
				names.push(test)
				const reason = reasons.find(r => r[0] == v.id || r[0] == test)
				if (v.protocol != `aws.protocols#${this.protocol}`) {
					throw new ModelError(`${v.id}: a vector of ${v.protocol}`)
				} else if (v.appliesTo == "client" || reason != null) {
					const why = if (reason == null) "for clients only" else reason.slice(1, reason.length).join(": ")
					skipped.push(`// ${test}: ${why}`)
				} else if (this.unexpressible.includes(op)) {
					skipped.push(`// ${test}: of an operation the API cannot express`)
				} else if (error != null && this.protocol == "restXml" && this.unrequestable(op)) {
					skipped.push(`// ${test}: of an input whose required members a request of its route lacks`)
				} else if (error == null) {
					if (!requested) {
						const output = this.className(this.shape(op).output)
						const body = ["\t\tthis.input = `${input}`", `\t\treturn new ${output}()`]
						got.push(new Decl("method", method(this.head(op), body)))
						requested = true
					}
					tests.push(new Decl("test", [`test ${json.quoted(test)} {`, ...this.request(op, v), "}"]))
				} else {
					// its own handler, a class named by its id
					if (classes.includes(v.id)) {
						throw new ModelError(`${v.id}: names two declarations`)
					}
					classes.push(v.id)
					const handler = [`class ${v.id} {`, ...layout([spread, this.answer(op, v, error)]), "}"]
					tests.push(new Decl("class", handler))
					tests.push(new Decl("test", [`test ${json.quoted(test)} {`, ...this.response(op, v), "}"]))
				}
			}
		}
		for (const r of reasons.filter(r => !ids.includes(r[0]) && !names.includes(r[0]))) {
			throw new ModelError(`${r[0]}: skipped, but no such vector`)
		}
		const count = tests.filter(d => d.kind == "test").length
		const tally = `${ids.length} vectors: ${count} tests, ${skipped.length} skipped`
		const up = root(out)
		const decls = [new Decl("import", [`import { Fault } from "${up}core/fault"`])]
		decls.push(new Decl("import", [`import { Caller, Unit } from "${up}core/service"`]))
		const same = if (this.codec() == "json") "sameJson" else "same"
		decls.push(new Decl("import", [`import { caller, ${same} } from "${up}tools/smithygen/vectors"`]))
		decls.push(new Decl("import", [`import * as api from "./${replace(split(out, "/").pop()!, ".bob", "")}"`]))
		decls.push(new Decl("import", [`import { Request } from "std/http"`]))
		if (got.length > 0) {
			const members = layout([spread, new Decl("field", ["\tinput = \"\""]), ...got])
			const doc = "/// The input of the operation it served last, as text."
			decls.push(new Decl("class", [doc, "class Got {", ...members, "}"]))
		}
		const head = [`// Code generated by tools/smithygen from ${from}. DO NOT EDIT.`, `// ${tally}:`, ...skipped]
		return [[...head, ...layout([...decls, ...tests])].join("\n") + "\n", tally]
	}

	/// The signature of the method of a test's handler for operation op.
	head(op: string): string throws ModelError {
		const o = this.shape(op)
		const input = this.className(o.input)
		return `\t${lowerCamel(name(op))}(c: Caller, input: ${input}): ${this.className(o.output)} throws Fault`
	}

	/// The test that the request of vector v, of operation op, decodes to its params.
	request(op: string, v: Vector): string[] throws ModelError | ParseError {
		const o = this.shape(op)
		const input = this.className(o.input)
		const rest = this.protocol == "restXml"
		if (v.body == null && !rest) {
			throw new ModelError(`${v.id}: a request without a body`)
		}
		const lines = ["\tconst h = new Got()"]
		const uri = if (v.queryParams.length == 0) v.uri else `${v.uri}?${v.queryParams.join("&")}`
		const req = `new Request(${json.quoted(v.method)}, ${json.quoted(uri)}, ${json.quoted(v.body ?? "")})`
		lines.append(wrap(`\tconst req = ${req}`))
		for (const h of v.headers) {
			lines.push(`\treq.headers.set(${json.quoted(h[0])}, ${json.quoted(h[1])})`)
		}
		if (this.protocol != "awsQuery" && !rest && !v.headers.some(h => lower(h[0]) == "x-amz-target")) {
			lines.push(this.target(op))
		}
		lines.append([`\tapi.handle(h, caller(""), req)`, `\tconst want = new ${input}()`])
		lines.append(this.assignments("\twant", o.input, v.params))
		lines.push("\tassert h.input == `${want}`")
		return lines
	}

	/// The method of the handler of vector v of operation op: making the params of v, or throwing the error of them if
	/// error is not "".
	answer(op: string, v: Vector, error: string): Decl throws ModelError | ParseError {
		const o = this.shape(op)
		const output = this.className(o.output)
		const body: string[] = []
		if (error != "") {
			const message = this.shape(error).members.find(m => lower(m[0]) == "message")
			const given = v.params.all.find(p => message != null && p[0] == message[0])
			const query = this.protocol == "awsQuery"
			if (query && given == null) {
				throw new ModelError(`${v.id}: an error without a Message, which the awsQuery codec writes`)
			}
			let text = if (message == null && !query && this.protocol != "restXml") ""
				else if (given == null) "\"\""
				else this.literal(message![1], given[1])
			const others = v.params.all.filter(p => message == null || p[0] != message[0])
			if (others.length > 0) {
				body.push(`\t\tconst e = new api.${name(error)}()`)
				for (const p of others) {
					body.append(wrap(`\t\te.${p[0]} = ${this.literal(this.member(error, p[0]), p[1])}`))
				}
				text = if (text == "") "e" else `${text}, e`
			}
			body.append(wrap(`\t\tthrow api.${lowerCamel(name(error))}(${text})`))
		} else if (v.params.all.length == 0) {
			body.push(`\t\treturn new ${output}()`)
		} else {
			body.push(`\t\tconst out = new ${output}()`)
			body.append(this.assignments("\t\tout", o.output, v.params))
			body.push("\t\treturn out")
		}
		return new Decl("method", method(this.head(op), body))
	}

	/// The test that operation op, by the handler of vector v, answers as v does.
	response(op: string, v: Vector): string[] throws ModelError {
		const lines: string[] = []
		const body = v.body ?? ""
		const query = this.protocol == "awsQuery"
		if (query) {
			const id = if (has(body, "<RequestId>")) split(split(body, "<RequestId>")[1], "</RequestId>")[0] else ""
			const req = `new Request("POST", "/", ${json.quoted(`Action=${name(op)}&Version=${this.version}`)})`
			lines.append(wrap(`\tconst res = api.handle(new ${v.id}(), caller(${json.quoted(id)}), ${req})`))
		} else if (this.protocol == "restXml") {
			const header = v.headers.find(h => lower(h[0]) == "x-amzn-requestid")
			const id = if (header == null) "" else header[1]
			lines.append(this.routed(op))
			lines.append(wrap(`\tconst res = api.handle(new ${v.id}(), caller(${json.quoted(id)}), req)`))
		} else {
			const header = v.headers.find(h => lower(h[0]) == "x-amzn-requestid")
			const id = if (header == null) "" else header[1]
			lines.append([`\tconst req = new Request("POST", "/", "{}")`, this.target(op)])
			lines.append(wrap(`\tconst res = api.handle(new ${v.id}(), caller(${json.quoted(id)}), req)`))
		}
		lines.push(`\tassert res.status == ${v.code}`)
		for (const h of v.headers) {
			lines.push(`\tassert res.headers.get(${json.quoted(h[0])}) == ${json.quoted(h[1])}`)
		}
		if (v.body != null) {
			const verbatim = !has(body, "`") && !has(body, "${") && !has(body, "\\")
			if (query && !verbatim) {
				throw new ModelError(`${v.id}: a body that a template literal cannot hold as it is`)
			}
			const want = (if (verbatim) `\`${body}\`` else json.quoted(body)) + ")"
			const same = if (this.codec() == "json") "sameJson" else "same"
			const line = `\tassert ${same}(res, ${want}`
			// as bober format breaks it, a body of several lines measured as if of one
			lines.append(if (wide(line)) [`\tassert ${same}(res,`, `\t\t${want}`] else [line])
		}
		return lines
	}

	/// The statements making req, a request of the restXml operation op's route: each label and required query
	/// parameter or header of it "a".
	routed(op: string): string[] throws ModelError {
		const http = this.shape(op).traits.http!
		const parts = split(http.uri, "?")
		const segments = split(parts[0], "/").map(s => if (startsWith(s, "{")) "a" else s)
		const query = if (parts.length < 2) [] else split(parts[1], "&").filter(l => l != "")
		const headers: string[] = []
		for (const m of this.required(op)) {
			if (m.traits.httpQuery != null) {
				query.push(`${m.traits.httpQuery!}=a`)
			} else if (m.traits.httpHeader != null) {
				headers.push(`\treq.headers.set(${json.quoted(m.traits.httpHeader!)}, "a")`)
			}
		}
		const uri = segments.join("/") + (if (query.length == 0) "" else `?${query.join("&")}`)
		return [...wrap(`\tconst req = new Request(${json.quoted(http.method)}, ${json.quoted(uri)}, "")`), ...headers]
	}

	/// The required members of the input of operation op.
	required(op: string): Ref[] throws ModelError {
		const input = this.shape(op).input
		if (input == null || input.target == "smithy.api#Unit") {
			return []
		}
		return this.shape(input.target).members.filter(m => m[1].traits.required != null).map(m => m[1])
	}

	/// Whether a request of the restXml operation op's route, as routed makes it, lacks a member its input requires.
	unrequestable(op: string): bool throws ModelError {
		return this.required(op).some(m => m.traits.httpLabel == null && m.traits.httpQuery == null
			&& m.traits.httpHeader == null)
	}

	/// The statement setting the X-Amz-Target of req to name the operation op.
	target(op: string): string {
		return `\treq.headers.set("X-Amz-Target", ${json.quoted(`${name(this.id)}.${name(op)}`)})`
	}

	/// The class of an operation's input or output r, as a test names it.
	className(r: Ref | null): string throws ModelError {
		const c = this.structure(r)
		return if (c == "Unit") c else `api.${c}`
	}

	/// The statements setting the members of x, of the structure r, to the values that params gives them.
	assignments(x: string, r: Ref | null, params: json.Keys): string[] throws ModelError | ParseError {
		const lines: string[] = []
		for (const p of params.all) {
			lines.append(wrap(`${x}.${p[0]} = ${this.literal(this.member(r!.target, p[0]), p[1])}`))
		}
		return lines
	}

	/// The member m of the structure id.
	member(id: string, m: string): Ref throws ModelError {
		const found = this.shape(id).members.find(x => x[0] == m)
		if (found == null) {
			throw new ModelError(`${id}: no member ${m}`)
		}
		return found[1]
	}

	/// The value, of the member or item r, that a vector's params give as the JSON v: a document as its JSON.
	literal(r: Ref, v: string): string throws ModelError | ParseError {
		const s = this.shape(r.target)
		if (v == "null") {
			return "null"
		}
		switch (if (enumerates(s)) "string" else s.type) {
			case "string", "blob": return json.quoted(json.decode[string](v))
			case "boolean", "byte", "short", "integer", "long", "intEnum": return v
			case "float", "double":
				switch (v) {
					case "\"NaN\"": return "0.0 / 0.0"
					case "\"Infinity\"": return "1.0 / 0.0"
					case "\"-Infinity\"": return "-1.0 / 0.0"
				}
				return if (has(v, ".")) v else `${v}.0`
			case "timestamp":
				// ns from epoch seconds
				return `${(round(json.decode[f64](v) * 1000.0) as i64) * 1000000}`
			case "list":
				const items: string[] = []
				for (const x of json.decode[Item[]](v)) {
					items.push(this.literal(s.member!, encode(x)))
				}
				return `[${items.join(", ")}]`
			case "map":
				const entries: string[] = []
				for (const e of json.decode[json.Keys](v).all) {
					entries.push(`[${json.quoted(e[0])}, ${this.literal(s.value!, e[1])}]`)
				}
				return `[${entries.join(", ")}]`
			case "structure":
				const members: string[] = []
				for (const p of json.decode[json.Keys](v).all) {
					members.push(`, ${p[0]}: ${this.literal(this.member(r.target, p[0]), p[1])}`)
				}
				return `{ ...new api.${name(r.target)}()${members.join("")} }`
			case "union":
				const m = json.decode[json.Keys](v).all[0]
				const variant = `${name(r.target)}$${m[0]}`
				return `{ ...new api.${variant}(), ${m[0]}: ${this.literal(this.member(r.target, m[0]), m[1])} }`
			case "document": return json.quoted(v)
			default: throw new ModelError(`${r.target}: a ${s.type} in a vector`)
		}
	}
}

/// An item of a list in a vector's params, a list of items of no lists if one.
type Item = string | f64 | bool | json.Keys | null | (string | f64 | bool | json.Keys | null)[]

/// The JSON of x, which it can hold.
function encode(x: Item): string {
	try {
		return json.encode(x)
	} catch (e: json.EncodeError) {
		return "" // a float of JSON is finite
	}
}

/// The API of the service that the Smithy JSON AST model, read from the file from, describes, as the file out.
export function generate(model: string, from: string, out: string): string throws ModelError {
	try {
		return new Generator(json.decode[Model](model)).api(from, out)
	} catch (e: ParseError) {
		throw new ModelError(`${from}: ${e}`)
	}
}

/// The tests of the vectors of the model, read from the file from, of the API that generate makes as the file out,
/// but for those that skips, of a line "id: reason" each, gives a reason for; and how many there are.
export function vectors(model: string, from: string, out: string, skips: string): [string, string] throws ModelError {
	try {
		const g = new Generator(json.decode[Model](model))
		g.api(from, out)
		return g.suite(from, out, skips)
	} catch (e: ParseError) {
		throw new ModelError(`${from}: ${e}`)
	}
}

/// The path from the file out up to the root.
function root(out: string): string {
	let up = ""
	for (let i = 1; i < split(out, "/").length; i++) {
		up += "../"
	}
	return up
}

/// The imports of the file out, of the codec, of Unit if unit, and of the codecs' model if modeled.
function imports(out: string, codec: string, unit: bool, modeled: bool): Decl[] {
	const up = root(out)
	const decls: Decl[] = []
	decls.push(new Decl("import", [`import * as ${codec} from "${up}core/protocol/${codec}"`]))
	if (modeled) {
		decls.push(new Decl("import", [`import * as model from "${up}core/protocol/model"`]))
	}
	decls.push(new Decl("import", [`import { Fault } from "${up}core/fault"`]))
	const names = if (unit) "Caller, notImplemented, Unit" else "Caller, notImplemented"
	decls.push(new Decl("import", [`import { ${names} } from "${up}core/service"`]))
	decls.push(new Decl("import", [`import { Request, Response } from "std/http"`]))
	return decls
}

/// The function serving a request by a handler of the interface handlers, by the cases of its operations, of the codec
/// query, json or restxml; of the service's validation if validated; IAM's denials answered as denied says, its
/// status, code and wording as 403, "AccessDenied", "reasoned".
function handle(handlers: string, cases: string[], codec: string, validated: bool, denied: string): string[] {
	const lines = ["/// The answer of h to req."]
	const head = `export function handle(h: ${handlers}, caller: Caller, req: Request)`
	lines.append(signature(`${head}: Response throws IoError {`))
	lines.push(`\tcaller.denied = [${denied}]`)
	if (codec == "query") {
		const call = `\tconst c = query.call(caller, req, version, ns${if (validated) ", validation" else ""})`
		lines.append([call, "\tswitch (c.action) {", ...cases])
		lines.push("\t\tdefault: return c.invalidAction()")
	} else {
		const call = if (codec == "json") "json.call(caller, req, service)"
			else "restxml.call(caller, req, service, routes)"
		lines.append([`\tconst c = ${call}`, "\tswitch (c.operation) {", ...cases])
		lines.push("\t\tdefault: return c.unknownOperation()")
	}
	lines.append(["\t}", "}"])
	return lines
}

/// The method of the signature head and the statements body, on one line where it fits and body is one line.
function method(head: string, body: string[]): string[] {
	const line = `${head} { ${body[0].slice(tabs(body[0]), body[0].length)} }`
	return if (body.length == 1 && !wide(line)) [line] else [...signature(`${head} {`), ...body, "\t}"]
}

/// The signature line, its parameters wrapped as bober format wraps them: one that does not fit on the line goes on a
/// line of its own, a tab in, unless it would not fit there either and does not overflow where it is.
function signature(line: string): string[] {
	const open = indexOf(line, "(")
	const close = lastIndexOf(line, ")")
	const params = split(line.slice(open + 1, close), ", ")
	const tail = line.slice(close, line.length)
	const indent = line.slice(0, tabs(line)) + "\t"
	const lines = [line.slice(0, open + 1) + params[0]]
	for (let i = 1; i < params.length; i++) {
		lines[lines.length - 1] += ","
		const last = lines[lines.length - 1]
		const w = params[i].length + (if (i < params.length - 1) 1 else 0) // with its comma
		const after = if (i == params.length - 1) tail.length else 0
		const col = last.length + 3 * tabs(last)
		if (col + 1 + w + after > width && (col + 1 + w > width || 4 * indent.length + w + after <= width)) {
			lines.push(indent + params[i])
		} else {
			lines[lines.length - 1] = `${last} ${params[i]}`
		}
	}
	lines[lines.length - 1] += tail
	return lines
}

/// The number of lines of d but its comments.
function code(d: Decl): i32 { return d.lines.filter(l => !startsWith(l, "//") && !startsWith(l, "\t//")).length }

/// The decls' lines, a blank line between two of different kinds or of more than a line of code, as bober format puts
/// them.
function layout(decls: Decl[]): string[] {
	const lines: string[] = []
	for (let i = 0; i < decls.length; i++) {
		const d = decls[i]
		if (i > 0) {
			const prev = decls[i - 1]
			if (prev.kind != d.kind || code(prev) > 1 || code(d) > 1) {
				lines.push("")
			}
		}
		lines.push(...d.lines)
	}
	return lines
}

/// head followed by the union of values, wrapped as bober format wraps it.
function fill(head: string, values: string[]): string[] {
	const lines = [head + values[0]]
	for (const v of values.slice(1, values.length)) {
		const last = lines[lines.length - 1]
		if (wide(`${last} | ${v}`)) {
			lines.push(`\t| ${v}`)
		} else {
			lines[lines.length - 1] = `${last} | ${v}`
		}
	}
	return lines
}

/// line, wrapped as bober format wraps one too wide, the lines after the first indented a tab more.
function wrap(line: string): string[] {
	const lines = [""]
	put(lines, line, line.slice(0, tabs(line)) + "\t")
	return lines
}

/// Puts s on lines: on the last where it fits, else on a line of its own at indent, else each of its pieces so, from
/// a line of their own.
function put(lines: string[], s: string, indent: string): void {
	const last = lines[lines.length - 1]
	const blank = tabs(last) == last.length
	const cut = pieces(s)
	if (!wide(last + s) || blank && cut.length == 1) {
		lines[lines.length - 1] = last + s
	} else if (!blank) {
		lines.push(indent)
		put(lines, s.slice(1, s.length), indent)
	} else {
		for (const p of cut) {
			put(lines, p, indent)
		}
	}
}

/// s cut after each of its commas, not in a string or at its end, that the fewest brackets enclose.
function pieces(s: string): string[] {
	const commas: [i32, i32][] = [] // where, and in how many brackets
	let depth = 0
	let quoted = false
	for (let i = 0; i < s.length; i++) {
		const c = s.slice(i, i + 1)
		if (c == "\\") {
			i++
		} else if (c == "\"") {
			quoted = !quoted
		} else if (!quoted) {
			depth += if (c == "(" || c == "[" || c == "{") 1 else if (c == ")" || c == "]" || c == "}") -1 else 0
			if (c == "," && i < s.length - 1) {
				commas.push([i, depth])
			}
		}
	}
	let least = s.length
	for (const c of commas) {
		least = min(least, c[1])
	}
	const out: string[] = []
	let at = 0
	for (const c of commas.filter(c => c[1] == least)) {
		out.push(s.slice(at, c[0] + 1))
		at = c[0] + 1
	}
	out.push(s.slice(at, s.length))
	return out
}

/// The text of a constraint's bound b, "" if none.
function bound(b: f64 | null): string {
	if (b == null) {
		return "\"\""
	}
	const n = b!
	return json.quoted(if (n == round(n)) `${n as i64}` else `${n}`)
}

/// Whether line is wider than bober format allows, a tab as 4 columns.
function wide(line: string): bool { return line.length + 3 * tabs(line) > width }

/// How many tabs line starts with.
function tabs(line: string): i32 {
	let n = 0
	while (n < line.length && line.slice(n, n + 1) == "\t") {
		n++
	}
	return n
}

/// The restXml tag of the XML namespace ns.
function namespace(ns: Namespace): string {
	const prefix = if (ns.prefix == "") "" else `, ${json.quoted(ns.prefix)}`
	return `@restxml.Namespace[${json.quoted(ns.uri)}${prefix}]`
}

/// Whether s has sub in it.
function has(s: string, sub: string): bool { return indexOf(s, sub) >= 0 }
/// Whether s is an enum, or a string of Smithy 1's enum trait.
function enumerates(s: Shape): bool { return s.type == "enum" || s.traits.enum != null }
/// Sorts the shape ids by their names.
function sortNames(ids: string[]) { sortBy(ids, (a, b) => name(a) < name(b)) }
/// The name of the shape id, without its namespace.
function name(id: string): string { return split(id, "#")[1] }

/// The name of the enum id, followed by a $ if the API imports one of that name, as SSM's Fault.
function enumName(id: string): string {
	return if (["Caller", "Fault", "Request", "Response"].includes(name(id))) `${name(id)}$` else name(id)
}

/// s with its leading capitals lowered, but for the last of several that starts a word: IDPError as idpError.
function lowerCamel(s: string): string {
	let n = 0
	while (n < s.length && s.slice(n, n + 1) != lower(s.slice(n, n + 1))) {
		n++
	}
	if (n > 1 && n < s.length) {
		n--
	}
	return lower(s.slice(0, n)) + s.slice(n, s.length)
}

function main(): i32 {
	const a = args()
	if (a.length != 2 && a.length != 3) {
		print("usage: smithygen MODEL OUT [SKIPS]")
		return 2
	}
	const model = readFile(a[0])
	const skips = if (a.length == 3) readFile(a[2]) else ""
	if (model == null || skips == null) {
		print(`smithygen: cannot read ${a.filter(f => f != a[1]).join(" or ")}`)
		return 1
	}
	try {
		const tests = replace(a[1], ".bob", ".test.bob")
		const suite = if (a.length == 3) vectors(model, a[0], a[1], skips) else null
		if (!writeFile(a[1], generate(model, a[0], a[1])) || suite != null && !writeFile(tests, suite[0])) {
			print(`smithygen: cannot write ${a[1]} or ${tests}`)
			return 1
		}
		if (suite != null) {
			print(suite[1])
		}
	} catch (e: ModelError) {
		print(`smithygen: ${e.what}`)
		return 1
	}
	return 0
}
