/// Whether the API and tests in the directory dir are what the model, of protocol test vectors, generates; and their
/// tally.
function fresh(model: string, dir: string, tally: string): bool throws ModelError {
	const m = readFile(model)!
	const api = `${dir}/api.bob`
	const suite = vectors(m, model, api, readFile(`${dir}/skips.txt`)!)
	return generate(m, model, api) == readFile(api) && suite[0] == readFile(`${dir}/api.test.bob`) && suite[1] == tally
}

test "protocoltests/json10 is what models/awsjson10-tests.json generates" {
	assert fresh("models/awsjson10-tests.json", "protocoltests/json10", "73 vectors: 43 tests, 30 skipped")
}

test "protocoltests/json10querycompatible is what models/awsjson10-querycompatible-tests.json generates" {
	const model = "models/awsjson10-querycompatible-tests.json"
	assert fresh(model, "protocoltests/json10querycompatible", "3 vectors: 3 tests, 0 skipped")
}

test "protocoltests/json11 is what models/awsjson11-tests.json generates" {
	assert fresh("models/awsjson11-tests.json", "protocoltests/json11", "122 vectors: 96 tests, 26 skipped")
}

test "a model it cannot express" {
	const document = `{"smithy": "2.0", "shapes": {"a#S": {"type": "service", "version": "1", "operations": [{"target": "a#Op"}],
		"traits": {"aws.protocols#awsQuery": {}, "aws.auth#sigv4": {"name": "s"}, "smithy.api#xmlNamespace": {"uri": "u"}}},
		"a#Op": {"type": "operation", "input": {"target": "a#In"}}, "a#In": {"type": "structure", "members":
		{"U": {"target": "a#U"}}}, "a#U": {"type": "document"}}}`
	assert generate(document, "m.json", "api.bob") throws new ModelError("a#U: a document")
	const rest = `{"smithy": "2.0", "shapes": {"a#S": {"type": "service", "version": "1", "traits": {"aws.protocols#restXml": {}}}}}`
	const why = "a#S: not an awsQuery service of an XML namespace, an awsJson or REST one, of sigv4, or has resources"
	assert generate(rest, "m.json", "api.bob") throws new ModelError(why)
}

