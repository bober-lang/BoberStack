/// Whether the API and tests in the directory dir are what the model, of protocol test vectors, generates; and their
/// tally.
function fresh(model: string, dir: string, tally: string): bool throws ModelError {
	const m = readFile(model)!
	const api = `${dir}/api.bob`
	const suite = vectors(m, model, api, readFile(`${dir}/skips.txt`)!)
	return generate(m, model, api) == readFile(api) && suite[0] == readFile(`${dir}/api.test.bob`) && suite[1] == tally
}

test "protocoltests/json10 is what models/awsjson10-tests.json generates" {
	assert fresh("models/awsjson10-tests.json", "protocoltests/json10", "73 vectors: 43 tests, 30 skipped")
}

test "protocoltests/json10querycompatible is what models/awsjson10-querycompatible-tests.json generates" {
	const model = "models/awsjson10-querycompatible-tests.json"
	assert fresh(model, "protocoltests/json10querycompatible", "3 vectors: 3 tests, 0 skipped")
}

