/// Whether what std/regex runs for the pattern p matches s; null if it runs nothing for it.
function runs(p: string, s: string): bool | null {
	const r = runnable(p)
	if (r == null) {
		return null
	}
	try {
		return compile(r!).test(s)
	} catch (e: ParseError) {
		return null
	}
}

test "a pattern of Java's spelling runs in RE2's" {
	const latin = "^[\\u0009\\u000A\\u000D\\u0020-\\u00FF]+$"
	assert runnable(latin) == "^[\\x{0009}\\x{000A}\\x{000D}\\x{0020}-\\x{00FF}]+$"
	assert runs(latin, "a\té") == true && runs(latin, "€") == false && runs(latin, "") == false
	assert runs("^\\p{ASCII}+$", "a~") == true && runs("^\\p{ASCII}+$", "é") == false
	assert runnable("^[x\\p{ASCII}]$") == "^[x\\x00-\\x7F]$"
	// four digits, as Java reads them: U+1000, then 0 to U+10FF, then F
	assert runnable("^[\\u10000-\\u10FFFF]$") == "^[\\x{1000}0-\\x{10FF}FF]$"
	assert runnable("^[a-z]+$") == "^[a-z]+$"
	assert runnable("^[\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*$") == null
}

test "a pattern of lookarounds runs as one without, matching the same strings" {
	const filled = "^(?!\\s*$).+$"
	assert runs(filled, " a ") == true && runs(filled, "") == false && runs(filled, " \t ") == false
	const alias = "^(?!^[0-9]+$)([a-zA-Z0-9-_]+)$"
	assert runs(alias, "live") == true && runs(alias, "1a") == true && runs(alias, "v-1_") == true
	assert runs(alias, "123") == false && runs(alias, "") == false && runs(alias, "a b") == false
	const qualifier = "^((?!^\\d+$)^[0-9a-zA-Z-_]+$)$"
	assert runs(qualifier, "1a") == true && runs(qualifier, "12") == false
	const name = "^(?=.*[a-zA-Z_\\-\\.])[a-zA-Z0-9_\\-\\.]+$"
	assert runs(name, "a1") == true && runs(name, "1.") == true && runs(name, "12") == false
		&& runs(name, "a b") == false
	const undotted = "^[0-9A-Za-z\\.\\-_]*(?<!\\.)$"
	assert runs(undotted, "") == true && runs(undotted, "a.b") == true
	assert runs(undotted, "a.") == false && runs(undotted, ".") == false
	const collection = "^(^(?!(system\\x2e)))(^[_a-zA-Z0-9])([^$]*)$"
	for (const s of ["users", "s", "sys.a", "system", "systems.a", "_a.b"]) {
		assert runs(collection, s) == true
	}
	for (const s of ["system.users", "system.", "a$b", "", "$", ".a"]) {
		assert runs(collection, s) == false
	}
	const domain = "^(\\*\\.)?(((?!-)[A-Za-z0-9-]{0,62}[A-Za-z0-9])\\.)+((?!-)[A-Za-z0-9-]{1,62}[A-Za-z0-9])$"
	for (const s of ["example.com", "*.example.com", "a.b-c.io"]) {
		assert runs(domain, s) == true
	}
	for (const s of ["-a.com", "a-.com", "example", "a.c", "a.-cc", "*.com"]) {
		assert runs(domain, s) == false
	}
	const named = "^(arn:(aws[a-zA-Z-]*)?:lambda:)?((eusc-)?[a-z]{2}((-gov)|(-iso([a-z]?)))?-[a-z]+-\\d{1}:)?(\\d{12}:)?"
		+ "(function:)?([a-zA-Z0-9-_]{1,64})(:((?!\\d+$)[0-9a-zA-Z-_]+))?$"
	assert runs(named, "f") == true && runs(named, "f:live") == true && runs(named, "f:1a") == true
	assert runs(named, "arn:aws:lambda:us-east-1:000000000000:function:f:live") == true
	assert runs(named, "f:12") == false && runs(named, "f:") == false
	const jdbc = "^jdbc:(redshift|postgresql)://((?!-)[A-Za-z0-9-]{1,63}(?<!-)\\.)+(redshift(-serverless)?)\\."
		+ "([a-zA-Z0-9\\.\\-]+):\\d{1,5}/[a-zA-Z0-9_$-]+$"
	assert runs(jdbc, "jdbc:redshift://c.a-b.redshift.amazonaws.com:5439/db") == true
	assert runs(jdbc, "jdbc:redshift://-c.redshift.amazonaws.com:5439/db") == false
	assert runs(jdbc, "jdbc:redshift://c-.redshift.amazonaws.com:5439/db") == false
	const source = "^(?=[/\\.\\-_A-Za-z0-9]+)((?!aws\\.).*)|(\\$(\\.[\\w_-]+(\\[(\\d+|\\*)\\])*)*)$"
	for (const s of ["my.app", "a", "aws", "awsx.a", "$.detail.items[0]"]) {
		assert runs(source, s) == true
	}
	for (const s of ["aws.ec2", "", " a"]) {
		assert runs(source, s) == false
	}
}
