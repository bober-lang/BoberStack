//! What the tests that smithygen generates from a model's protocol test vectors share.

import { sort, startsWith } from "std/algo"
import * as json from "std/encoding/json"
import { Node, parse } from "std/encoding/xml"
import { Response } from "std/http"
import { ParseError, trim } from "std/string"
import { Caller } from "../../core/service"

/// The caller of a request answered under requestId.
export function caller(requestId: string): Caller {
	return new Caller("000000000000", "us-east-1", "arn:aws:iam::000000000000:root", requestId)
}

/// Whether the XML document of res and want say the same, whitespace between elements aside; or, if want is no
/// document, whether res's body is want. Where the root of want has no ResponseMetadata, that of res is left out: a
/// vector shows it only where it tests it.
export function same(res: Response, want: string): bool throws ParseError {
	if (!startsWith(trim(want), "<")) {
		return (res.body.whole ?? "") == want
	}
	const g = parse(res.body.whole ?? "").elements()[0]
	const w = parse(want).elements()[0]
	if (!w.children.some(c => c.name == "ResponseMetadata")) {
		g.children = g.children.filter(c => c.name != "ResponseMetadata")
	}
	return alike(g, w)
}

/// Whether the elements a and b have the same name, attributes and content.
function alike(a: Node, b: Node): bool {
	const as = a.children.filter(c => c.kind == "element")
	const bs = b.children.filter(c => c.kind == "element")
	if (a.name != b.name || a.ns != b.ns || attributes(a) != attributes(b) || as.length != bs.length) {
		return false
	}
	if (as.length == 0) {
		return trim(a.text()) == trim(b.text())
	}
	for (let i = 0; i < as.length; i++) {
		if (!alike(as[i], bs[i])) {
			return false
		}
	}
	return true
}

/// The attributes of el, in order of their names.
function attributes(el: Node): string {
	const all = el.attrs.map(a => `${a.name}="${a.value}"`)
	sort(all)
	return all.join(" ")
}

/// Whether the JSON of res and want say the same, whitespace and the order of members aside; none if want is "", and
/// byte for byte if want is no object or array, as a payload's text or blob.
export function sameJson(res: Response, want: string): bool throws ParseError {
	const got = res.body.whole ?? ""
	const t = trim(want)
	return if (startsWith(t, "{") || startsWith(t, "[")) canonical(got) == canonical(want) else got == want
}

/// An item of a JSON array, an array of none if one, as std/encoding/json decodes any.
type Item = f64 | string | bool | json.Keys | null | (f64 | string | bool | json.Keys | null)[]

/// The JSON s, without whitespace and with the members of its objects in order of their names.
function canonical(s: string): string throws ParseError {
	const t = trim(s)
	if (startsWith(t, "{")) {
		const members = json.decode[json.Keys](t).all.map(m => `${json.quoted(m[0])}:${canonical(m[1])}`)
		sort(members)
		return `{${members.join(",")}}`
	}
	if (startsWith(t, "[")) {
		const items: string[] = []
		for (const x of json.decode[Item[]](t)) {
			items.push(canonical(encode(x)))
		}
		return `[${items.join(",")}]`
	}
	return encode(json.decode[Item](t))
}

/// The JSON of x, which it can hold.
function encode(x: Item): string {
	try {
		return json.encode(x)
	} catch (e: json.EncodeError) {
		return "" // a float of JSON is finite
	}
}
