//! Records a tape from real AWS: `bober run tools/tape/main.bob -- record <scenario> [<tape>]` sends the scenario's
//! steps, then its cleanup, to us-east-1, signed by the credentials in AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
//! AWS_SESSION_TOKEN, and writes the tape, by default over the scenario. ./tape.bob says what a scenario is.

import * as client from "../../core/client"
import { answer, bodyOf, find, form, load, request, Step, Tape, text, volatiles } from "./tape"
import * as tape from "./tape"
import { indexOf, sortBy } from "std/algo"
import { isDigit, isUpper } from "std/ascii"
import { CryptoError } from "std/crypto/error"
import { bytes } from "std/crypto/random"
import * as hex from "std/encoding/hex"
import { mapFile, writeFile } from "std/fs"
import { Request, Response, send } from "std/http"
import { ParseError, replace, split } from "std/string"
import { env } from "std/process"
import { iso8601Basic, second, sleep } from "std/time"

/// Why a recording stops.
class Failure {
	what: string

	constructor(what: string) { this.what = what }
}

/// Whom requests are signed as, and who that is.
class Caller {
	accessKey = ""
	secret = ""
	token = ""
	account = ""
	arn = ""
	userId = ""
}

/// A recording: the caller, the prefix of its names, the values bound, and those of captures as a tape holds them.
class Recording {
	caller: Caller
	prefix: string
	values: [string, string][]
	captured: [string, string][] = []

	constructor(caller: Caller, prefix: string) {
		this.caller = caller
		this.prefix = prefix
		this.values = [["prefix", prefix], ["account", caller.account], ["region", "us-east-1"]]
	}

	/// s as AWS answers it, retried until its status is s.until, if that is not 0; its answer is set on s, normalised,
	/// the values of members named volatile, there or on s, as their forms, and captured values of 8 characters or more
	/// as ${name}.
	run(s: Step, volatile: string[]) throws IoError | ParseError | CryptoError | Failure {
		let [res, body] = this.send(s)
		for (let tries = 1; s.until != 0 && res.status != s.until && tries < 15; tries++) {
			sleep(2 * second)
			[res, body] = this.send(s)
		}
		for (const [name, path] of s.capture) {
			const v = find(body, path)
			if (v == null) {
				throw new Failure(`nothing at ${path} to capture as ${name}`)
			}
			tape.bind(this.values, name, v!)
			if (v!.length >= 8) {
				tape.bind(this.captured, name, this.normal(v!))
			}
		}
		let normal = this.normal(body)
		const names = volatile.slice(0, volatile.length)
		names.append(s.volatile)
		for (const v of volatiles(normal, names)) {
			if (!this.captured.some(c => c[1] == v)) {
				normal = replace(normal, v, form(v))
			}
		}
		const captured = this.captured.slice(0, this.captured.length)
		sortBy(captured, (a, b) => a[1].length > b[1].length)
		for (const [name, v] of captured) {
			normal = replace(normal, v, "${" + name + "}")
		}
		const a = answer(res, normal)
		a.headers = a.headers.map(h => [h[0], this.normal(h[1])])
		s.response = a
		print(`${s.name}: ${a.status} ${code(bodyOf(a))}`)
	}

	/// The answer to s, its body whole.
	send(s: Step): [Response, string] throws IoError | ParseError | CryptoError | Failure {
		const host = if (s.service == "iam") "iam.amazonaws.com" else `${s.service}.us-east-1.amazonaws.com`
		return call(this.caller, request(s, this.values, `https://${host}`), s.service)
	}

	/// s with the caller as the root of 000000000000, and the prefix the tape's.
	normal(s: string): string {
		const c = this.caller
		let out = replace(s, c.arn, "arn:aws:iam::000000000000:root")
		out = replace(out, c.userId, "000000000000")
		out = replace(out, c.account, "000000000000")
		return replace(out, this.prefix, tape.prefix)
	}
}

function main(): i32 {
	const a = args()
	const at = indexOf(a, ["record"])
	if (at < 0 || a.length < at + 2 || a.length > at + 3) {
		print("usage: bober run tools/tape/main.bob -- record <scenario> [<tape>]")
		return 2
	}
	const from = a[at + 1]
	const to = if (a.length == at + 3) a[at + 2] else from
	const c = new Caller()
	c.accessKey = env("AWS_ACCESS_KEY_ID") ?? ""
	c.secret = env("AWS_SECRET_ACCESS_KEY") ?? ""
	c.token = env("AWS_SESSION_TOKEN") ?? ""
	if (c.accessKey == "" || c.secret == "") {
		print("tape: no AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY")
		return 1
	}
	let t = new Tape()
	try {
		t = load(from)
		identify(c)
	} catch (e: IoError | ParseError | CryptoError | Failure) {
		print(`tape: ${message(e)}`)
		return 1
	}
	let r: Recording | null = null
	try {
		r = new Recording(c, `boberstack-ab-${hex.encode(bytes(4))}`)
	} catch (e: IoError) {
		print(`tape: ${e}`)
		return 1
	}
	let failed = false
	for (const s of t.steps) {
		try {
			r!.run(s, t.volatile)
		} catch (e: IoError | ParseError | CryptoError | Failure) {
			print(`tape: ${s.name}: ${message(e)}`)
			failed = true
			break
		}
	}
	for (const s of t.cleanup) {
		try {
			r!.run(s, t.volatile)
		} catch (e: IoError | ParseError | CryptoError | Failure) {
			print(`tape: ${s.name}: ${message(e)}`)
			failed = true
		}
	}
	if (failed) {
		print(`tape: ${to} not written`)
		return 1
	}
	const out = text(t)
	let leak = ""
	try {
		leak = leaks(out, c, mapFile("models/iam-managed-policies.jsonl"))
	} catch (e: IoError) {
		leak = `what it cannot check: ${e}`
	}
	if (leak != "") {
		print(`tape: ${to} not written: it holds ${leak}`)
		return 1
	}
	try {
		writeFile(to, out)
	} catch (e: IoError) {
		print(`tape: ${e}`)
		return 1
	}
	return 0
}

/// Sets on c its account, ARN and user id, as GetCallerIdentity answers.
function identify(c: Caller) throws IoError | ParseError | CryptoError | Failure {
	const s = new Step()
	s.service = "sts"
	s.query = [["Action", "GetCallerIdentity"], ["Version", "2011-06-15"]]
	const [res, body] = call(c, request(s, [], "https://sts.us-east-1.amazonaws.com"), "sts")
	if (res.status != 200) {
		throw new Failure(`GetCallerIdentity answers ${res.status} ${code(body)}`)
	}
	c.account = find(body, "Account") ?? ""
	c.arn = find(body, "Arn") ?? ""
	c.userId = find(body, "UserId") ?? ""
	if (c.account == "" || c.arn == "" || c.userId == "") {
		throw new Failure("GetCallerIdentity answers no identity")
	}
}

/// The answer to req, for service, signed as c, its body whole.
function call(c: Caller, req: Request,
	service: string): [Response, string] throws IoError | ParseError | CryptoError | Failure {
	const t = now()
	client.sign(req, req.body.whole ?? "", service, "us-east-1", c.accessKey, c.secret, c.token,
		iso8601Basic(t - t % second))
	const res = send(req)
	return [res, res.body.text()]
}

/// What of the account out holds, "" if nothing: its id, the caller's access key or a part of its ARN or user id, or
/// a unique id, which encodes the account, but those of AWS managed policies, which managed holds.
function leaks(out: string, c: Caller, managed: string): string {
	if (indexOf(out, c.account) >= 0) {
		return "the account id"
	}
	if (indexOf(out, c.accessKey) >= 0) {
		return "the access key id"
	}
	const parts = split(c.arn, "/")
	parts.append(split(c.userId, ":"))
	for (const p of parts.slice(1, parts.length)) {
		if (p.length >= 4 && indexOf(out, p) >= 0) {
			return "a part of the caller's ARN or user id"
		}
	}
	for (const prefix of ["AIDA", "AROA", "AKIA", "ASIA", "AGPA", "AIPA", "ANPA", "ANVA", "APKA"]) {
		for (let i = indexOf(out, prefix); i >= 0; i = indexOf(out, prefix, i + 1)) {
			let end = i + prefix.length
			while (end < out.length && (isUpper(out[end]) || isDigit(out[end]))) {
				end++
			}
			const id = out.slice(i, end)
			if (id.length >= 16 && indexOf(managed, `"${id}"`) < 0) {
				return `the unique id ${id}`
			}
		}
	}
	return ""
}

/// The error code in body, XML's Code or JSON's __type, "" if none.
function code(body: string): string {
	try {
		return find(body, "Code") ?? find(body, "__type") ?? ""
	} catch (e: ParseError) {
		return ""
	}
}

/// What e says.
function message(e: IoError | ParseError | CryptoError | Failure): string {
	return if (e instanceof Failure) e.what else `${e}`
}
