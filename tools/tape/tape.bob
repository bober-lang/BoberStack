//! Tapes: what real AWS answered to a scenario's requests, recorded once by ./main.bob and replayed against a Gateway
//! by a test, which checks that BoberStack answers as AWS did.
//!
//! A scenario is a JSON file of steps, which recording rewrites as a tape, the steps with AWS's answers:
//!
//! ```json
//! {
//! 	"volatile": ["RequestId", "CreateDate", "UserId"],
//! 	"steps": [
//! 		{"name": "create", "service": "iam", "capture": {"arn": "User/Arn"},
//! 			"query": {"Action": "CreateUser", "Version": "2010-05-08", "UserName": "${prefix}-u"}},
//! 		{"name": "get missing", "service": "iam", "differs": "BoberStack answers 400",
//! 			"query": {"Action": "GetUser", "Version": "2010-05-08", "UserName": "${prefix}-none"}},
//! 		{"name": "queue", "service": "sqs", "target": "AmazonSQS.CreateQueue", "until": 200,
//! 			"json": {"QueueName": "${prefix}-q"}}
//! 	],
//! 	"cleanup": [{"name": "delete", "service": "iam",
//! 		"query": {"Action": "DeleteUser", "Version": "2010-05-08", "UserName": "${prefix}-u"}}]
//! }
//! ```
//!
//! A step is a request to the service of the signing name `service`: `POST /` unless `method` and `path` say
//! otherwise, its body the form of the parameters `query` (awsQuery), or the JSON object `json` (awsJson, as
//! `application/x-amz-json-1.0` unless `contentType` says otherwise), with `target` as X-Amz-Target. `${name}` in a
//! path or a value is replaced by what name is bound to: `prefix` to `boberstack-ab-` and 8 random hex digits when
//! recording, which name every resource made, `account` to the account and `region` to us-east-1, and the names that
//! earlier steps `capture`, each the text at a path of its answer: segments separated by /, each the first element of
//! XML, or member or index of JSON, of that name below the one before. Recording retries a step `until` its answer
//! has that status, for what AWS makes eventually consistent, and runs `cleanup` even after a step failed. A step is
//! sent as the scenario's caller unless `as` names others, whose access key, secret and session token, if any, earlier
//! steps capture as `<as>.key`, `<as>.secret` and `<as>.token`; a tape holds them as captures, `${<as>.secret}`.
//!
//! S3's requests are REST: `path` is a bucket and key, `/${prefix}-b/a key`, which the tool encodes once, as S3
//! signs it, and sends to the bucket's host, `<bucket>.s3.<region>.amazonaws.com`, if `virtual`; `params` is the URL's
//! query, `headers` the request's, `region` the one it is signed for if not the tape's `region`, by default
//! us-east-1, and the body is `body`'s text, `base64`'s bytes, or `size` bytes of `repeat` over and over, as a
//! multipart upload's parts are described rather than written out. A request to S3 is signed over all its headers
//! and X-Amz-Content-Sha256, the body's hash unless the step sets it; not at all if `anonymous`; or in a presigned
//! URL valid for `presign` seconds, signed `age` seconds before it is sent, whose query parameters `tamper` then
//! changes. A path `header:<name>` captures a header of the answer.
//!
//! A tape holds nothing of the account: recording makes its id 000000000000, the caller's identity the account's
//! root, which a replay sends as, the prefix `boberstack-ab-00000000`, a value captured `${name}` wherever it is, S3's
//! canonical user id of the account `${owner}`, and that of a member or header named `volatile`, of the tape or the
//! step, or `ignored`, its form; and it refuses to write a tape that still names the account, its canonical user or the
//! caller, or holds a unique id, which encodes the account: capture those, or make them volatile.
//!
//! A replay compares the status, the headers in `headers`, and the body as a tree: of XML elements, or JSON members
//! and items, matched by name, and the n-th of a name with the n-th, so that a list's order counts and a structure's
//! does not. A captured value is expected where AWS's was, as is a volatile member, of the same form: its runs of
//! letters, digits and +/= the same in number, between the same other characters; an ignored member need only be
//! there; a `${name}` not yet bound, as `${owner}`, binds it to what is there; and the random id of an authorization
//! that IAM's denials link to is not compared. Of S3 it compares the headers in `s3Headers`, Content-Length only of an
//! object's bytes or no body, and an object's bytes by their length and hash, which the tape holds instead. It sends
//! S3's requests to s3.localhost.localstack.cloud:4566, a virtual-hosted one to the bucket's subdomain of it, signed
//! when a test's clock reads, and an anonymous one unsigned. A step with `differs`, the reason BoberStack answers
//! otherwise, is expected to differ, until it no longer does.

import * as client from "../../core/client"
import * as sigv4 from "../../core/auth/sigv4"
import { Gateway } from "../../core/gateway"
import * as base64 from "std/encoding/base64"
import * as hex from "std/encoding/hex"
import * as json from "std/encoding/json"
import { Keys, Mapping, OmitEmpty } from "std/encoding/json"
import * as xml from "std/encoding/xml"
import { readFile } from "std/fs"
import { Request, Response } from "std/http"
import { isAlphanumeric } from "std/ascii"
import { CryptoError } from "std/crypto/error"
import { sha256 } from "std/crypto/hash"
import { indexOf, sort, startsWith, unique } from "std/algo"
import { ParseError, replace, split, trim } from "std/string"
import { iso8601Basic, second } from "std/time"
import { escape } from "std/url"

/// The headers of an answer that a tape holds.
export const headers = ["content-type", "x-amzn-errortype", "x-amzn-query-error"]

/// The headers of S3's answers that a tape holds, and the prefixes of the others it holds.
export const s3Headers = ["accept-ranges", "cache-control", "content-disposition", "content-encoding",
	"content-language", "content-length", "content-range", "content-type", "etag", "expires", "last-modified",
	"location", "x-amz-bucket-region", "x-amz-copy-source-version-id", "x-amz-delete-marker", "x-amz-missing-meta",
	"x-amz-mp-parts-count", "x-amz-storage-class", "x-amz-tagging-count", "x-amz-version-id",
	"x-amz-website-redirect-location"]

export const s3Prefixes = ["x-amz-checksum-", "x-amz-meta-", "x-amz-server-side-encryption"]
/// The prefix of the names in a tape, as long as a recording's.
export const prefix = "boberstack-ab-00000000"
/// The instant a replay signs its requests at, which is now() in a test: 20150626T140000Z.
export const replayed: i64 = 1435327200 * second

/// An answer as a tape holds it: a JSON body as an object, an object's bytes by their length and hash, any other as
/// text.
export class Answer {
	status: i32 = 0
	headers: [string, string][] @Mapping = []
	body: string @OmitEmpty = ""
	json: Keys | null @OmitEmpty = null
	size: i32 @OmitEmpty = 0
	/// In hex.
	sha256: string @OmitEmpty = ""
}

/// A request, what to bind from its answer, and once recorded what AWS answered.
export class Step {
	name = ""
	/// The signing name of the service.
	service = ""
	/// POST and / if "".
	method: string @OmitEmpty = ""
	path: string @OmitEmpty = ""
	target: string @OmitEmpty = ""
	contentType: string @OmitEmpty = ""
	/// awsQuery's parameters, or awsJson's object.
	query: [string, string][] @Mapping @OmitEmpty = []
	json: Keys | null @OmitEmpty = null
	/// The URL's query, a parameter of "" its name alone.
	params: [string, string][] @Mapping @OmitEmpty = []
	headers: [string, string][] @Mapping @OmitEmpty = []
	/// The body: a text, bytes in base64, or size bytes of repeat over and over.
	body: string @OmitEmpty = ""
	base64: string @OmitEmpty = ""
	repeat: string @OmitEmpty = ""
	size: i32 @OmitEmpty = 0
	/// Signed for, if not the tape's.
	region: string @OmitEmpty = ""
	/// Sent to the host of the bucket the path starts with.
	virtual: bool @OmitEmpty = false
	/// Unsigned.
	anonymous: bool @OmitEmpty = false
	/// A presigned URL's seconds, 0 to sign in the Authorization header; how long before it is sent it is signed; and
	/// the query parameters set once it is.
	presign: i64 @OmitEmpty = 0
	age: i64 @OmitEmpty = 0
	tamper: [string, string][] @Mapping @OmitEmpty = []
	/// By name, the path of the text to bind it to.
	capture: [string, string][] @Mapping @OmitEmpty = []
	volatile: string[] @OmitEmpty = []
	ignored: string[] @OmitEmpty = []
	/// Whom it is sent as: by the values bound to <as>.key, <as>.secret and, of a session, <as>.token; the root if "".
	as: string @OmitEmpty = ""
	/// The status to retry for while recording, 0 for none.
	until: i32 @OmitEmpty = 0
	/// Why BoberStack answers otherwise than AWS, "" if it does not.
	differs: string @OmitEmpty = ""
	/// What AWS answered, once recorded.
	response: Answer | null @OmitEmpty = null
}

/// A scenario, or once recorded a tape.
export class Tape {
	/// What ${region} is bound to, and steps are signed for unless they name another; us-east-1 if "".
	region: string @OmitEmpty = ""
	/// The members and headers of every answer whose values differ from one run to the next.
	volatile: string[] @OmitEmpty = []
	/// Those not compared at all.
	ignored: string[] @OmitEmpty = []
	steps: Step[] = []
	/// Run after the steps, even if one failed while recording.
	cleanup: Step[] @OmitEmpty = []
}

/// The tape, or scenario, in the file at path.
export function load(path: string): Tape throws IoError | ParseError { return json.decode[Tape](readFile(path)) }

/// t as its file holds it.
export function text(t: Tape): string {
	try {
		return json.indent(json.encode(t)) + "\n"
	} catch (e: json.EncodeError) {
		return "" // a tape holds no float
	}
}

/// The request of s to endpoint, as https://iam.amazonaws.com, with each ${name} replaced by its value in values,
/// unsigned.
export function request(s: Step, values: [string, string][], endpoint: string): Request throws ParseError {
	let body = ""
	let kind = s.contentType
	if (s.json != null) {
		body = fill(objectText(s.json!), values, true)
		kind = if (kind == "") "application/x-amz-json-1.0" else kind
	} else if (s.query.length > 0) {
		body = s.query.map(p => `${escape(p[0], "component")}=${escape(fill(p[1], values, false), "component")}`).join("&")
		kind = if (kind == "") "application/x-www-form-urlencoded; charset=utf-8" else kind
	} else {
		body = content(s, values)
	}
	let path = fill(if (s.path == "") "/" else s.path, values, false)
	let base = endpoint
	if (s.service == "s3") {
		path = split(path, "/").map(p => escape(p, "component")).join("/")
	}
	if (s.virtual) {
		const end = indexOf(path, "/", 1)
		const at = indexOf(base, "://") + 3
		base = base.slice(0, at) + path.slice(1, if (end < 0) path.length else end) + "." + base.slice(at, base.length)
		path = if (end < 0) "/" else path.slice(end, path.length)
	}
	const q = s.params.map(p => escape(p[0], "component")
		+ (if (p[1] == "") "" else `=${escape(fill(p[1], values, false), "component")}`)).join("&")
	const req = new Request(if (s.method == "") "POST" else s.method, base + path + (if (q == "") "" else `?${q}`),
		body)
	req.headers.set("host", `${req.url.host}${if (req.url.port == null) "" else `:${req.url.port}`}`)
	if (kind != "") {
		req.headers.set("content-type", kind)
	}
	if (s.target != "") {
		req.headers.set("x-amz-target", s.target)
	}
	for (const [name, v] of s.headers) {
		req.headers.set(name, fill(v, values, false))
	}
	return req
}

/// The body s describes: base64's bytes, size bytes of repeat, or body with each ${name} replaced by its value in
/// values.
export function content(s: Step, values: [string, string][]): string throws ParseError {
	if (s.base64 != "") {
		return base64.decode(s.base64)
	}
	if (s.repeat != "") {
		let out = s.repeat
		while (out.length < s.size) {
			out = out + out
		}
		return out.slice(0, s.size)
	}
	return fill(s.body, values, false)
}

/// Signs req, the request of s, by the access key, secret and session token of by at the instant t: not if s is
/// anonymous; of S3 as an SDK signs it, or in a presigned URL; of any other service as ./../../core/client signs a
/// query.
export function authorize(req: Request, s: Step, values: [string, string][], by: [string, string, string],
	t: i64) throws CryptoError {
	if (s.anonymous) {
		return
	}
	const [key, secret, token] = by
	const region = regionOf(s, values)
	const body = req.body.whole ?? ""
	if (s.service != "s3") {
		client.sign(req, body, s.service, region, key, secret, token, iso8601Basic(t - t % second))
		return
	}
	const a = new sigv4.Authorization()
	a.accessKey = key
	a.region = region
	a.service = "s3"
	if (s.presign != 0) {
		const stamp = iso8601Basic(t - t % second - s.age * second)
		a.date = stamp.slice(0, 8)
		a.expires = s.presign
		a.signedHeaders = ["host"]
		const q = req.url.query
		q.set("X-Amz-Algorithm", "AWS4-HMAC-SHA256")
		q.set("X-Amz-Credential", `${key}/${sigv4.scope(a)}`)
		q.set("X-Amz-Date", stamp)
		q.set("X-Amz-Expires", `${s.presign}`)
		if (token != "") {
			q.set("X-Amz-Security-Token", token)
		}
		q.set("X-Amz-SignedHeaders", "host")
		q.set("X-Amz-Signature", sigv4.signature(req, body, a, secret))
		for (const [name, v] of s.tamper) {
			q.set(name, fill(v, values, false))
		}
		return
	}
	const stamp = iso8601Basic(t - t % second)
	a.date = stamp.slice(0, 8)
	req.headers.set("x-amz-date", stamp)
	if (token != "") {
		req.headers.set("x-amz-security-token", token)
	}
	if (!req.headers.has("x-amz-content-sha256")) {
		req.headers.set("x-amz-content-sha256", hex.encode(sha256(body)))
	}
	const names = unique(req.headers.entries.map(e => e[0]))
	sort(names)
	a.signedHeaders = names
	const signature = sigv4.signature(req, body, a, secret, req.headers.get("x-amz-content-sha256"))
	req.headers.set("authorization",
		`AWS4-HMAC-SHA256 Credential=${key}/${sigv4.scope(a)}, SignedHeaders=${names.join(";")}, Signature=${signature}`)
}

/// The region s is signed for: its own, else the one values binds.
export function regionOf(s: Step, values: [string, string][]): string {
	return if (s.region == "") lookup(values, "region") ?? "us-east-1" else s.region
}

/// Whether a tape holds body, an answer of service, as an object's bytes: of S3, neither empty, XML nor JSON.
export function opaque(service: string, body: string): bool {
	const first = initial(body)
	return service == "s3" && body != "" && first != "<" && first != "{"
}

/// Whether a tape holds the header name of an answer of service, whose body is an object's bytes or not, or none.
export function kept(service: string, name: string, body: string): bool {
	if (service != "s3") {
		return headers.includes(name)
	}
	if (name == "content-length") {
		return body == "" || opaque(service, body)
	}
	return s3Headers.includes(name) || s3Prefixes.some(p => startsWith(name, p))
}

/// The answer that res, of service, is, its body body.
export function answer(res: Response, body: string, service: string): Answer throws CryptoError {
	const a = new Answer()
	a.status = res.status
	for (const [h, v] of res.headers.entries) {
		if (kept(service, h, body) && lookup(a.headers, h) == null) {
			a.headers.push([h, v])
		}
	}
	if (opaque(service, body)) {
		a.size = body.length
		a.sha256 = hex.encode(sha256(body))
		return a
	}
	if (initial(body) == "{") {
		try {
			a.json = json.decode[Keys](body)
			return a
		} catch (e: ParseError) {}
	}
	a.body = body
	return a
}

/// The text of a's body.
export function bodyOf(a: Answer): string { return if (a.json != null) objectText(a.json!) else a.body }

/// The text at path in the body, null if there is none.
export function find(body: string, path: string): string | null throws ParseError {
	let t: Tree | null = tree(body)
	for (const name of split(path, "/")) {
		t = below(t!, name)
		if (t == null) {
			return null
		}
	}
	return if (t!.leaf) t!.text else null
}

/// What path captures of res, whose body is body: the header it names after header:, else the text at it in the
/// body; null if there is none.
export function captured(res: Response, body: string, path: string): string | null throws ParseError {
	const header = "header:"
	return if (startsWith(path, header)) res.headers.get(path.slice(header.length, path.length)) else find(body, path)
}

/// The texts of the members named one of names in body, those of 8 characters or more.
export function volatiles(body: string, names: string[]): string[] throws ParseError {
	const out: string[] = []
	collect(tree(body), names, out)
	return out
}

/// What differs between the answers of g to the tape at path, its steps then its cleanup, and those it holds: a line
/// for each difference, naming the step, the path in the body and both values. g is sent requests as the root of
/// 000000000000, unless a step is sent as others.
export function replay(path: string, g: Gateway): string[] {
	let t = new Tape()
	try {
		t = load(path)
	} catch (e: IoError | ParseError) {
		return [`${path}: ${e}`]
	}
	return play(t, g)
}

/// What differs between the answers of g to t and those it holds, as replay says.
export function play(t: Tape, g: Gateway): string[] {
	const values: [string, string][] = [["prefix", prefix], ["account", "000000000000"],
		["region", if (t.region == "") "us-east-1" else t.region]]
	const out: string[] = []
	const steps = t.steps.slice(0, t.steps.length)
	steps.append(t.cleanup)
	for (let i = 0; i < steps.length; i++) {
		const s = steps[i]
		const name = `step ${i + 1} (${s.name})`
		const by = signer(s, values, ["test", "test", ""])
		let lines = [`no credentials captured as ${s.as}`]
		try {
			if (by != null) {
				lines = check(s, send(s, values, by!, g), t, values)
			}
		} catch (e: IoError | ParseError | CryptoError) {
			lines = [`${e}`]
		}
		if (s.differs == "") {
			out.append(lines.map(l => `${name}: ${l}`))
		} else if (lines.length == 0) {
			out.push(`${name}: answers as AWS did, though marked as differing: ${s.differs}`)
		}
	}
	return out
}

/// The answer of g to s, its ${name}s replaced by values, signed by the access key, secret and token of by.
function send(s: Step, values: [string, string][], by: [string, string, string],
	g: Gateway): Response throws IoError | ParseError | CryptoError {
	const req = request(s, values,
		if (s.service == "s3") "http://s3.localhost.localstack.cloud:4566" else "http://localhost:4566")
	authorize(req, s, values, by, replayed)
	return g.handle(req)
}

/// The access key, secret and session token s is sent with, as values binds them: root's if s is sent as no one, null
/// if no access key and secret are bound.
export function signer(s: Step, values: [string, string][],
	root: [string, string, string]): [string, string, string] | null {
	if (s.as == "") {
		return root
	}
	const of = (part: string) => lookup(values, `${s.as}.${part}`) ?? ""
	return if (of("key") == "" || of("secret") == "") null else [of("key"), of("secret"), of("token")]
}

/// s with the id of each authorization IAM links to, which a request is given at random, as 0s.
export function unlinked(s: string): string {
	let out = s
	for (const before of ["authorization-details/", "authorization id: "]) {
		for (let i = indexOf(out,
			before); i >= 0 && i + before.length + 25 <= out.length; i = indexOf(out, before, i + 1)) {
			const at = i + before.length
			out = out.slice(0, at) + "0000000000000000000000000" + out.slice(at + 25, out.length)
		}
	}
	return out
}

/// The start of the ARN of what an organization holds.
export const organizations = "arn:aws:organizations::"

/// s with the ARNs of an organization's policies, as an SCP that denies names it, of 0s: the management account's
/// id, and the ids of the organization, a root and a policy, after o-, r- and p-.
export function unorganized(s: string): string {
	let out = s
	for (let i = indexOf(out, organizations); i >= 0; i = indexOf(out, organizations, i + 1)) {
		let end = i
		while (end < out.length && (isAlphanumeric(out[end]) || indexOf(":/-_", [out[end]]) >= 0)) {
			end++
		}
		const parts = split(out.slice(i + organizations.length, end), ":")
		const ids = (p: string) => if (p.length > 2
			&& ["o-", "p-", "r-"].includes(p.slice(0, 2))) p.slice(0, 2) + zeros(p.length - 2)
			else p
		const resource = if (parts.length < 2) "" else split(parts[1], "/").map(ids).join("/")
		out = out.slice(0, i) + `${organizations}${zeros(parts[0].length)}:${resource}` + out.slice(end, out.length)
	}
	return out
}

/// n 0s.
function zeros(n: i32): string {
	let out = ""
	while (out.length < n) {
		out += "0"
	}
	return out
}

/// How res differs from the answer s, of t, holds, whose captures it binds in values.
function check(s: Step, res: Response, t: Tape, values: [string, string][]): string[] throws IoError | ParseError {
	const want = s.response ?? new Answer()
	const body = res.body.text(64 << 20)
	const out: string[] = []
	if (res.status != want.status) {
		out.push(`status: expected ${want.status}, got ${res.status}`)
	}
	for (const [name, path] of s.capture) {
		const v = captured(res, body, path)
		if (v == null) {
			out.push(`${path}: nothing to capture as ${name}`)
		} else {
			bind(values, name, v!)
		}
	}
	const volatile = t.volatile.slice(0, t.volatile.length)
	volatile.append(s.volatile)
	const ignored = t.ignored.slice(0, t.ignored.length)
	ignored.append(s.ignored)
	const names = if (s.service == "s3") want.headers.map(h => h[0]) else headers.slice(0, headers.length)
	for (const [h, v] of res.headers.entries) {
		if (s.service == "s3" && kept(s.service, h, body) && !names.includes(h)) {
			names.push(h)
		}
	}
	for (const h of names) {
		const w = lookup(want.headers, h)
		const e = if (w == null) null else fill(w!, values, false)
		const v = res.headers.get(h)
		const same = if (e == null || v == null) e == v
			else ignored.includes(h) || e == v || volatile.includes(h) && form(e!) == form(v!)
		if (!same) {
			out.push(`header ${h}: expected ${show(e)}, got ${show(v)}`)
		}
	}
	if (want.sha256 != "") {
		try {
			const hash = hex.encode(sha256(body))
			if (body.length != want.size || hash != want.sha256) {
				out.push(`body: expected ${want.size} bytes of SHA-256 ${want.sha256}, got ${body.length} of ${hash}`)
			}
		} catch (e: CryptoError) {
			out.push(`body: ${e}`)
		}
		return out
	}
	compare(tree(bodyOf(want)), tree(body), "", volatile, ignored, values, out)
	return out
}

/// The value of name in pairs, null if none.
function lookup(pairs: [string, string][], name: string): string | null {
	for (const [k, v] of pairs) {
		if (k == name) {
			return v
		}
	}
	return null
}

/// Sets name to v in values.
export function bind(values: [string, string][], name: string, v: string) {
	for (const e of values) {
		if (e[0] == name) {
			e[1] = v
			return
		}
	}
	values.push([name, v])
}

/// s with each ${name} replaced by its value in values, escaped for a JSON string if quoted.
function fill(s: string, values: [string, string][], quoted: bool): string {
	let out = s
	for (const [name, v] of values) {
		const q = json.quoted(v)
		out = replace(out, "${" + name + "}", if (quoted) q.slice(1, q.length - 1) else v)
	}
	return out
}

/// The JSON object k holds.
function objectText(k: Keys): string {
	try {
		return json.encode(k)
	} catch (e: json.EncodeError) {
		return "{}" // the text of JSON is finite
	}
}

/// A body as compared: an XML element or a JSON value, named by its element, member or index; a leaf has a text.
class Tree {
	name: string
	text = ""
	leaf = true
	children: Tree[] = []

	constructor(name: string) { this.name = name }
}

/// An item of a JSON array, an array of none if one, as std/encoding/json decodes any.
type Item = i64 | f64 | string | bool | Keys | null | (i64 | f64 | string | bool | Keys | null)[]

/// The tree of body: XML, JSON, or else a leaf of its text.
function tree(body: string): Tree throws ParseError {
	const first = initial(body)
	if (first == "<") {
		return element(xml.parse(body), "")
	}
	if (first == "{" || first == "[") {
		return value(body, "")
	}
	const t = new Tree("")
	t.text = body
	return t
}

/// The tree of the XML node n, named name: its attributes as leaves named @name, then its elements; or if it has
/// neither a leaf of its text, trimmed.
function element(n: xml.Node, name: string): Tree {
	const t = new Tree(name)
	for (const a of n.attrs) {
		const l = new Tree(`@${a.name}`)
		l.text = a.value
		t.children.push(l)
	}
	const elements = n.children.filter(c => c.kind == "element")
	for (const e of elements) {
		t.children.push(element(e, e.name))
	}
	if (t.children.length == 0) {
		t.text = trim(n.text())
	} else {
		t.leaf = false
		if (elements.length == 0) {
			const l = new Tree("#text")
			l.text = trim(n.text())
			t.children.push(l)
		}
	}
	return t
}

/// The tree of the JSON s, named name: an object's members and an array's items by index; a string's leaf its value,
/// any other scalar's its JSON.
function value(s: string, name: string): Tree throws ParseError {
	const t = new Tree(name)
	const first = initial(s)
	if (first == "{") {
		t.leaf = false
		for (const [k, v] of json.decode[Keys](s).all) {
			t.children.push(value(v, k))
		}
	} else if (first == "[") {
		t.leaf = false
		const items = json.decode[Item[]](s)
		for (let i = 0; i < items.length; i++) {
			let item = "null"
			try {
				item = json.encode(items[i])
			} catch (e: json.EncodeError) {} // a float of JSON is finite
			t.children.push(value(item, `${i}`))
		}
	} else if (first == "\"") {
		t.text = json.decode[string](s)
	} else {
		t.text = trim(s)
	}
	return t
}

/// The first of t's descendants named name, depth first, null if none.
function below(t: Tree, name: string): Tree | null {
	for (const c of t.children) {
		if (c.name == name) {
			return c
		}
		const d = below(c, name)
		if (d != null) {
			return d
		}
	}
	return null
}

/// Adds to out the texts of 8 characters or more of the leaves below t named one of names.
function collect(t: Tree, names: string[], out: string[]): void {
	for (const c of t.children) {
		if (c.leaf && names.includes(c.name) && c.text.length >= 8) {
			out.push(c.text)
		}
		collect(c, names, out)
	}
}

/// Adds to out how a, at path, differs from e, AWS's, whose ${name}s are as values has them, or bind them if it is one
/// not bound, whose members named one of volatile need only be of the same form, and those named one of ignored only
/// be there.
function compare(e: Tree, a: Tree, path: string, volatile: string[], ignored: string[], values: [string, string][],
	out: string[]): void {
	const at = if (path == "") "body" else path
	const want = fill(e.text, values, false)
	const unbound = startsWith(want, "${") && indexOf(want, "}") == want.length - 1
	if (e.leaf && a.leaf && (ignored.includes(e.name) || unbound)) {
		if (unbound) {
			bind(values, want.slice(2, want.length - 1), a.text)
		}
		return
	}
	if (volatile.includes(e.name) && e.leaf && a.leaf) {
		if (form(want) != form(a.text)) {
			out.push(`${at}: expected the form of ${show(want)}, got ${show(a.text)}`)
		}
		return
	}
	if (e.leaf || a.leaf) {
		if (e.leaf && a.leaf && unlinked(want) != unlinked(a.text)) {
			out.push(`${at}: ${contrast(want, a.text)}`)
		} else if (!e.leaf || !a.leaf) {
			out.push(`${at}: expected ${if (e.leaf) show(want) else outline(e)}, got ${if (a.leaf) show(a.text) else outline(a)}`)
		}
		return
	}
	const seen: [string, i32][] = []
	for (const c of e.children) {
		const n = count(seen, c.name)
		const ds = a.children.filter(x => x.name == c.name)
		const p = `${path}/${c.name}${if (ds.length > 1 || named(e, c.name) > 1) `[${n + 1}]` else ""}`
		if (n >= ds.length) {
			out.push(`${p}: expected ${if (c.leaf) show(c.text) else outline(c)}, got nothing`)
		} else {
			compare(c, ds[n], p, volatile, ignored, values, out)
		}
	}
	const extra: [string, i32][] = []
	for (const d of a.children) {
		const n = count(extra, d.name)
		if (n >= named(e, d.name)) {
			const p = `${path}/${d.name}${if (named(a, d.name) > 1) `[${n + 1}]` else ""}`
			out.push(`${p}: expected nothing, got ${if (d.leaf) show(d.text) else outline(d)}`)
		}
	}
}

/// How many of name seen counts, which it counts once more.
function count(seen: [string, i32][], name: string): i32 {
	for (const e of seen) {
		if (e[0] == name) {
			e[1]++
			return e[1] - 1
		}
	}
	seen.push([name, 1])
	return 0
}

/// How many of t's children are named name.
function named(t: Tree, name: string): i32 { return t.children.filter(c => c.name == name).length }

/// The form of v: each run of letters, digits and +/= an x.
export function form(v: string): string {
	const out: u8[] = []
	for (let i = 0; i < v.length; i++) {
		if (!formed(v[i])) {
			out.push(v[i])
		} else if (i == 0 || !formed(v[i - 1])) {
			out.push(120)
		}
	}
	return fromBytes(out)
}

/// Whether c is a letter, digit or +/=.
function formed(c: u8): bool {
	return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 43 || c == 47 || c == 61
}

/// "expected want, got v", of texts that differ; of long ones, from 20 characters before the first that differs and
/// up to 100 on.
function contrast(want: string, v: string): string {
	let i = 0
	while (i < want.length && i < v.length && want[i] == v[i]) {
		i++
	}
	if (want.length <= 100 && v.length <= 100) {
		return `expected ${show(want)}, got ${show(v)}`
	}
	const from = if (i > 20) i - 20 else 0
	const cut = (s: string) => (if (from > 0) "…" else "")
		+ show(s.slice(from, if (from + 100 < s.length) from + 100 else s.length))
		+ (if (from + 100 < s.length) "…" else "")
	return `expected ${cut(want)}, got ${cut(v)}`
}

/// The first character of s that is not a space, "" if none.
function initial(s: string): string {
	const t = trim(s)
	return if (t == "") "" else t.slice(0, 1)
}

/// v quoted, or none.
function show(v: string | null): string { return if (v == null) "none" else json.quoted(v!) }
/// The names of t's children, in braces.
function outline(t: Tree): string { return `{${t.children.map(c => c.name).join(", ")}}` }
